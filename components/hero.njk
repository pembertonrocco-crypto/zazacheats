        x: Math.random() * W,
        y: Math.random() * H,
        r: rand(1, 2.6),
        opacity: rand(0.03, 0.13),
        sx: Math.cos(angle) * mag,
        sy: Math.sin(angle) * mag,
        ts: rand(0.003, 0.011),
        to: rand(0, Math.PI * 2)
