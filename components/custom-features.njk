  <script>
    (function() {
      var navBtns = document.querySelectorAll('.cf-cheat__nav-btn');
      var panels = document.querySelectorAll('.cf-cheat__menu');

      navBtns.forEach(function(btn) {
        btn.addEventListener('mousedown', function(e) { e.preventDefault(); });
        btn.addEventListener('click', function() {
          var target = btn.getAttribute('data-menu');
          navBtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          panels.forEach(function(p) {
            p.classList.remove('active');
            if (p.getAttribute('data-panel') === target) p.classList.add('active');
          });
        });
      });

      document.querySelectorAll('.cf-cheat__toggle').forEach(function(tog) {
        tog.addEventListener('mousedown', function(e) { e.preventDefault(); });
        tog.addEventListener('click', function() { tog.classList.toggle('on'); });
      });

      var sliders = [
        { id: 'cf-esp-dist', valId: 'cf-esp-dist-val', suffix: 'm' },
        { id: 'cf-aim-fov', valId: 'cf-aim-fov-val', suffix: '°' },
        { id: 'cf-aim-smooth', valId: 'cf-aim-smooth-val', suffix: '' },
        { id: 'cf-vis-opacity', valId: 'cf-vis-opacity-val', suffix: '%' },
        { id: 'cf-fps-cap', valId: 'cf-fps-cap-val', suffix: '' }
      ];

      sliders.forEach(function(s) {
        var el = document.getElementById(s.id);
        var val = document.getElementById(s.valId);
        if (el && val) {
          var paint = function() {
            val.textContent = el.value + s.suffix;
            var min = parseFloat(el.min) || 0, max = parseFloat(el.max) || 100;
            var pct = ((parseFloat(el.value) - min) / (max - min)) * 100;
            el.style.setProperty('--p', pct + '%');
          };
          el.addEventListener('input', paint);
          paint(); // initialise fill on load
        }
      });

      function fillMarqueeTrack(track) {
        var origItems = Array.from(track.children);
        if (!origItems.length) return;
        var containerWidth = track.parentElement.offsetWidth || window.innerWidth;
        var minWidth = containerWidth * 2.5;
        var iterations = 0;
        while (track.scrollWidth < minWidth && iterations < 20) {
          origItems.forEach(function(item) {
            track.appendChild(item.cloneNode(true));
          });
          iterations++;
        }
      }

      document.querySelectorAll('.cf-marquee-track').forEach(function(track) {
        fillMarqueeTrack(track);
      });
    })();

    /* scroll-reveal for the feature cards */
    (function () {
      var section = document.querySelector('.cf-section');
      var cards = section ? section.querySelectorAll('.cf-card') : [];
      if (!cards.length) return;

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return; // cards stay visible, no animation

      section.classList.add('cf-reveal-ready');

      if (!('IntersectionObserver' in window)) {
        cards.forEach(function (c) { c.classList.add('cf-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('cf-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      cards.forEach(function (c) { io.observe(c); });
    })();
  </script>
