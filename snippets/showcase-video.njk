{# =========================================================================
   SHOWCASE-VIDEO — Rust NFA showcase (direct .mp4 via HTML5 video).
   Custom poster + play-button overlay; the <video> element is created
   only on click, so the file is fetched lazily.
   Hosted on catbox.moe (permanent, no archiving).
   ========================================================================= #}
<section class="zaza-showcase zaza-showcase--nfa" aria-labelledby="zaza-showcase-nfa-title">
  <div class="zaza-showcase__bg" aria-hidden="true">
    <span class="zaza-showcase__bloom"></span>
    <span class="zaza-showcase__orb zaza-showcase__orb--a"></span>
    <span class="zaza-showcase__orb zaza-showcase__orb--b"></span>
    <span class="zaza-showcase__grid"></span>
  </div>

  <div class="zaza-showcase__inner">
    <p class="zaza-showcase__eyebrow">
      <span class="zaza-showcase__dot"></span>PROOF — REAL GAMEPLAY
    </p>

    <h2 id="zaza-showcase-nfa-title" class="zaza-showcase__title">See what you're buying<span class="zaza-showcase__title-dot">.</span></h2>

    <p class="zaza-showcase__sub">
      A <b>Non Full Access</b> Rust account — a disposable smurf you cheat on instead of your main.
    </p>

    <div class="zaza-showcase__frame zaza-showcase__frame--video" data-lenis-prevent>
      <button type="button"
              class="zaza-showcase__facade"
              id="zaza-showcase-nfa-facade"
              data-video-src="https://files.catbox.moe/38qmur.mp4"
              aria-label="Play the Rust NFA showcase video">
        {# AVIF/WebP with the JPEG kept as fallback (42K / 85K at full width).
           The frame measures ~330px on a phone and ~1030px on a desktop, and
           it is 16:9 in a 16:9 box so there is no crop — meaning a phone was
           downloading the full 1920px file to paint a third of it. The 1280w
           step covers phones at DPR2-3 and tablets; 1920w takes over on
           desktop. sizes reflects measured layout: ~95vw up to 900px, ~72vw
           above. #}
        <picture>
          <source type="image/avif"
                  sizes="(max-width: 900px) 95vw, 72vw"
                  srcset="{{ 'rust-nfa-showcase-poster-1280.avif' | assetUrl }} 1280w,
                          {{ 'rust-nfa-showcase-poster.avif' | assetUrl }} 1920w">
          <source type="image/webp"
                  sizes="(max-width: 900px) 95vw, 72vw"
                  srcset="{{ 'rust-nfa-showcase-poster-1280.webp' | assetUrl }} 1280w,
                          {{ 'rust-nfa-showcase-poster.webp' | assetUrl }} 1920w">
          <img class="zaza-showcase__thumb"
               src="{{ 'rust-nfa-showcase-poster.jpg' | assetUrl }}"
               alt="" width="1920" height="1080" loading="lazy" decoding="async" />
        </picture>
        <span class="zaza-showcase__scrim" aria-hidden="true"></span>
        <span class="zaza-showcase__sheen" aria-hidden="true"></span>
        <span class="zaza-showcase__play" aria-hidden="true">
          <span class="zaza-showcase__play-ring zaza-showcase__play-ring--1"></span>
          <span class="zaza-showcase__play-ring zaza-showcase__play-ring--2"></span>
          <span class="zaza-showcase__play-core">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true">
              <path d="M8 5.14v13.72a.5.5 0 0 0 .77.42l10.29-6.86a.5.5 0 0 0 0-.84L8.77 4.72A.5.5 0 0 0 8 5.14Z"/>
            </svg>
          </span>
        </span>
        <span class="zaza-showcase__hint" aria-hidden="true">
          <span class="zaza-showcase__hint-dot"></span>Watch — 0:38
        </span>
      </button>
    </div>

    {# The essentials strip that sat here — "Your main stays safe" / "Instant
       delivery" / "Real playtime hours" — is gone. zaza-nfa-block.njk now
       renders above this section and makes all three points properly, so
       keeping both restated them twice on one page. #}

    {# ---------- WARRANTY COMPARE ---------- #}
    <div class="zaza-warranty-compare">
      <div class="zaza-wc zaza-wc--free">
        <span class="zaza-wc__tag">
          <span class="zaza-wc__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </span>
          INCLUDED
        </span>
        <p class="zaza-wc__big"><b>1 replacement</b></p>
        <p class="zaza-wc__sm">If your account dies in the first 6 hours, we swap it once — at no cost.</p>
      </div>

      <div class="zaza-wc__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
        </svg>
      </div>

      <div class="zaza-wc zaza-wc--upgrade">
        <span class="zaza-wc__tag zaza-wc__tag--accent">+ $0.50 · RECOMMENDED</span>
        <p class="zaza-wc__big"><b>Up to 3 replacements</b></p>
        <p class="zaza-wc__sm">Triple your coverage in the same 6-hour window. Add it above in the buy panel <span aria-hidden="true">↑</span></p>
      </div>
    </div>

  </div>
</section>

<style>
  .zaza-showcase--nfa{
    --zs-accent: var(--cl-accent, #BF40BF);
    --zs-accent-rgb: var(--cl-accent-rgb, 191,64,191);
    --zs-blue: 124,58,237;
    --zs-text: var(--cl-t-primary, 255,255,255);
    position:relative;overflow:hidden;isolation:isolate;
    padding:clamp(3.25rem,7vw,5.5rem) 1.25rem;
  }
  .zaza-showcase--nfa .zaza-showcase__bg{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;}
  .zaza-showcase--nfa .zaza-showcase__bloom{
    position:absolute;top:8%;left:50%;width:min(900px,90%);height:420px;transform:translateX(-50%);
    background:radial-gradient(60% 60% at 50% 40%,rgba(var(--zs-accent-rgb),.30),transparent 70%);
    filter:blur(20px);
  }
  .zaza-showcase--nfa .zaza-showcase__orb{position:absolute;width:44vw;max-width:620px;aspect-ratio:1;border-radius:50%;filter:blur(130px);opacity:.55;}
  .zaza-showcase--nfa .zaza-showcase__orb--a{top:-18%;left:-10%;background:rgba(var(--zs-accent-rgb),.6);}
  .zaza-showcase--nfa .zaza-showcase__orb--b{bottom:-26%;right:-12%;background:rgba(var(--zs-blue),.5);}
  .zaza-showcase--nfa .zaza-showcase__grid{
    position:absolute;inset:0;opacity:.4;
    -webkit-mask-image:radial-gradient(70% 60% at 50% 45%,#000 0%,transparent 75%);
            mask-image:radial-gradient(70% 60% at 50% 45%,#000 0%,transparent 75%);
    background-image:linear-gradient(rgba(var(--zs-text),.05) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(var(--zs-text),.05) 1px,transparent 1px);
    background-size:46px 46px;
  }

  .zaza-showcase--nfa .zaza-showcase__inner{max-width:1000px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center;}

  .zaza-showcase--nfa .zaza-showcase__eyebrow{
    display:inline-flex;align-items:center;gap:.6rem;margin:0 0 1.15rem;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:.72rem;font-weight:500;letter-spacing:.24em;text-transform:uppercase;
    color:var(--zs-accent);
    padding:.45rem 1rem;border-radius:999px;
    background:rgba(var(--zs-accent-rgb),.1);
    border:1px solid rgba(var(--zs-accent-rgb),.3);
    box-shadow:0 0 24px -6px rgba(var(--zs-accent-rgb),.5);
  }
  .zaza-showcase--nfa .zaza-showcase__dot{width:7px;height:7px;border-radius:50%;background:var(--zs-accent);box-shadow:0 0 0 0 rgba(var(--zs-accent-rgb),.7);animation:zsDot 2s ease-out infinite;}

  .zaza-showcase--nfa .zaza-showcase__title{
    margin:0 0 .8rem;line-height:1.05;
    font-family:var(--zz-sans);
    font-weight:700;letter-spacing:-.02em;
    font-size:clamp(1.9rem,3.6vw,2.7rem);
    color:var(--zs-text-on,#fff);
  }
  .zaza-showcase--nfa .zaza-showcase__title-dot{
    color:var(--zs-accent);
      }

  .zaza-showcase--nfa .zaza-showcase__sub{
    margin:0 0 clamp(1.8rem,3vw,2.2rem);max-width:38rem;
    font-size:clamp(.95rem,1.9vw,1.05rem);line-height:1.55;
    color:rgba(var(--zs-text),.7);
  }
  .zaza-showcase--nfa .zaza-showcase__sub b{color:var(--zs-text);font-weight:500;}

  /* ---- WARRANTY COMPARE ---- */
  .zaza-showcase--nfa .zaza-warranty-compare{
    width:100%;display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:.75rem;align-items:stretch;
    text-align:left;
  }
  .zaza-showcase--nfa .zaza-wc{
    display:flex;flex-direction:column;gap:.45rem;
    padding:1.1rem 1.1rem 1.2rem;
    border-radius:12px;
    border:1px solid rgba(var(--zs-text),.08);
    background:rgba(255,255,255,.025);
  }
  .zaza-showcase--nfa .zaza-wc--upgrade{
    border-color:rgba(var(--zs-accent-rgb),.4);
    background:
      linear-gradient(135deg, rgba(var(--zs-accent-rgb),.12), rgba(var(--zs-accent-rgb),.03) 60%),
      rgba(255,255,255,.025);
    box-shadow:0 8px 28px -14px rgba(var(--zs-accent-rgb),.6);
  }
  .zaza-showcase--nfa .zaza-wc__tag{
    display:inline-flex;align-items:center;gap:.4rem;align-self:flex-start;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:.65rem;font-weight:700;letter-spacing:.14em;
    color:#22c55e;
    padding:.32rem .55rem;border-radius:5px;
    background:rgba(34,197,94,.1);
    border:1px solid rgba(34,197,94,.32);
  }
  .zaza-showcase--nfa .zaza-wc__check{
    display:inline-flex;align-items:center;justify-content:center;
    width:14px;height:14px;border-radius:50%;
    background:#22c55e;color:#0a0c18;
  }
  .zaza-showcase--nfa .zaza-wc__tag--accent{
    color:var(--zs-accent);
    background:rgba(var(--zs-accent-rgb),.13);
    border-color:rgba(var(--zs-accent-rgb),.4);
  }
  .zaza-showcase--nfa .zaza-wc__big{
    margin:.2rem 0 .15rem;
    font-family:var(--zz-sans);
    font-size:1.15rem;font-weight:500;letter-spacing:-.01em;
    color:var(--zs-text);
  }
  .zaza-showcase--nfa .zaza-wc__big b{font-weight:700;}
  .zaza-showcase--nfa .zaza-wc--upgrade .zaza-wc__big b{color:var(--zs-accent);}
  .zaza-showcase--nfa .zaza-wc__sm{
    margin:0;font-size:.83rem;line-height:1.5;
    color:rgba(var(--zs-text),.62);
  }
  .zaza-showcase--nfa .zaza-wc__arrow{
    display:flex;align-items:center;justify-content:center;
    color:rgba(var(--zs-text),.35);
    padding:0 .15rem;
  }

  @media (max-width:720px){
    .zaza-showcase--nfa .zaza-warranty-compare{
      grid-template-columns:1fr;
    }
    .zaza-showcase--nfa .zaza-wc__arrow{
      transform:rotate(90deg);
      padding:.1rem 0;
      color:rgba(var(--zs-text),.45);
    }
  }

  .zaza-showcase--nfa .zaza-showcase__frame{
    position:relative;width:100%;aspect-ratio:16/9;border-radius:20px;padding:2px;overflow:hidden;
    box-shadow:0 40px 120px -30px rgba(var(--zs-accent-rgb),.55),0 20px 60px -25px rgba(0,0,0,.7);
  }
  .zaza-showcase--nfa .zaza-showcase__frame::before{
    content:"";position:absolute;inset:-45%;z-index:0;
    background:conic-gradient(from 0deg,
      rgba(var(--zs-accent-rgb),1),
      rgba(var(--zs-blue),1),
      rgba(var(--zs-accent-rgb),0) 42%,
      rgba(var(--zs-accent-rgb),0) 58%,
      rgba(var(--zs-accent-rgb),1));
    animation:zsSpin 8s linear infinite;
  }
  .zaza-showcase--nfa .zaza-showcase__frame::after{
    content:"";position:absolute;inset:0;z-index:2;border-radius:20px;pointer-events:none;
    border:1px solid rgba(var(--zs-text),.08);
  }

  .zaza-showcase--nfa .zaza-showcase__facade{
    position:absolute;inset:2px;z-index:1;width:calc(100% - 4px);height:calc(100% - 4px);
    display:block;border:0;padding:0;margin:0;cursor:pointer;border-radius:18px;overflow:hidden;background:#06070f;
  }
  .zaza-showcase--nfa .zaza-showcase__thumb{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.03);transition:transform .7s cubic-bezier(.16,1,.3,1),filter .4s ease;filter:saturate(1.06);}
  .zaza-showcase--nfa .zaza-showcase__scrim{position:absolute;inset:0;background:radial-gradient(55% 55% at 50% 50%,transparent 0%,rgba(6,7,15,.5) 100%),linear-gradient(180deg,rgba(6,7,15,.1),rgba(6,7,15,.45));transition:opacity .4s ease;}
  .zaza-showcase--nfa .zaza-showcase__sheen{position:absolute;inset:0;background:linear-gradient(120deg,transparent 35%,rgba(255,255,255,.06) 50%,transparent 65%);}

  .zaza-showcase--nfa .zaza-showcase__play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:92px;height:92px;display:grid;place-items:center;}
  .zaza-showcase--nfa .zaza-showcase__play-core{
    position:relative;z-index:2;width:84px;height:84px;border-radius:50%;display:grid;place-items:center;color:#fff;
    background:linear-gradient(135deg,var(--zs-accent),#8e2d8e);
    box-shadow:0 18px 50px -10px rgba(var(--zs-accent-rgb),.95),0 0 0 1px rgba(255,255,255,.16) inset,0 0 0 6px rgba(var(--zs-accent-rgb),.14);
    transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease;
  }
  .zaza-showcase--nfa .zaza-showcase__play-core svg{margin-left:5px;}
  .zaza-showcase--nfa .zaza-showcase__play-ring{position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(var(--zs-accent-rgb),.65);}
  .zaza-showcase--nfa .zaza-showcase__play-ring--1{animation:zsPulse 2.6s ease-out infinite;}
  .zaza-showcase--nfa .zaza-showcase__play-ring--2{animation:zsPulse 2.6s ease-out infinite 1.3s;}

  .zaza-showcase--nfa .zaza-showcase__hint{
    position:absolute;left:50%;bottom:1.15rem;transform:translateX(-50%);
    display:inline-flex;align-items:center;gap:.5rem;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.72rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#fff;
    padding:.45rem .9rem;border-radius:999px;background:rgba(6,7,15,.6);
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.16);
    transition:transform .35s cubic-bezier(.16,1,.3,1),opacity .35s ease;
  }
  .zaza-showcase--nfa .zaza-showcase__hint-dot{width:6px;height:6px;border-radius:50%;background:var(--zs-accent);box-shadow:0 0 8px 1px rgba(var(--zs-accent-rgb),.9);}

  .zaza-showcase--nfa .zaza-showcase__facade:hover .zaza-showcase__thumb{transform:scale(1.07);filter:saturate(1.18);}
  .zaza-showcase--nfa .zaza-showcase__facade:hover .zaza-showcase__scrim{opacity:.82;}
  .zaza-showcase--nfa .zaza-showcase__facade:hover .zaza-showcase__play-core{transform:scale(1.09);box-shadow:0 24px 64px -8px rgba(var(--zs-accent-rgb),1),0 0 0 1px rgba(255,255,255,.24) inset,0 0 0 8px rgba(var(--zs-accent-rgb),.2);}
  .zaza-showcase--nfa .zaza-showcase__facade:hover .zaza-showcase__hint{transform:translateX(-50%) translateY(-3px);}
  .zaza-showcase--nfa .zaza-showcase__facade:focus-visible{outline:3px solid var(--zs-accent);outline-offset:4px;}

  .zaza-showcase--nfa .zaza-showcase__frame video{
    position:absolute;inset:2px;z-index:3;width:calc(100% - 4px);height:calc(100% - 4px);
    border:0;border-radius:18px;background:#000;object-fit:cover;display:block;
  }

  .zaza-showcase--nfa .zaza-showcase__eyebrow,
  .zaza-showcase--nfa .zaza-showcase__title,
  .zaza-showcase--nfa .zaza-showcase__sub,
  .zaza-showcase--nfa .zaza-showcase__frame{
    opacity:0;transform:translateY(28px);
    transition:opacity .85s cubic-bezier(.16,1,.3,1),transform .85s cubic-bezier(.16,1,.3,1);
  }
  .zaza-showcase--nfa.is-revealed .zaza-showcase__eyebrow{transition-delay:.05s;}
  .zaza-showcase--nfa.is-revealed .zaza-showcase__title{transition-delay:.15s;}
  .zaza-showcase--nfa.is-revealed .zaza-showcase__sub{transition-delay:.26s;}
  .zaza-showcase--nfa.is-revealed .zaza-showcase__frame{transition-delay:.38s;}
  .zaza-showcase--nfa.is-revealed .zaza-showcase__eyebrow,
  .zaza-showcase--nfa.is-revealed .zaza-showcase__title,
  .zaza-showcase--nfa.is-revealed .zaza-showcase__sub,
  .zaza-showcase--nfa.is-revealed .zaza-showcase__frame{opacity:1;transform:none;}

  @media (max-width:600px){
    .zaza-showcase--nfa .zaza-showcase__play{width:76px;height:76px;}
    .zaza-showcase--nfa .zaza-showcase__play-core{width:68px;height:68px;}
    .zaza-showcase--nfa .zaza-showcase__play-core svg{width:26px;height:26px;}
  }

  @media (prefers-reduced-motion:reduce){
    .zaza-showcase--nfa .zaza-showcase__title-fill{animation:none;background-position:50% 50%;}
    .zaza-showcase--nfa .zaza-showcase__title-fill::after,
    .zaza-showcase--nfa .zaza-showcase__dot,
    .zaza-showcase--nfa .zaza-showcase__frame::before,
    .zaza-showcase--nfa .zaza-showcase__play-ring{animation:none;}
    .zaza-showcase--nfa .zaza-showcase__eyebrow,
    .zaza-showcase--nfa .zaza-showcase__title,
    .zaza-showcase--nfa .zaza-showcase__sub,
    .zaza-showcase--nfa .zaza-showcase__frame{opacity:1;transform:none;transition:none;}
  }
</style>

<script>
(function(){
  function ready(fn){ if(document.readyState!=='loading') fn(); else document.addEventListener('DOMContentLoaded',fn); }
  ready(function(){
    document.querySelectorAll('.zaza-showcase--nfa .zaza-showcase__facade:not([data-zsv-bound])').forEach(function(btn){
      btn.setAttribute('data-zsv-bound','1');
      btn.addEventListener('click',function(){
        var frame=btn.closest('.zaza-showcase__frame');
        if(!frame||frame.querySelector('video')) return;
        var src=btn.getAttribute('data-video-src');
        var video=document.createElement('video');
        video.controls=true;
        video.autoplay=true;
        video.playsInline=true;
        video.setAttribute('playsinline','');
        video.preload='auto';
        var source=document.createElement('source');
        source.src=src;
        source.type='video/mp4';
        video.appendChild(source);
        function showError(){
          if(frame.querySelector('.zsv-error')) return;
          var err=document.createElement('div');
          err.className='zsv-error';
          err.style.cssText='position:absolute;inset:2px;z-index:4;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:1.5rem;background:rgba(6,7,15,.92);color:#fff;border-radius:18px;font-family:var(--zz-alt);font-size:.82rem;line-height:1.6;';
          err.innerHTML='<div style="font-weight:500;margin-bottom:.6rem;color:#f87171;">Video failed to load</div><div style="opacity:.7;word-break:break-all;max-width:90%;">'+src+'</div>';
          frame.appendChild(err);
        }
        source.addEventListener('error',showError);
        video.addEventListener('error',showError);
        frame.appendChild(video);
        btn.style.display='none';
        var p=video.play();
        if(p&&typeof p.catch==='function'){ p.catch(function(){}); }
      });
    });
    var sections=document.querySelectorAll('.zaza-showcase--nfa:not([data-zsv-seen])');
    if(!('IntersectionObserver' in window)){ sections.forEach(function(s){ s.classList.add('is-revealed'); }); return; }
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-revealed'); io.unobserve(e.target); } });
    },{threshold:0.18});
    sections.forEach(function(s){ s.setAttribute('data-zsv-seen','1'); io.observe(s); });
  });
})();
</script>