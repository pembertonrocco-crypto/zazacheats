  letter-spacing:.16em;text-transform:uppercase;color:rgba(230,170,255,.95)}
.tp-card--nfa .tp-role{color:rgba(231,236,255,.95)}
.tp-role__num{color:var(--v);font-size:.82rem}
.tp-role__sep{color:rgba(231,236,255,.35)}
.tp-card__name{font-size:clamp(1.5rem,2.4vw,1.9rem);font-weight:700;letter-spacing:-.02em;line-height:1.18;margin:0}
.tp-desc{margin:0;font-size:.98rem;line-height:1.65;color:rgba(231,236,255,.8)}
.tp-specs{display:flex;flex-wrap:wrap;gap:7px}
.tp-spec{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.75rem;letter-spacing:.05em;text-transform:uppercase;
  color:rgba(231,236,255,.9);padding:6px 12px;border-radius:999px;
  border:1px solid rgba(191,64,191,.3);background:rgba(191,64,191,.1)}
.tp-card--nfa .tp-spec{border-color:rgba(191,64,191,.34);background:rgba(191,64,191,.12)}
.tp-card__foot{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:14px;margin-top:auto}
.tp-pricing{display:flex;flex-direction:column;gap:3px}
.sp-price__label{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(231,236,255,.6)}
.tp-price{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:2rem;font-weight:700;letter-spacing:-.02em;display:flex;align-items:baseline;gap:8px;color:#fff}
.sp-price__slash{font-size:1.05rem;font-weight:500;color:rgba(231,236,255,.42);text-decoration:line-through}
.tp-cta{display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border-radius:12px;font-size:1rem;font-weight:700;color:#fff;white-space:nowrap;
  background:linear-gradient(135deg,var(--v),var(--b));box-shadow:0 12px 28px -10px rgba(191,64,191,.75);
  transition:filter .25s,gap .25s,box-shadow .25s}
.tp-card:hover .tp-cta{filter:brightness(1.1);gap:11px;box-shadow:0 16px 34px -10px rgba(191,64,191,.9)}

/* loadout advice strip */
.tpl{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:26px;
  padding:20px 24px;border-radius:18px;border:1px solid var(--edge);
  background:linear-gradient(135deg,rgba(191,64,191,.06),rgba(10,12,24,.6));
  animation:spUp .7s ease .3s both}
.tpl__eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;color:var(--v);font-size:.76rem;letter-spacing:.2em;margin:0 0 8px}
.tpl__line{margin:0;font-size:1rem;line-height:1.7;color:rgba(231,236,255,.85);max-width:62ch}
.tpl__link{flex-shrink:0;display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:10px;
  text-decoration:none;font-size:.92rem;font-weight:700;color:rgba(134,239,172,.95);
  background:rgba(34,197,94,.06);border:1px solid rgba(34,197,94,.22);
  transition:border-color .25s,background .25s,gap .25s}
.tpl__link:hover{border-color:rgba(34,197,94,.45);background:rgba(34,197,94,.1);gap:11px}
.tpl__pulse{position:relative;width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,.9)}
.tpl__pulse::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:1px solid rgba(34,197,94,.55);animation:tplPulse 2.2s ease-out infinite}
@keyframes tplPulse{0%{transform:scale(.5);opacity:1}70%,100%{transform:scale(1.6);opacity:0}}

@keyframes tpFade{from{opacity:0}to{opacity:1}}
