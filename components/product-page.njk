.ppx-bar__btn{flex-shrink:0;display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;
  padding:13px 24px;border-radius:12px;font-weight:800;font-size:.95rem;color:#fff;font-family:inherit;
