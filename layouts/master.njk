<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {# =====================================================================
       CONNECTION SETUP — must be the first thing in <head>.
       These used to sit ~60 lines lower, below the Bootstrap/pro/custom
       stylesheet links, which made them useless: by the time the parser
       reached them the browser had already opened those connections the
       slow way. Hoisted here, the DNS + TCP + TLS handshakes for every
       render-blocking origin overlap with the HTML download instead of
       queueing behind it (~200-400ms off first paint on mobile).
       ===================================================================== #}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
    {# fontshare CSS comes from api. but the woff2 binaries come from cdn. —
       preconnecting both means the hero's Clash Display swaps in a round-trip sooner #}
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin>
    {# font-awesome + choices.js are loaded non-blocking further down, so a
       cheap dns-prefetch is enough — no need to hold a TLS session open #}
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    {# LCP preload — the homepage hero background is the largest paint on the
       most-trafficked page. It's discoverable in the markup, but only after
       ~50KB of blocking CSS has been fetched; preloading starts it in the
       first round trip. type= means only AVIF-capable browsers take this,
       and those are exactly the ones <picture> will serve AVIF to, so no
       byte is downloaded twice. #}
    {% if templateName == 'shop' %}
    <link rel="preload" as="image" href="{{ 'esp-demo-player.avif' | assetUrl }}" type="image/avif" fetchpriority="high">
    {% endif %}

    {% render_snippet "meta-tags.njk" %}

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
      crossorigin="anonymous"
    />
    <link href="{{ 'pro.css' | assetUrl }}" rel="stylesheet"/>
    <link href="{{ 'custom.css' | assetUrl }}" rel="stylesheet"/>

    <style id="theme-styles">
      :root {
        --cl-accent: {{ global.properties.theme_color }};
        --cl-accent-rgb: {{ global.properties.theme_color | hex_to_rgb }};
        --cl-background-primary: {{ global.properties.primary_background_color }};
        --cl-background-primary-rgb: {{ global.properties.primary_background_color | hex_to_rgb }};
        --cl-background-secondary: {{ global.properties.secondary_background_color }};
        --cl-background-secondary-rgb: {{ global.properties.secondary_background_color | hex_to_rgb }};
        --cl-border: {{ global.properties.primary_border_color }};
        --cl-border-rgb: {{ global.properties.primary_border_color | hex_to_rgb }};
        --bs-font-sans-serif: '{{ (global.properties.font if global.properties.font else 'Poppins') }}', sans-serif;

        /* ---- type system ----
           Three roles, defined once. Before this the stacks were written out
           by hand in ~250 places across 34 files, which is why they had
           drifted into eight different spellings of the same thing.

           --zz-alt replaces JetBrains Mono. That face was named in 187
           declarations — every eyebrow, label, badge, price and stat — and was
           never actually loaded by any link on the page, so all of it fell
           back to whatever the OS calls "monospace": Courier New on a lot of
           Windows machines. A storefront whose labels render in Courier does
           not read as a premium product, and that, far more than the choice of
           typeface, is what made the site feel generated.
           The replacement is the same family as the body text, set in small
           uppercase with wide tracking — how Apple and Rolex set their eyebrow
           and spec labels. Where the mono was doing real work, holding digits
           in place so a counter does not jitter as it ticks, tabular-nums does
           that job properly and without changing the typeface. */
        --zz-sans: 'Satoshi','Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
        --zz-display: 'Clash Display','Satoshi','Inter',system-ui,sans-serif;
        --zz-alt: 'Satoshi','Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
        --cl-snow: {{ (global.properties.snow_color if global.properties.snow_color else '#ffffff') | hex_to_rgb }};

        --product-card-image-aspect-ratio: {{ (global.properties.product_card_image_aspect_ratio if global.properties.product_card_image_aspect_ratio else '16/9') }};
        --product-page-image-aspect-ratio: {{ (global.properties.product_page_image_aspect_ratio if global.properties.product_page_image_aspect_ratio else '16/9') }};
        --group-card-image-aspect-ratio: {{ (global.properties.group_card_image_aspect_ratio if global.properties.group_card_image_aspect_ratio else '16/9') }};
        --blog-card-image-aspect-ratio: {{ (global.properties.blog_card_image_aspect_ratio if global.properties.blog_card_image_aspect_ratio else '16/9') }};
        --product-image-fit: {{ (global.properties.product_image_fit if global.properties.product_image_fit else 'cover') }};
        --group-image-fit: {{ (global.properties.group_image_fit if global.properties.group_image_fit else 'cover') }};
      }

      /* Anything that does not name a face inherits from here. Without this it
         inherited Bootstrap's --bs-font-sans-serif, i.e. the dashboard font
         (Poppins) — so the buy box's labels and variant names were set in
         Poppins while the headings were Clash Display and the eyebrows were
         Satoshi. Three unrelated typefaces inside one card is most of what
         reads as unconsidered. One family for text, one for display, and the
         dashboard font stays on as a fallback rather than the default. */
      body {
        font-family: var(--zz-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        /* the display face is set tight; give body copy room to breathe */
        letter-spacing: -0.005em;
      }

      {% if global.properties.smooth_scroll !== false %}
      html.lenis,
      html.lenis body {
        height: auto;
      }

      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }

      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }

      .lenis.lenis-stopped {
        overflow: hidden;
      }

      .lenis.lenis-smooth iframe {
        pointer-events: none;
      }
      {% endif %}
    </style>

    {# preconnects for these origins are hoisted to the top of <head> #}
    <link href="https://fonts.googleapis.com/css2?family={{ (global.properties.font if global.properties.font else 'Poppins') | replace(" ", "+") }}:wght@400;500;600;700&display=swap" rel="stylesheet" id="theme-font">
    {# Every weight the stylesheets actually ask for, so the browser never has
       to fake one. Satoshi was loaded at 400/500/700 only while the theme
       asked for 800 in 146 places and 600 in 83 — so most of the bold on the
       site, including the price and the buy button, was synthetic: the browser
       smearing the 700 wider. Synthetic bold is the single most recognisable
       "cheap web page" tell, and no amount of restyling survives it.
       Satoshi ships 300/400/500/700/900 and nothing between, so the CSS is
       normalised to those five rather than requesting weights that cannot
       exist. #}
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700,900&f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    {# non-blocking: every above-the-fold icon (navbar, hero, buy buttons) is inline
       SVG — Font Awesome only decorates labels further down, so it can load async
       without any visible above-fold flash. ~33KB gzip off the critical path. #}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" media="print" onload="this.media='all'" />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" /></noscript>
    {# non-blocking: only styles the currency dropdown, no need to hold first paint #}
    <link href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" rel="stylesheet" integrity="sha256-gS3HxgWFFFqEo0wQoALebu5XlWdYr3gqd4/Tk5wt8Ig=" crossorigin="anonymous" media="print" onload="this.media='all'" />

    {# =====================================================================
       GLOBAL SMOOTH LAYER — scroll reveals, refined interactions, polish.
       FOUC-safe: content is only hidden when html.zz-motion is set (JS + no
       reduced-motion), and a failsafe reveals everything if JS never inits.
       ===================================================================== #}
    <script>
      (function(){
        try{
          var h = document.documentElement;
          if(window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
          h.classList.add('zz-motion');
          window.__zzInit = false;
          // if the main reveal script never runs, reveal all content anyway
          setTimeout(function(){ if(!window.__zzInit) h.classList.add('zz-revealed'); }, 3000);
        }catch(e){ try{ document.documentElement.classList.add('zz-revealed'); }catch(_){} }
      })();
    </script>
    <style id="zz-smooth">
      /* ---------- page arrival ---------- */
      @keyframes zzPageIn{from{opacity:0}to{opacity:1}}
      html.zz-motion body{animation:zzPageIn .55s ease both}

      /* ---------- scroll reveal (gated on html.zz-motion to avoid FOUC) ---------- */
      html.zz-motion .components > *{
        opacity:0;transform:translateY(34px) scale(.955);filter:blur(9px);
        transition:opacity .9s cubic-bezier(.22,1,.36,1),transform .95s cubic-bezier(.22,1,.36,1),filter .8s ease;
        will-change:opacity,transform,filter;backface-visibility:hidden}
      html.zz-motion .components > *.zz-in,
      html.zz-motion.zz-revealed .components > *{opacity:1;transform:none;filter:none}
      /* LCP: whatever is already on screen at first paint must not fade in.
         Every page's first section — the hero, the product buy box, the
         status shield — starts at opacity:0 with a blur and a 0.9s
         transition, which holds the largest paint back for no benefit the
         user can see (there is nothing to "reveal" on content that was
         never scrolled to). The reveal script tags those elements with
         .zz-instant so they paint immediately, while everything below the
         fold keeps the full entrance. */
      html.zz-motion .components > *.zz-instant,
      html.zz-motion [data-zz-reveal].zz-instant{
        transition:none!important;transition-delay:0s!important;will-change:auto}
      /* stagger is assigned per-batch by the reveal script (--zz-d), so it
         works for any number of sections and any nesting depth */
      html.zz-motion .components > *,
      html.zz-motion [data-zz-reveal]{transition-delay:var(--zz-d,0s)}
      /* opt-in reveal for nested elements inside sections */
      html.zz-motion [data-zz-reveal]{
        opacity:0;transform:translateY(26px);
        transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1)}
      html.zz-motion [data-zz-reveal].zz-in,
      html.zz-motion.zz-revealed [data-zz-reveal]{opacity:1;transform:none}

      /* ---------- refined interaction transitions ---------- */
      html.zz-motion a{transition:color .22s ease,opacity .22s ease,text-shadow .22s ease}
      html.zz-motion .btn,html.zz-motion button{transition:background-color .25s ease,border-color .25s ease,color .2s ease,box-shadow .3s cubic-bezier(.22,1,.36,1),transform .22s cubic-bezier(.22,1,.36,1),filter .25s ease}
      html.zz-motion .btn-primary:hover:not(:disabled){transform:translateY(-2px) scale(1.018);filter:brightness(1.06);box-shadow:0 18px 40px -14px rgba(var(--cl-accent-rgb,191,64,191),.85)}
      html.zz-motion .btn-primary:active:not(:disabled){transform:translateY(0) scale(.985);transition-duration:.08s}
      html.zz-motion .btn:not(.btn-primary):hover:not(:disabled){transform:translateY(-1px)}
      html.zz-motion .card{transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s ease,border-color .35s ease}
      html.zz-motion .card:hover{transform:translateY(-5px);box-shadow:0 28px 60px -28px rgba(0,0,0,.65)}
      html.zz-motion img{transition:transform .45s cubic-bezier(.22,1,.36,1)}

      /* ---------- inputs ---------- */
      .form-control,.form-select,.choices__inner{transition:border-color .22s ease,box-shadow .3s cubic-bezier(.22,1,.36,1),background-color .22s ease,transform .22s ease!important}
      .form-control:focus,.form-select:focus,.choices.is-focused .choices__inner{
        box-shadow:0 0 0 3px rgba(var(--cl-accent-rgb,191,64,191),.22),0 8px 24px -12px rgba(var(--cl-accent-rgb,191,64,191),.45)!important;
        border-color:rgba(var(--cl-accent-rgb,191,64,191),.6)!important}

      /* ---------- accessible focus ring ---------- */
      a:focus:not(:focus-visible),button:focus:not(:focus-visible){outline:none}
      /* (::selection, :focus-visible, scrollbar and font-smoothing rules live
         once in the LUXURY PASS block below — duplicates removed) */

      /* Firefox scrollbar (webkit styling is in the luxury block) */
      html{scrollbar-width:thin;scrollbar-color:rgba(var(--cl-accent-rgb,191,64,191),.6) transparent}

      /* anchor targets (e.g. /#products) land clear of the fixed navbar pill */
      html{scroll-padding-top:96px}
      [id]{scroll-margin-top:96px}
      /* headings wrap evenly instead of leaving orphan words */
      h1,h2,h3{text-wrap:balance}
      /* main is a programmatic focus target for the skip link — no ring needed */
      main#zz-main{outline:none}
      .choices__list--dropdown{transition:opacity .2s ease,transform .2s ease}

      @media (prefers-reduced-motion:reduce){
        html .components > *{opacity:1!important;transform:none!important;filter:none!important}
        html.zz-motion body{animation:none!important}
        *{scroll-behavior:auto!important}
      }
    
      /* ================= LUXURY PASS ================= */
      /* display type: headings step up to Clash Display */
      h1,h2,.zz-h1,.zz-h2,.hero-title,.af-title,.fbq__title,.dl-title,
      .rev-title,.zs-title,.af-h2,.zz-sc__title{
        font-family:var(--zz-display)!important;
        letter-spacing:-.025em;font-weight:500}
      h1 b,h1 strong,h2 b,h2 strong{font-weight:700}
      body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}

      /* ── z-index tiers (verified 2026-07; keep new fixed UI inside these bands) ──
         waypoint rail / back-to-top .. 880–940
         home & product buy bars ...... 990   (below navbar, above content)
         navbar/header pill ........... 1000 !important
         scratch-card popup overlay ... 1090  (above navbar & buy bars)
         scroll progress hairline ..... 1200
         (reserve 1300+ for toasts/one-offs)                                  */

      /* premium selection + focus */
      ::selection{background:rgba(191,64,191,.4);color:#fff}
      :focus-visible{outline:2px solid rgba(191,64,191,.75);outline-offset:3px;border-radius:6px}

      /* jewel scrollbar */
      ::-webkit-scrollbar{width:10px;height:10px}
      ::-webkit-scrollbar-track{background:#06070f}
      ::-webkit-scrollbar-thumb{background:linear-gradient(180deg,#3a2a52,#241a38);
        border-radius:99px;border:2px solid #06070f}
      ::-webkit-scrollbar-thumb:hover{background:linear-gradient(180deg,#BF40BF,#7C3AED)}

      /* gold ratings everywhere read as one metal */
      .fbq__agg-stars,.zz-reviews-stat__stars,.pf-rating__stars,
      .rev-score-stars-big,.scs-quote__stars{color:#f2c14e!important;
        text-shadow:0 0 18px rgba(242,193,78,.35)}

      /* primary CTA: shine sweep on hover */
      html.zz-motion .btn-primary{position:relative;overflow:hidden;isolation:isolate}
      html.zz-motion .btn-primary::after{content:"";position:absolute;inset:0;z-index:1;
        background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);
        transform:translateX(-130%);transition:transform .8s cubic-bezier(.22,1,.36,1);pointer-events:none}
      html.zz-motion .btn-primary:hover::after{transform:translateX(130%)}

      /* glass cards: hairline top highlight for depth */
      html.zz-motion .card{position:relative}
      html.zz-motion .card::before{content:"";position:absolute;inset:0 0 auto 0;height:1px;
        background:linear-gradient(90deg,transparent,rgba(255,255,255,.16),transparent);
        border-radius:inherit;pointer-events:none}

      /* smooth anchor travel */
      html{scroll-behavior:smooth}
      @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

      /* ================= TOUCH TARGETS =================
         Measured with tools/mobile.js in headless Chromium at 375/393/768px:
         every rule below is a control that rendered under the 44px WCAG 2.2
         minimum on a phone. Scoped to (pointer:coarse) so the desktop design
         is untouched — this only ever applies to fingers.
         Display values are split the way the browser actually computed them,
         so nothing changes box type: the block-level ones gain centring
         alongside the min-height (otherwise their label would sit high in the
         taller box), the flex ones only gain the height. */
      @media (pointer:coarse){
        /* computed display:block — grow and re-centre the label */
        .faq-stuck__btn,.zs-filter__btn,.zs-more,.faq-toggleall,
        .scs-proof__link,.rev-auto-more,.rev-sort,.pp-tab-btn,
        .cart-code__copy,.faq-search__input{
          min-height:44px;display:flex;align-items:center;justify-content:center}
        /* form controls keep their own text alignment, not centred */
        .rev-sort,.faq-search__input{display:block;line-height:1.2}

        /* computed display:inline-block — needs a box to apply height to */
        /* .pf-addon__btn measured 57x31: it is the add-on's only control and
           sits mid-purchase, but no fixture rendered an add-on until now, so
           the mobile suite had never once measured it. */
        .bfq__review-link,.pf-addon__btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center}

        /* Standalone links with no class of their own, reached via their
           wrapper. Each is a real CTA, not a link inside a sentence.
           .pf-trust a joined them when the buy box's five trailing blocks
           merged into one row: Refund policy and Terms had been links inside a
           sentence in .pf-policies, and became standalone targets. */
        .zz-reviews-more a,.cart-trust a,.pf-trust a,#rev-q{
          min-height:44px;display:inline-flex;align-items:center}
        /* "Terms" is 33px of text, and the status link shrinks to its 13px
           icon for any product without a badge, so both need the width too.
           Centred, or the short labels sit against the left edge of the box. */
        .pf-trust a{min-width:44px;justify-content:center}

        /* computed display:flex / inline-flex — already centred, just grow */
        .zznx__btn,.zzbb__cta,.zs-card__cta,.tpl__link,.zs-nav__lnk,
        .hero-status,.hero-resume__link,.zz-chip--link,.nb-toggler,
        .zzds__all,.zs-verify__link,.rev-bar-row,.rev-f,.rev-topic,
        .rev-close__btn,.zzbar__link,.hero-rating,.zzhf__status,
        /* Buy box. These only became measurable once the harness ran Alpine —
           until then x-cloak kept the whole form display:none, so none of it
           had ever been checked. */
        .pf-rating,.zzb__add{
          min-height:44px}
        /* the +/- steppers are square, so they need the width too */
        .pf-qty__btn{min-height:44px;min-width:44px}

        /* Quantity field: 42px tall and 13px text, so it was both under the
           target size and small enough for iOS to zoom the page on focus —
           on the field a buyer taps mid-purchase. */
        .pf-qty__input{min-height:44px;font-size:16px!important}

        /* Small icon buttons keep their visual size — a 44px "×" in a slim
           bar would look broken. Instead an invisible centred pseudo-element
           carries the hit area. Safe here because all three compute to
           overflow:visible, so it is never clipped, and none of them already
           define ::after. */
        /* .zzbar__x is deliberately left out — it computes to
           position:absolute, so it already establishes a containing block for
           its ::after, and forcing relative would drop it back into flow. */
        .hero-resume__x,.zzbb__close{position:relative}
        .hero-resume__x::after,.zzbar__x::after,.zzbb__close::after{
          content:"";position:absolute;left:50%;top:50%;
          transform:translate(-50%,-50%);
          width:100%;height:100%;min-width:44px;min-height:44px}

        /* iOS Safari zooms the whole page when a focused field is under 16px.
           These four measured 13.76–14.72px, so tapping search or the review
           sort control yanked the layout. 16px on touch only; the desktop
           sizes are unchanged. */
        /* !important because these component styles live in <style> blocks
           rendered in the body, i.e. after this one — at equal specificity
           they win on document order. */
        .faq-search__input,#rev-q,.rev-sort,.zaf__input,.pf-qty__input{font-size:16px!important}
      }
    </style>

    <style id="zz-status">
      /* shared animated product status badge (snippets/status-badge.njk) — chamfered cyber chip */
      .zzstatus{position:relative;display:inline-flex;isolation:isolate;--sc:34,197,94;--ch:6px;line-height:1}
      .zzstatus--u{--sc:34,197,94}
      .zzstatus--p{--sc:234,179,8}
      .zzstatus--d{--sc:239,68,68}
      .zzstatus__chip{position:relative;display:inline-flex;align-items:center;gap:6px;padding:5px 12px;line-height:1;
        font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:10.5px;font-weight:700;letter-spacing:.07em;
        text-transform:uppercase;color:#fff;overflow:hidden;
        background:rgba(var(--sc),.18);border:1px solid rgba(var(--sc),.6);
        -webkit-clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch));
        clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch));
        animation:zzstatusGlow 2.6s ease-in-out infinite}
      .zzstatus__icon{position:relative;z-index:2;flex:none}
      .zzstatus__icon [stroke]{stroke:rgb(var(--sc))}
      .zzstatus__icon path:first-child{fill:rgba(var(--sc),.2)}
      .zzstatus__label{position:relative;z-index:2}
      /* chamfered radar ring, lives outside the clipped chip so it can pulse outward */
      .zzstatus__ring{position:absolute;inset:0;z-index:0;pointer-events:none;border:1px solid rgb(var(--sc));
        -webkit-clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch));
        clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch));
        animation:zzstatusRing 2.4s cubic-bezier(.16,1,.3,1) infinite}
      @keyframes zzstatusRing{0%{transform:scale(1);opacity:.7}100%{transform:scale(1.24);opacity:0}}
      .zzstatus__sweep{position:absolute;inset:0;z-index:1;pointer-events:none;
        background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.4) 50%,transparent 65%);
        transform:translateX(-130%);animation:zzstatusSweep 3.4s ease-in-out infinite}
      @keyframes zzstatusSweep{0%,55%{transform:translateX(-130%)}82%,100%{transform:translateX(130%)}}
      /* glow uses drop-shadow (not box-shadow) so it follows the chamfered outline */
      @keyframes zzstatusGlow{0%,100%{filter:drop-shadow(0 0 5px rgba(var(--sc),.28))}
        50%{filter:drop-shadow(0 0 13px rgba(var(--sc),.55))}}
      @media (prefers-reduced-motion:reduce){
        .zzstatus__chip,.zzstatus__ring,.zzstatus__sweep{animation:none}
        .zzstatus__chip{filter:drop-shadow(0 0 6px rgba(var(--sc),.3))}
        .zzstatus__sweep{display:none}
      }
    </style>

    <style id="zz-neon">
      /* slow ambient "neon-pulse" border ring (Aether-Chroma), brand violet.
         Rendered as an inset ring child so it never fights a card's own
         border or hover transition, and stays clip-safe inside the card. */
      .zz-neon{position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:2;
        border:1px solid rgba(191,64,191,.32);
        animation:zzNeonPulse 10s ease-in-out infinite}
      @keyframes zzNeonPulse{
        0%,100%{border-color:rgba(191,64,191,.26);box-shadow:0 0 6px rgba(191,64,191,.10),inset 0 0 9px rgba(191,64,191,.05)}
        50%{border-color:rgba(191,64,191,.66);box-shadow:0 0 20px rgba(191,64,191,.34),inset 0 0 15px rgba(191,64,191,.12)}
      }
      @media (prefers-reduced-motion:reduce){
        .zz-neon{animation:none;border-color:rgba(191,64,191,.34);box-shadow:none}
      }
    </style>
  </head>
  <body>
    {# Skip link, server-rendered as the first focusable thing on the page.
       polish.njk used to inject this from JS, which meant it did not exist
       for no-JS users and — more to the point — did not exist during the
       window where a keyboard user is most likely to press Tab. polish.njk
       still guards on .zz-skip already existing, so it now no-ops. #}
    <a class="zz-skip" href="#zz-main">Skip to content</a>

    {# Global icon sprite — shared glyphs referenced via <use href="#…">.
       Lives in the layout (rendered on every page) rather than a new snippet
       because newly added .njk snippet files don't render on SellAuth. #}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="zz-ico-discord" viewBox="0 0 24 24"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></symbol>
    </svg>
    {% if shop.background_image_url %}
      <div class="bg-image" style="background-image: url({{ shop.background_image_url }});"></div>
    {% endif %}

    <div class="flex-wrapper" id="app" x-data="app">
      <div>
        {% if templateName != 'maintenance' %}
          <header class="sticky-top">
            {% render_snippet "bundle-bar.njk" %}
            {% render_component "announcement" %}
            {% render_component "navbar" %}
          </header>
        {% endif %}

        <main id="zz-main" tabindex="-1">
          {{ templateContent | safe }}
        </main>
      </div>

      {% if templateName != 'maintenance' %}
        {% render_component "footer" %}
        {% render_snippet "customer-login-modal.njk" %}
        {% render_snippet "scratch-card-popup.njk" %}
      {% endif %}
    </div>

    <script>
      window.shopId = {{ shop.id | json }};
      window.apiBaseUrl = {{ '' | apiInternalUrl | json }};
      window.currencyRatesUsd = {{ currency_rates_usd | json }};
      window.currencySymbols = {{ currency_symbols | json }};
      window.defaultCurrency = {{ currency | json }};
      window.shopCustomer = {{ shop_customer | json }};
    </script>

    {% if isBuilder %}
      {% render_snippet "script-builder.njk" %}
    {% endif %}

    {% if altcha or altcha_shop_customer %}
      <script type="module">
        import { Altcha } from 'https://cdn.jsdelivr.net/npm/altcha@1.2.0/+esm'
      </script>
    {% elif shop.recaptcha_key %}
      <script src="https://www.google.com/recaptcha/api.js?render={{ shop.recaptcha_key }}"></script>
    {% endif %}

    {# =====================================================================
       All five bundles are `defer`: they download in parallel with parsing
       and execute in document order, right before DOMContentLoaded. Order
       still matters and defer preserves it —
         script.js must run before Alpine boots, because it registers
         Alpine.data('app') on the `alpine:init` event;
         bootstrap must be parsed before script.js's zzModal() is *called*,
         which only happens on user interaction, well after both have run.
       Everything else in script.js is already wrapped in zzReady()/
       DOMContentLoaded, so nothing regresses. This takes ~230KB of
       third-party JS off the parser's critical path.
       ===================================================================== #}
    <script defer
      src="https://cdn.jsdelivr.net/npm/js-cookie@3.0.5/dist/js.cookie.min.js"
      integrity="sha256-WCzAhd2P6gRJF9Hv3oOOd+hFJi/QJbv+Azn4CGB8gfY="
      crossorigin="anonymous"
    ></script>
    <script defer
      src="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/scripts/choices.min.js"
      integrity="sha256-P+JgcxEeZtxwYS1+TAAuusKFM646SB8Oodk0TYu9zuo="
      crossorigin="anonymous"
    ></script>
    {# jQuery removed 2026-07: audited every template/snippet/component and
       script.js — zero usages. ~30KB gzip saved on every page load. #}
    <script defer
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
      crossorigin="anonymous"
    ></script>
    <script defer
      src="{{ 'script.js' | assetUrl }}"
      crossorigin="anonymous"
    ></script>
    <script defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js"
      integrity="sha256-aJ9ROXjRHWn00zeU9ylsmlhqLlXeebtEfN28P0dPnwc="
      crossorigin="anonymous"
    ></script>

    {% if global.properties.smooth_scroll !== false %}
    {# =====================================================================
       Smooth scroll, loaded conditionally rather than on every page.
       Locomotive/Lenis takes over the scroll thread, so it is the single
       largest INP liability on the site. Three gates, all of which used to
       be missing:
         1. prefers-reduced-motion — hijacked scrolling is exactly what that
            setting asks us not to do. Previously it loaded regardless.
         2. coarse pointers (phones/tablets) — native momentum scrolling is
            better than the emulated kind, and these are the devices least
            able to afford the main-thread cost. This is where most of the
            traffic is.
         3. deferred to idle — it is pure polish, so it must never compete
            with the hero paint or the buy button becoming interactive.
       Desktop pointer users still get the identical effect.
       ===================================================================== #}
    <script>
      (function () {
        var mq = window.matchMedia;
        if (!mq) return;
        if (mq('(prefers-reduced-motion:reduce)').matches) return;
        if (mq('(pointer:coarse)').matches) return;

        var load = function () {
          import('https://cdn.jsdelivr.net/npm/locomotive-scroll@5.0.1/+esm')
            .then(function (m) {
              window.locomotiveScroll = new m.default({
                lenisOptions: {
                  lerp: 0.1,
                  duration: 1.2,
                  smoothWheel: true,
                  wheelMultiplier: 1,
                  touchMultiplier: 2,
                  infinite: false,
                }
              });
            })
            .catch(function () { /* polish only — plain scrolling is the fallback */ });
        };

        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2500 });
        else setTimeout(load, 1200);
      })();
    </script>
    {% endif %}

    {% if global.properties.snow %}
      <div id="snow"></div>
      {# script.js is deferred now, so snow() is not defined until DOMContentLoaded #}
      <script>document.addEventListener('DOMContentLoaded', function () { snow({ count: 200 }); });</script>
    {% endif %}

    <script>
      (function(){
        var h = document.documentElement;
        if(!h.classList.contains('zz-motion')) return;   // reduced-motion / disabled
        window.__zzInit = true;
        function run(){
          // top-level sections plus any opted-in nested element ([data-zz-reveal])
          var targets = Array.prototype.slice.call(document.querySelectorAll('.components > *, [data-zz-reveal]'));
          if(!('IntersectionObserver' in window) || !targets.length){ h.classList.add('zz-revealed'); return; }
          function reveal(el, i){
            // stagger within the batch that intersected together; delay is
            // cleared after the entrance so it never slows later transitions
            el.style.setProperty('--zz-d', Math.min(i * 80, 400) + 'ms');
            el.classList.add('zz-in');
            setTimeout(function(){ el.style.removeProperty('--zz-d'); }, 1500 + i * 80);
          }
          // Above the fold there is nothing to reveal — the user never
          // scrolled to it — so show it with the transition suppressed
          // instead of fading it in. This is what keeps the entrance
          // animation from sitting in front of the LCP element.
          function revealInstant(el){
            el.classList.add('zz-instant', 'zz-in');
          }

          // Synchronous, before the first paint: this script is at the end of
          // <body>, so layout is available here. Doing it in rAF (as it was)
          // guarantees at least one painted frame with the hero at opacity 0.
          var vh0 = window.innerHeight || h.clientHeight;
          var pending = [];
          for (var i = 0; i < targets.length; i++){
            if (targets[i].getBoundingClientRect().top < vh0) revealInstant(targets[i]);
            else pending.push(targets[i]);
          }

          var io = new IntersectionObserver(function(entries){
            var batch = entries.filter(function(en){ return en.isIntersecting; });
            // stagger in visual order, not observer-callback order
            batch.sort(function(a, b){ return a.boundingClientRect.top - b.boundingClientRect.top; });
            batch.forEach(function(en, i){ reveal(en.target, i); io.unobserve(en.target); });
          }, { rootMargin:'0px 0px -6% 0px', threshold:0.03 });
          pending.forEach(function(t){ io.observe(t); });

          // Re-check once images have settled, in case loading them pushed
          // something that was below the fold up into view.
          window.addEventListener('load', function(){
            requestAnimationFrame(function(){
              var vh = window.innerHeight || h.clientHeight;
              var seen = 0;
              pending.forEach(function(t){
                if(!t.classList.contains('zz-in') && t.getBoundingClientRect().top < vh){ reveal(t, seen++); }
              });
            });
          });
        }
        if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
        else run();
      })();
    </script>

    {% render_snippet "polish.njk" %}
    {% render_snippet "navigator.njk" %}
    {% render_snippet "script-integrations.njk" %}
    {# polish.njk refreshes the sitewide review total by loading /feedback in a
       hidden same-origin iframe named zz-rc-sync. Cancel the deferred/async
       third-party tags in that frame — they haven't executed yet at this point,
       so removing them here stops a phantom pageview being logged. #}
    <script>
      try{
        if(window.name==='zz-rc-sync'&&window.top!==window.self){
          document.querySelectorAll('script[defer][src],script[async][src]').forEach(function(s){s.remove();});
        }
      }catch(e){}
    </script>
  </body>
</html>