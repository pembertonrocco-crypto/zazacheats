.dl-card__head{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.dl-ico{font-size:1.6rem}
.dl-h2{font-size:1.2rem;font-weight:700;letter-spacing:-.01em;margin:0 0 14px;display:flex;align-items:center;gap:10px}
.dl-card__head .dl-h2{margin:0}
.dl-step{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:8px;font-size:.85rem;font-weight:700;
