<form @submit.prevent="buyNow" class="pf-form">

  <a href="/feedback" class="pf-rating"
     onclick="var r=document.getElementById('zz-reviews');if(r){event.preventDefault();r.scrollIntoView({behavior:'smooth',block:'start'});}">
    <span class="pf-rating__stars" data-zz-rstars aria-hidden="true">★★★★★</span>
    <span class="pf-rating__text"><strong><span data-zz-ravg>5.0</span></strong> from <strong><span data-zz-rc>78</span> verified buyers</strong></span>
    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <div class="pf-price-block" x-cloak>
    <div class="pf-price-block__row">
      <span class="pf-price-block__amount" x-text="appCurrency.format(totalPrice, '{{ product.currency }}')"></span>
      {# dormant until a compare-at price is configured on the variant #}
      <s class="pf-price-block__slash" x-show="variant && variant.price_slash > 0" x-text="appCurrency.format((variant.price_slash || 0) * quantity, '{{ product.currency }}')"></s>
      {# unit price only earns its place once quantity > 1 #}
      <span class="pf-price-block__unit" x-show="quantity > 1">
        <span x-text="appCurrency.format(variant.price, '{{ product.currency }}')"></span>
        <span class="pf-price-block__each">/ each</span>
      </span>
    </div>
    <p class="pf-price-block__sub"><span class="pf-price-block__tick" aria-hidden="true">✓</span> One-time payment — instant automatic delivery</p>
  </div>

  {% if product.variants.length > 1 %}
  <div class="pf-section">
    {# real cross-tier math for the savings chips: find the day & week rates once.
       (array-push is the Nunjucks idiom for writing past a for-loop's scope) #}
    {% set zzDayArr = [] %}{% set zzWeekArr = [] %}
    {% for v in product.variants %}
      {% if v.price > 0 and (v.name == '1 Day Key' or v.name == '1 Day' or v.name == '24 Hour Key' or v.name == 'Day Key') %}{% if zzDayArr.push(v.price) %}{% endif %}{% endif %}
      {% if v.price > 0 and (v.name == '1 Week Key' or v.name == '1 Week' or v.name == '7 Day Key') %}{% if zzWeekArr.push(v.price) %}{% endif %}{% endif %}
    {% endfor %}
    {% set zzDayP = zzDayArr[0] %}{% set zzWeekP = zzWeekArr[0] %}
    {# NFA hour-tiers: baseline = the entry hour-tier's cost per 100 GUARANTEED
       hours (its range minimum), so every claim is conservative #}
    {% set zzNfaArr = [] %}
    {% for v in product.variants %}
      {% if v.price > 0 and v.name == '100-200 Hours' %}{% if zzNfaArr.push(v.price) %}{% endif %}{% endif %}
    {% endfor %}
    {% set zzNfaBase = zzNfaArr[0] %}
    {% if product.path == 'rust-nfa' %}
    <p class="pf-label">Choose your tier<span class="pf-label__hint">— every account includes the 6-hour replacement warranty</span></p>
    {% elif product.path == 'zaza-rust-private-cheat' %}
    <p class="pf-label">Choose your access<span class="pf-label__hint">— every key unlocks every feature</span></p>
    {% else %}
    <p class="pf-label">Choose an option</p>
    {% endif %}
    <div class="pf-variants">
      {% for variant in product.variants %}
      <button
        type="button"
        class="pf-variant{% if variant.name == 'Lifetime Key' or variant.name == '1000+ Hours' %} pf-variant--value{% elif variant.name == '1 Week Key' or variant.name == '500-1000 Hours' %} pf-variant--popular{% elif variant.name == '1 Day Key' or variant.name == '1 Day' or variant.name == '24 Hour Key' or variant.name == 'Day Key' or variant.name == '1-100 Hours' %} pf-variant--try{% endif %}"
        :class="activeVariant == {{ loop.index0 }} ? 'pf-variant--active' : ''"
        :aria-pressed="activeVariant == {{ loop.index0 }} ? 'true' : 'false'"
        @click="() => activeVariant = {{ loop.index0 }}"
        {{ 'title="Out of Stock"' if variant.stock === 0 }}
        {{ 'disabled' if variant.stock === 0 }}
      >
        <div class="pf-variant__meta">
          <div class="pf-variant__nameRow">
            <span class="pf-variant__name">{{ variant.name }}</span>
            {% if variant.name == 'Lifetime Key' %}
            <span class="pf-variant__badge pf-variant__badge--value">
              <i class="fa-solid fa-crown"></i> Best Value
            </span>
            {% elif variant.name == '1 Week Key' %}
            <span class="pf-variant__badge pf-variant__badge--popular">
              <i class="fa-solid fa-fire"></i> Most Popular
            </span>
            {% elif variant.name == '1 Day Key' or variant.name == '1 Day' or variant.name == '24 Hour Key' or variant.name == 'Day Key' %}
            <span class="pf-variant__badge pf-variant__badge--try">
              <i class="fa-solid fa-flask"></i> Try It First
            </span>
            {% elif variant.name == '1000+ Hours' %}
            <span class="pf-variant__badge pf-variant__badge--value">
              <i class="fa-solid fa-crown"></i> Best $/Hour
            </span>
            {% elif variant.name == '500-1000 Hours' %}
            <span class="pf-variant__badge pf-variant__badge--popular">
              <i class="fa-solid fa-fire"></i> Most Popular
            </span>
            {% elif variant.name == '1-100 Hours' %}
            <span class="pf-variant__badge pf-variant__badge--try">
              <i class="fa-solid fa-flask"></i> Starter
            </span>
            {% endif %}
          </div>
          {% if variant.description %}
          <span class="pf-variant__desc">{{ variant.description }}</span>
          {% endif %}
          <span class="pf-variant__stock{% if variant.stock > 0 and variant.stock <= 3 and not product.hide_stock_count %} pf-variant__stock--low{% endif %}">
            {% if variant.stock === 0 %}
              Out of Stock
            {% elif product.hide_stock_count %}
              In Stock
            {% elif variant.stock === -1 %}
              In Stock
            {% else %}
              {{ variant.stock }} In Stock
            {% endif %}
          </span>
        </div>
        <div class="pf-variant__right">
          <span class="pf-variant__price" x-text="appCurrency.format({{ variant.price }}, '{{ product.currency }}')">
            {{ formatPrice(variant.price, product.currency) }}
          </span>
          {% if variant.price_slash %}
          <s class="pf-variant__slash" x-text="appCurrency.format({{ variant.price_slash }}, '{{ product.currency }}')">
            {{ formatPrice(variant.price_slash, product.currency) }}
          </s>
          {% endif %}
          {# Per-day anchor + honest savings math: real price ÷ real duration,
             compared against the real 1-day rate found above. Every chip
             degrades to nothing if a tier is renamed, missing, or the
             saving is too small to be worth claiming. #}
          {% if variant.name == '1 Week Key' or variant.name == '1 Week' or variant.name == '7 Day Key' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 7, '{{ product.currency }}') + ' / day'">≈ {{ formatPrice(variant.price / 7, product.currency) }} / day</span>
          {% if zzDayP %}{% set zzPct = (100 - ((variant.price / 7) / zzDayP) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save">Save {{ zzPct }}% vs daily</span>
          {% endif %}{% endif %}
          {% elif variant.name == '1 Month Key' or variant.name == '1 Month' or variant.name == '30 Day Key' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 30, '{{ product.currency }}') + ' / day'">≈ {{ formatPrice(variant.price / 30, product.currency) }} / day</span>
          {% if zzDayP %}{% set zzPct = (100 - ((variant.price / 30) / zzDayP) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save">Save {{ zzPct }}% vs daily</span>
          {% endif %}{% endif %}
          {% elif variant.name == '3 Month Key' or variant.name == '90 Day Key' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 90, '{{ product.currency }}') + ' / day'">≈ {{ formatPrice(variant.price / 90, product.currency) }} / day</span>
          {% if zzDayP %}{% set zzPct = (100 - ((variant.price / 90) / zzDayP) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save">Save {{ zzPct }}% vs daily</span>
          {% endif %}{% endif %}
          {% elif variant.name == 'Lifetime Key' or variant.name == 'Lifetime' %}
          {% if zzWeekP %}{% set zzBE = (variant.price / zzWeekP) | round %}{% if zzBE >= 2 and zzBE <= 52 %}
          <span class="pf-variant__save pf-variant__save--gold">Pays for itself in {{ zzBE }} weeks</span>
          {% endif %}{% endif %}
          {# NFA hour-tiers: cost per 100 guaranteed hours (range minimum), and
             how much cheaper per hour than the entry hour-tier #}
          {% elif variant.name == '100-200 Hours' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }}, '{{ product.currency }}') + ' / 100 hrs'">≈ {{ formatPrice(variant.price, product.currency) }} / 100 hrs</span>
          {% elif variant.name == '200-500 Hours' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 2, '{{ product.currency }}') + ' / 100 hrs'">≈ {{ formatPrice(variant.price / 2, product.currency) }} / 100 hrs</span>
          {% if zzNfaBase %}{% set zzPct = (100 - ((variant.price / 2) / zzNfaBase) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save">{{ zzPct }}% cheaper / hr</span>
          {% endif %}{% endif %}
          {% elif variant.name == '500-1000 Hours' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 5, '{{ product.currency }}') + ' / 100 hrs'">≈ {{ formatPrice(variant.price / 5, product.currency) }} / 100 hrs</span>
          {% if zzNfaBase %}{% set zzPct = (100 - ((variant.price / 5) / zzNfaBase) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save">{{ zzPct }}% cheaper / hr</span>
          {% endif %}{% endif %}
          {% elif variant.name == '1000+ Hours' %}
          <span class="pf-variant__perday" x-text="'≈ ' + appCurrency.format({{ variant.price }} / 10, '{{ product.currency }}') + ' / 100 hrs'">≈ {{ formatPrice(variant.price / 10, product.currency) }} / 100 hrs</span>
          {% if zzNfaBase %}{% set zzPct = (100 - ((variant.price / 10) / zzNfaBase) * 100) | round %}{% if zzPct >= 10 and zzPct < 95 %}
          <span class="pf-variant__save pf-variant__save--gold">{{ zzPct }}% cheaper / hr</span>
          {% endif %}{% endif %}
          {% endif %}
        </div>
        <template x-if="activeVariant == {{ loop.index0 }}">
          <div class="pf-variant__check">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
            </svg>
          </div>
        </template>
      </button>
      {% endfor %}
    </div>
    <small x-show="!(activeVariant in product.variants)" x-cloak class="pf-error">Please select a variant.</small>
  </div>
  {% endif %}

  <div class="pf-section">
    <p class="pf-label">Quantity</p>
    <div class="pf-qty">
      <button
        @click="changeQuantity(quantity - 1)"
        type="button"
        class="pf-qty__btn"
        :disabled="outOfStock || quantity <= minQuantity"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15"/>
        </svg>
      </button>
      <input
        type="number"
        class="pf-qty__input"
        name="quantity"
        x-model.number="quantity"
        :min="minQuantity"
        :max="maxQuantity"
        :disabled="outOfStock"
      />
      <button
        @click="changeQuantity(quantity + 1)"
        type="button"
        class="pf-qty__btn"
        :disabled="outOfStock || quantity >= maxQuantity"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
      </button>
    </div>
    <small x-show="!outOfStock && (quantity < minQuantity || quantity > maxQuantity)" x-cloak class="pf-error">
      Please enter a valid quantity (from <span x-text="minQuantity"></span> to <span x-text="maxQuantity"></span>).
    </small>
    <div x-show="nextVolumeDiscount" x-cloak class="pf-vol-discount">
      Buy <span x-text="nextVolumeDiscount?.quantity - quantity"></span> more to get a <span x-text="nextVolumeDiscount?.percentage"></span>% discount.
    </div>
  </div>

  {% if productAddons and productAddons.length > 0 %}
  <div class="pf-section">
    <p class="pf-label">Recommended add-on</p>
    <div class="pf-addons">
      {% for addon in productAddons %}
      <div class="pf-addon">
        <span class="pf-addon__ribbon">RECOMMENDED</span>
        <div class="pf-addon__info">
          {% if addon.image_urls and addon.image_urls[0] %}
          <img src="{{ addon.image_urls[0] }}" alt="{{ addon.name }}" class="pf-addon__img" loading="lazy" decoding="async">
          {% else %}
          <span class="pf-addon__img pf-addon__img--icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </span>
          {% endif %}
          <div class="pf-addon__text">
            <p class="pf-addon__name">{{ addon.name }}</p>
            {% if addon.description %}
            <p class="pf-addon__desc">{{ addon.description }}</p>
            {% endif %}
          </div>
        </div>
        <div class="pf-addon__actions">
          <span class="pf-addon__price" x-text="'+ ' + appCurrency.format('{{ addon.variants[0].price }}', '{{ addon.currency }}')">
            + {{ formatPrice(addon.variants[0].price, addon.currency) }}
          </span>
          <button
            type="button"
            x-show="!appCart.isInCart({{ addon.variants[0].id }}, variant.id)"
            x-cloak
            x-on:click="appCart.add({{ addon.id }}, {{ addon.variants[0].id }}, 1, variant.id)"
            class="pf-addon__btn pf-addon__btn--add"
            :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
          >+ Add</button>
          {% if addon.is_mandatory %}
          <button type="button" x-show="appCart.isInCart({{ addon.variants[0].id }}, variant.id)" x-cloak class="pf-addon__btn pf-addon__btn--added" disabled>✓ Added</button>
          {% else %}
          <button
            type="button"
            x-show="appCart.isInCart({{ addon.variants[0].id }}, variant.id)"
            x-cloak
            x-on:click="appCart.remove({{ addon.variants[0].id }}, variant.id)"
            class="pf-addon__btn pf-addon__btn--remove"
            :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
          >✓ Added</button>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if product.path == 'zaza-rust-private-cheat' %}
    <p class="pf-anchor">Lifetime works out under <b>$0.55/day</b> — the cheapest way to run Zaza long-term.</p>
    {% endif %}
    {% if product.path == 'rust-nfa' %}
    <p class="pf-anchor">Every tier ships with the <b>free 6-hour replacement warranty</b> — even the cheapest Starter.</p>
    {% endif %}
  </div>
  {% endif %}

  {% if altcha and not properties.hide_buy_now %}
  <div x-cloak x-show="!altchaPayload" class="pf-section">
    <altcha-widget
      challengejson='{{ altcha | json }}'
      auto="onload"
      hidefooter="true"
      hidelogo="true"
      x-ref="altcha"
    ></altcha-widget>
  </div>
  {% endif %}

  <div x-cloak x-show="buyNowError" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
    <div class="pf-error-box" role="alert">
      <span x-text="buyNowError"></span>
      <span class="pf-error-box__fallback">Still stuck? <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener">Message us on Discord</a> — we answer fast, or try again in a minute.</span>
    </div>
  </div>

  <div class="pf-actions">
    {% if not properties.hide_buy_now %}
    <button
      type="submit"
      class="pf-btn pf-btn--primary"
      :disabled="outOfStock || product.visibility == 'on_hold' || buyingNow || buyNowDisabled"
    >
      <span x-show="!buyingNow" x-cloak class="pf-btn__inner">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M237.66,122.34l-96-96A8,8,0,0,0,128,32V72H104a8,8,0,0,0-8,8v96a8,8,0,0,0,8,8h24v40a8,8,0,0,0,13.66,5.66l96-96A8,8,0,0,0,237.66,122.34ZM144,204.69V176a8,8,0,0,0-8-8H112V88h24a8,8,0,0,0,8-8V51.31L220.69,128ZM48,80v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Zm32,0v96a8,8,0,0,1-16,0V80a8,8,0,0,1,16,0Z"/></svg>
        <span>Buy Now</span>
        <span class="pf-btn__price" x-show="variant" x-cloak>&middot;&nbsp;<span x-text="appCurrency.format(totalPrice, '{{ product.currency }}')"></span></span>
      </span>
      <span x-show="buyingNow" x-cloak class="pf-btn__inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="pf-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"/></svg>
        Processing...
      </span>
    </button>
    {% endif %}

    {% if not properties.hide_add_to_cart %}
    <button
      type="button"
      x-on:click="addToCart"
      class="pf-btn pf-btn--secondary"
      :disabled="outOfStock || product.visibility == 'on_hold' || cartLimitReached || addingToCart"
    >
      <span x-show="!addingToCart && !addedToCart" x-cloak class="pf-btn__inner">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87ZM104,204a12,12,0,1,1-12-12A12,12,0,0,1,104,204Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,200,204Zm4-74.57A8,8,0,0,1,196.1,136H77.22L65.59,72H214.41Z"/></svg>
        <span x-text="cartLimitReached ? 'Cart Limit Reached' : 'Add to Cart'"></span>
      </span>
      <span x-show="addingToCart" x-cloak class="pf-btn__inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="pf-spin" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"/></svg>
        Adding...
      </span>
      <span x-show="addedToCart" x-cloak class="pf-btn__inner">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"/></svg>
        Go to Cart
      </span>
    </button>
    {% endif %}
  </div>

  {# ---- What happens after you click Buy Now: removes the "then what?" fear at the exact decision moment ---- #}
  <div class="pf-next" aria-label="What happens after you buy">
    <span class="pf-next__step"><span class="pf-next__num">1</span>Pay by card or crypto</span>
    <svg class="pf-next__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="pf-next__step"><span class="pf-next__num">2</span>Key appears on screen</span>
    <svg class="pf-next__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="pf-next__step"><span class="pf-next__num">3</span>Load &amp; play</span>
  </div>

  <div class="pf-guarantee">
    <div class="pf-guarantee__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 100 18 9 9 0 000-18z" stroke="#4ade80" stroke-width="1.5"/><circle cx="12" cy="12" r="3.5" fill="#4ade80"/></svg>
      <div>
        <span class="pf-guarantee__t">Live status: {% render_snippet "status-badge.njk", pname=product.name, pid=product.id %}</span>
        <span class="pf-guarantee__d">Public and dated — <a href="{{ '/status' | shopUrl }}" style="color:#4ade80;text-decoration:underline">verify it yourself before you buy →</a></span>
      </div>
    </div>
    <div class="pf-guarantee__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z" fill="#BF40BF"/></svg>
      <div>
        <span class="pf-guarantee__t">Instant delivery, guaranteed</span>
