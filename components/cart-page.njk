<script>
/* Day/Week key -> NFA upsell.
   Show when: cheat product (760665) is in the cart with a variant that is
   NOT month (1259108) or lifetime (1259110) — i.e. a Day or Week key, ids
   we don't need to know — AND there are no NFAs (766224) in the cart yet.
   Month/Lifetime carts are excluded on purpose: they already get the free
   bundle, and a paid pitch under a free one reads badly.
   One tap adds 1x NFA 500-1000 (1277466) via the theme's own appCart. */
(function(){
  var box=document.getElementById('zz-nfa-upsell');
  if(!box) return;
  var btn=box.querySelector('[data-zzup-add]');
  var CHEAT=760665, MONTH=1259108, LIFE=1259110, NFA_P=766224, NFA_V=1277466;

  function readCart(){
    try{ var c=JSON.parse(localStorage.getItem('cart')||'[]'); return Array.isArray(c)?c:[]; }
    catch(e){ return []; }
  }
  function shouldShow(cart){
    var hasSmallKey=false, hasNfa=false;
    for(var i=0;i<cart.length;i++){
      var it=cart[i];
      if(it.productId===CHEAT && it.variantId!==MONTH && it.variantId!==LIFE) hasSmallKey=true;
      if(it.productId===NFA_P) hasNfa=true;
    }
    return hasSmallKey && !hasNfa;
  }
  function getCart(){
    try{
      var root=document.getElementById('app');
      if(root&&window.Alpine&&typeof Alpine.$data==='function'){
        var d=Alpine.$data(root);
        if(d&&d.appCart&&typeof d.appCart.add==='function') return d.appCart;
      }
    }catch(e){}
    return null;
  }
  function refresh(){
    if(btn.classList.contains('zzup--done')) return; // let the ✓ state linger
    box.hidden=!shouldShow(readCart());
  }

  btn.addEventListener('click',function(){
    var cart=getCart();
    if(cart){ cart.add(NFA_P,NFA_V,1); }
    else{
      // storage fallback, same shape appCart.init() reads
      try{
        var c=readCart();
        c.push({productId:NFA_P,variantId:NFA_V,quantity:1,parentVariantId:null});
        localStorage.setItem('cart',JSON.stringify(c));
        window.location.reload();
        return;
      }catch(e){ return; }
    }
    btn.classList.add('zzup--done');
    btn.textContent='✓ Added';
    setTimeout(function(){ box.hidden=true; },1400);
  });

  refresh();
  setInterval(refresh,600);
})();
</script>