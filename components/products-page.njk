  opacity:.35;transition:opacity .4s}
.tp-card--nfa::after{background:linear-gradient(135deg,rgba(191,64,191,.6),transparent 42%,transparent 58%,rgba(191,64,191,.4))}
.tp-grid .tp-card--cheat{box-shadow:0 0 0 1px rgba(191,64,191,.16),0 24px 60px -34px rgba(191,64,191,.4)}
.tp-card:hover{--ty:-9px;--sc:1.022;border-color:rgba(191,64,191,.4);box-shadow:0 40px 90px -34px rgba(191,64,191,.65)}
.tp-card--nfa:hover{border-color:rgba(191,64,191,.45);box-shadow:0 40px 90px -34px rgba(191,64,191,.65)}
.tp-card:hover::after{opacity:1}
.tp-card__spot{position:absolute;inset:0;z-index:2;pointer-events:none;opacity:0;transition:opacity .35s;mix-blend-mode:screen;
  background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(191,64,191,.26),transparent 60%)}
.tp-card--nfa .tp-card__spot{background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(191,64,191,.28),transparent 60%)}
.tp-card:hover .tp-card__spot{opacity:1}
.tp-card__glow{position:absolute;top:-26%;left:50%;transform:translateX(-50%);width:360px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(191,64,191,.22),transparent 70%);opacity:0;transition:opacity .45s;pointer-events:none;z-index:0}
.tp-card--nfa .tp-card__glow{background:radial-gradient(circle,rgba(191,64,191,.24),transparent 70%)}
.tp-card:hover .tp-card__glow{opacity:1}
.tp-card__shine{position:absolute;top:0;left:-120%;width:55%;height:100%;z-index:4;pointer-events:none;
  background:linear-gradient(120deg,transparent,rgba(255,255,255,.13),transparent);transform:skewX(-20deg)}
.tp-card:hover .tp-card__shine{animation:tpShine .9s ease-out}
@keyframes tpShine{from{left:-120%}to{left:170%}}

.tp-card__media{position:relative;aspect-ratio:16/10;overflow:hidden;background:#0a0c18;
  margin:16px 16px 0;border-radius:16px;
  box-shadow:0 20px 38px -16px rgba(0,0,0,.72),0 0 0 1px rgba(255,255,255,.06),0 0 26px -6px rgba(191,64,191,.22);
  will-change:transform;animation:tpFloat 7s ease-in-out infinite}
.tp-card:hover .tp-card__media{box-shadow:0 30px 50px -16px rgba(0,0,0,.8),0 0 0 1px rgba(255,255,255,.09),0 0 36px -4px rgba(191,64,191,.4)}
@keyframes tpFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.tp-card__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .65s cubic-bezier(.16,1,.3,1)}
.tp-card:hover .tp-card__img{transform:scale(1.06)}
.tp-js .tp-card__media img.tp-card__img{opacity:0;transition:transform .65s cubic-bezier(.16,1,.3,1),opacity .7s ease}
.tp-js .tp-card__media img.tp-card__img.is-ready{opacity:1}
.tp-card__img--empty{display:flex;align-items:center;justify-content:center;color:rgba(231,236,255,.15)}
.tp-card__shade{position:absolute;inset:0;pointer-events:none;border-radius:16px;background:linear-gradient(180deg,transparent 48%,rgba(6,7,15,.82))}
@media (prefers-reduced-motion:reduce){.tp-card__media{animation:none}}
.tp-badges{position:absolute;top:12px;left:12px;display:flex;flex-wrap:wrap;gap:5px;z-index:3}
.tp-stock{position:absolute;top:12px;right:12px;z-index:3}
.tp-tl{position:absolute;top:12px;left:12px;display:flex;flex-direction:column;align-items:flex-start;gap:6px;z-index:3}

.sp-badge{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:11.5px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:#fff;padding:6px 11px;border-radius:999px;line-height:1;backdrop-filter:blur(8px)}
.sp-stock{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.78rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;padding:6px 11px;border-radius:999px}
.sp-stock--in{background:rgba(34,197,94,.14);color:rgba(34,197,94,.95);border:1px solid rgba(34,197,94,.25);backdrop-filter:blur(8px)}
.sp-stock--low{background:rgba(251,191,36,.16);color:rgba(251,191,36,.98);border:1px solid rgba(251,191,36,.3);backdrop-filter:blur(8px)}
.sp-stock--out{background:rgba(10,12,24,.6);color:rgba(231,236,255,.45);border:1px solid rgba(231,236,255,.12);backdrop-filter:blur(8px)}

.tp-card__body{position:relative;z-index:3;padding:22px 24px 24px;display:flex;flex-direction:column;gap:14px;flex:1;
  background:linear-gradient(180deg,rgba(10,12,24,.55),rgba(6,7,15,.78));
