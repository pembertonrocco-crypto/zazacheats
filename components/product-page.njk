  transition:transform .2s,filter .2s}
.ppx-bar__btn:hover{transform:translateY(-1px);filter:brightness(1.1)}
.ppx-bar__btn:disabled{opacity:.5;cursor:not-allowed}
@media (min-width:1100px){.ppx-bar{left:auto;right:24px;bottom:24px;width:380px;border:1px solid rgba(191,64,191,.3);border-radius:16px;padding:12px 16px}}

/* lightbox */
.ppx-lb{position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;
  background:rgba(4,5,12,.92);backdrop-filter:blur(10px);padding:34px}
.ppx-lb.is-on{display:flex;animation:ppxFade .25s ease}
@keyframes ppxFade{from{opacity:0}to{opacity:1}}
.ppx-lb__img{max-width:min(1200px,94vw);max-height:88vh;border-radius:14px;
  border:1px solid rgba(255,255,255,.12);box-shadow:0 40px 120px -30px rgba(0,0,0,.9)}
.ppx-lb__x,.ppx-lb__nav{position:absolute;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);
  color:#fff;cursor:pointer;border-radius:12px;display:grid;place-items:center;transition:background .2s}
.ppx-lb__x:hover,.ppx-lb__nav:hover{background:rgba(255,255,255,.14)}
.ppx-lb__x{top:18px;right:18px;width:42px;height:42px;font-size:1.1rem}
.ppx-lb__nav{top:50%;transform:translateY(-50%);width:46px;height:64px;font-size:1.3rem}
.ppx-lb__nav--l{left:14px}.ppx-lb__nav--r{right:14px}
.ppx-lb__count{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);
  font-family:'JetBrains Mono',monospace;font-size:.7rem;letter-spacing:.14em;color:rgba(220,232,255,.6)}
.pp-carousel__img{cursor:zoom-in}

/* trust strip under buy buttons */
.ppx-trust{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:14px;justify-content:center;
  font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.62rem;letter-spacing:.1em;color:rgba(200,215,240,.55)}
.ppx-trust span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}

/* pairs-with card */
.ppx-pair{margin-top:18px;border:1px solid rgba(245,196,81,.28);border-radius:16px;padding:16px 18px;
  background:linear-gradient(150deg,rgba(245,196,81,.07),rgba(12,15,30,.55));text-decoration:none;display:block;
  transition:transform .25s,border-color .25s}
.ppx-pair:hover{transform:translateY(-2px);border-color:rgba(245,196,81,.5)}
.ppx-pair__tag{font-family:'JetBrains Mono',monospace;font-size:.58rem;font-weight:800;letter-spacing:.2em;
  color:#0b0a05;background:linear-gradient(135deg,#ffe9a3,#e8b53a);border-radius:999px;padding:4px 10px;display:inline-block}
.ppx-pair__t{display:block;font-weight:800;color:#fff;margin:9px 0 3px;font-size:.98rem}
.ppx-pair__d{display:block;color:rgba(210,224,250,.62);font-size:.84rem;line-height:1.55}
.ppx-pair__go{display:inline-flex;align-items:center;gap:6px;margin-top:9px;color:#f7d474;font-weight:800;font-size:.82rem}
</style>

<script>
(function(){
  var actions=document.querySelector('.pf-actions');
  var realBtn=document.querySelector('.pf-btn--primary');

  /* ---------- trust strip + pairs-with, anchored to the buy form ---------- */
  if(actions){
    var trust=document.createElement('div');
    trust.className='ppx-trust';
    trust.innerHTML='<span>\u26A1 INSTANT DELIVERY</span><span>\uD83D\uDD12 SECURE CHECKOUT</span><span>\uD83D\uDCB3 CARD &amp; CRYPTO</span><span>\uD83D\uDEE1 WARRANTY BACKED</span>';
    actions.parentNode.insertBefore(trust,actions.nextSibling);

    var path=location.pathname;
    var pair=null;
    if(path.indexOf('zaza-rust-private-cheat')>-1){
      pair={href:'/product/rust-nfa',tag:'COMPLETE THE LOADOUT',t:'Add a disposable account \u2014 NFA from $1.00',
        d:'Never risk your main. Aged NFA accounts with a free 6-hour replacement warranty, delivered instantly.'};
    }else if(path.indexOf('rust-nfa')>-1){
      pair={href:'/product/zaza-rust-private-cheat',tag:'PAIRS WITH',t:'Zaza Private Cheat \u2014 keys from $4.99',
        d:'Private build, ~100 players on an average day. Run it on this account and keep your main untouched.'};
    }
    if(pair){
      var a=document.createElement('a');
      a.className='ppx-pair';a.href=pair.href;
      a.innerHTML='<span class="ppx-pair__tag">'+pair.tag+'</span>'+
        '<span class="ppx-pair__t">'+pair.t+'</span>'+
        '<span class="ppx-pair__d">'+pair.d+'</span>'+
        '<span class="ppx-pair__go">View product \u2192</span>';
      trust.parentNode.insertBefore(a,trust.nextSibling);
    }
  }

  /* ---------- sticky buy bar ---------- */
  if(actions&&realBtn){
    var bar=document.createElement('div');
    bar.className='ppx-bar';
    var nameEl=document.querySelector('.pp-title');
    bar.innerHTML='<div class="ppx-bar__info"><span class="ppx-bar__name">'+(nameEl?nameEl.textContent.trim():'Product')+
      '</span><span class="ppx-bar__price" data-ppx-price></span></div>'+
      '<button type="button" class="ppx-bar__btn">\u26A1 Buy Now</button>';
    document.body.appendChild(bar);
    var barBtn=bar.querySelector('.ppx-bar__btn');
    var barPrice=bar.querySelector('[data-ppx-price]');
    barBtn.addEventListener('click',function(){
      realBtn.scrollIntoView({behavior:'smooth',block:'center'});
      setTimeout(function(){ if(!realBtn.disabled) realBtn.click(); },450);
    });
    var sync=function(){
      var pEl=document.querySelector('.pf-btn__price');
      var txt=pEl?pEl.textContent.replace(/^[\s\u00b7\u00a0]+/,'').trim():'';
      barPrice.textContent=txt||'Select a key above';
      barBtn.disabled=!!realBtn.disabled;
    };
    sync();setInterval(sync,700);
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(es){
        es.forEach(function(e){bar.classList.toggle('is-on',!e.isIntersecting);});
      },{threshold:0});
      io.observe(actions);
    }else{bar.classList.add('is-on');}
  }

  /* ---------- gallery lightbox ---------- */
  var mains=Array.prototype.slice.call(document.querySelectorAll('.pp-carousel__img'));
  if(mains.length){
    var urls=mains.map(function(im){return im.getAttribute('src');});
    var lb=document.createElement('div');
    lb.className='ppx-lb';
    lb.innerHTML='<button type="button" class="ppx-lb__x" aria-label="Close">\u2715</button>'+
      (urls.length>1?'<button type="button" class="ppx-lb__nav ppx-lb__nav--l" aria-label="Previous">\u2039</button>'+
      '<button type="button" class="ppx-lb__nav ppx-lb__nav--r" aria-label="Next">\u203A</button>':'')+
      '<img class="ppx-lb__img" alt="Product screenshot"><span class="ppx-lb__count"></span>';
    document.body.appendChild(lb);
    var img=lb.querySelector('.ppx-lb__img'),count=lb.querySelector('.ppx-lb__count'),idx=0;
    function show(i){idx=(i+urls.length)%urls.length;img.src=urls[idx];
      count.textContent=(idx+1)+' / '+urls.length;}
    function open(i){show(i);lb.classList.add('is-on');document.body.style.overflow='hidden';}
    function close(){lb.classList.remove('is-on');document.body.style.overflow='';}
    mains.forEach(function(im,i){im.addEventListener('click',function(){open(i);});});
    lb.querySelector('.ppx-lb__x').addEventListener('click',close);
    lb.addEventListener('click',function(e){if(e.target===lb)close();});
    var L=lb.querySelector('.ppx-lb__nav--l'),R=lb.querySelector('.ppx-lb__nav--r');
    if(L)L.addEventListener('click',function(){show(idx-1);});
    if(R)R.addEventListener('click',function(){show(idx+1);});
    document.addEventListener('keydown',function(e){
      if(!lb.classList.contains('is-on'))return;
      if(e.key==='Escape')close();
      if(e.key==='ArrowLeft')show(idx-1);
      if(e.key==='ArrowRight')show(idx+1);
    });
  }
})();
</script>

