.wu-list{margin:0;padding-left:0;list-style:none;counter-reset:wu}
.wu-list li{position:relative;padding:12px 0 12px 42px;color:var(--mut);font-size:.94rem;line-height:1.6;border-top:1px solid rgba(255,255,255,.05)}
.wu-list li:first-child{border-top:none}
.wu-list li strong{color:#fff}
.wu-list li::before{counter-increment:wu;content:counter(wu);position:absolute;left:0;top:12px;
  width:26px;height:26px;display:grid;place-items:center;border-radius:8px;font-size:.78rem;font-weight:700;
  background:rgba(191,64,191,.16);border:1px solid rgba(191,64,191,.3);color:#e6aaff}

.wu-tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.wu-table{width:100%;border-collapse:collapse;font-size:.88rem;min-width:520px}
.wu-table th,.wu-table td{padding:12px 14px;text-align:left;border-top:1px solid rgba(255,255,255,.055);vertical-align:top}
.wu-table thead th{border-top:none;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(231,236,255,.5);font-weight:500}
.wu-table thead .wu-th--good{color:#4ade80}
.wu-table tbody th{font-weight:500;color:#fff;width:26%}
.wu-table td{color:rgba(231,236,255,.72)}
.wu-table .wu-td--good{color:#e7ecff;background:rgba(34,197,94,.045)}

.wu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-bottom:18px}
.wu-mini{border:1px solid var(--edge);border-radius:16px;padding:20px;background:var(--panel);backdrop-filter:blur(14px);
  transition:border-color .25s,transform .25s}
.wu-mini:hover{border-color:rgba(191,64,191,.32);transform:translateY(-3px)}
.wu-mini__ico{font-size:1.4rem;display:block;margin-bottom:10px}
.wu-mini__t{font-size:1rem;font-weight:700;margin:0 0 7px;letter-spacing:-.01em}
.wu-mini__p{color:var(--mut);font-size:.88rem;line-height:1.55;margin:0}

.wu-proof{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.wu-proof__item{border:1px solid var(--edge);border-radius:14px;padding:18px 14px;background:var(--panel);text-align:center}
.wu-proof__n{font-size:1.6rem;font-weight:700;margin:0;letter-spacing:-.02em;color:#fff}
.wu-proof__l{font-size:.76rem;color:rgba(231,236,255,.55);margin:6px 0 0;line-height:1.35}

.wu-cta{text-align:center;border:1px solid rgba(191,64,191,.3);border-radius:18px;padding:34px 24px;
  background:linear-gradient(135deg,rgba(191,64,191,.1),rgba(191,64,191,.04))}
.wu-cta__t{font-size:1.4rem;font-weight:700;margin:0;letter-spacing:-.02em}
.wu-cta__p{color:var(--mut);font-size:.94rem;margin:.5rem 0 20px}
.wu-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:12px;
  background:linear-gradient(135deg,var(--v),var(--b));color:#fff;font-weight:700;font-size:1rem;text-decoration:none;
  box-shadow:0 12px 32px -10px rgba(191,64,191,.8);transition:filter .25s,transform .25s,gap .25s}
.wu-btn:hover{filter:brightness(1.1);transform:translateY(-2px);gap:13px;color:#fff;text-decoration:none}
.wu-cta__f{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.76rem;color:rgba(231,236,255,.45);margin:18px 0 0}

.wu-faqlead{text-align:center;color:rgba(231,236,255,.5);font-size:.9rem;margin:44px 0 0}
.wu-components{background:radial-gradient(120% 80% at 50% 0%,#0a0c18 0%,#06070f 60%)}

@media (max-width:860px){
  .wu-versus{grid-template-columns:1fr;gap:12px}
  .wu-vs__mid{padding:2px 0}
  .wu-proof{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:680px){
  .wu-wrap{padding:104px 16px 32px}
  .wu-card,.wu-mini{padding:20px}
}
@media (prefers-reduced-motion:reduce){
  .wu-page *{animation:none!important;transition:none!important}
  .wu-rise{opacity:1!important;transform:none!important}
}
</style>

{% else %}

<div class="container">
  <section class="py-5-nav">
    <div class="section-title">
      <h1>{{ custom_page.name }}</h1>
    </div>
  </section>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>

{% endif %}