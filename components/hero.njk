  }
  function startLoop() {
    if (rafId === null && !reduceMotion) rafId = requestAnimationFrame(loop);
  }
  function stopLoop() {
    if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 1.75);
    W = section.offsetWidth;
    H = section.offsetHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    makeTargets();
    makeParticles();
    cross.x = aim.x = W * 0.5;
    cross.y = aim.y = H * 0.45;
    if (reduceMotion) frame(); /* single static frame */
  }

  section.addEventListener('mousemove', function (e) {
    var r = section.getBoundingClientRect();
    mouse.x = e.clientX - r.left;
    mouse.y = e.clientY - r.top;
    mouse.t = Date.now();
  });
  section.addEventListener('mouseleave', function () {
    mouse.x = null;
    mouse.y = null;
  });

  window.addEventListener('resize', resize);
  resize();

  if (!reduceMotion) {
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        if (visible) startLoop(); else stopLoop();
      }, { threshold: 0 });
      io.observe(section);
    } else {
      startLoop();
    }
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopLoop();
      else if (visible) startLoop();
    });
  }
})();
</script>

<script>
(function () {
  var section = document.querySelector('.hero[data-component-id="{{ componentId }}"]') || document.querySelector('.hero');
  if (!section) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;

  /* cursor spotlight on primary CTA */
  if (fine && !reduce) {
    section.querySelectorAll('.hero-btn-primary').forEach(function (btn) {
      btn.addEventListener('pointermove', function (e) {
        var r = btn.getBoundingClientRect();
        btn.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        btn.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  }

  /* micro-parallax: content drifts a few px against the cursor */
  if (fine && !reduce) {
    var inner = section.querySelector('.hero-inner');
    var scene = section.querySelector('.hero-scene');
    if (inner) {
      var tx = 0, ty = 0, cx = 0, cy = 0, raf = null;
      function tick() {
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        inner.style.setProperty('--hpx', cx.toFixed(2) + 'px');
        inner.style.setProperty('--hpy', cy.toFixed(2) + 'px');
        /* scene layer counter-drifts (content moves against the cursor,
           the world moves with it) — opposing motion sells the depth */
        if (scene) {
          section.style.setProperty('--hsx', (-cx * 2.4).toFixed(2) + 'px');
          section.style.setProperty('--hsy', (-cy * 2.4).toFixed(2) + 'px');
        }
        if (Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05) { raf = requestAnimationFrame(tick); }
        else raf = null;
      }
      section.addEventListener('pointermove', function (e) {
        var r = section.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * -8;
        ty = ((e.clientY - r.top) / r.height - 0.5) * -5;
        if (!raf) raf = requestAnimationFrame(tick);
      });
      section.addEventListener('pointerleave', function () {
        tx = 0; ty = 0;
        if (!raf) raf = requestAnimationFrame(tick);
      });
    }
  }

  /* scroll cue: click scrolls past the hero; fades once the user scrolls */
  var cue = section.querySelector('[data-hero-scrollcue]');
  if (cue) {
    cue.addEventListener('click', function () {
      window.scrollTo({ top: section.offsetTop + section.offsetHeight - 60, behavior: reduce ? 'auto' : 'smooth' });
    });
    var onScroll = function () {
      cue.classList.toggle('is-hidden', window.scrollY > 40);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
})();
</script>
