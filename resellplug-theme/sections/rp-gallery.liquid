{%- comment -%}
  Lifestyle gallery.

  Somewhere to put real photographs — hauls opened on the floor, parcels
  stacked up, a table of stock, a member's shelf. The proof slider carries
  chat screenshots, which prove people are talking; these prove the goods are
  physical and actually arrive, which is a different objection.

  Every tile crops to the same aspect ratio. That is deliberate and it is the
  one rule to keep: a grid where each photo takes its own proportions was the
  thing that made the product grid look broken, and phone photos vary far
  more than product shots do.

  A block with no image is skipped on the live site. In the theme editor it
  renders as a labelled placeholder instead, so an empty slot is a visible
  instruction while you are working and invisible to customers.
{%- endcomment -%}

{{ 'rp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ratio = section.settings.ratio | default: 'square'
  assign has_image = false
  for block in section.blocks
    if block.settings.image != blank
      assign has_image = true
      break
    endif
  endfor
-%}

{%- if has_image or request.design_mode -%}
  <div class="rp-section rp-section--{{ section.settings.tone | default: 'flat' }}" id="{{ section.settings.anchor | default: 'gallery' | handle }}">
    <div class="rp-wrap">
      {%- if section.settings.heading != blank -%}
        <div class="rp-center">
          {%- if section.settings.eyebrow != blank -%}
            <p class="rp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="rp-h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="rp-lede">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="rp-gallery rp-gallery--{{ section.settings.columns }} rp-gallery--{{ ratio }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <figure class="rp-gallery__item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 900',
                  sizes: '(min-width: 990px) 33vw, 46vw',
                  class: 'rp-gallery__img',
                  alt: block.settings.alt | default: section.settings.default_alt
              }}
              {%- if block.settings.caption != blank -%}
                <figcaption class="rp-gallery__caption">{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- elsif request.design_mode -%}
            <div class="rp-gallery__item rp-gallery__item--empty" {{ block.shopify_attributes }}>
              <span>Add a photo</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <div class="rp-center" style="margin-top: 28px">
          <div class="rp-actions">
            {% render 'rp-primary-button',
              link: section.settings.cta_link,
              label: section.settings.cta_label,
              source: 'gallery'
            %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "RP · Photo gallery",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Real photos: hauls on the floor, parcels stacked, stock laid out, a member's shelf. Shoot them on a phone — over-produced stock imagery reads as fake here."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The goods" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What actually turns up" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "Hauls from the suppliers on this site, photographed as they came out of the box."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Photo shape",
      "default": "square",
      "info": "Every photo crops to this, so the grid stays even no matter what you upload.",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "text",
      "id": "default_alt",
      "label": "Image description",
      "default": "Haul from a supplier on Resell Plug"
    },
    { "type": "text", "id": "cta_label", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "gallery" },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "default": "flat",
      "options": [
        { "value": "flat", "label": "Black" },
        { "value": "raised", "label": "Raised" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption" },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "info": "For screen readers and for when the image fails to load."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RP · Photo gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
