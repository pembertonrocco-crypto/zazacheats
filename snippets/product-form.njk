<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('productForm', () => ({
      product: {{ product | json }},
      productAddons: {{ productAddons | json }},
      activeVariant: 0,
      quantity: {{ product.quantity_min or 1 }},
      isEmbed: {{ 'true' if is_embed else 'false' }},
      addingToCart: false,
      addedToCart: false,
      buyingNow: false,
      buyNowError: null,
      buyNowDisabled: false,
      altchaPayload: null,

      get variant() { return this.product.variants[this.activeVariant]; },

      init: function () {
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.has('variant')) {
          const variantIndex = this.product.variants.findIndex(v => v.name === urlParams.get('variant'));
          if (variantIndex !== -1) this.activeVariant = variantIndex;
        } else {
          for (let i = 0; i < this.product.variants.length; i++) {
            if (this.product.variants[i].stock !== 0) { this.activeVariant = i; break; }
          }
          // Prefer the mid-tier "Most Popular" key as the default selection when
          // it's in stock — anchors on the typical purchase, not the cheapest.
          const popularNames = ['1 Week Key', '1 Week', '7 Day Key'];
          const popularIndex = this.product.variants.findIndex(v => popularNames.includes(v.name) && v.stock !== 0);
          if (popularIndex !== -1) this.activeVariant = popularIndex;
        }

        if (this.variant.quantity_min) this.quantity = this.variant.quantity_min;

        if (urlParams.has('quantity')) {
          const urlQuantity = parseInt(urlParams.get('quantity'));
          if (!isNaN(urlQuantity) && urlQuantity >= this.minQuantity && urlQuantity <= this.maxQuantity) this.quantity = urlQuantity;
        }

        this.$watch('activeVariant', () => {
          this.quantity = this.product.quantity_min || 1;
          if (this.variant.quantity_min) this.quantity = this.variant.quantity_min;
          this.addedToCart = false;
          for (const addon of this.productAddons) {
            if (addon.is_mandatory && !this.appCart.isInCart(addon.variants[0].id, this.variant.id)) {
              this.appCart.add(addon.id, addon.variants[0].id, 1, this.variant.id);
            }
          }
        });

        this.$watch('quantity', () => { this.addedToCart = false; });

        {% if altcha and not properties.hide_buy_now %}
          this.addAltchaEventListener();
        {% endif %}
      },

      get nextVolumeDiscount() {
        if (this.variant.volume_discounts) {
          const vd = [...this.variant.volume_discounts].sort((a, b) => a.quantity - b.quantity);
          for (const v of vd) { if (this.quantity < parseInt(v.quantity)) return v; }
        }
        return null;
      },

      getAppliedVolumeDiscount: function (quantity = null) {
        if (quantity === null) quantity = this.quantity;
        if (this.variant.volume_discounts) {
          const vd = [...this.variant.volume_discounts].sort((a, b) => b.quantity - a.quantity);
          for (const v of vd) { if (quantity >= parseInt(v.quantity)) return v; }
        }
        return null;
      },

      get unitPrice() {
        let price = this.variant.price;
        const avd = this.getAppliedVolumeDiscount(1);
        if (avd) price -= this.variant.price * parseInt(avd.percentage) / 100;
        return price.toFixed(2);
      },

      get totalPrice() {
        let price = this.variant.price * this.quantity;
        const avd = this.getAppliedVolumeDiscount();
        if (avd) price -= (this.variant.price * this.quantity) * parseInt(avd.percentage) / 100;
        if (this.appCart.items.length > 0) {
          for (const item of this.appCart.items) {
            if (item.parentVariantId === this.variant.id) {
              const addonProduct = this.productAddons.find(a => a.id === item.productId && a.variants.some(v => v.id === item.variantId));
              if (addonProduct) {
                const addonPrice = addonProduct.variants.find(v => v.id === item.variantId).price;
                price += addonPrice * item.quantity;
              }
            }
          }
        }
        if (price < 0) price = 0;
        return price.toFixed(2);
      },

      get outOfStock() {
        if (this.variant) {
          if (this.variant.stock === 0) return true;
          if (this.variant.quantity_min > 0 && this.variant.stock !== -1 && !this.product.hide_stock_count && this.variant.stock < this.variant.quantity_min) return true;
        }
        return false;
      },

      get minQuantity() {
        if (this.variant.stock === 0) return 0;
        return this.variant.quantity_min || 1;
      },

      get maxQuantity() {
        const max = this.variant.quantity_max || 999999;
        if (this.variant.stock === 0) return 0;
        if (this.product.hide_stock_count || this.variant.stock === -1) return max;
        return Math.min(max, this.variant.stock);
      },

      changeQuantity: function (quantity) {
        this.quantity = Math.min(Math.max(this.minQuantity, quantity), this.maxQuantity);
      },

      get cartLimitReached() {
        {#— The fallback is load-bearing, not defensive padding. If
            shop.max_cart_limit is ever null/unset this interpolates to
            nothing, emitting `length >= ;` — a syntax error that takes out
            this entire <script>, and with it the whole productForm Alpine
            component: variant picker, quantity, add-to-cart and buy-now all
            stop responding on the product page. 100 stands in for "no
            practical limit". —#}
        return this.appCart.items.filter(i => !i.parentVariantId).length >= {{ shop.max_cart_limit if shop.max_cart_limit else 100 }};
      },

      addToCart: function () {
        if (this.addedToCart) { window.location.href = '{{ '/cart' | shopUrl }}'; return; }
        this.addingToCart = true;
        this.appCart.add(this.product.id, this.variant.id, this.quantity);
        setTimeout(() => { this.addedToCart = true; this.addingToCart = false; }, 1000);
      },

      addAltchaEventListener: function () {
        this.$refs.altcha.addEventListener('statechange', (event) => {
          if (event.detail.state === 'verifying') this.buyNowDisabled = true;
          else if (event.detail.state === 'verified') { this.buyNowDisabled = false; this.altchaPayload = event.detail.payload; }
        });
      },

      generateRecaptchaToken: async function () {
        return new Promise((resolve) => {
          grecaptcha.ready(() => void (async () => {
            resolve(await grecaptcha.execute('{{ shop.recaptcha_key }}', { action: 'buynow_s{{ shop.id }}' }));
          })());
        });
      },

      buyNow: async function () {
        if (this.buyingNow) return;
        if (this.quantity < this.minQuantity || this.quantity > this.maxQuantity) {
          this.buyNowError = `Please enter a valid quantity (from ${this.minQuantity} to ${this.maxQuantity}).`;
          return;
        }

        const buyNowCart = [{ productId: this.product.id, variantId: this.variant.id, quantity: this.quantity }];
        if (this.appCart.items.length > 0) {
          for (const item of this.appCart.items) {
            if (item.parentVariantId === this.variant.id) {
              buyNowCart.push({ productId: item.productId, variantId: item.variantId, parentVariantId: item.parentVariantId, quantity: item.quantity });
            }
          }
        }

        // Route Buy Now through the custom /pay checkout: save this order as the
        // cart, then go to /pay (which collects email + payment method and calls
        // the checkout backend). Skips SellAuth's hosted checkout.
        try {
          this.buyingNow = true;
          localStorage.setItem('cart', JSON.stringify(buyNowCart));
          // Hand the known prices to /pay so its summary shows real figures
          // instantly (display only — SellAuth computes the binding total).
          try {
            localStorage.setItem('zz_pay_snapshot', JSON.stringify([{
              product: {
                id: this.product.id,
                name: this.product.name,
                image_url: (this.product.image_urls && this.product.image_urls[0]) || this.product.image_url || null,
                currency: this.product.currency
              },
              variant: { name: this.variant.name, price: this.variant.price },
              quantity: this.quantity
            }]));
          } catch (e) {}
          const payUrl = '{{ '/pay' | shopUrl }}';
          if (this.isEmbed) window.open(payUrl, '_blank');
          else window.location.href = payUrl;
        } catch (error) {
          console.error(error);
          this.buyingNow = false;
          this.buyNowError = "Checkout couldn't start — refresh and try again.";
        }
      }
    }));
  });
</script>

