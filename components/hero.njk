    ctx.moveTo(cross.x, cross.y - gap - len); ctx.lineTo(cross.x, cross.y - gap);
    ctx.moveTo(cross.x, cross.y + gap);       ctx.lineTo(cross.x, cross.y + gap + len);
    ctx.stroke();
    ctx.fillStyle = 'rgba(191, 64, 191, 0.85)';
    ctx.beginPath();
    ctx.arc(cross.x, cross.y, 1.6, 0, Math.PI * 2);
    ctx.fill();
