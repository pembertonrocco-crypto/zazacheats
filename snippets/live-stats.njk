{#
  live-stats.njk — animated "by the numbers" social-proof band.
  ---------------------------------------------------------------------------
  A row of counters that tick up as they scroll into view (players online,
  keys delivered, average delivery time, days undetected). Immediately visible
  proof — no waiting, no hover. Rendered near the bottom of every page.

  House rules: static HTML/CSS/JS only; no-JS shows the final numbers plainly;
  prefers-reduced-motion skips the count-up (numbers just appear).
  Edit ZZ_STATS values below to match your real figures.
#}
<section class="zzst" aria-label="Store stats">
  <div class="zzst__inner">
    <div class="zzst__item">
      <span class="zzst__pulse" aria-hidden="true"></span>
      <span class="zzst__num" data-zzst="147" data-zzst-suffix="">147</span>
      <span class="zzst__lbl">players online now</span>
    </div>
    <span class="zzst__div" aria-hidden="true"></span>
    <div class="zzst__item">
      <span class="zzst__num" data-zzst="2480" data-zzst-suffix="+">2,480+</span>
      <span class="zzst__lbl">keys delivered</span>
    </div>
    <span class="zzst__div" aria-hidden="true"></span>
    <div class="zzst__item">
      <span class="zzst__num" data-zzst="12" data-zzst-prefix="~" data-zzst-suffix="s">~12s</span>
      <span class="zzst__lbl">avg. delivery time</span>
    </div>
    <span class="zzst__div" aria-hidden="true"></span>
    <div class="zzst__item">
      <span class="zzst__num zzst__num--g" data-zzst="214" data-zzst-suffix="d">214d</span>
      <span class="zzst__lbl">longest undetected streak</span>
    </div>
  </div>
</section>

<style>
  .zzst{max-width:960px;margin:56px auto 8px;padding:0 16px;
    font-family:var(--zz-sans)}
  .zzst__inner{display:flex;align-items:stretch;justify-content:center;gap:6px;flex-wrap:wrap;
    padding:20px 18px;border-radius:18px;
    background:linear-gradient(180deg,rgba(191,64,191,.06),rgba(255,255,255,.015));
    border:1px solid rgba(191,64,191,.18);
    box-shadow:0 20px 50px -30px rgba(191,64,191,.6),inset 0 1px 0 rgba(255,255,255,.04)}
  .zzst__item{flex:1;min-width:150px;display:flex;flex-direction:column;align-items:center;gap:5px;
    padding:6px 10px;position:relative;text-align:center}
  .zzst__pulse{position:absolute;top:8px;right:calc(50% - 46px);width:7px;height:7px;border-radius:50%;
    background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,.9);animation:zzstPulse 1.8s ease-in-out infinite}
  @keyframes zzstPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.82)}}
  .zzst__num{font-family:var(--zz-sans);font-size:clamp(1.7rem,3.4vw,2.35rem);
    font-weight:700;letter-spacing:-.02em;line-height:1;color:#fff;
    font-variant-numeric:tabular-nums}
  .zzst__num--g{color:#4ade80}
  .zzst__lbl{font-size:.72rem;font-weight:500;letter-spacing:.04em;text-transform:uppercase;
    color:rgba(231,236,255,.55)}
  .zzst__div{width:1px;align-self:center;height:38px;flex-shrink:0;
    background:linear-gradient(180deg,transparent,rgba(191,64,191,.35),transparent)}
  @media (max-width:620px){
    .zzst__inner{gap:0}
    .zzst__item{flex:1 1 45%;min-width:45%;padding:12px 8px}
    .zzst__div{display:none}
    .zzst__pulse{right:calc(50% - 40px)}
  }
</style>

<script>
(function(){
  'use strict';
  var nums=document.querySelectorAll('.zzst__num[data-zzst]');
  if(!nums.length) return;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  function fmt(n){ return n.toLocaleString('en-US'); }
  function render(el,val){
    var pre=el.getAttribute('data-zzst-prefix')||'';
    var suf=el.getAttribute('data-zzst-suffix')||'';
    el.textContent=pre+fmt(val)+suf;
  }
  function run(el){
    var target=parseInt(el.getAttribute('data-zzst'),10)||0;
    if(reduce){ render(el,target); return; }
    var dur=1400,start=null;
    function step(ts){
      if(!start) start=ts;
      var p=Math.min((ts-start)/dur,1);
      var eased=1-Math.pow(1-p,3);          // easeOutCubic
      render(el,Math.round(target*eased));
      if(p<1) requestAnimationFrame(step);
      else render(el,target);
    }
    requestAnimationFrame(step);
  }

  if(!('IntersectionObserver' in window)){ nums.forEach(function(n){ run(n); }); return; }
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ run(en.target); io.unobserve(en.target); }
    });
  },{threshold:0.4});
  nums.forEach(function(n){ io.observe(n); });
})();
</script>
