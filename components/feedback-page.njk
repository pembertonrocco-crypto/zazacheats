        <button class="rev-bar-row" type="button" data-star="2" aria-label="Show 2 star reviews" disabled><span class="rev-bl">2★</span><div class="rev-bt"><div class="rev-bf rev-bf-2" style="--w:0%"></div></div><span class="rev-bp">0%</span></button>
