{% set title_to_use = properties.default_title %}
{% if category and properties.category_title %}
  {% set title_to_use = properties.category_title %}
{% endif %}

{# Count real (non-grouped) sellable items so we can switch layouts. #}
{% set realItemCount = 0 %}
{% for item in items %}
  {% if item.type == 'group' or not item.group_id %}
    {% set realItemCount = realItemCount + 1 %}
  {% endif %}
{% endfor %}

{% if realItemCount == 1 and not filters.keyword and not filters.price.from and not filters.price.to %}
{# ============================================================
   SINGLE-PRODUCT STOREFRONT
   One focused hero card instead of a filter sidebar + grid.
   ============================================================ #}
<div class="sp-page component" data-component-id="{{ componentId }}">
  <div class="sp-bg" aria-hidden="true">
    <div class="sp-bg__grid"></div>
    <div class="sp-bg__beam sp-bg__beam--a"></div>
    <div class="sp-bg__beam sp-bg__beam--b"></div>
  </div>

  <div class="sp-wrap">
    <header class="sp-head">
      <p class="sp-eyebrow">// THE PRODUCT</p>
      <h1 class="sp-title">{{ title_to_use | renderString if title_to_use else 'Our Product' }}</h1>
      <p class="sp-subtitle">One private build. Built to dominate, maintained to last.</p>
    </header>

    {% for item in items %}
      {% if item.type == 'group' or not item.group_id %}
      <a class="sp-card" href="{{ ('/product/' + item.path) | shopUrl }}">
        <div class="sp-card__glow" aria-hidden="true"></div>

        <div class="sp-card__media">
          {% if item.image_urls|length > 0 %}
            <img src="{{ item.image_urls[0] }}" alt="{{ item.name }}" class="sp-card__img" loading="lazy" />
          {% elif item.image_url %}
            <img src="{{ item.image_url }}" alt="{{ item.name }}" class="sp-card__img" loading="lazy" />
          {% else %}
            <div class="sp-card__img sp-card__img--empty">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 256 256" fill="currentColor"><path d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46Z"/></svg>
            </div>
          {% endif %}

          {% if item.product_badges.card|length > 0 %}
          <div class="sp-card__badges">
            {% for b in item.product_badges.card %}
            <span class="sp-badge" style="background-color: {{ b.color }};">
              {% if b.icon %}<i class="{{ b.icon }} fa-fw"></i>{% endif %}{{ b.label }}
            </span>
            {% endfor %}
          </div>
          {% endif %}
        </div>

        <div class="sp-card__body">
          <div class="sp-card__chips">
            <span class="sp-chip sp-chip--g"><span class="sp-dot"></span>Status tracked live</span>
            <span class="sp-chip">Instant delivery</span>
            <span class="sp-chip">24h+ downtime covered</span>
          </div>

          <h2 class="sp-card__name">{{ item.name }}</h2>

          <div class="sp-card__stock">
            {% if item.type == 'group' %}
              <span class="sp-stock sp-stock--in">{{ item.products | length }} options</span>
            {% elif item.stock === 0 %}
              <span class="sp-stock sp-stock--out">Out of stock</span>
            {% elif item.stock === -1 or item.hide_stock_count %}
              <span class="sp-stock sp-stock--in">In stock</span>
            {% elif item.stock < 5 %}
              <span class="sp-stock sp-stock--low">{{ item.stock }} left</span>
            {% else %}
              <span class="sp-stock sp-stock--in">In stock</span>
            {% endif %}
          </div>

          <div class="sp-card__pricing">
            <span class="sp-price__label">From</span>
            <span class="sp-price">
              {% if item.min_price %}
                <span x-text="appCurrency.format({{ item.min_price }}, '{{ item.currency }}')">{{ formatPrice(item.min_price, item.currency) }}</span>
              {% else %}—{% endif %}
              {% if item.min_price_slash %}
                <s class="sp-price__slash"><span x-text="appCurrency.format({{ item.min_price_slash }}, '{{ item.currency }}')">{{ formatPrice(item.min_price_slash, item.currency) }}</span></s>
              {% endif %}
            </span>
          </div>

          <span class="sp-cta">
            View &amp; Buy
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>

          <div class="sp-card__trust">
            <span>🛡️ 24h+ downtime covered</span><span>⚡ Instant key</span><span>💬 Support</span><span>🔄 Updated</span>
          </div>
        </div>
      </a>
      {% endif %}
    {% endfor %}

    {% render_snippet "store-conversion-strip.njk" %}
  </div>
</div>

<style>
.sp-page{--g:#22c55e;--a:#fbbf24;--r:#ef4444;--v:#BF40BF;--b:#8e2d8e;
  --ink:#e7ecff;--mut:rgba(231,236,255,.6);--edge:rgba(191,64,191,.14);--void:#06070f;
  position:relative;width:100%;min-height:100vh;min-height:100dvh;overflow:hidden;
  background:radial-gradient(120% 80% at 50% -10%,#0a0c18 0%,#06070f 55%);
  font-family:var(--zz-sans);color:var(--ink)}
.sp-page *{box-sizing:border-box}
.sp-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.sp-bg__grid{position:absolute;inset:-2px;
  background-image:linear-gradient(rgba(191,64,191,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(191,64,191,.06) 1px,transparent 1px);
  background-size:44px 44px;-webkit-mask-image:radial-gradient(100% 70% at 50% 0%,#000 30%,transparent 80%);mask-image:radial-gradient(100% 70% at 50% 0%,#000 30%,transparent 80%)}
.sp-bg__beam{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;animation:spFloat 14s ease-in-out infinite}
.sp-bg__beam--a{width:34rem;height:34rem;top:-12rem;left:-8rem;background:radial-gradient(circle,rgba(191,64,191,.5),transparent 65%)}
.sp-bg__beam--b{width:30rem;height:30rem;top:-6rem;right:-8rem;background:radial-gradient(circle,rgba(191,64,191,.4),transparent 65%);animation-delay:-7s}
@keyframes spFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(26px)}}

.sp-wrap{position:relative;z-index:1;max-width:920px;margin:0 auto;padding:130px 20px 90px}
.sp-head{text-align:center;animation:spUp .7s ease both}
.sp-eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;color:var(--v);font-size:.74rem;letter-spacing:.22em;margin:0}
.sp-title{font-size:clamp(2.4rem,7vw,3.8rem);font-weight:700;letter-spacing:-.03em;margin:.5rem 0 0;color:#fff}
.sp-subtitle{color:var(--mut);font-size:1.05rem;margin:.6rem 0 0}

.sp-card{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:0;overflow:hidden;margin-top:44px;
  text-decoration:none;color:inherit;border:1px solid var(--edge);border-radius:24px;
  background:linear-gradient(135deg,rgba(191,64,191,.08),rgba(191,64,191,.03));
  transition:transform .4s cubic-bezier(.16,1,.3,1),border-color .4s,box-shadow .4s;animation:spUp .7s ease .1s both}
.sp-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;z-index:2;background:linear-gradient(90deg,transparent,rgba(191,64,191,.55),transparent)}
.sp-card:hover{transform:translateY(-6px);border-color:rgba(191,64,191,.4);box-shadow:0 32px 70px -28px rgba(191,64,191,.55)}
.sp-card__glow{position:absolute;top:-50%;right:-20%;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(191,64,191,.2),transparent 70%);opacity:0;transition:opacity .45s}
.sp-card:hover .sp-card__glow{opacity:1}

.sp-card__media{position:relative;background:#0a0c18;min-height:100%}
.sp-card__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s cubic-bezier(.16,1,.3,1)}
.sp-card:hover .sp-card__img{transform:scale(1.05)}
.sp-card__img--empty{display:flex;align-items:center;justify-content:center;color:rgba(231,236,255,.15);min-height:320px}
.sp-card__badges{position:absolute;top:14px;left:14px;display:flex;flex-wrap:wrap;gap:5px;z-index:2}
.sp-badge{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:10px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:#fff;padding:5px 10px;border-radius:999px;line-height:1;backdrop-filter:blur(8px)}

.sp-card__body{position:relative;z-index:1;padding:38px 36px;display:flex;flex-direction:column;gap:16px}
.sp-card__chips{display:flex;flex-wrap:wrap;gap:8px}
.sp-chip{display:inline-flex;align-items:center;gap:6px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.66rem;letter-spacing:.04em;text-transform:uppercase;
  color:var(--mut);border:1px solid var(--edge);background:var(--void);border-radius:999px;padding:5px 11px}
.sp-chip--g{color:var(--g);border-color:rgba(34,197,94,.3);background:rgba(34,197,94,.08)}
.sp-dot{width:6px;height:6px;border-radius:50%;background:var(--g);animation:spPulse 1.8s ease-in-out infinite}
@keyframes spPulse{0%,100%{opacity:1}50%{opacity:.4}}

.sp-card__name{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:700;letter-spacing:-.02em;margin:.2rem 0 0;line-height:1.1}
.sp-card__stock .sp-stock{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.7rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;padding:5px 10px;border-radius:999px}
.sp-stock--in{background:rgba(34,197,94,.1);color:rgba(34,197,94,.9);border:1px solid rgba(34,197,94,.18)}
.sp-stock--low{background:rgba(251,191,36,.1);color:rgba(251,191,36,.95);border:1px solid rgba(251,191,36,.2)}
.sp-stock--out{background:rgba(231,236,255,.04);color:rgba(231,236,255,.3);border:1px solid rgba(231,236,255,.07)}

.sp-card__pricing{display:flex;flex-direction:column;gap:3px;margin-top:4px}
.sp-price__label{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(231,236,255,.4)}
.sp-price{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:2rem;font-weight:700;letter-spacing:-.02em;display:flex;align-items:baseline;gap:8px}
.sp-price__slash{font-size:1rem;font-weight:500;color:rgba(231,236,255,.3);text-decoration:line-through}

.sp-cta{display:inline-flex;align-items:center;justify-content:center;gap:9px;margin-top:8px;padding:14px 22px;
  background:linear-gradient(135deg,var(--v),var(--b));border-radius:12px;font-weight:700;color:#fff;
  box-shadow:0 10px 30px -10px rgba(191,64,191,.7);transition:filter .25s,transform .25s,gap .25s}
.sp-card:hover .sp-cta{filter:brightness(1.1);gap:13px}

.sp-card__trust{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:6px;
  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.68rem;color:var(--mut)}
.sp-card__trust span{border:1px solid var(--edge);background:rgba(10,12,24,.5);border-radius:8px;padding:7px 10px;text-align:center}

@keyframes spUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

@media (max-width:760px){
  .sp-wrap{padding:104px 16px 64px}
  .sp-card{grid-template-columns:1fr}
  .sp-card__img{aspect-ratio:16/10}
  .sp-card__img--empty{min-height:200px}
  .sp-card__body{padding:28px 24px}
}
@media (prefers-reduced-motion:reduce){.sp-page *{animation:none!important}}
</style>

{% elif (items | length) == 2 and not filters.keyword and not filters.price.from and not filters.price.to %}
{# ============================================================
   TWO-PRODUCT LOADOUT — decision layout, not a grid.
   Cards get roles: 01/THE CHEAT (non-nfa path) renders first,
   02/THE ACCOUNT ('nfa' in path) second, via two passes over the
   real platform items (no synthetic data). Spec lines reuse only
   claims already established on the product pages.
   ============================================================ #}
<div class="sp-page component" data-component-id="{{ componentId }}">
  <div class="sp-bg" aria-hidden="true">
    <div class="sp-bg__grid"></div>
    <div class="sp-bg__beam sp-bg__beam--a"></div>
    <div class="sp-bg__beam sp-bg__beam--b"></div>
  </div>

  <div class="tp-wrap">
    <header class="sp-head">
      <p class="sp-eyebrow">// BUILD YOUR LOADOUT</p>
      <h1 class="sp-title">{{ title_to_use | renderString if title_to_use else 'Our Products' }}</h1>
      <p class="sp-subtitle">Two pieces: the cheat, and the account you run it on. Most customers grab both.</p>
      <div class="sp-trust">
        <span><i class="fa-solid fa-bolt"></i> Instant delivery</span>
        <span><i class="fa-solid fa-headset"></i> Active support</span>
        <span><i class="fa-solid fa-arrows-rotate"></i> Frequent updates</span>
      </div>
    </header>

    <div class="tp-grid">
      <span class="tp-plus" aria-hidden="true">+</span>

      {# ---- pass 1: the cheat (any real item whose path doesn't contain 'nfa') ---- #}
      {% for item in items %}
        {% if (item.type == 'group' or not item.group_id) and not ('nfa' in (item.path | lower)) %}
        <a class="tp-card tp-card--cheat" style="--i:0" href="{{ ('/product/' + item.path) | shopUrl }}" data-tilt>
          <span class="zz-neon" aria-hidden="true"></span>
          <span class="tp-card__spot" aria-hidden="true"></span>
          <span class="tp-card__shine" aria-hidden="true"></span>
          <span class="tp-card__glow" aria-hidden="true"></span>

          <div class="tp-card__media">
            {% if item.image_urls|length > 0 %}
              <img src="{{ item.image_urls[0] }}" alt="{{ item.name }}" class="tp-card__img" loading="lazy" />
            {% elif item.image_url %}
              <img src="{{ item.image_url }}" alt="{{ item.name }}" class="tp-card__img" loading="lazy" />
            {% else %}
              <div class="tp-card__img tp-card__img--empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 256 256" fill="currentColor"><path d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46Z"/></svg>
              </div>
            {% endif %}
            <span class="tp-card__shade" aria-hidden="true"></span>

            <div class="tp-tl">
              {% render_snippet "status-badge.njk", pname=item.name, pid=item.id %}
              {% if item.product_badges.card|length > 0 %}
              {% for b in item.product_badges.card %}
              <span class="sp-badge" style="background-color: {{ b.color }};">
                {% if b.icon %}<i class="{{ b.icon }} fa-fw"></i>{% endif %}{{ b.label }}
              </span>
              {% endfor %}
              {% endif %}
            </div>

            <div class="tp-stock">
              {% if item.type == 'group' %}
                <span class="sp-stock sp-stock--in">{{ item.products | length }} options</span>
              {% elif item.stock === 0 %}
                <span class="sp-stock sp-stock--out">Out of stock</span>
              {% elif item.stock === -1 or item.hide_stock_count %}
                <span class="sp-stock sp-stock--in">In stock</span>
              {% elif item.stock < 10 %}
                <span class="sp-stock sp-stock--low">{{ item.stock }} left</span>
              {% else %}
                <span class="sp-stock sp-stock--in">In stock</span>
              {% endif %}
            </div>
          </div>

          <div class="tp-card__body">
            <p class="tp-role"><span class="tp-role__num">01</span><span class="tp-role__sep">/</span>The Cheat</p>
            <h2 class="tp-card__name">{{ item.name }}</h2>
            <p class="tp-desc">Aim, ESP and configs &mdash; the private build itself. Keys by duration, delivered the moment payment clears.</p>

            <div class="tp-specs">
              <span class="tp-spec">Aimbot</span>
              <span class="tp-spec">ESP</span>
              <span class="tp-spec">Configs</span>
              <span class="tp-spec">Key by duration</span>
            </div>

            <div class="tp-card__foot">
              <div class="tp-pricing">
                <span class="sp-price__label">From</span>
                <span class="tp-price">
                  {% if item.min_price %}
                    <span x-text="appCurrency.format({{ item.min_price }}, '{{ item.currency }}')">{{ formatPrice(item.min_price, item.currency) }}</span>
                  {% else %}&mdash;{% endif %}
                  {% if item.min_price_slash %}
                    <s class="sp-price__slash"><span x-text="appCurrency.format({{ item.min_price_slash }}, '{{ item.currency }}')">{{ formatPrice(item.min_price_slash, item.currency) }}</span></s>
                  {% endif %}
                </span>
              </div>
              <span class="tp-cta">
                View &amp; Buy
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        </a>
        {% endif %}
      {% endfor %}

      {# ---- pass 2: the account ('nfa' in path) ---- #}
      {% for item in items %}
        {% if (item.type == 'group' or not item.group_id) and ('nfa' in (item.path | lower)) %}
        <a class="tp-card tp-card--nfa" style="--i:1" href="{{ ('/product/' + item.path) | shopUrl }}" data-tilt>
          <span class="zz-neon" aria-hidden="true"></span>
          <span class="tp-card__spot" aria-hidden="true"></span>
          <span class="tp-card__shine" aria-hidden="true"></span>
          <span class="tp-card__glow" aria-hidden="true"></span>

          <div class="tp-card__media">
            {% if item.image_urls|length > 0 %}
              <img src="{{ item.image_urls[0] }}" alt="{{ item.name }}" class="tp-card__img" loading="lazy" />
            {% elif item.image_url %}
              <img src="{{ item.image_url }}" alt="{{ item.name }}" class="tp-card__img" loading="lazy" />
            {% else %}
              <div class="tp-card__img tp-card__img--empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 256 256" fill="currentColor"><path d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46Z"/></svg>
              </div>
            {% endif %}
            <span class="tp-card__shade" aria-hidden="true"></span>

            <div class="tp-tl">
              {% render_snippet "status-badge.njk", pname=item.name, pid=item.id %}
              {% if item.product_badges.card|length > 0 %}
              {% for b in item.product_badges.card %}
              <span class="sp-badge" style="background-color: {{ b.color }};">
                {% if b.icon %}<i class="{{ b.icon }} fa-fw"></i>{% endif %}{{ b.label }}
              </span>
              {% endfor %}
              {% endif %}
            </div>

            <div class="tp-stock">
              {% if item.type == 'group' %}
                <span class="sp-stock sp-stock--in">{{ item.products | length }} options</span>
              {% elif item.stock === 0 %}
                <span class="sp-stock sp-stock--out">Out of stock</span>
              {% elif item.stock === -1 or item.hide_stock_count %}
                <span class="sp-stock sp-stock--in">In stock</span>
              {% elif item.stock < 10 %}
                <span class="sp-stock sp-stock--low">{{ item.stock }} left</span>
              {% else %}
                <span class="sp-stock sp-stock--in">In stock</span>
              {% endif %}
            </div>
          </div>

          <div class="tp-card__body">
            <p class="tp-role"><span class="tp-role__num">02</span><span class="tp-role__sep">/</span>The Account</p>
            <h2 class="tp-card__name">{{ item.name }}</h2>
            <p class="tp-desc">An aged Non-Full-Access Rust account to run it on. Bans land here &mdash; never on your main.</p>

            <div class="tp-specs">
              <span class="tp-spec">Aged playtime</span>
              <span class="tp-spec">6h warranty</span>
              <span class="tp-spec">One user per key</span>
            </div>

            <div class="tp-card__foot">
              <div class="tp-pricing">
                <span class="sp-price__label">From</span>
                <span class="tp-price">
                  {% if item.min_price %}
                    <span x-text="appCurrency.format({{ item.min_price }}, '{{ item.currency }}')">{{ formatPrice(item.min_price, item.currency) }}</span>
                  {% else %}&mdash;{% endif %}
                  {% if item.min_price_slash %}
                    <s class="sp-price__slash"><span x-text="appCurrency.format({{ item.min_price_slash }}, '{{ item.currency }}')">{{ formatPrice(item.min_price_slash, item.currency) }}</span></s>
                  {% endif %}
                </span>
              </div>
              <span class="tp-cta">
                View &amp; Buy
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>

    {# ---- loadout advice strip ---- #}
    <aside class="tpl">
      <div class="tpl__text">
        <p class="tpl__eyebrow">// THE FULL LOADOUT</p>
        <p class="tpl__line">One cheat key + one NFA account = a complete setup. Most customers grab both and pick the NFA tier that suits their wipe &mdash; the cheat needs an account you're willing to risk, and your main isn't it.</p>
      </div>
      <a class="tpl__link" href="{{ '/status' | shopUrl }}">
        <span class="tpl__pulse" aria-hidden="true"></span>
        Check both lights first
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </aside>

    {% render_snippet "store-conversion-strip.njk" %}
  </div>
</div>

<style>
.sp-page{--g:#22c55e;--a:#fbbf24;--r:#ef4444;--v:#BF40BF;--b:#8e2d8e;
  --ink:#e7ecff;--mut:rgba(231,236,255,.6);--edge:rgba(191,64,191,.14);--void:#06070f;
  position:relative;width:100%;min-height:100vh;min-height:100dvh;overflow:hidden;
  background:radial-gradient(120% 80% at 50% -10%,#0a0c18 0%,#06070f 55%);
  font-family:var(--zz-sans);color:var(--ink)}
.sp-page *{box-sizing:border-box}
.sp-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.sp-bg__grid{position:absolute;inset:-2px;
  background-image:linear-gradient(rgba(191,64,191,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(191,64,191,.06) 1px,transparent 1px);
  background-size:44px 44px;-webkit-mask-image:radial-gradient(100% 70% at 50% 0%,#000 30%,transparent 80%);mask-image:radial-gradient(100% 70% at 50% 0%,#000 30%,transparent 80%)}
.sp-bg__beam{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;animation:spFloat 14s ease-in-out infinite}
.sp-bg__beam--a{width:34rem;height:34rem;top:-12rem;left:-8rem;background:radial-gradient(circle,rgba(191,64,191,.5),transparent 65%)}
.sp-bg__beam--b{width:30rem;height:30rem;top:-6rem;right:-8rem;background:radial-gradient(circle,rgba(191,64,191,.4),transparent 65%);animation-delay:-7s}
@keyframes spFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(26px)}}

.tp-wrap{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:130px 24px 90px}
.sp-head{text-align:center;animation:spUp .7s ease both}
.sp-eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;color:var(--v);font-size:.84rem;letter-spacing:.22em;margin:0}
.sp-title{font-size:clamp(2.4rem,7vw,3.8rem);font-weight:700;letter-spacing:-.03em;margin:.5rem 0 0;color:#fff}
.sp-subtitle{color:rgba(231,236,255,.82);font-size:1.18rem;line-height:1.55;margin:.7rem auto 0;max-width:44rem}
