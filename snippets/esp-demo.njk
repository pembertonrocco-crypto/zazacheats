.zed__slider-thumb{position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:#fff;
  transform:translate(-50%,-50%);box-shadow:0 0 10px rgba(233,30,233,.85)}

.zed__select{display:inline-flex;align-items:center;justify-content:space-between;gap:8px;width:100%;
  padding:7px 10px;border-radius:6px;border:1px solid rgba(233,120,233,.25);background:rgba(255,255,255,.04);
  font-size:.62rem;color:rgba(225,210,235,.8);cursor:default}
.zed__select svg{color:#e91ee9;flex-shrink:0}

/* ================= viewport ================= */
.zed__view{position:relative;border-radius:12px;overflow:hidden;border:1px solid rgba(233,30,233,.3);
  box-shadow:0 30px 70px -25px rgba(0,0,0,.85);aspect-ratio:1058/671;position:sticky;top:90px}
.zed__img{width:100%;height:100%;object-fit:cover;display:block}
.zed__ov{position:absolute;inset:0;width:100%;height:100%}
.zed__layer{transition:opacity .25s}
.zed__vtag{position:absolute;top:12px;left:12px;display:inline-flex;align-items:center;gap:7px;
  padding:5px 10px;border-radius:7px;background:rgba(8,6,14,.7);backdrop-filter:blur(6px);
  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.58rem;letter-spacing:.16em;color:rgba(240,220,245,.8)}
.zed__vtag-dot{width:6px;height:6px;border-radius:50%;background:#e91ee9;box-shadow:0 0 8px rgba(233,30,233,.9);
  animation:zedPulse 1.8s infinite}
@keyframes zedPulse{0%,100%{opacity:1}50%{opacity:.4}}
.zed__corner{position:absolute;width:16px;height:16px;border-color:rgba(233,30,233,.75);border-style:solid;border-width:0;z-index:2}
.zed__corner--tl{top:6px;left:6px;border-top-width:2px;border-left-width:2px}
.zed__corner--tr{top:6px;right:6px;border-top-width:2px;border-right-width:2px}
.zed__corner--bl{bottom:6px;left:6px;border-bottom-width:2px;border-left-width:2px}
.zed__corner--br{bottom:6px;right:6px;border-bottom-width:2px;border-right-width:2px}

@media (max-width: 1080px){
  .zed__grid{grid-template-columns:1fr}
  .zed__view{position:relative;top:0;order:-1}
}
@media (max-width: 640px){
  .zed{padding:64px 16px}
  .zed__side{width:96px}
  .zed__panels{grid-template-columns:1fr}
}
@media (prefers-reduced-motion: reduce){
  .zed__vtag-dot{animation:none}
  .zed__layer{transition:none}
}
</style>

<script>
(function(){
  var menu = document.getElementById('zed-menu');
  if(!menu) return;

  /* checkbox → overlay layer */
  menu.querySelectorAll('input[data-zed]').forEach(function(input){
    var layer = document.getElementById('zed-ov-' + input.getAttribute('data-zed'));
    if(!layer) return;
    function apply(){ layer.style.display = input.checked ? '' : 'none'; }
    input.addEventListener('change', apply);
    apply();
  });

  /* generic cosmetic slider builder */
  function makeSlider(id, valId, initialPct, format){
    var slider = document.getElementById(id);
    if(!slider) return null;
    var fill = slider.querySelector('.zed__slider-fill');
    var thumb = slider.querySelector('.zed__slider-thumb');
    var valEl = valId ? document.getElementById(valId) : null;
    var onSet = null;
    function set(pct){
      pct = Math.max(0, Math.min(100, pct));
      fill.style.width = pct + '%';
      thumb.style.left = pct + '%';
      if(valEl && format) valEl.textContent = format(pct);
      if(onSet) onSet(pct);
    }
    var dragging = false;
    function fromEvent(e){
      var r = slider.getBoundingClientRect();
      var x = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
      set(x / r.width * 100);
    }
    slider.addEventListener('pointerdown', function(e){ dragging = true; slider.setPointerCapture(e.pointerId); fromEvent(e); });
    slider.addEventListener('pointermove', function(e){ if(dragging) fromEvent(e); });
    slider.addEventListener('pointerup', function(){ dragging = false; });
    set(initialPct);
    return { set: set, bind: function(fn){ onSet = fn; set(initialPct); } };
  }

  /* skeleton thickness: 0.5 – 4.0, default 1.5 — drives stroke width */
  var skel = document.getElementById('zed-ov-skeleton');
  var thick = makeSlider('zed-thick', 'zed-thick-val', ((1.5 - 0.5) / 3.5) * 100,
    function(pct){ return (0.5 + (pct / 100) * 3.5).toFixed(1); });
  if(thick && skel){
    thick.bind(function(pct){
      skel.setAttribute('stroke-width', (0.5 + (pct / 100) * 3.5).toFixed(1));
    });
  }

  /* ESP distance: 0 – 500, default 330 — cosmetic like the real menu at this range */
  makeSlider('zed-dist', 'zed-dist-val', (330 / 500) * 100,
    function(pct){ return (pct / 100 * 500).toFixed(1); });

  /* FPS readout jitters like a real one */
  var fpsEl = document.getElementById('zed-fps');
  if(fpsEl && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)){
    setInterval(function(){ fpsEl.textContent = 158 + Math.floor(Math.random() * 12); }, 900);
  }
})();
</script>
