/* ═══ CLOSE CTA ═══ */
.rev-close{max-width:760px;margin:36px auto 8px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;padding:22px 26px;border-radius:16px;border:1px solid rgba(191,64,191,.22);background:linear-gradient(180deg,rgba(191,64,191,.08),rgba(10,14,34,.6));}
.rev-close__text{display:flex;flex-direction:column;gap:4px;min-width:230px;flex:1;}
.rev-close__t{font-weight:700;font-size:1.05rem;color:#fff;}
.rev-close__d{font-size:.82rem;color:rgba(205,218,242,.72);line-height:1.5;}
.rev-close__d a{color:#d98ad9;text-decoration:underline;}
.rev-close__btns{display:flex;gap:10px;flex-wrap:wrap;}
.rev-close__btn{display:inline-flex;align-items:center;gap:8px;padding:.75rem 1.4rem;border-radius:11px;font-weight:700;font-size:.88rem;text-decoration:none;white-space:nowrap;transition:filter .2s;}
.rev-close__btn--buy{background:linear-gradient(135deg,#BF40BF,#7C3AED);color:#fff;box-shadow:0 8px 24px -10px rgba(191,64,191,.8);}
.rev-close__btn--buy:hover{filter:brightness(1.12);}
.rev-close__btn--dc{border:1px solid rgba(200,215,240,.22);color:rgba(220,230,250,.9);}
.rev-close__btn--dc:hover{border-color:rgba(200,215,240,.45);}

/* ═══ RESPONSIVE ═══ */
@media(max-width:900px){
  .rev-panel{flex-direction:column;width:100%;max-width:440px;}
  .rev-panel-div{width:100%;height:1px;}
  .rev-tiles{flex-direction:row;justify-content:space-around;padding:20px 24px;}
  .rev-tile{flex:1;padding:0 8px;}
  .rev-tile+.rev-tile{border-top:none;border-left:1px solid rgba(255,255,255,.06);}
  .rev-bars{min-width:0;}
}
@media(max-width:560px){
  .rev-wrap{padding:62px 16px 80px;}
  .rev-h1{font-size:clamp(2.3rem,11vw,3rem);}
  .rev-score-num{font-size:2.5rem;}
  .rev-tools{flex-direction:column;align-items:stretch;}
  .rev-fresh{text-align:center;}
  .rev-auto-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));}
  .rev-trust{flex-direction:column;}
  .rev-trust-sep{width:100%;height:1px;}
  .rev-close{flex-direction:column;align-items:stretch;text-align:center;}
  .rev-close__btns{flex-direction:column;}
  .rev-close__btn{justify-content:center;}
}
@media(prefers-reduced-motion:reduce){
  .rc,.rev-blob,.rev-pulse{animation:none!important;}
  .rc,.rev-bf,.rev-ring-fg{transition:none!important;}
}
</style>

