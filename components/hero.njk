  function drawAtmosphere() {
    ctx.fillStyle = '#0a0c18';
    ctx.fillRect(0, 0, W, H);

    var isMobile = W < 640;
    var cx = W * 0.5;

    var vig = ctx.createRadialGradient(cx, H * 0.38, 0, cx, H * 0.5, W * 0.7);
    vig.addColorStop(0, 'rgba(10, 12, 24, 0.6)');
    vig.addColorStop(0.5, 'rgba(6, 7, 15, 0.42)');
    vig.addColorStop(1, 'rgba(6, 7, 15, 0)');
    ctx.fillStyle = vig;
    ctx.fillRect(0, 0, W, H);

    var glowRadius = isMobile ? W * 0.95 : W * 0.58;
    var coreRadius = isMobile ? W * 0.38 : W * 0.18;
    var g = isMobile ? 1.6 : 1;

    var topGlow = ctx.createRadialGradient(cx, 0, 0, cx, 0, glowRadius);
    topGlow.addColorStop(0, 'rgba(191, 64, 191, ' + 0.2 * g + ')');
    topGlow.addColorStop(0.14, 'rgba(191, 64, 191, ' + 0.13 * g + ')');
    topGlow.addColorStop(0.32, 'rgba(191, 64, 191, ' + 0.07 * g + ')');
    topGlow.addColorStop(0.58, 'rgba(191, 64, 191, ' + 0.025 * g + ')');
    topGlow.addColorStop(1, 'rgba(191, 64, 191, 0)');
    ctx.fillStyle = topGlow;
    ctx.fillRect(cx - glowRadius, 0, glowRadius * 2, glowRadius);

    var core = ctx.createRadialGradient(cx, 0, 0, cx, 0, coreRadius);
    core.addColorStop(0, 'rgba(230, 170, 255, ' + 0.5 * g + ')');
    core.addColorStop(0.22, 'rgba(230, 170, 255, ' + 0.28 * g + ')');
    core.addColorStop(0.5, 'rgba(191, 64, 191, ' + 0.12 * g + ')');
    core.addColorStop(1, 'rgba(191, 64, 191, 0)');
    ctx.fillStyle = core;
    ctx.fillRect(cx - coreRadius, 0, coreRadius * 2, coreRadius);
  }

  function drawBottomFade() {
    var bv = ctx.createLinearGradient(0, H * 0.35, 0, H);
    bv.addColorStop(0, 'rgba(6, 7, 15, 0)');
    bv.addColorStop(0.4, 'rgba(6, 7, 15, 0.45)');
    bv.addColorStop(0.7, 'rgba(6, 7, 15, 0.82)');
    bv.addColorStop(0.88, 'rgba(6, 7, 15, 0.97)');
    bv.addColorStop(1, 'rgba(6, 7, 15, 1)');
    ctx.fillStyle = bv;
    ctx.fillRect(0, H * 0.35, W, H * 0.65);
    ctx.fillStyle = '#0a0c18';
    ctx.fillRect(0, H - 2, W, 2);
  }

  function stepTargets() {
    for (var i = 0; i < targets.length; i++) {
      var t = targets[i];
      t.x += t.vx;
      t.y += t.vy;
      /* bounce softly inside a loose zone so nothing parks over the copy */
      if (t.x < W * 0.02 || t.x + t.w > W * 0.98) t.vx *= -1;
      if (t.y < H * 0.08 || t.y + t.h > H * 0.72) t.vy *= -1;
