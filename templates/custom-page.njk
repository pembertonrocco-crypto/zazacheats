.dl-fine{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.74rem;color:rgba(231,236,255,.5);margin:14px 0 0}

.dl-list{margin:0;padding-left:0;list-style:none;counter-reset:dl}
.dl-list li{position:relative;padding:10px 0 10px 38px;color:var(--mut);font-size:.94rem;line-height:1.55;
