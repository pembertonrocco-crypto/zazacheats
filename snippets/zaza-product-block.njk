<script>
(function(){
  var blocks = document.querySelectorAll('.zz > section, .zz-hero');
  if(!blocks.length) return;
  // respect reduced motion
  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  blocks.forEach(function(el, i){
    el.classList.add('zz-reveal');
    el.style.transitionDelay = Math.min(i * 60, 240) + 'ms';
  });

  if(!('IntersectionObserver' in window)){
    blocks.forEach(function(el){ el.classList.add('zz-in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('zz-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  blocks.forEach(function(el){ io.observe(el); });
})();
</script>

