  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;user-select:none}

/* --- sidebar --- */
.zed__side{width:118px;flex-shrink:0;background:#0a0710;border-right:1px solid rgba(233,30,233,.14);
  display:flex;flex-direction:column;padding-bottom:10px}
.zed__side-logo{position:relative;padding:14px 12px 16px;border-bottom:1px solid rgba(233,30,233,.14);margin-bottom:8px}
.zed__side-bolt{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:7px;
  background:linear-gradient(135deg,#e91ee9,#a21caf);color:#fff;font-size:.8rem;margin-bottom:7px;
  box-shadow:0 0 14px rgba(233,30,233,.6)}
.zed__side-name{display:block;font-size:.72rem;font-weight:700;letter-spacing:.06em;line-height:1.25;color:#fff}
.zed__side-ver{display:block;margin-top:4px;font-size:.46rem;letter-spacing:.1em;color:rgba(233,150,233,.45)}
.zed__side-item{display:flex;align-items:center;gap:9px;padding:11px 12px;font-size:.6rem;font-weight:700;
  letter-spacing:.1em;color:rgba(205,190,215,.5);border-left:2px solid transparent;cursor:default;
  transition:color .15s,background .15s}
.zed__side-item svg{flex-shrink:0;opacity:.75}
.zed__side-item:hover{color:rgba(230,215,240,.85);background:rgba(233,30,233,.05)}
.zed__side-item--active{color:#fff;background:rgba(233,30,233,.12);border-left-color:#e91ee9}
.zed__side-item--active svg{color:#e91ee9;opacity:1}
.zed__side-foot{margin-top:auto;padding:10px 12px 4px}
.zed__side-bolt--sm{width:22px;height:22px;font-size:.68rem;margin:0}

/* --- main column --- */
.zed__main{flex:1;min-width:0;display:flex;flex-direction:column}
.zed__topline{height:3px;background:linear-gradient(90deg,#e91ee9,#a855f7);
  box-shadow:0 0 14px rgba(233,30,233,.7)}
.zed__topbar{display:flex;align-items:center;gap:16px;padding:10px 14px;
  border-bottom:1px solid rgba(233,30,233,.12);font-size:.62rem}
.zed__topbar-seg{display:inline-flex;align-items:center;gap:6px;color:rgba(210,195,220,.6)}
.zed__topbar-seg svg{color:#e91ee9}
.zed__topbar-dim{color:rgba(200,180,210,.4)}
.zed__topbar-hot{color:#f068f0}
.zed__search{margin-left:auto;display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:7px;
