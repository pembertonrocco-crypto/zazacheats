{# =========================================================================
   TITLE MARQUEE — big outlined scrolling text divider ("ZAZA ▸ RUST ▸
   PRIVATE") in the style of echoed hero-title marquees. Pure CSS animation,
   duplicated track for a seamless loop. Static HTML only.
   ========================================================================= #}
<div class="zmq" aria-hidden="true">
  <div class="zmq__track">
    <span class="zmq__seg">ZAZA <i>▸</i> RUST <i>▸</i> PRIVATE <i>▸</i> UNDETECTED <i>▸</i>&nbsp;</span><span class="zmq__seg">ZAZA <i>▸</i> RUST <i>▸</i> PRIVATE <i>▸</i> UNDETECTED <i>▸</i>&nbsp;</span>
  </div>
</div>

<style>
.zmq{overflow:hidden;padding:34px 0;position:relative;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.zmq__track{display:flex;width:max-content;animation:zmqScroll 30s linear infinite}
.zmq__seg{flex-shrink:0;white-space:nowrap;
  font-family:var(--zz-sans);
  font-size:clamp(3rem,8vw,6rem);font-weight:900;letter-spacing:.02em;line-height:1;
  color:transparent;-webkit-text-stroke:1.5px rgba(191,64,191,.34);
  text-transform:uppercase}
.zmq__seg i{font-style:normal;-webkit-text-stroke:0;color:rgba(191,64,191,.55);
  font-size:.5em;vertical-align:.22em;padding:0 .25em}
@keyframes zmqScroll{to{transform:translateX(-50%)}}
.zmq:hover .zmq__track{animation-play-state:paused}
@media (prefers-reduced-motion: reduce){ .zmq__track{animation:none} }
</style>
