<script>
/* Live FPS counter for the HUD watermark — a REAL measurement of this
   browser's render loop, not a fabricated number. */
(function(){
  var el = document.getElementById('hero-hud-fps');
  if(!el) return;
  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){ el.textContent='60'; return; }
  var frames = 0, last = performance.now();
  function loop(now){
    frames++;
    if(now - last >= 1000){
      el.textContent = Math.min(999, Math.round(frames * 1000 / (now - last)));
      frames = 0; last = now;
    }
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
