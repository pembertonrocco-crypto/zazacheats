.dl-bg__beam--b{width:30rem;height:30rem;top:-6rem;right:-9rem;background:radial-gradient(circle,rgba(191,64,191,.4),transparent 65%);animation-delay:-8s}

.dl-wrap{position:relative;z-index:1;max-width:760px;margin:0 auto;padding:130px 20px 90px}
.dl-rise{opacity:0;transform:translateY(20px);animation:dlRise .8s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d,0s)}
