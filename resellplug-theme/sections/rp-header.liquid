{%- comment -%}
  Header.

  Dawn's own header section was switched off on this store, which left the
  site with no way to reach the cart, no way back to the homepage from a
  product page, and no persistent join button. This is a slim replacement:
  brand, a few in-page links, the join button, and a working cart icon.

  The cart anchor keeps Dawn's id="cart-icon-bubble" and its inner markup,
  because cart-drawer.js binds the drawer open to that id and replaces the
  contents of that element with the rendered cart-icon-bubble section after
  every add to cart. Rename either and the count silently stops updating.
{%- endcomment -%}

{{ 'rp.css' | asset_url | stylesheet_tag }}

<style>
  /* Dawn paints the count bubble for a light header; restate it for this one. */
  .rp-header .cart-count-bubble {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--rp-accent);
    color: var(--rp-accent-ink);
    font-family: var(--rp-font);
    font-size: 11px;
    font-weight: 800;
    display: grid;
    place-items: center;
    line-height: 1;
  }

  .rp-header .svg-wrapper svg {
    width: 22px;
    height: 22px;
  }
</style>

<header class="rp-header">
  <div class="rp-header__bar">
    <a class="rp-header__brand" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- comment -%}
          A filter cannot be applied to a filter argument, so the two derived
          strings are built first.
        {%- endcomment -%}
        {%- liquid
          assign logo_px = section.settings.logo_width | append: 'px'
          assign logo_style = 'width:' | append: logo_px
        -%}
        {{
          section.settings.logo
          | image_url: width: 300
          | image_tag: loading: 'eager', widths: '90, 180, 300', sizes: logo_px, style: logo_style, alt: shop.name
        }}
      {%- else -%}
        <span>{{ section.settings.brand_text | default: shop.name | escape }}</span>
      {%- endif -%}
    </a>

    {%- comment -%}
      current_page marks the link for the page you are on. Knowing where you
      are is the cheapest orientation cue there is, and without it a five-item
      nav on a five-page site gives you nothing back.

      The home link is matched on an exact '/' because every other path also
      starts with one.
    {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="rp-header__nav" aria-label="Main">
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.link | default: '/'
            assign current = false
            if href == '/' or href == routes.root_url
              if request.page_type == 'index'
                assign current = true
              endif
            elsif request.path contains href
              assign current = true
            endif
          -%}
          <a
            href="{{ href }}"
            {% if current %}aria-current="page"{% endif %}
            {{ block.shopify_attributes }}
          >{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.show_cta -%}
      {% render 'rp-primary-button', link: section.settings.cta_link, label: section.settings.cta_label, icon: 'cart', source: 'header' %}
    {%- endif -%}

    {%- comment -%}
      The menu button only exists under 990px, where the inline nav is hidden.
      Before this the site had no navigation at all on a phone — every page
      but the homepage was reachable only from the footer, on the device
      nearly all the traffic arrives on.
    {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <button
        type="button"
        class="rp-header__menu"
        aria-expanded="false"
        aria-controls="rp-drawer"
        aria-label="Menu"
        data-rp-menu-open
      >
        <span class="rp-header__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    {%- endif -%}

    {%- if section.settings.show_cart -%}
      <a class="rp-header__cart" id="cart-icon-bubble" href="{{ routes.cart_url }}">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</header>

{%- if section.blocks.size > 0 -%}
  <div class="rp-drawer" id="rp-drawer" data-rp-drawer hidden>
    <div class="rp-drawer__scrim" data-rp-menu-close></div>

    <div class="rp-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="rp-drawer__top">
        <span class="rp-label">Menu</span>
        <button type="button" class="rp-drawer__close" data-rp-menu-close aria-label="Close menu">&times;</button>
      </div>

      <nav class="rp-drawer__nav" aria-label="Main">
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.link | default: '/'
            assign current = false
            if href == '/' or href == routes.root_url
              if request.page_type == 'index'
                assign current = true
              endif
            elsif request.path contains href
              assign current = true
            endif
          -%}
          <a href="{{ href }}" {% if current %}aria-current="page"{% endif %}>
            <span>{{ block.settings.label | escape }}</span>
            {% render 'rp-icon', icon: 'arrow', size: 16 %}
          </a>
        {%- endfor -%}
      </nav>

      <div class="rp-drawer__foot">
        {% render 'rp-primary-button',
          link: section.settings.cta_link,
          label: section.settings.cta_label,
          icon: 'cart',
          block: true,
          source: 'drawer'
        %}

        {%- if settings.rp_vouches_url != blank -%}
          <a class="rp-btn rp-btn--ghost rp-btn--block" href="{{ settings.rp_vouches_url }}"
             target="_blank" rel="noopener" data-rp-cta="drawer-vouches">
            {% render 'rp-icon', icon: 'star', size: 18 %}
            <span>Read the vouches</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%}
  Organization and WebSite structured data.

  Both used to live in Dawn's header.liquid, which is disabled on this store —
  so neither had been reaching Google. They belong on whichever section is
  actually rendering the site header, which is now this one.

  Dawn's version printed every social setting into sameAs whether it was set
  or not, so an untouched store published an array of nulls. This one only
  lists links that exist, and includes the community and vouches channels:
  they are where the brand actually lives, more than any of the stock social
  fields.
{%- endcomment -%}

{%- liquid
  # Liquid has no array literal, so the candidates are joined into one string
  # and split back out. Blank settings collapse to empty entries and are
  # dropped, then the whole array goes through | json — building the JSON by
  # hand with comma bookkeeping is where trailing-comma bugs come from.
  assign candidates = settings.rp_tiktok_url | append: ',' | append: settings.rp_group_url | append: ',' | append: settings.rp_vouches_url | append: ',' | append: settings.social_tiktok_link | append: ',' | append: settings.social_instagram_link | append: ',' | append: settings.social_youtube_link | append: ',' | append: settings.social_twitter_link | append: ',' | append: settings.social_facebook_link

  assign candidate_list = candidates | split: ','
  assign kept = ''
  for link in candidate_list
    assign trimmed = link | strip
    if trimmed != blank
      assign kept = kept | append: ',' | append: trimmed
    endif
  endfor
  assign same_as = kept | remove_first: ',' | split: ','
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": {{ same_as | json }},
    "url": {{ request.origin | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "RP · Header",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Wordmark",
      "info": "Used when no logo is set. Defaults to the store name."
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show join button",
      "default": true
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Header button link",
      "info": "Blank falls back to the free community link."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Join button text",
      "default": "Shop"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RP · Header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Free group",
            "link": "/#free"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Suppliers",
            "link": "/#suppliers"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Proof",
            "link": "/#proof"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "FAQ",
            "link": "/#faq"
          }
        }
      ]
    }
  ]
}
{% endschema %}
