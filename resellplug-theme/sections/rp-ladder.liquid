{%- comment -%}
  Free tier vs private community.

  Putting the two side by side is what makes the paid tier sellable without
  hiding the free one. The free column is deliberately generous and its
  button is the primary style: someone who only ever joins the free group is
  a win, because the group is where the paid tier actually gets sold.

  The price and the buy button come from a real product so there is a single
  source of truth for price, stock and checkout.
{%- endcomment -%}

{{ 'rp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign paid = section.settings.product
  assign variant = paid.selected_or_first_available_variant

  # Nested rather than "A and B": Liquid evaluates and/or right-to-left, so a
  # same-line blank guard would still hand nil to the ">". Plain
  # truthiness, not "!= blank", which is not portable against nil.
  assign on_sale = false
  if variant.compare_at_price
    if variant.compare_at_price > variant.price
      assign on_sale = true
    endif
  endif
-%}

<div class="rp-section rp-section--{{ section.settings.tone | default: 'flat' }}" id="{{ section.settings.anchor | default: 'join' | handle }}">
  <div class="rp-wrap rp-wrap--narrow">
    <div class="rp-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="rp-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rp-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="rp-ladder">
      {%- comment -%} Free tier {%- endcomment -%}
      <div class="rp-tier">
        <p class="rp-tier__tag">{{ section.settings.free_tag | escape }}</p>
        <h3 class="rp-h3">{{ section.settings.free_title | escape }}</h3>
        <p class="rp-tier__price">
          {{ section.settings.free_price | escape }}
          <small>{{ section.settings.free_price_note | escape }}</small>
        </p>

        <ul class="rp-tier__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'free_item' -%}
              <li data-state="{% if block.settings.included %}yes{% else %}no{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.included %}
                  {% render 'rp-icon', icon: 'check', size: 16 %}
                {% else %}
                  {% render 'rp-icon', icon: 'cross', size: 16 %}
                {% endif %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {% render 'rp-group-button', block: true, source: 'ladder' %}
      </div>

      {%- comment -%} Paid tier {%- endcomment -%}
      <div class="rp-tier rp-tier--paid">
        <p class="rp-tier__tag">{{ section.settings.paid_tag | escape }}</p>
        <h3 class="rp-h3">
          {{ section.settings.paid_title | default: paid.title | escape }}
        </h3>

        <p class="rp-tier__price">
          {%- if paid != blank -%}
            {{ variant.price | money }}
            <small>
              {%- if on_sale -%}
                was {{ variant.compare_at_price | money }} ·
              {%- endif -%}
              {{ section.settings.paid_price_note | escape }}
            </small>
          {%- else -%}
            —
            <small>Pick a product in the theme editor</small>
          {%- endif -%}
        </p>

        <ul class="rp-tier__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'paid_item' -%}
              <li data-state="yes" {{ block.shopify_attributes }}>
                {% render 'rp-icon', icon: 'check', size: 16 %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if paid != blank and variant != blank -%}
          {%- form 'product', paid, id: 'rp-ladder-form', class: 'rp-tier__form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <button
              type="submit"
              class="rp-btn rp-btn--primary rp-btn--block"
              {% unless variant.available %}disabled{% endunless %}
            >
              {%- if variant.available -%}
                {% render 'rp-icon', icon: 'lock', size: 18 %}
                <span>{{ section.settings.paid_cta | escape }}</span>
              {%- else -%}
                <span>Sold out</span>
              {%- endif -%}
            </button>
          {%- endform -%}
          <p class="rp-reassure" style="margin-top:12px">
            <span>{% render 'rp-icon', icon: 'bolt', size: 14 %}{{ section.settings.paid_reassure | escape }}</span>
          </p>
        {%- else -%}
          <p class="rp-body">Choose the private community product in the theme editor to show its price and buy button here.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

