{%- comment -%}
  Photo beside text.

  The workhorse visual block: one photograph, one point, one button. Stack
  two or three down a page with the image side alternating and the page
  stops being a wall of cards.

  On a phone the image always comes first regardless of which side it sits
  on at desktop width. The photo is the hook; leading with the paragraph
  wastes it.

  With no image it degrades to a centred text block rather than leaving a
  gap, so an unfinished section never looks broken to a customer.
{%- endcomment -%}

{{ 'rp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign layout = 'rp-split'
  if has_image
    if section.settings.image_side == 'right'
      assign layout = 'rp-split rp-split--flip'
    endif
  else
    assign layout = 'rp-split rp-split--solo'
  endif
-%}

<div class="rp-section rp-section--{{ section.settings.tone | default: 'flat' }}" id="{{ section.settings.anchor | default: 'about' | handle }}">
  <div class="rp-wrap">
    <div class="{{ layout }}">
      {%- if has_image -%}
        <div class="rp-split__media rp-split__media--{{ section.settings.ratio | default: 'portrait' }}">
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 990px) 45vw, 92vw',
              alt: section.settings.alt | default: section.settings.heading
          }}
          {%- if section.settings.badge != blank -%}
            <span class="rp-split__badge">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="rp-split__media rp-split__media--empty">
          <span>Add a photo — this block is built around one</span>
        </div>
      {%- endif -%}

      <div class="rp-split__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="rp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="rp-h2">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.text != blank -%}
          <div class="rp-split__text rp-rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="rp-tier__list">
            {%- for block in section.blocks -%}
              <li data-state="yes" {{ block.shopify_attributes }}>
                {% render 'rp-icon', icon: 'check', size: 16 %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="rp-actions">
            {% render 'rp-primary-button',
              link: section.settings.cta_link,
              label: section.settings.cta_label,
              source: 'split'
            %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RP · Photo + text",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "One photo, one point, one button. Add two or three of these down the page and alternate the image side."
    },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side on desktop",
      "default": "left",
      "info": "On a phone the photo is always first — it is the hook.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Photo shape",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    },
    { "type": "text", "id": "badge", "label": "Badge on the photo" },
    { "type": "text", "id": "alt", "label": "Image description" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading goes here" },
    { "type": "richtext", "id": "text", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button text" },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Blank falls back to the free community link."
    },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "default": "flat",
      "options": [
        { "value": "flat", "label": "Black" },
        { "value": "raised", "label": "Raised" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Tick point",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [{ "name": "RP · Photo + text" }]
}
{% endschema %}
