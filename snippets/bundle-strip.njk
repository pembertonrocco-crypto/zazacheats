{# =========================================================================
   v64: BUNDLE-STRIP — homepage banner for the free NFA bundles.
   Rendered right under the products grid. Links to the cheat product page,
   anchored at #zz-bundles. Static HTML, self-contained styles, no vars.
   ========================================================================= #}
<section class="zzbs" aria-labelledby="zzbs-title">
  <a class="zzbs__inner" href="/product/zaza-rust-private-cheat#zz-bundles">
    <div class="zzbs__glow" aria-hidden="true"></div>

    <div class="zzbs__left">
      <p class="zzbs__eyebrow"><span class="zzbs__dot"></span>FREE WITH BIGGER KEYS<span class="zzbs__ends" data-zzbs-ends="" hidden></span></p>
      <h2 id="zzbs-title" class="zzbs__title">Buy a key. <span class="zzbs__accent">Get accounts to burn.</span></h2>
      <p class="zzbs__sub">Month and Lifetime keys ship with free NFA accounts on top — so you're never cheating on your main.</p>
    </div>

    <div class="zzbs__bundles">
      <div class="zzbs__b">
        <span class="zzbs__b-key">MONTH KEY</span>
        <span class="zzbs__b-what"><strong>2× NFA</strong> · 500–1000 hrs · 3 replacements each</span>
      </div>
      <div class="zzbs__b zzbs__b--top">
        <span class="zzbs__b-key">LIFETIME KEY</span>
        <span class="zzbs__b-what"><strong>5× NFA</strong> · incl. 2× top-tier 1000+ hrs</span>
      </div>
    </div>

    <span class="zzbs__cta">Claim yours →</span>
  </a>
</section>

<style>
.zzbs{padding:0 20px;margin:34px auto;max-width:1200px}
.zzbs__inner{position:relative;display:grid;grid-template-columns:1.2fr 1fr auto;align-items:center;gap:22px;padding:24px 26px;border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;border:1px solid rgba(var(--cl-accent-rgb,191,64,191),.35);background:linear-gradient(120deg,rgba(10,12,24,.92),rgba(10,12,24,.92));transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
.zzbs__inner:hover{border-color:rgba(var(--cl-accent-rgb,191,64,191),.7);transform:translateY(-2px);box-shadow:0 18px 50px -20px rgba(var(--cl-accent-rgb,191,64,191),.55)}
.zzbs__glow{position:absolute;inset:-40%;background:radial-gradient(circle at 15% 20%,rgba(var(--cl-accent-rgb,191,64,191),.22),transparent 45%),radial-gradient(circle at 90% 85%,rgba(34,197,94,.12),transparent 40%);pointer-events:none}
.zzbs__inner::after{content:'';position:absolute;top:0;left:-60%;width:45%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.055),transparent);transform:skewX(-18deg);pointer-events:none}
.zzbs__eyebrow{display:flex;align-items:center;gap:8px;margin:0 0 8px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.64rem;letter-spacing:.16em;color:#4ade80}
.zzbs__dot{width:6px;height:6px;border-radius:50%;background:#4ade80;box-shadow:0 0 10px #4ade80;animation:zzbs-pulse 2.2s ease-in-out infinite}
@keyframes zzbs-pulse{0%,100%{opacity:1}50%{opacity:.35}}
.zzbs__title{margin:0 0 6px;font-size:clamp(1.2rem,2.4vw,1.7rem);font-weight:700;color:#fff;letter-spacing:-.01em}
.zzbs__accent{color:var(--cl-accent,#BF40BF)}
.zzbs__sub{margin:0;font-size:.82rem;line-height:1.5;color:rgba(231,236,255,.65);max-width:40ch}
.zzbs__bundles{display:flex;flex-direction:column;gap:8px;position:relative}
.zzbs__b{display:flex;flex-direction:column;gap:2px;padding:10px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.03)}
.zzbs__b--top{border-color:rgba(var(--cl-accent-rgb,191,64,191),.5);background:rgba(var(--cl-accent-rgb,191,64,191),.08)}
.zzbs__b-key{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.6rem;letter-spacing:.12em;color:rgba(231,236,255,.6)}
.zzbs__b-what{font-size:.8rem;color:rgba(231,236,255,.9)}
.zzbs__b-what strong{color:#4ade80}
.zzbs__b--top .zzbs__b-what strong{color:var(--cl-accent,#BF40BF)}
.zzbs__cta{position:relative;font-weight:700;font-size:.9rem;color:#fff;padding:12px 20px;border-radius:10px;background:linear-gradient(135deg,var(--cl-accent,#BF40BF),#8e2d8e);box-shadow:0 8px 26px -10px rgba(var(--cl-accent-rgb,191,64,191),.8);white-space:nowrap}
@media (max-width:900px){.zzbs__inner{grid-template-columns:1fr;gap:16px}.zzbs__cta{justify-self:start}}
.zzbs__ends{margin-left:10px;font-size:.56rem;letter-spacing:.12em;font-weight:700;padding:3px 8px;border-radius:99px;border:1px solid rgba(251,191,36,.5);background:rgba(251,191,36,.12);color:#fde047}
@media (prefers-reduced-motion:reduce){.zzbs__inner::after,.zzbs__dot{animation:none}}
</style>
<script>
/* Same honest-deadline rule as the product page: real date or no badge. */
(function(){
  var el=document.querySelector('[data-zzbs-ends]');
  if(!el) return;
  var raw=(el.getAttribute('data-zzbs-ends')||'').trim();
  if(!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return;
  var end=new Date(raw+'T23:59:59');
  if(isNaN(end)||end<new Date()) return;
  var m=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  el.textContent='ENDS '+end.getDate()+' '+m[end.getMonth()];
  el.hidden=false;
})();
</script>
