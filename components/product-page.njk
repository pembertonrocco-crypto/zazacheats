<script>
  (function () {
    function initCarousel() {
      var carouselEl = document.getElementById('productImageCarousel');
      if (!carouselEl || typeof bootstrap === 'undefined') {
        setTimeout(initCarousel, 100);
        return;
      }

      var carousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, { ride: false, interval: false });

      document.querySelectorAll('.pp-thumb').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var index = parseInt(btn.getAttribute('data-index'), 10);
          carousel.to(index);
          document.querySelectorAll('.pp-thumb').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
        });
      });

      carouselEl.addEventListener('slid.bs.carousel', function (e) {
        document.querySelectorAll('.pp-thumb').forEach(function (b) { b.classList.remove('active'); });
        var active = document.querySelector('.pp-thumb[data-index="' + e.to + '"]');
        if (active) active.classList.add('active');
      });
    }

    document.addEventListener('DOMContentLoaded', initCarousel);
  })();
</script>
