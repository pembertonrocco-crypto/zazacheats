@keyframes zsFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(28px)}}

.zs-wrap{position:relative;z-index:1;max-width:780px;margin:0 auto;padding:130px 20px 90px}

/* entrance */
.zs-rise{opacity:0;transform:translateY(22px);animation:zsRise .85s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d,0s)}
