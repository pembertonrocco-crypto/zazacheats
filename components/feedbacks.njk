<script>
(function () {
  var section = document.querySelector('[data-component-id="{{ componentId }}"]');
  if (!section) return;

  /* AUTO REVIEW STATS
     Row 2 repeats row 1's reviews for the counter-scroll, so only row 1
     is measured. Each card encodes its rating as filled star icons, so
     the count AND the average come straight from the real cards --
     no network fetch, nothing hardcoded. Runs before cloning. */

  function zzStars(a){
    var pctFull=Math.max(0,Math.min(100,(a/5)*100));
    document.querySelectorAll('[data-zz-rstars]').forEach(function(el){
      if(!el.dataset.zzInit){
        el.dataset.zzInit='1';
        el.style.position='relative';
        el.style.display='inline-block';
        el.style.whiteSpace='nowrap';
        var base=document.createElement('span');
        base.textContent='\u2605\u2605\u2605\u2605\u2605';
        base.style.opacity='0.22';
        var fill=document.createElement('span');
        fill.className='zz-star-fill';
        fill.textContent='\u2605\u2605\u2605\u2605\u2605';
        fill.style.cssText='position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:inherit';
        el.textContent='';
        el.appendChild(base);
        el.appendChild(fill);
      }
      var f=el.querySelector('.zz-star-fill');
      if(f)f.style.width=pctFull+'%';
    });
    document.querySelectorAll('[data-zz-rstars-svg]').forEach(function(el){
      var stars=el.querySelectorAll('svg');
      var exact=(a/5)*stars.length;
      for(var i=0;i<stars.length;i++){
        var fillAmt=Math.max(0,Math.min(1,exact-i));
        stars[i].style.opacity=(0.22+0.78*fillAmt).toFixed(3);
      }
    });
  }

  (function(){
    var firstRow=section.querySelector('.fbq__row');
    if(!firstRow)return;
    var cards=firstRow.querySelectorAll('.fbq__item .fc');
    var total=0,sum=0;
    cards.forEach(function(c){
      var f=c.querySelectorAll('.fc__star--filled').length;
      if(f<1||f>5)return;
      total++;sum+=f;
    });
    if(!total)return;
    var avg=sum/total;
    /* NOTE: this marquee shows only a slice of reviews, so it must NOT write the
       sitewide review TOTAL or the zzRev cache — that would undercount every
       [data-zz-rc] on the page. The real total comes from the zz-review-total
       meta tag via polish.njk. We only render this row's aggregate stars. */
    section.querySelectorAll('[data-zz-ravg]').forEach(function(el){el.textContent=avg.toFixed(2);});
    zzStars(avg);
  })();

  /* Marquee: transform-only keyframes, cloned to fill 3x viewport.
     Runs only while on-screen (IntersectionObserver) and never under
     prefers-reduced-motion. Hover-pause is delegated to the track
     (2 listeners per row instead of one per card). */
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var rows = section.querySelectorAll('.fbq__row');
  var CARD_W = 300;
  var GAP = 14;
  var SPEED_PX_PER_SEC = 40;
  var tracks = [];

  rows.forEach(function (row, rowIndex) {
    var track = row.querySelector('.fbq__track');
    var items = track.querySelectorAll('.fbq__item');
    if (!items.length) return;

    // offsetWidth can read 0 if the section is measured before styles/layout
    // settle; fall back to the viewport and always clone at least one full
    // set so the loop is seamless (a 0-clone track shows a screen-wide gap).
    var viewW = section.offsetWidth || window.innerWidth || 1280;
    var originalW = items.length * (CARD_W + GAP);
    var clonesNeeded = Math.max(1, Math.ceil((viewW * 3) / originalW));

    for (var c = 0; c < clonesNeeded; c++) {
      items.forEach(function (item) {
        var clone = item.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });
    }

    if (reduceMotion) return; // cards stay visible, just static

    var direction = row.getAttribute('data-direction');
    var duration = originalW / SPEED_PX_PER_SEC;
    var animName = 'fbq-anim-' + rowIndex;

    var styleEl = document.createElement('style');
    if (direction === 'rtl') {
      styleEl.textContent = [
        '@keyframes ' + animName + ' {',
        '  0%   { transform: translateX(-' + originalW + 'px); }',
        '  100% { transform: translateX(0); }',
        '}'
      ].join('\n');
    } else {
      styleEl.textContent = [
        '@keyframes ' + animName + ' {',
        '  0%   { transform: translateX(0); }',
        '  100% { transform: translateX(-' + originalW + 'px); }',
        '}'
      ].join('\n');
    }
    document.head.appendChild(styleEl);
    track.style.animation = animName + ' ' + duration + 's linear infinite';
    tracks.push(track);

    track.addEventListener('mouseenter', function () {
      track.dataset.hover = '1';
      track.style.animationPlayState = 'paused';
    });
    track.addEventListener('mouseleave', function () {
      delete track.dataset.hover;
      if (track.dataset.visible !== '0') track.style.animationPlayState = 'running';
    });
  });

  if (tracks.length && 'IntersectionObserver' in window) {
    var vio = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var track = en.target;
        track.dataset.visible = en.isIntersecting ? '1' : '0';
        track.style.animationPlayState =
          (en.isIntersecting && !track.dataset.hover) ? 'running' : 'paused';
      });
    }, { rootMargin: '80px 0px' });
    tracks.forEach(function (t) { vio.observe(t); });
  }
})();
</script>

