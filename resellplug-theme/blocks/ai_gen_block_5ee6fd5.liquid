{% doc %}
  @prompt
    I need a cart button for users to checkout, have it just below the announcement bar
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-button-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-cart-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-cart-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-cart-button-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-cart-button-count-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    background-color: {{ block.settings.count_bg_color }};
    color: {{ block.settings.count_text_color }};
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-cart-button-{{ ai_gen_id }} {
      width: 100%;
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<cart-button-{{ ai_gen_id }}
  class="ai-cart-button-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <a
    href="/cart"
    class="ai-cart-button-{{ ai_gen_id }}"
    aria-label="View cart"
  >
    {% if block.settings.show_icon %}
      <svg
        class="ai-cart-button-icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
    {% endif %}

    <span>{{ block.settings.button_text }}</span>

    {% if block.settings.show_count %}
      <span
        class="ai-cart-button-count-{{ ai_gen_id }}"
        data-cart-count
      >
        {{ cart.item_count }}
      </span>
    {% endif %}
  </a>
</cart-button-{{ ai_gen_id }}>

<script>
  (function() {
    class CartButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cartCount = this.querySelector('[data-cart-count]');
      }

      connectedCallback() {
        this.setupCartListener();
      }

      setupCartListener() {
        if (!this.cartCount) return;

        document.addEventListener('cart:updated', (event) => {
          if (event.detail && typeof event.detail.item_count !== 'undefined') {
            this.cartCount.textContent = event.detail.item_count;
          }
        });

        const observer = new MutationObserver(() => {
          this.updateCartCount();
        });

        const cartIconBubble = document.querySelector('.cart-count-bubble');
        if (cartIconBubble) {
          observer.observe(cartIconBubble, {
            childList: true,
            characterData: true,
            subtree: true
          });
        }
      }

      updateCartCount() {
        fetch('/cart.js')
          .then(response => response.json())
          .then(data => {
            if (this.cartCount) {
              this.cartCount.textContent = data.item_count;
            }
          })
          .catch(error => {
            console.error('Error fetching cart:', error);
          });
      }
    }

    customElements.define('cart-button-{{ ai_gen_id }}', CartButton{{ ai_gen_id }});
  })();
</script>

