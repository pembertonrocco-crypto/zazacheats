<script>
(function(){
  /* After the visitor genuinely plays with the demo (2+ control changes),
     give the CTA a gentle pulse. No counters, no fake urgency. */
  var zed=document.querySelector('.zed'); var next=document.getElementById('zed-next');
  if(!zed||!next) return;
  var n=0;
  zed.addEventListener('change',function(e){
    if(e.target && (e.target.type==='checkbox'||e.target.type==='range'||e.target.type==='radio')){
      if(++n>=2) next.classList.add('zznx--charged');
    }
  },true);
})();
</script>

<style>
.zed{position:relative;padding:90px 24px;font-family:var(--zz-sans)}
.zed__inner{max-width:1360px;margin:0 auto}
.zed__head{text-align:center;margin-bottom:40px}
.zed__eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.68rem;letter-spacing:.16em;color:#e97ae9;margin:0 0 12px}
.zed__title{margin:0 0 12px;font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:700;color:#fff;line-height:1.12}
.zed__grad{background:linear-gradient(90deg,#e91ee9,#8b5cf6);-webkit-background-clip:text;background-clip:text;color:transparent}
.zed__sub{margin:0 auto;font-size:.95rem;line-height:1.6;color:rgba(205,218,242,.68);max-width:56ch}

.zed__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:22px;align-items:start}

/* ================= MENU replica ================= */
