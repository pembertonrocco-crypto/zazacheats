<script>
(function(){
  /* Shared copy handler: buttons carry data-zaf-copy-target = id of an
     element (or <template>) whose text gets copied. Fallback for browsers
     without the async clipboard API. */
  function grab(id){
    var el=document.getElementById(id); if(!el) return '';
    return (el.content ? el.content.textContent : el.textContent).trim();
  }
  function done(btn){
    var label=btn.querySelector('[data-zaf-label]');
    var prev=label?label.textContent:null;
    btn.classList.add('zaf--copied');
    if(label) label.textContent='Copied!';
    setTimeout(function(){
      btn.classList.remove('zaf--copied');
      if(label&&prev) label.textContent=prev;
    },1800);
  }
  document.querySelectorAll('[data-zaf-copy-target]').forEach(function(btn){
    btn.addEventListener('click',function(){
      var txt=grab(btn.getAttribute('data-zaf-copy-target')); if(!txt) return;
      if(navigator.clipboard&&navigator.clipboard.writeText){
        navigator.clipboard.writeText(txt).then(function(){done(btn);},function(){fallback(txt,btn);});
      } else { fallback(txt,btn); }
    });
  });
  function fallback(txt,btn){
    try{
      var ta=document.createElement('textarea');
      ta.value=txt; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta); done(btn);
    }catch(e){}
  }
})();
</script>

<script>
/* Rank ladder. Derives rank from the referral count already rendered by
   SellAuth — no API call, no extra data source. Must stay in sync with
   RANKS/BASE_RATE in the affiliate worker. */
(function(){
  var root=document.querySelector('[data-zrank-root]');
  if(!root) return;

  /* BUYER_DISCOUNT is fixed at every rank — the coupon is always 5% off.
     Only `rate` (what the affiliate earns) moves. Keep in sync with the
     worker's RANKS/BUYER_DISCOUNT. */
  var BUYER_DISCOUNT=5;

  var RANKS=[
    {name:'Bronze',rate:5,min:0},
    {name:'Silver',rate:10,min:3},
    {name:'Gold',rate:15,min:10},
    {name:'Diamond',rate:20,min:25}
  ];

  var count=parseInt((root.getAttribute('data-zrank-count')||'0').replace(/[^0-9]/g,''),10);
  if(isNaN(count)) count=0;

  var idx=0;
  for(var i=0;i<RANKS.length;i++){ if(count>=RANKS[i].min) idx=i; }
  var cur=RANKS[idx];
  var next=RANKS[idx+1]||null;

  // rate readouts
  Array.prototype.forEach.call(document.querySelectorAll('[data-zrank-rate]'),function(el){
    el.textContent=cur.rate;
  });
  var chip=document.querySelector('[data-zrank-name]');
  if(chip){ chip.textContent=cur.name.toUpperCase(); chip.hidden=false; }

  // ladder states
  Array.prototype.forEach.call(root.querySelectorAll('[data-zrank-step]'),function(el){
    var step=parseInt(el.getAttribute('data-zrank-step'),10);
    if(step<=idx) el.classList.add('is-reached');
    if(step===idx) el.classList.add('is-current');
  });

  // progress + next-rank line
  var nextEl=root.querySelector('[data-zrank-next]');
  var fill=root.querySelector('[data-zrank-fill]');
  if(next){
    var span=next.min-cur.min;
    var done=count-cur.min;
    var pct=span>0?Math.max(0,Math.min(100,(done/span)*100)):100;
    if(fill) fill.style.width=pct+'%';
    var need=next.min-count;
    if(nextEl) nextEl.innerHTML=need+' more referral'+(need===1?'':'s')+' to <strong>'+next.name+' &mdash; '+next.rate+'%</strong>';
  }else{
    if(fill) fill.style.width='100%';
    if(nextEl) nextEl.innerHTML='<strong>Top rank reached.</strong> You&rsquo;re on the best rate we do.';
  }
})();
</script>

<script>
/* Affiliate application intake. Progressive enhancement: the form is plain
   HTML; this wires validation, a live link preview, and a fetch to the
   review Worker (endpoint read from data-endpoint). */
(function(){
  var form=document.getElementById('zaf-apply-form');
  if(!form) return;

  var endpoint=form.getAttribute('data-endpoint')||'';
  var email=form.getAttribute('data-email')||'';
  var customerId=form.getAttribute('data-customer-id')||'';

  var codeEl=document.getElementById('zaf-ap-code');
  var previewEl=document.getElementById('zaf-ap-preview-code');
  var discordEl=document.getElementById('zaf-ap-discord');
  var dnameEl=document.getElementById('zaf-ap-dname');
  var audienceEl=document.getElementById('zaf-ap-audience');
  var agreeEl=document.getElementById('zaf-ap-agree');
  var submitEl=document.getElementById('zaf-ap-submit');
  var labelEl=submitEl.querySelector('[data-zaf-ap-label]');
  var msgEl=document.getElementById('zaf-ap-msg');

  var STORE_KEY='zaf_affiliate_applied';

  function cleanCode(v){ return (v||'').toLowerCase().replace(/[^a-z0-9_-]/g,'').slice(0,32); }
  function validCode(){ return codeEl.value.length>=3; }
  function validDiscord(){ return /^\d{17,20}$/.test(discordEl.value.trim()); }

  function refresh(){
    codeEl.value=cleanCode(codeEl.value);
    previewEl.textContent=codeEl.value||'yourcode';
    submitEl.disabled=!(validCode()&&validDiscord()&&agreeEl.checked);
    codeEl.classList.toggle('zaf--invalid',codeEl.value.length>0&&!validCode());
    discordEl.classList.toggle('zaf--invalid',discordEl.value.length>0&&!validDiscord());
  }

  function showMsg(kind,text){
    msgEl.hidden=false;
    msgEl.className='zaf__msg zaf__msg--'+kind;
    msgEl.textContent=text;
  }

  function lockSubmitted(text){
    showMsg('ok',text);
    codeEl.disabled=discordEl.disabled=dnameEl.disabled=audienceEl.disabled=agreeEl.disabled=true;
    submitEl.disabled=true;
    labelEl.textContent='Application sent';
  }

  ['input','change'].forEach(function(ev){
    codeEl.addEventListener(ev,refresh);
    discordEl.addEventListener(ev,refresh);
    agreeEl.addEventListener(ev,refresh);
  });

  // If they already applied on this device, reflect that on load.
  try{
    if(localStorage.getItem(STORE_KEY)==='1'){
      lockSubmitted("You've already applied — we'll DM you on Discord once it's reviewed.");
    }
  }catch(e){}

  form.addEventListener('submit',function(e){
    e.preventDefault();
    if(submitEl.disabled) return;

    if(!endpoint||endpoint.indexOf('REPLACE-WITH')!==-1){
      showMsg('err','Applications are not wired up yet — please ping us on Discord or open a ticket.');
      return;
    }
    if(!customerId){
      showMsg('err','We could not read your account. Please refresh or re-login, then try again.');
      return;
    }

    submitEl.disabled=true;
    labelEl.textContent='Sending…';
    msgEl.hidden=true;

    fetch(endpoint,{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({
        customer_id:customerId,
        email:email,
        code:codeEl.value,
        discord_id:discordEl.value.trim(),
        discord_username:dnameEl.value.trim(),
        audience:audienceEl.value.trim()
      })
    }).then(function(r){
      return r.json().catch(function(){return {};}).then(function(data){return {status:r.status,data:data};});
    }).then(function(res){
      if(res.status>=200&&res.status<300&&res.data.ok){
        try{localStorage.setItem(STORE_KEY,'1');}catch(e){}
        lockSubmitted("Application in! We'll review it and DM you on Discord — usually quickly. Keep those DMs open.");
      }else if(res.status===409){
        try{localStorage.setItem(STORE_KEY,'1');}catch(e){}
        lockSubmitted(res.data.error||"You already have an application in review.");
      }else{
        showMsg('err',res.data.error||'Something went wrong. Please try again in a moment.');
        submitEl.disabled=false;
        labelEl.textContent='Submit application';
      }
    }).catch(function(){
      showMsg('err','Network error. Please try again.');
      submitEl.disabled=false;
      labelEl.textContent='Submit application';
    });
  });

  refresh();
})();
</script>