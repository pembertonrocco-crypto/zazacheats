{
  "name": "zazacheats-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Zaza Cheats SellAuth storefront theme (Nunjucks). Tooling only — the platform renders these templates server-side.",
  "scripts": {
    "check": "node tools/check.js",
    "check:html": "node tools/check.js --html",
    "mobile": "node tools/mobile.js",
    "desktop": "node tools/desktop.js",
    "test": "node tools/check.js && node tools/mobile.js && node tools/desktop.js",
    "fonts": "node tools/fonts.js",
    "bundle": "esbuild assets/script.src.js --minify --target=es2017 --outfile=assets/script.js --log-level=warning"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "alpinejs": "^3.14.3",
    "bootstrap": "^5.3.2",
    "esbuild": "^0.28.1",
    "nunjucks": "^3.2.4",
    "playwright": "^1.62.0"
  }
}
