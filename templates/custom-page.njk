.dl-step--warn{background:rgba(251,191,36,.14);border-color:rgba(251,191,36,.3);color:#fde047}
.dl-muted{color:var(--mut);font-size:.9rem;margin:0}
.dl-mb{margin-bottom:14px}
.dl-p{color:var(--mut);font-size:.94rem;line-height:1.6;margin:0}
.dl-p strong,.dl-muted strong{color:#fff}

.dl-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:12px;
  background:linear-gradient(135deg,var(--v),var(--b));color:#fff;font-weight:700;font-size:1rem;text-decoration:none;
  box-shadow:0 12px 32px -10px rgba(191,64,191,.8);transition:filter .25s,transform .25s,gap .25s}
