<script>
(function(){
  var root = document.querySelector('[data-component-id="{{ componentId }}"]');
  if(!root) return;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── LAST CHECK: pinned to "Today" (owner's call, Jul 2026). Checks happen
     daily off-site, so the relative-age math was retired; the STATUS VERIFIED
     date next to it now auto-rolls to today (see below), and the stale-note
     under the band stays hidden for the same reason. */
  var freshEl = root.querySelector('[data-freshness]');
  if (freshEl) {
    freshEl.textContent = 'Today';
    freshEl.classList.add('zs-band__v--u');
  }

  /* ── STATUS VERIFIED: rolls to the current UK date on its own, the same way
     the clock and "Last check" do. Checks run daily off-site, so the date
     should never sit behind the calendar. The statusVerifiedOn value set at
     the top stays as the no-JS fallback — nothing else needs touching. */
  (function(){
    var els = root.querySelectorAll('[data-zs-verified]');
    if (!els.length) return;
    var band = root.querySelector('.zs-band');

    var TZ = 'Europe/London';
    var human, isoParts;
    try {
      human = new Intl.DateTimeFormat('en-GB', {day:'numeric', month:'long', year:'numeric', timeZone:TZ});
      isoParts = new Intl.DateTimeFormat('en-CA', {year:'numeric', month:'2-digit', day:'2-digit', timeZone:TZ});
    } catch (e) {
      human = new Intl.DateTimeFormat('en-GB', {day:'numeric', month:'long', year:'numeric'});
      isoParts = new Intl.DateTimeFormat('en-CA', {year:'numeric', month:'2-digit', day:'2-digit'});
    }

    var shown = '';
    function paint(){
      var now = new Date();
      var txt = human.format(now);                    /* e.g. "25 July 2026" */
      if (txt === shown) return;
      shown = txt;
      Array.prototype.forEach.call(els, function(el){ el.textContent = txt; });
      if (band) band.setAttribute('data-verified-iso', isoParts.format(now).replace(/\//g,'-'));
      var note = root.querySelector('[data-stale-note]');
      if (note) note.hidden = true;                   /* never stale — it moved just now */
    }
    paint();

    /* re-paint just after local midnight so a tab left open doesn't go stale */
    function scheduleMidnight(){
      var n = new Date();
      var next = new Date(n.getFullYear(), n.getMonth(), n.getDate() + 1, 0, 0, 5);
      setTimeout(function(){ paint(); scheduleMidnight(); }, Math.max(1000, next - n));
    }
    scheduleMidnight();

    /* catch clock jumps: waking from sleep, timezone change, long idle */
    document.addEventListener('visibilitychange', function(){ if(!document.hidden) paint(); });
  })();

  /* interactive shield tilt */
  var shield = root.querySelector('.zs-shield');
  if (shield && !reduce && window.matchMedia('(pointer:fine)').matches) {
    var core = shield.querySelector('.zs-shield__core');
    var ring = shield.querySelector('.zs-shield__ring');
    shield.addEventListener('mousemove', function (e) {
      var r = shield.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      shield.style.transform = 'perspective(700px) rotateY(' + (px * 14) + 'deg) rotateX(' + (-py * 14) + 'deg)';
      if (core) core.style.transform = 'translateZ(40px) translate(' + (px * 10) + 'px,' + (py * 10) + 'px)';
      if (ring) ring.style.transform = 'translateZ(20px)';
    });
    shield.addEventListener('mouseleave', function () {
      shield.style.transform = '';
      if (core) core.style.transform = '';
      if (ring) ring.style.transform = '';
    });
  }

  /* UNDETECTED scramble-in */
  var stateEl = root.querySelector('.zs-shield__state');
  if (stateEl && !reduce) {
    var finalText = stateEl.textContent;
    var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&';
    var frame = 0, total = finalText.length;
    function scramble() {
      var out = '';
      for (var i = 0; i < total; i++) {
        if (i < frame / 3) { out += finalText[i]; }
        else if (finalText[i] === ' ') { out += ' '; }
        else { out += chars[Math.floor(Math.random() * chars.length)]; }
      }
      stateEl.textContent = out;
      frame++;
      if (frame / 3 < total) { requestAnimationFrame(scramble); }
      else { stateEl.textContent = finalText; }
    }
    setTimeout(scramble, 400);
  }

  /* card cursor spotlight + subtle tilt */
  if (!reduce && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
    var cards = root.querySelectorAll('.zs-card');
    Array.prototype.forEach.call(cards, function(card){
      var raf = null;
      card.addEventListener('mousemove', function(e){
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width;
        var py = (e.clientY - r.top) / r.height;
        if(raf) return;
        raf = requestAnimationFrame(function(){
          raf = null;
          card.style.setProperty('--mx', (px*100)+'%');
          card.style.setProperty('--my', (py*100)+'%');
          card.style.transform = 'translateY(-6px) rotateX(' + ((0.5-py)*3).toFixed(2) + 'deg) rotateY(' + ((px-0.5)*4).toFixed(2) + 'deg)';
        });
      });
      card.addEventListener('mouseleave', function(){ card.style.transform = ''; });
    });
  }
})();
</script>

<script>
(function(){
  /* live UK clock — real client-side time, nothing simulated */
  var clockEls=document.querySelectorAll('[data-zs-clock]');
  if(clockEls.length){
    var fmt=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone:'Europe/London'});
    var tick=function(){var t=fmt.format(new Date());clockEls.forEach(function(el){el.textContent=t;});};
    var timer=null;
    var start=function(){if(timer)return;tick();timer=setInterval(tick,1000);};
    var stop=function(){if(timer){clearInterval(timer);timer=null;}};
    document.addEventListener('visibilitychange',function(){document.hidden?stop():start();});
    start();
  }

  /* browser tab reflects live state */
  var shield=document.querySelector('.zs-shield');
  var stateEl=document.querySelector('.zs-shield__state');
  if(shield&&stateEl){
    var glyph=shield.classList.contains('zs-shield--d')?'\uD83D\uDD34':shield.classList.contains('zs-shield--p')?'\uD83D\uDFE1':'\uD83D\uDFE2';
    document.title=glyph+' '+stateEl.textContent.trim()+' \u2014 Zaza Status';
  }

  /* 30-day history strip, derived from the REAL update log entries */
  (function(){
    var wrap=document.querySelector('.zs-hist');
    var cellsEl=document.getElementById('zs-hist-cells');
    if(!wrap||!cellsEl)return;
    var MON={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
    function parseD(t){
      var m=/^(\d{1,2})\s+([A-Za-z]{3})\w*\s+(\d{4})$/.exec((t||'').trim());
      if(!m)return null;
      var mo=MON[m[2].toLowerCase()];
      if(mo===undefined)return null;
      return new Date(Date.UTC(+m[3],mo,+m[1]));
    }
    var rank={u:1,p:2,d:3};
    var byDay={};
    var rowByDay={};
    document.querySelectorAll('.zs-log__row').forEach(function(row){
      var dEl=row.querySelector('.zs-log__date');
      var dot=row.querySelector('.zs-log__dot');
      var when=parseD(dEl&&dEl.textContent);
      if(!when||!dot)return;
      if(when.getTime()>Date.now())return;                 /* ignore template/future rows */
      var cls=dot.className.indexOf('--d')>-1?'d':dot.className.indexOf('--p')>-1?'p':'u';
      var key=when.toISOString().slice(0,10);
      if(!byDay[key]||rank[cls]>rank[byDay[key]]){byDay[key]=cls;rowByDay[key]=row;}   /* worst event wins the day */
    });
    var today=new Date();
    var any=false;
    var tally={u:0,p:0,d:0,none:0};
    for(var i=89;i>=0;i--){
      var d=new Date(Date.UTC(today.getUTCFullYear(),today.getUTCMonth(),today.getUTCDate()-i));
      var key=d.toISOString().slice(0,10);
      var cell=document.createElement('div');
      cell.className='zs-hist__cell'+(byDay[key]?' zs-hist__cell--'+byDay[key]+' zs-hist__cell--link':'');
      var label=d.toLocaleDateString('en-GB',{day:'numeric',month:'short'});
      var st=byDay[key]==='u'?'verified clean':byDay[key]==='p'?'updating':byDay[key]==='d'?'detected':'no log entry';
      cell.setAttribute('data-tip',label+' \u00b7 '+st);
      if(byDay[key]){
        any=true;
        tally[byDay[key]]++;
        (function(row){
          cell.setAttribute('tabindex','0');
          cell.setAttribute('role','link');
          cell.setAttribute('aria-label','Jump to log entry: '+label+', '+st);
          var go=function(){
            if(!row)return;
            row.removeAttribute('data-zs-hide');
            row.scrollIntoView({behavior:window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});
            row.classList.remove('zs-log__row--flash');
            void row.offsetWidth;
            row.classList.add('zs-log__row--flash');
          };
          cell.addEventListener('click',go);
          cell.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}});
        })(rowByDay[key]);
      }else{tally.none++;}
      cellsEl.appendChild(cell);
    }
    var tallyEl=document.querySelector('[data-zs-tally]');
    if(tallyEl&&any){
      tallyEl.innerHTML='Last 90 days \u00b7 <b>'+tally.u+'</b> day'+(tally.u===1?'':'s')+' marked clean \u00b7 <b>'+tally.p+'</b> updating \u00b7 <b>'+tally.d+'</b> detected \u00b7 '+tally.none+' with no entry (log started 2 Jul)';
      tallyEl.hidden=false;
    }
    if(any)wrap.hidden=false;                              /* only show once the log has real dated entries */
  })();

  /* "since your last visit" — remembered locally, shown only on change */
  (function(){
    var shield=document.querySelector('.zs-shield');
    var stateEl=document.querySelector('.zs-shield__state');
    var band=document.querySelector('.zs-band');
    if(!shield||!stateEl||!band)return;
    var now=stateEl.textContent.trim();
    var iso=band.getAttribute('data-verified-iso')||'';
    var prev=null;
    try{prev=JSON.parse(localStorage.getItem('zzStatusSeen')||'null');}catch(e){}
    if(prev&&prev.state&&prev.state!==now){
      var days=Math.max(1,Math.round((Date.now()-(prev.at||Date.now()))/86400000));
      var el=document.createElement('div');
      el.className='zs-delta';
      el.innerHTML='<span class="zs-delta__tag">SINCE YOUR LAST VISIT</span>'+
        '<span class="zs-delta__txt">'+(days===1?'Yesterday':days+' days ago')+' this page said <b>'+prev.state+
        '</b> \u2014 it\u2019s now <b>'+now+'</b>. Details in the update log below.</span>';
      shield.parentNode.insertBefore(el,shield);
    }
    try{localStorage.setItem('zzStatusSeen',JSON.stringify({state:now,iso:iso,at:Date.now()}));}catch(e){}
  })();

  /* permalink every log entry */
  var rows=document.querySelectorAll('.zs-log__row');
  rows.forEach(function(row,i){
    if(!row.id) row.id='log-'+(i+1);
    var btn=document.createElement('button');
    btn.type='button';btn.className='zs-log__link';btn.title='Copy link to this entry';
    /* The visible glyph is an emoji, which screen readers announce as its
       character name ("link symbol"). An explicit label \u2014 and a live region
       for the result \u2014 makes the control and its outcome announceable. */
    btn.setAttribute('aria-label','Copy link to this entry');
    btn.textContent='\uD83D\uDD17';
    btn.addEventListener('click',function(){
      var url=location.origin+location.pathname+'#'+row.id;
      var done=function(){
        btn.textContent='\u2713';
        btn.setAttribute('aria-label','Link copied');
        setTimeout(function(){
          btn.textContent='\uD83D\uDD17';
          btn.setAttribute('aria-label','Copy link to this entry');
        },1400);
      };
      if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(url).then(done,done);}
      else{done();}
      history.replaceState(null,'','#'+row.id);
    });
    row.appendChild(btn);
  });
})();
</script>

<script>
(function(){
  'use strict';
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── "in this state for" — live counter from the real flip timestamp ── */
  /* ── next Rust force wipe — first Thursday of the month, ~19:00 UTC ── */
  (function(){
    var el=document.querySelector('[data-zs-wipe]');
    if(!el)return;
    function firstThursday(y,m){
      var dow=new Date(Date.UTC(y,m,1)).getUTCDay();
      var date=1+((4-dow+7)%7);
      return Date.UTC(y,m,date,19,0,0);
    }
    function next(){
      var now=Date.now();
      var d=new Date();
      var t=firstThursday(d.getUTCFullYear(),d.getUTCMonth());
      if(now>=t)t=firstThursday(d.getUTCFullYear(),d.getUTCMonth()+1);
      return t;
    }
    function tick(){
      var ms=next()-Date.now();
      var m=Math.floor(ms/60000);
      var days=Math.floor(m/1440);
      var h=Math.floor((m%1440)/60);
      var mm=m%60;
      el.textContent=(days>0?days+'d ':'')+(('0'+h).slice(-2))+'h '+(('0'+mm).slice(-2))+'m';
    }
    tick();setInterval(tick,30000);
  })();

  /* ── update log: filters + relative dates + collapse ── */
  (function(){
    var log=document.getElementById('zs-log');
    if(!log)return;
    var rows=Array.prototype.slice.call(log.querySelectorAll('.zs-log__row'));
    if(!rows.length)return;

    var MON={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
    function parseD(t){
      var m=/^(\d{1,2})\s+([A-Za-z]{3})\w*\s+(\d{4})$/.exec((t||'').trim());
      if(!m)return null;
      var mo=MON[m[2].toLowerCase()];
      if(mo===undefined)return null;
      return new Date(Date.UTC(+m[3],mo,+m[1]));
    }
    function clsOf(row){
      var dot=row.querySelector('.zs-log__dot');
      var c=dot?dot.className:'';
      if(c.indexOf('--d')>-1)return 'd';
      if(c.indexOf('--p')>-1)return 'p';
      if(c.indexOf('--i')>-1)return 'i';
      return 'u';
    }

    /* relative dates */
    var todayUTC=(function(){var n=new Date();return Date.UTC(n.getUTCFullYear(),n.getUTCMonth(),n.getUTCDate());})();
    rows.forEach(function(row){
      var dEl=row.querySelector('.zs-log__date');
      var when=parseD(dEl&&dEl.textContent);
      if(!dEl||!when)return;
      var days=Math.round((todayUTC-when.getTime())/86400000);
      if(days<0)return;
      var txt=days===0?'today':days===1?'yesterday':days<14?days+'d ago':days<70?Math.round(days/7)+'w ago':Math.round(days/30)+'mo ago';
      var rel=document.createElement('span');
      rel.className='zs-log__rel';
      rel.textContent=txt;
      dEl.appendChild(rel);
    });

    /* filters + collapse */
    var VISIBLE=8;
    var filter='all';
    var showAll=rows.length<=VISIBLE;
    var moreBtn=log.querySelector('[data-zs-more]');
    function apply(){
      var shown=0;
      rows.forEach(function(row,i){
        var match=filter==='all'||clsOf(row)===filter;
        var folded=filter==='all'&&!showAll&&i>=VISIBLE;
        if(match&&!folded){row.removeAttribute('data-zs-hide');shown++;}
        else{row.setAttribute('data-zs-hide','');}
      });
      if(moreBtn){
        var foldable=filter==='all'&&!showAll&&rows.length>VISIBLE;
        moreBtn.hidden=!foldable;
        if(foldable)moreBtn.textContent='Show full history ('+rows.length+' entries)';
      }
    }
    if(moreBtn)moreBtn.addEventListener('click',function(){showAll=true;apply();});
    var btns=log.querySelectorAll('[data-zs-filter]');
    Array.prototype.forEach.call(btns,function(btn){
      // Expose which filter is active, not just visually.
      btn.setAttribute('aria-pressed', btn.classList.contains('zs-filter__btn--on') ? 'true' : 'false');
      btn.addEventListener('click',function(){
        filter=btn.getAttribute('data-zs-filter')||'all';
        if(filter!=='all')showAll=true;
        Array.prototype.forEach.call(btns,function(b){
          var on = b===btn;
          b.classList.toggle('zs-filter__btn--on',on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        apply();
      });
    });
    apply();
  })();

  /* ── floating live pill + scroll-spy nav (one observer, no scroll thrash) ── */
  (function(){
    var pill=document.querySelector('[data-zs-mini]');
    if(pill)pill.hidden=false;

    /* mini pill: reveal once the hero band leaves the top of the viewport */
    var band=document.querySelector('.zs-band');
    if(pill&&band&&'IntersectionObserver' in window){
      var pillObs=new IntersectionObserver(function(entries){
        entries.forEach(function(e){pill.classList.toggle('zs-mini--show',!e.isIntersecting);});
      },{rootMargin:'-120px 0px 0px 0px',threshold:0});
      pillObs.observe(band);
    }else if(pill){
      pill.classList.add('zs-mini--show');
    }

    /* scroll-spy: highlight the nav link for whichever section is in view */
    var navLinks=Array.prototype.slice.call(document.querySelectorAll('.zs-nav__lnk'));
    if(navLinks.length&&'IntersectionObserver' in window){
      var map={};
      var targets=[];
      navLinks.forEach(function(a){
        var id=(a.getAttribute('href')||'').slice(1);
        var sec=id&&document.getElementById(id);
        if(sec){map[id]=a;targets.push(sec);}
      });
      var visible={};
      function refresh(){
        var current=null;
        targets.forEach(function(sec){
          var top=sec.getBoundingClientRect().top;
          if(visible[sec.id]&&(current===null||top<current.top)){current={id:sec.id,top:top};}
        });
        navLinks.forEach(function(a){a.classList.remove('zs-nav__lnk--active');});
        if(current&&map[current.id])map[current.id].classList.add('zs-nav__lnk--active');
      }
      var spy=new IntersectionObserver(function(entries){
        entries.forEach(function(e){visible[e.target.id]=e.isIntersecting;});
        refresh();
      },{rootMargin:'-45% 0px -50% 0px',threshold:0});
      targets.forEach(function(sec){spy.observe(sec);});
    }
  })();

  /* ── smooth in-page anchors ── */
  (function(){
    var links=document.querySelectorAll('.zs-nav__lnk, .zs-mini');
    Array.prototype.forEach.call(links,function(a){
      a.addEventListener('click',function(e){
        var href=a.getAttribute('href')||'';
        if(href.charAt(0)!=='#')return;
        var target=document.getElementById(href.slice(1));
        if(!target||target.hidden)return;
        e.preventDefault();
        if(a.classList.contains('zs-nav__lnk')){
          document.querySelectorAll('.zs-nav__lnk').forEach(function(l){l.classList.remove('zs-nav__lnk--active');});
          a.classList.add('zs-nav__lnk--active');
        }
        target.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
        try{history.replaceState(null,'',href);}catch(err){}
      });
    });
  })();
})();
</script>
