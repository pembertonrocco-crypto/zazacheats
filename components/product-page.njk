<div class="pp-wrap component" data-component-id="{{ componentId }}" x-data x-cloak>
  <div class="pp-glows" aria-hidden="true">
    <div class="pp-glow pp-glow--left"></div>
    <div class="pp-glow pp-glow--right"></div>
  </div>
  <div class="pp-inner">
    <section class="pp-section">
      <div class="pp-container">

        <div class="pp-header">
          <h1 class="pp-title">{{ product.name }}</h1>
          {% if product.status_color or product.status_text %}
          <div class="pp-status">
            <span class="pp-status__dot" style="background-color: {{ product.status_color }};"></span>
            <span class="pp-status__label" style="color: {{ product.status_color }};">{{ product.status_text }}</span>
          </div>
          {% endif %}
        </div>

        <div class="pp-layout">

          <div class="pp-col pp-col--media">
            {% if product.image_urls|length > 0 %}
            <div class="pp-carousel carousel slide" id="productImageCarousel" data-bs-ride="false" data-bs-interval="false">
              <div class="carousel-inner pp-carousel__inner">
                {% for image in product.image_urls %}
                <div class="carousel-item pp-carousel__item {{ 'active' if loop.first }}">
                  <img src="{{ image }}" alt="{{ product.name }} screenshot {{ loop.index }}" class="pp-carousel__img" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async" fetchpriority="{{ 'high' if loop.first else 'auto' }}" />
                </div>
                {% endfor %}
              </div>
              {% if product.image_urls|length > 1 %}
              <div class="pp-thumbs">
                {% for image in product.image_urls %}
                <button
                  type="button"
                  data-index="{{ loop.index0 }}"
                  class="pp-thumb {{ 'active' if loop.first }}"
                >
                  <img src="{{ image }}" alt="" class="pp-thumb__img" loading="lazy" decoding="async" />
                </button>
                {% endfor %}
              </div>
              {% endif %}
            </div>
            {% elif product.image_url %}
            <div class="pp-image-wrap">
              <img src="{{ product.image_url }}" alt="{{ product.name }}" class="pp-carousel__img" decoding="async" fetchpriority="high" />
            </div>
            {% else %}
            <div class="pp-image-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 256 256" fill="currentColor">
                <path d="m222.72 67.91l-88-48.18a13.9 13.9 0 0 0-13.44 0l-88 48.18A14 14 0 0 0 26 80.18v95.64a14 14 0 0 0 7.28 12.27l88 48.18a13.92 13.92 0 0 0 13.44 0l88-48.18a14 14 0 0 0 7.28-12.27V80.18a14 14 0 0 0-7.28-12.27ZM127 30.25a2 2 0 0 1 1.92 0L212.51 76l-33.94 18.57l-84.52-46.26ZM122 223l-83-45.43a2 2 0 0 1-1-1.75V86.66l84 46ZM43.49 76l38.07-20.85l84.51 46.26L128 122.24ZM218 175.82a2 2 0 0 1-1 1.75L134 223v-90.36l36-19.71V152a6 6 0 0 0 12 0v-45.63l36-19.71Z"/>
              </svg>
            </div>
            {% endif %}

            <div x-data="{ activeTab: '{{ product.product_tabs[0].slug if (product.product_tabs|length > 0 and product.path == 'rust-nfa') else 'description' }}' }" class="pp-tabs">
              {% if product.product_tabs|length > 0 or product.path == 'zaza-rust-private-cheat' or (product.path != 'rust-nfa' and product.description|length > 0) %}
              <div class="pp-tabs__nav">
                {% if product.path != 'rust-nfa' %}
                <button type="button" @click="activeTab = 'description'" class="pp-tab-btn" :class="activeTab == 'description' ? 'pp-tab-btn--active' : ''">
                  Description
                </button>
                {% endif %}
                {% for productTab in product.product_tabs %}
                <button type="button" @click="activeTab = '{{ productTab.slug }}'" class="pp-tab-btn" :class="activeTab == '{{ productTab.slug }}' ? 'pp-tab-btn--active' : ''">
                  {{ productTab.title }}
                </button>
                {% endfor %}
              </div>
              {% endif %}
              <div class="pp-tabs__content">
                {% if product.path != 'rust-nfa' %}
                <template x-if="activeTab == 'description'">
                  {% if product.path == 'zaza-rust-private-cheat' %}
                  <div class="zzd">{% render_snippet "zaza-description.njk", product=product %}</div>
                  {% else %}
                  <div class="pp-editor editor">{{ product.description | safe }}</div>
                  {% endif %}
                </template>
                {% endif %}
                {% for productTab in product.product_tabs %}
                <template x-if="activeTab == '{{ productTab.slug }}'">
                  <div class="pp-editor editor">{{ productTab.content | safe }}</div>
                </template>
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="pp-col pp-col--form" id="zz-buybox">
            <div x-data="productForm" x-cloak>

              {% if 'sales' in liveStats or 'views' in liveStats %}
              <div class="pp-live-stats">
                {% if 'views' in liveStats %}
                <div class="pp-live-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,168a40,40,0,1,1,40-40A40,40,0,0,1,128,168Z"></path></svg>
                  <span><strong>{{ liveStats.views }}</strong> {{ 'person is' if liveStats.views == 1 else 'people are' }} currently viewing</span>
                </div>
                {% endif %}
                {% if 'sales' in liveStats %}
                {% set salesCountHoursLabelMap = { '1': 'hour', '6': '6 hours', '12': '12 hours', '24': '24 hours', '168': '7 days', '720': '30 days' } %}
                <div class="pp-live-stat pp-live-stat--sales">
                  <span class="pp-live-dot" aria-hidden="true"></span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87ZM104,204a12,12,0,1,1-12-12A12,12,0,0,1,104,204Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,200,204Zm4-74.57A8,8,0,0,1,196.1,136H77.22L65.59,72H214.41Z"></path></svg>
                  <span><strong>{{ liveStats.sales }}</strong> {{ 'person has' if liveStats.sales == 1 else 'people have' }} purchased{{ '.' if not product.sales_count_hours in salesCountHoursLabelMap else (' in the last ' ~ salesCountHoursLabelMap[product.sales_count_hours] ~ '.') }}</span>
                </div>
                {% endif %}
              </div>
              {% endif %}

              {% if product.path == 'zaza-rust-private-cheat' %}
              {# ---- duration chooser: kills 4-variant choice paralysis, honest preference logic ---- #}
              <div class="pp-chooser">
                <button type="button" class="pp-chooser__head" data-zz-chooser-toggle aria-expanded="false">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M9.5 9.3a2.5 2.5 0 1 1 3.4 2.33c-.7.27-.9.77-.9 1.37v.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="16.6" r="1" fill="currentColor"/></svg>
                  <span>Not sure which key to pick?</span>
                  <svg class="pp-chooser__chev" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="pp-chooser__body" hidden>
                  <p class="pp-chooser__q">What fits you best?</p>
                  <button type="button" class="pp-chooser__opt" data-zz-pick="1 Day"><strong>Just want to test it first</strong><span>Cheapest way in — try the loader, features and support yourself.</span></button>
                  <button type="button" class="pp-chooser__opt" data-zz-pick="1 Week"><strong>Committed for this wipe</strong><span>A full week of play — the most popular starting point.</span></button>
                  <button type="button" class="pp-chooser__opt" data-zz-pick="1 Month"><strong>I play most wipes</strong><span>Cheaper per day than weekly if you know you'll keep playing.</span></button>
                  <button type="button" class="pp-chooser__opt" data-zz-pick="Lifetime"><strong>I'm here long-term</strong><span>One payment, done — best value if you're certain.</span></button>
                </div>
              </div>
              {% endif %}

              {% render_snippet "product-form.njk", product=product %}
              {% if product.path == 'zaza-rust-private-cheat' %}
              {% render_snippet "bundle-block.njk" %}
              {% render_snippet "bundle-popup.njk" %}
              {% endif %}

            </div>
          </div>

        </div>

        {% if product.path == 'zaza-rust-private-cheat' %}
        {% render_snippet "zaza-product-block.njk", product=product %}
        {% endif %}

        {# Rust NFA description is now handled by showcase-video.njk below #}

      </div>
    </section>
  </div>
</div>

{% if product.path == 'zaza-rust-private-cheat' %}
<div class="pp-defer">{% render_snippet "showcase.njk" %}</div>
{% endif %}

{% if product.path == 'rust-nfa' %}
<div class="pp-defer">{% render_snippet "showcase-video.njk" %}</div>
{% endif %}

{% if product.path == 'zaza-rust-private-cheat' or product.path == 'rust-nfa' %}
<div class="pp-defer">{% render_snippet "buy-faq.njk" %}</div>
<div class="pp-defer">{% render_snippet "pair-block.njk" %}</div>
{% endif %}

{# ---------- MOBILE STICKY BUY BAR (mobile only) ---------- #}
<div class="zz-sticky" id="zz-sticky" aria-hidden="true">
  <div class="zz-sticky__info">
    <span class="zz-sticky__label">From</span>
    <span class="zz-sticky__price">
      {% if product.min_price %}
        <span x-text="appCurrency.format({{ product.min_price }}, '{{ product.currency }}')">{{ formatPrice(product.min_price, product.currency) }}</span>
      {% else %}—{% endif %}
    </span>
  </div>
  <a href="#zz-buybox" class="zz-sticky__btn"
     onclick="var b=document.getElementById('zz-buybox');if(b){event.preventDefault();b.scrollIntoView({behavior:'smooth',block:'center'});}">
    Buy Now
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<style>
.zz-sticky{
  position:fixed;left:0;right:0;bottom:0;z-index:900;
  display:none;align-items:center;justify-content:space-between;gap:14px;
  padding:12px 16px calc(12px + env(safe-area-inset-bottom));
  background:rgba(8,11,24,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  border-top:1px solid rgba(191,64,191,.18);
  transform:translateY(100%);transition:transform .35s cubic-bezier(.16,1,.3,1);
  font-family:'Satoshi','Inter',system-ui,sans-serif;
}
.zz-sticky.zz-sticky--show{transform:translateY(0)}
.zz-sticky__info{display:flex;flex-direction:column;line-height:1.1}
.zz-sticky__label{font-family:'JetBrains Mono',monospace;font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(200,215,240,.5)}
.zz-sticky__price{font-family:'JetBrains Mono',monospace;font-size:1.25rem;font-weight:800;color:#fff}
.zz-sticky__btn{display:inline-flex;align-items:center;gap:8px;padding:.8rem 1.5rem;border-radius:11px;
  background:linear-gradient(135deg,#BF40BF,#7C3AED);color:#fff;font-weight:700;font-size:.95rem;text-decoration:none;
  box-shadow:0 8px 24px -8px rgba(191,64,191,.8)}
@media (max-width:768px){ .zz-sticky{display:flex} }
@media (prefers-reduced-motion:reduce){ .zz-sticky{transition:none} }
</style>

<script>
(function(){
  var bar = document.getElementById('zz-sticky');
  var box = document.getElementById('zz-buybox');
  if(!bar || !box) return;

  // Keep the bar's price in sync with the actual selected variant/quantity:
  // mirror the live total from the real price block (no duplicated logic).
  var barPrice = bar.querySelector('.zz-sticky__price');
  var barLabel = bar.querySelector('.zz-sticky__label');
  var liveAmount = box.querySelector('.pf-price-block__amount');
  function syncPrice(){
    if(!barPrice || !liveAmount) return;
    var t = (liveAmount.textContent || '').trim();
    if(t){ barPrice.textContent = t; if(barLabel) barLabel.textContent = 'Your total'; }
  }
  if(liveAmount && 'MutationObserver' in window){
    new MutationObserver(syncPrice).observe(liveAmount, {childList:true, characterData:true, subtree:true});
  }

  // Show the bar once the real buy box has scrolled out of view; hide while it's visible.
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ bar.classList.remove('zz-sticky--show'); }
        else { bar.classList.add('zz-sticky--show'); syncPrice(); }
      });
    }, { threshold: 0 });
    io.observe(box);
  } else {
    bar.classList.add('zz-sticky--show');
  }
  // Initial sync after Alpine renders.
  setTimeout(syncPrice, 800);
})();
</script>

