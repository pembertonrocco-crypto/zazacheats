<section class="fbq component" data-component-id="{{ componentId }}">

  {# Shared star glyph: every .fc__star below references this single path via
     <use> instead of repeating the ~600-byte path 400 times (was ~130KB of HTML). #}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="zz-fcstar" viewBox="0 0 24 24"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></symbol>
  </svg>

  <div class="fbq__head">
    <div class="fbq__badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none">
        <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 110-16 8 8 0 010 16zm3.707-10.707a1 1 0 00-1.414 0L11 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4a1 1 0 000-1.414z" fill="rgba(180,210,255,0.8)"/>
      </svg>
      <span>Customer Reviews</span>
    </div>
    {% if properties.title %}
    <h2 class="fbq__title">{{ properties.title | renderString }}</h2>
    {% endif %}
    {% if properties.subtitle %}
    <p class="fbq__subtitle">{{ properties.subtitle | renderString }}</p>
    {% endif %}

    <div class="fbq__aggregate">
      <div class="fbq__agg-score" data-zz-ravg>{% if shop.average_rating and shop.average_rating > 0 %}{{ helpers.numbers.formatDecimal(shop.average_rating) }}{% else %}4.8{% endif %}</div>
      <div class="fbq__agg-meta">
        <div class="fbq__agg-stars" data-zz-rstars>★★★★★</div>
        <div class="fbq__agg-count">Based on <span data-zz-rc>78</span> verified reviews</div>
      </div>
    </div>
    <p class="fbq__provenance">40 reviews carried over word-for-word from our previous storefront &middot; new reviews are added automatically after every purchase</p>
  </div>

  <div class="fbq__marquee-wrap">
    <div class="fbq__fade fbq__fade--left" aria-hidden="true"></div>
    <div class="fbq__fade fbq__fade--right" aria-hidden="true"></div>

    <div class="fbq__row" data-direction="ltr">
      <div class="fbq__track">
{# ---- LIVE SELLAUTH REVIEWS (auto) ----
   New feedbacks left through SellAuth render here automatically,
   using the platform-aware feedback-card snippet. Guarded so nothing
   breaks if the platform passes no feedbacks.
   Auto-generated entries ("Automatic feedback after 7 days.") and
   empty messages are skipped — the homepage wall only shows reviews
   a customer actually wrote. The full list stays on /feedback. ---- #}
{% if feedbacks %}
{% if feedbacks.data %}
{% for fb in feedbacks.data %}
{% if fb.message and not ('Automatic feedback' in fb.message) %}
        <div class="fbq__item">{% render_snippet "feedback-card.njk", feedback=fb %}</div>
{% endif %}
{% endfor %}
{% else %}
{% for fb in feedbacks %}
{% if fb.message and not ('Automatic feedback' in fb.message) %}
        <div class="fbq__item">{% render_snippet "feedback-card.njk", feedback=fb %}</div>
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
