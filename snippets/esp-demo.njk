  border-bottom:2px solid transparent;cursor:default;transition:color .15s}
.zed__tab:hover{color:rgba(230,215,240,.8)}
.zed__tab--active{color:#fff;border-bottom-color:#e91ee9;background:rgba(233,30,233,.1);border-radius:6px 6px 0 0}

/* Phones: the topbar and tab strip are flex rows of non-shrinking children
   (the search pill alone reserves min-width:120px), so they spilled ~116px
   and ~52px past the panel and were clipped. Let both wrap, and drop the
   fake search pill — it is decorative chrome and the least useful thing on
   a 375px screen. */
@media (max-width:768px){
  .zed__topbar{flex-wrap:wrap;gap:8px 12px}
  .zed__search{display:none}
  .zed__tabs{flex-wrap:wrap}
  .zed__tab{padding:8px 12px}
}

.zed__panels{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px}
.zed__panel{border:1px solid rgba(233,30,233,.28);border-radius:8px;padding:14px 13px 16px;
  background:rgba(10,7,15,.6);display:flex;flex-direction:column;gap:1px}
.zed__panel-title{margin:0 0 10px;padding-bottom:8px;font-size:.74rem;font-weight:700;color:#fff;
  border-bottom:1px solid rgba(255,255,255,.09)}
.zed__section{margin:14px 0 7px;font-size:.6rem;font-weight:700;letter-spacing:.1em;color:#e91ee9;
