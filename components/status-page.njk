.zs-bg__beam--a{width:36rem;height:36rem;top:-14rem;left:-10rem;background:radial-gradient(circle,rgba(191,64,191,.5),transparent 65%)}
.zs-bg__beam--b{width:32rem;height:32rem;top:-8rem;right:-10rem;background:radial-gradient(circle,rgba(34,197,94,.32),transparent 65%);animation-delay:-8s}
