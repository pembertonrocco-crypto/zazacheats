.tp-grid{position:relative;display:grid;grid-template-columns:repeat(2,1fr);gap:26px;margin-top:48px;perspective:1500px}
.tp-plus{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:6;
  width:44px;height:44px;display:grid;place-items:center;border-radius:50%;
  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:1.25rem;font-weight:700;color:#e6aaff;
  background:rgba(10,12,24,.92);border:1px solid rgba(191,64,191,.4);
  box-shadow:0 0 0 6px rgba(6,7,15,.85),0 0 24px -4px rgba(191,64,191,.55);pointer-events:none;
  animation:spUp .7s ease .35s both}
.tp-card{position:relative;display:flex;flex-direction:column;overflow:hidden;text-decoration:none;color:inherit;
  border:1px solid var(--edge);border-radius:22px;background:linear-gradient(180deg,rgba(191,64,191,.06),rgba(191,64,191,.02));
  transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(var(--ty,0)) scale(var(--sc,1));
  transition:transform .5s cubic-bezier(.16,1,.3,1),border-color .4s,box-shadow .4s;
  opacity:0;animation:tpFade .6s ease forwards;animation-delay:calc(var(--i,0)*.12s + .12s);will-change:transform}
.tp-card--nfa{--v:#8e2d8e;--edge:rgba(191,64,191,.16)}
.tp-card::after{content:'';position:absolute;inset:0;border-radius:22px;padding:1px;z-index:5;pointer-events:none;
  background:linear-gradient(135deg,rgba(191,64,191,.6),transparent 42%,transparent 58%,rgba(191,64,191,.55));
