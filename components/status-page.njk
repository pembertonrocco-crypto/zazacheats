<div class="zs-page component" data-component-id="{{ componentId }}" data-zz-build="svdate1">
  <div class="zs-bg" aria-hidden="true">
    <div class="zs-bg__grid"></div>
    <div class="zs-bg__beam zs-bg__beam--a"></div>
    <div class="zs-bg__beam zs-bg__beam--b"></div>
    <div class="zs-bg__scan"></div>
    <div class="zs-aura zs-aura--{{ ovCls }}"></div>
  </div>

  <div class="zs-wrap">

    <header class="zs-head zs-rise">
      <p class="zs-eyebrow">// ZAZA CHEATS — DETECTION STATUS</p>
      <h1 class="zs-title">Status</h1>
      <p class="zs-subtitle">Hand-verified before every green light. If it's red here, we say so.</p>
    </header>

    {# ════════════════════════════════════════════════════════════════
       STATUS CONTROL PANEL — the ONLY block you edit day-to-day.

       1) Product statuses. Each accepts:
              'undetected' | 'updating' | 'detected'
          The shield, band, cards, protocol and CTA all recolour from
          these two lines. Flip them the moment the real status changes.

       2) Verified date. AUTOMATIC — the page rewrites "Status verified"
          to the current UK date on load (and again at midnight), exactly
          like the live clock and "Last check". You do NOT need to touch
          these two lines day-to-day; they are only the no-JS fallback:
              statusVerifiedOn  — what buyers read  (e.g. '2 July 2026')
              statusVerifiedISO — fallback freshness date (YYYY-MM-DD)

       3) UPDATE LOG — scroll to the zs-log section further down and
          add a row at the TOP of the list whenever status changes.
          Copy-paste templates are in a comment there.
       ════════════════════════════════════════════════════════════════ #}
    {% set zazaStatus = 'undetected' %}
    {% set rustNfaStatus = 'undetected' %}
    {% set statusVerifiedOn = '25 July 2026' %}
    {% set statusVerifiedISO = '2026-07-25' %}

    {# 4) Build + freshness per product — shown on the cards.
          Update zazaVersion + zazaUpdatedOn every cheat release,
          nfaRestockedOn every time you restock accounts.
          statusChangedISO = when the CURRENT light began (date or full
          ISO timestamp). Powers the live "in this state for Xh Ym"
          counter. Update it every time you flip zazaStatus. #}
    {% set zazaVersion = 'v2.4 · build 614' %}
    {% set zazaUpdatedOn = '17 July 2026' %}
    {% set nfaRestockedOn = '8 July 2026' %}
    {% set statusChangedISO = '2026-07-17T17:06:00Z' %}

    {# 5) Subsystems — the component board. Each accepts:
              'op'   → Operational (green)
              'slow' → Degraded    (amber)
              'down' → Down        (red)
          Flip individually: e.g. keys still deliver while ESP is down. #}
    {% set sysLoader = 'op' %}
    {% set sysInjection = 'op' %}
    {% set sysEsp = 'op' %}
    {% set sysAim = 'op' %}
    {% set sysDelivery = 'op' %}
    {% set sysSupport = 'op' %}

    {# per-product display tokens (derived — no need to edit) #}
    {% set zCls = 'u' %}{% set zLabel = 'Undetected' %}{% set zDet = 'Clean' %}
    {% if zazaStatus == 'detected' %}{% set zCls = 'd' %}{% set zLabel = 'Detected' %}{% set zDet = 'Flagged' %}
    {% elif zazaStatus == 'updating' %}{% set zCls = 'p' %}{% set zLabel = 'Updating' %}{% set zDet = 'Updating' %}{% endif %}

    {% set nfaCls = 'u' %}{% set nfaLabel = 'Undetected' %}{% set nfaDet = 'Clean' %}
    {% if rustNfaStatus == 'detected' %}{% set nfaCls = 'd' %}{% set nfaLabel = 'Detected' %}{% set nfaDet = 'Flagged' %}
    {% elif rustNfaStatus == 'updating' %}{% set nfaCls = 'p' %}{% set nfaLabel = 'Updating' %}{% set nfaDet = 'Updating' %}{% endif %}

    {# overall = worst case across products #}
    {% set ovCls = 'u' %}{% set ovState = 'UNDETECTED' %}{% set ovSub = 'All systems operational' %}{% set ovBuild = 'Active' %}
    {% if zazaStatus == 'updating' or rustNfaStatus == 'updating' %}{% set ovCls = 'p' %}{% set ovState = 'UPDATING' %}{% set ovSub = 'Update in progress' %}{% set ovBuild = 'Updating' %}{% endif %}
    {% if zazaStatus == 'detected' or rustNfaStatus == 'detected' %}{% set ovCls = 'd' %}{% set ovState = 'DETECTED' %}{% set ovSub = 'Action required — see below' %}{% set ovBuild = 'Paused' %}{% endif %}

    <!-- status centerpiece -->
    <section class="zs-shield zs-shield--{{ ovCls }} zs-rise" style="--d:.08s">
      <div class="zs-shield__sweep" aria-hidden="true"></div>
      <div class="zs-shield__pulse" aria-hidden="true"></div>
      <div class="zs-shield__pulse zs-shield__pulse--2" aria-hidden="true"></div>
      <div class="zs-shield__ring" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <circle class="zs-shield__track" cx="100" cy="100" r="88"></circle>
          <circle class="zs-shield__fill" cx="100" cy="100" r="88"></circle>
        </svg>
      </div>
      <div class="zs-shield__core">
        <svg class="zs-shield__icon" viewBox="0 0 24 24" fill="none">
          <path d="M12 2.5l7 3v5.2c0 4.3-2.9 7.9-7 9.3-4.1-1.4-7-5-7-9.3V5.5l7-3z" stroke-width="1.3"/>
          <path d="M8.5 12.2l2.4 2.4 4.6-4.8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="zs-shield__state">{{ ovState }}</div>
        <div class="zs-shield__sub" aria-live="polite"><span class="zs-livedot"></span>{{ ovSub }}</div>
      </div>
    </section>

    <!-- status readout band -->
    <section class="zs-band zs-rise" style="--d:.16s" data-verified-iso="{{ statusVerifiedISO }}">
      <div class="zs-band__item">
        <span class="zs-band__v zs-band__v--{{ ovCls }}">{{ ovBuild }}</span>
        <span class="zs-band__k">Build status</span>
      </div>
      <div class="zs-band__div" aria-hidden="true"></div>
      <div class="zs-band__item">
        <span class="zs-band__v">Instant</span>
        <span class="zs-band__k">Key delivery</span>
      </div>
      <div class="zs-band__div" aria-hidden="true"></div>
      <div class="zs-band__item">
        <span class="zs-band__v" data-zs-verified>{{ statusVerifiedOn }}</span>
        <span class="zs-band__k">Status verified</span>
      </div>
      <div class="zs-band__div" aria-hidden="true"></div>
      <div class="zs-band__item">
        <span class="zs-band__v" data-freshness>&mdash;</span>
        <span class="zs-band__k">Last check</span>
      </div>
      <div class="zs-band__div" aria-hidden="true"></div>
      <div class="zs-band__item">
        <span class="zs-band__v zs-band__v--clock" data-zs-clock>&mdash;:&mdash;:&mdash;</span>
        <span class="zs-band__k">UK time · live</span>
      </div>
    </section>
    <p class="zs-stale zs-rise" data-stale-note hidden style="--d:.2s">
      It's been a while since the date above moved &mdash; ask in
      <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener">Discord</a>
      for the freshest word before you buy.
    </p>

    <!-- ops strip: live counters — all computed client-side from real data -->
    <div class="zs-ops zs-rise" style="--d:.21s" data-changed-iso="{{ statusChangedISO }}">
      <div class="zs-ops__chip">
        <span class="zs-ops__k">Next Rust force wipe</span>
        <span class="zs-ops__v" data-zs-wipe>&mdash;</span>
        <span class="zs-ops__note">first Thu · ~19:00 UTC · Facepunch can shift it</span>
      </div>
    </div>

    <!-- quick jump -->
    <nav class="zs-nav zs-rise" style="--d:.23s" aria-label="Status page sections">
      <a class="zs-nav__lnk" href="#zs-products">Products</a>
      <a class="zs-nav__lnk" href="#zs-components">Components</a>
      <a class="zs-nav__lnk" href="#zs-history">History</a>
      <a class="zs-nav__lnk" href="#zs-log">Update log</a>
      <a class="zs-nav__lnk" href="#zs-protocol">Key protocol</a>
    </nav>

    <!-- 90-day history — drawn from the real update log below; grey = no logged entry -->
    <section class="zs-hist zs-rise" id="zs-history" style="--d:.22s" hidden>
      <div class="zs-hist__head">
        <span class="zs-hist__title">Last 90 days</span>
        <span class="zs-hist__note">built from the update log — grey days simply have no entry · click a day to jump to its entry</span>
      </div>
      <div class="zs-hist__cells" id="zs-hist-cells"></div>
      <div class="zs-hist__legend">
        <span><i class="zs-hist__key zs-hist__key--u"></i>Verified clean</span>
        <span><i class="zs-hist__key zs-hist__key--p"></i>Updating</span>
        <span><i class="zs-hist__key zs-hist__key--d"></i>Detected</span>
        <span><i class="zs-hist__key"></i>No entry</span>
      </div>
      <p class="zs-hist__tally" data-zs-tally hidden></p>
    </section>

    <div class="zs-legend zs-rise" style="--d:.24s">
      <span class="zs-leg"><span class="zs-leg__dot zs-leg__dot--u"></span>Undetected</span>
      <span class="zs-leg"><span class="zs-leg__dot zs-leg__dot--p"></span>Updating</span>
      <span class="zs-leg"><span class="zs-leg__dot zs-leg__dot--d"></span>Detected</span>
    </div>

    <!-- component board -->
    {% set opCount = 0 %}
    {% if sysLoader == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    {% if sysInjection == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    {% if sysEsp == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    {% if sysAim == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    {% if sysDelivery == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    {% if sysSupport == 'op' %}{% set opCount = opCount + 1 %}{% endif %}
    <section class="zs-sys zs-rise" id="zs-components" style="--d:.28s">
      <div class="zs-sys__head">
        <h2 class="zs-sys__title">Components</h2>
        <span class="zs-opsum {% if opCount == 6 %}zs-opsum--op{% elif opCount >= 4 %}zs-opsum--slow{% else %}zs-opsum--down{% endif %}">{{ opCount }}/6 operational</span>
        <span class="zs-sys__note">set by hand after real checks — this board never auto-greens</span>
      </div>
      <div class="zs-sys__grid">
        <div class="zs-sys__row">
          <span class="zs-sys__name">Loader</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysLoader }}"><span class="zs-sys__dot"></span>{% if sysLoader == 'op' %}Operational{% elif sysLoader == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
        <div class="zs-sys__row">
          <span class="zs-sys__name">Injection</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysInjection }}"><span class="zs-sys__dot"></span>{% if sysInjection == 'op' %}Operational{% elif sysInjection == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
        <div class="zs-sys__row">
          <span class="zs-sys__name">ESP / Visuals</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysEsp }}"><span class="zs-sys__dot"></span>{% if sysEsp == 'op' %}Operational{% elif sysEsp == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
        <div class="zs-sys__row">
          <span class="zs-sys__name">Aim</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysAim }}"><span class="zs-sys__dot"></span>{% if sysAim == 'op' %}Operational{% elif sysAim == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
        <div class="zs-sys__row">
          <span class="zs-sys__name">Key delivery</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysDelivery }}"><span class="zs-sys__dot"></span>{% if sysDelivery == 'op' %}Operational{% elif sysDelivery == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
        <div class="zs-sys__row">
          <span class="zs-sys__name">Discord support</span>
          <span class="zs-sys__chip zs-sys__chip--{{ sysSupport }}"><span class="zs-sys__dot"></span>{% if sysSupport == 'op' %}Operational{% elif sysSupport == 'slow' %}Degraded{% else %}Down{% endif %}</span>
        </div>
      </div>
    </section>

    <!-- coverage: what this status does and doesn't speak to -->
    <section class="zs-cover zs-rise" style="--d:.3s">
      <span class="zs-cover__chip">EAC</span>
      <p class="zs-cover__txt"><b>Coverage:</b> this status tracks Rust's client-side anti-cheat (Easy Anti-Cheat).
      No cheat on the market can cover server-side detection or an admin spectating you &mdash; play smart even on green.</p>
    </section>

    <section class="zs-grid" id="zs-products">

      {% for item in statuses %}
        {% if item.type == 'group' %}
          <div class="status-group">
            <h2 class="status-group-title">{{ item.name }}</h2>
            <div class="status-group-cards">
              {% for product in item.products %}
                {% render_snippet "status-card.njk", product=product %}
              {% endfor %}
            </div>
          </div>
        {% elif not item.group_id %}
          {% render_snippet "status-card.njk", product=item %}
        {% endif %}
      {% endfor %}

      <div class="zs-card zs-card--state zs-card--{{ zCls }} zs-rise" style="--d:.32s">
        <div class="zs-card__glow" aria-hidden="true"></div>
        <div class="zs-card__sheen" aria-hidden="true"></div>

        <div class="zs-card__top">
          <div class="zs-card__id">
            <span class="zs-card__icon">
              <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                <path d="M12 2.5l7 3v5.2c0 4.3-2.9 7.9-7 9.3-4.1-1.4-7-5-7-9.3V5.5l7-3z" fill="rgba(34,197,94,.14)" stroke="#22c55e" stroke-width="1.3"/>
                <path d="M8.5 12.2l2.4 2.4 4.6-4.8" stroke="#22c55e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <h3 class="zs-card__name">Zaza Rust Private Cheat</h3>
              <p class="zs-card__sub">Private build &middot; Rust</p>
            </div>
          </div>
          <span class="zs-pill"><span class="zs-pill__dot"></span>{{ zLabel }}</span>
        </div>

        <div class="zs-bar"><div class="zs-bar__fill"></div></div>

        <div class="zs-meta">
          <div class="zs-meta__item"><span class="zs-meta__k">Version</span><span class="zs-meta__v">{{ zazaVersion }}</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Detection</span><span class="zs-meta__v zs-stateClr">{{ zDet }}</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Last update</span><span class="zs-meta__v">{{ zazaUpdatedOn }}</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Delivery</span><span class="zs-meta__v">Instant</span></div>
        </div>

        {# ── CHANGELOG (cheat) — newest FIRST. Copy-paste template: ──
           <div class="zs-cl__row">
             <span class="zs-cl__ver">v2.5</span>
             <div class="zs-cl__body">
               <span class="zs-cl__date">14 Jul 2026</span>
               <span class="zs-cl__txt">What changed, in one or two honest lines.</span>
             </div>
           </div>                                                    ── #}
        <details class="zs-cl">
          <summary class="zs-cl__sum">
            <span>Release notes</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="zs-cl__rows">
            <div class="zs-cl__row">
              <span class="zs-cl__ver">v2.5</span>
              <div class="zs-cl__body">
                <span class="zs-cl__date">14 Jul 2026</span>
                <span class="zs-cl__txt">Fixed issues with FOV change and zoom.</span>
              </div>
            </div>
            <div class="zs-cl__row">
              <span class="zs-cl__ver">v2.4</span>
              <div class="zs-cl__body">
                <span class="zs-cl__date">8 Jul 2026</span>
                <span class="zs-cl__txt">Build 614 — re-verified after the July Rust client patch. Safe to inject.</span>
              </div>
            </div>
            <div class="zs-cl__row">
              <span class="zs-cl__ver">v2.3</span>
              <div class="zs-cl__body">
                <span class="zs-cl__date">3 Jul 2026</span>
                <span class="zs-cl__txt">Force-wipe rebuild — re-verified and safe to inject.</span>
              </div>
            </div>
          </div>
        </details>

        {% if zCls == 'u' %}
        <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="zs-card__cta">
          Get instant access
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {% else %}
        <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" class="zs-card__cta zs-card__cta--wait">
          Wait for green &mdash; get pinged on Discord
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {% endif %}
      </div>

      <div class="zs-card zs-card--state zs-card--{{ nfaCls }} zs-rise" style="--d:.4s">
        <div class="zs-card__glow" aria-hidden="true"></div>
        <div class="zs-card__sheen" aria-hidden="true"></div>

        <div class="zs-card__top">
          <div class="zs-card__id">
            <span class="zs-card__icon">
              <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                <path d="M12 2.5l7 3v5.2c0 4.3-2.9 7.9-7 9.3-4.1-1.4-7-5-7-9.3V5.5l7-3z" fill="rgba(34,197,94,.14)" stroke="#22c55e" stroke-width="1.3"/>
                <path d="M8.5 12.2l2.4 2.4 4.6-4.8" stroke="#22c55e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <h3 class="zs-card__name">Rust NFA</h3>
              <p class="zs-card__sub">NFA accounts &middot; Rust</p>
            </div>
          </div>
          <span class="zs-pill"><span class="zs-pill__dot"></span>{{ nfaLabel }}</span>
        </div>

        <div class="zs-bar"><div class="zs-bar__fill"></div></div>

        <div class="zs-meta">
          <div class="zs-meta__item"><span class="zs-meta__k">Type</span><span class="zs-meta__v">NFA accounts</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Detection</span><span class="zs-meta__v zs-stateClr">{{ nfaDet }}</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Restocked</span><span class="zs-meta__v">{{ nfaRestockedOn }}</span></div>
          <div class="zs-meta__item"><span class="zs-meta__k">Warranty</span><span class="zs-meta__v">6h included</span></div>
        </div>

        {# ── CHANGELOG (NFA) — restocks & policy changes, newest FIRST ── #}
        <details class="zs-cl">
          <summary class="zs-cl__sum">
            <span>Restock log</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="zs-cl__rows">
            <div class="zs-cl__row">
              <span class="zs-cl__ver">Stock</span>
              <div class="zs-cl__body">
                <span class="zs-cl__date">8 Jul 2026</span>
                <span class="zs-cl__txt">All four hour tiers restocked — Starter through Veteran available.</span>
              </div>
            </div>
          </div>
        </details>

        {% if nfaCls == 'u' %}
        <a href="{{ '/product/rust-nfa' | shopUrl }}" class="zs-card__cta">
          Get instant access
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {% else %}
        <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" class="zs-card__cta zs-card__cta--wait">
          Wait for green &mdash; get pinged on Discord
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {% endif %}
      </div>

    </section>

    {# ════════════════════════════════════════════════════════════════
       UPDATE LOG — the public record. Newest entry FIRST.

       Add a row whenever status changes. Never delete red entries;
       a log that only shows green is just marketing. Types:
         zs-log__dot--u  green   (back to undetected / all clear)
         zs-log__dot--p  amber   (updating started)
         zs-log__dot--d  red     (detection event)
         zs-log__dot--i  violet  (info: new feature, policy, page news)

       Copy-paste templates:

       <li class="zs-log__row">
         <span class="zs-log__date">14 Jul 2026</span>
         <span class="zs-log__dot zs-log__dot--p" aria-hidden="true"></span>
         <div class="zs-log__body">
           <span class="zs-log__t">Updating — Rust client patch</span>
           <span class="zs-log__d">Build pulled while we re-verify against today's update. Don't inject until this flips green.</span>
         </div>
       </li>

       <li class="zs-log__row">
         <span class="zs-log__date">14 Jul 2026</span>
         <span class="zs-log__dot zs-log__dot--u" aria-hidden="true"></span>
         <div class="zs-log__body">
           <span class="zs-log__t">Back to Undetected</span>
           <span class="zs-log__d">Re-verified after the client patch. Safe to inject.</span>
         </div>
       </li>
       ════════════════════════════════════════════════════════════════ #}
    <section class="zs-log zs-rise" id="zs-log" style="--d:.46s">
      <p class="zs-eyebrow" style="text-align:center">// UPDATE LOG — EVERY STATUS CHANGE, ON THE RECORD</p>
      <div class="zs-filter" role="group" aria-label="Filter log entries">
        <button type="button" class="zs-filter__btn zs-filter__btn--on" data-zs-filter="all">All</button>
        <button type="button" class="zs-filter__btn" data-zs-filter="u">Clean</button>
