{% set hasLinks = global.components.footer.links.length > 0 %}
{% set hasLinks2 = global.components.footer.links_2.length > 0 %}
{% set hasSocials = global.components.footer.show_socials %}

{% if global.components.footer.show_shop_name or global.components.footer.show_logo or global.components.footer.show_socials or global.components.footer.links.length > 0 %}

<footer class="ft component" data-component-id="footer">

  <div class="ft__glow" aria-hidden="true"></div>

  <div class="ft__main">
    <div class="ft__brand">
      <div class="ft__brand-row">
        {% if global.components.footer.show_logo %}
          <img src="{{ shop.image_url }}" alt="{{ shop.name }}" class="ft__logo" loading="lazy" decoding="async" />
        {% endif %}
        {% if global.components.footer.show_shop_name %}
          <span class="ft__name">{{ shop.name }}</span>
        {% endif %}
      </div>
      <p class="ft__tagline">Private Rust cheats, actively maintained and delivered instantly. The current state of every build is published — dated — on our status page, so you can check it before you spend anything.</p>
      <a href="{{ '/status' | shopUrl }}" class="ft__badge">
        <span class="ft__badge-dot"></span>
        <span class="ft__badge-text">Live build status — see for yourself &rarr;</span>
      </a>
      <p class="ft__contact">Support: <a href="mailto:support@zazacheats.net" class="ft__contact-link">support@zazacheats.net</a> <span class="ft__contact-sep">&middot;</span> <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" class="ft__contact-link">Discord tickets</a></p>

      {% if hasSocials %}
      <div class="ft__social-icons">
        {% if shop.discord_url %}
        <a href="{{ shop.discord_url }}" class="ft__social-icon" target="_blank" rel="noopener" aria-label="Discord" title="Discord">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#zz-ico-discord"/></svg>
        </a>
        {% endif %}
        {% if shop.telegram_url %}
        <a href="{{ shop.telegram_url }}" class="ft__social-icon" target="_blank" rel="noopener" aria-label="Telegram" title="Telegram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12a12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0Zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472c-.18 1.898-.962 6.502-1.36 8.627c-.168.9-.499 1.201-.82 1.23c-.696.065-1.225-.46-1.9-.902c-1.056-.693-1.653-1.124-2.678-1.8c-1.185-.78-.417-1.21.258-1.91c.177-.184 3.247-2.977 3.307-3.23c.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345c-.48.33-.913.49-1.302.48c-.428-.008-1.252-.241-1.865-.44c-.752-.245-1.349-.374-1.297-.789c.027-.216.325-.437.893-.663c3.498-1.524 5.83-2.529 6.998-3.014c3.332-1.386 4.025-1.627 4.476-1.635Z"/></svg>
        </a>
        {% endif %}
        {% if shop.instagram_url %}
        <a href="{{ shop.instagram_url }}" class="ft__social-icon" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07c3.252.148 4.771 1.691 4.919 4.919c.058 1.265.069 1.645.069 4.849c0 3.205-.012 3.584-.069 4.849c-.149 3.225-1.664 4.771-4.919 4.919c-1.266.058-1.644.07-4.85.07c-3.204 0-3.584-.012-4.849-.07c-3.26-.149-4.771-1.699-4.919-4.92c-.058-1.265-.07-1.644-.07-4.849c0-3.204.013-3.583.07-4.849c.149-3.227 1.664-4.771 4.919-4.919c1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072C2.695.272.273 2.69.073 7.052C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98c.059-1.28.073-1.689.073-4.948c0-3.259-.014-3.667-.072-4.947c-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324a6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8a4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881a1.44 1.44 0 0 0 0-2.881Z"/></svg>
        </a>
        {% endif %}
        {% if shop.tiktok_url %}
        <a href="{{ shop.tiktok_url }}" class="ft__social-icon" target="_blank" rel="noopener" aria-label="TikTok" title="TikTok">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02c.08 1.53.63 3.09 1.75 4.17c1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97c-.57-.26-1.1-.59-1.62-.93c-.01 2.92.01 5.84-.02 8.75c-.08 1.4-.54 2.79-1.35 3.94c-1.31 1.92-3.58 3.17-5.91 3.21c-1.43.08-2.86-.31-4.08-1.03c-2.02-1.19-3.44-3.37-3.65-5.71c-.02-.5-.03-1-.01-1.49c.18-1.9 1.12-3.72 2.58-4.96c1.66-1.44 3.98-2.13 6.15-1.72c.02 1.48-.04 2.96-.04 4.44c-.99-.32-2.15-.23-3.02.37c-.63.41-1.11 1.04-1.36 1.75c-.21.51-.15 1.07-.14 1.61c.24 1.64 1.82 3.02 3.5 2.87c1.12-.01 2.19-.66 2.77-1.61c.19-.33.4-.67.41-1.06c.1-1.79.06-3.57.07-5.36c.01-4.03-.01-8.05.02-12.07Z"/></svg>
        </a>
        {% endif %}
        {% if shop.youtube_url %}
        <a href="{{ shop.youtube_url }}" class="ft__social-icon" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
        </a>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <div class="ft__cols">
      {% if hasLinks %}
      <div class="ft__col">
        <span class="ft__col-heading">{{ global.components.footer.links_title if global.components.footer.links_title else 'Navigation' }}</span>
        <ul class="ft__links">
          {% for link in global.components.footer.links %}
          <li><a href="{{ link.link | shopUrl }}" target="{{ '_blank' if link.new_tab }}" class="ft__link">{{ link.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {% if hasLinks2 %}
      <div class="ft__col">
        <span class="ft__col-heading">{{ global.components.footer.links_2_title if global.components.footer.links_2_title else 'Legal' }}</span>
        <ul class="ft__links">
          {% for link in global.components.footer.links_2 %}
          <li><a href="{{ link.link | shopUrl }}" target="{{ '_blank' if link.new_tab }}" class="ft__link">{{ link.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {% if hasSocials %}
      <div class="ft__col">
        <span class="ft__col-heading">Socials</span>
        <ul class="ft__links">
          {% if shop.discord_url %}<li><a href="{{ shop.discord_url }}" class="ft__link" target="_blank" rel="noopener">Discord</a></li>{% endif %}
          {% if shop.telegram_url %}<li><a href="{{ shop.telegram_url }}" class="ft__link" target="_blank" rel="noopener">Telegram</a></li>{% endif %}
          {% if shop.instagram_url %}<li><a href="{{ shop.instagram_url }}" class="ft__link" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
          {% if shop.tiktok_url %}<li><a href="{{ shop.tiktok_url }}" class="ft__link" target="_blank" rel="noopener">TikTok</a></li>{% endif %}
          {% if shop.youtube_url %}<li><a href="{{ shop.youtube_url }}" class="ft__link" target="_blank" rel="noopener">YouTube</a></li>{% endif %}
        </ul>
      </div>
      {% endif %}
    </div>
  </div>

  <div class="ft__pay">
    <span class="ft__pay-label">SECURE CHECKOUT</span>
    <span class="ft__pay-item">VISA</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">Mastercard</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">Apple&nbsp;Pay</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">Google&nbsp;Pay</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">BTC</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">ETH</span><span class="ft__pay-dot">·</span>
    <span class="ft__pay-item">LTC</span>
  </div>

  <div class="zzfc">
    <span class="zzfc__t">Made it all the way down here? <strong>Your key takes about a minute.</strong></span>
    <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="zznx__btn">Get your key</a>
    <a href="{{ '/status' | shopUrl }}" class="zznx__btn zznx__btn--ghost">Live status</a>
  </div>

  <div class="ft__bottom">
    <span class="ft__copy">&copy; 2026 {{ shop.name }}. All rights reserved.</span>
    <div class="ft__bottom-links">
      <a href="{{ '/terms-of-service' | shopUrl }}" class="ft__bottom-link">Terms</a>
      <span class="ft__bottom-sep">/</span>
      <a href="{{ '/refund-policy' | shopUrl }}" class="ft__bottom-link">Refunds</a>
      <span class="ft__bottom-sep">/</span>
      <a href="{{ '/privacy-policy' | shopUrl }}" class="ft__bottom-link">Privacy</a>
    </div>
  </div>

</footer>

<style>
.ft {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #06091a 0%, #080b1e 100%);
  border-top: 1px solid rgba(191,64,191, 0.12);
  box-sizing: border-box;
  overflow: hidden;
  font-family: 'Satoshi', 'Inter', system-ui, sans-serif;
}

.ft__glow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(191,64,191, 0.5) 30%, rgba(124,58,237, 0.6) 50%, rgba(191,64,191, 0.5) 70%, transparent);
  pointer-events: none;
  z-index: 0;
}

.ft__glow::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 120px;
  background: radial-gradient(ellipse at bottom, rgba(124,58,237, 0.09) 0%, transparent 70%);
  pointer-events: none;
}

.ft__main {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 64px 24px 56px;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 80px;
  box-sizing: border-box;
}

.ft__brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  flex: 0 0 auto;
  max-width: 320px;
}

.ft__brand-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
}

.ft__logo {
  height: 32px;
  width: auto;
  display: block;
  flex-shrink: 0;
  border-radius: 6px;
}

.ft__name {
  font-size: 26px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.035em;
  line-height: 1;
  white-space: nowrap;
}

.ft__tagline {
  font-size: 14px;
  font-weight: 400;
  color: rgba(200, 215, 240, 0.65);
  line-height: 1.5;
  margin: 0;
  letter-spacing: -0.01em;
}

.ft__badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(191, 64, 191, 0.07);
  border: 1px solid rgba(191, 64, 191, 0.2);
  border-radius: 9999px;
  padding: 5px 12px;
  text-decoration: none;
  transition: border-color .2s, background .2s;
}

.ft__badge:hover {
  border-color: rgba(191, 64, 191, 0.5);
  background: rgba(191, 64, 191, 0.12);
}

.ft__badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 9999px;
  background: #c084fc;
  flex-shrink: 0;
  animation: ft-pulse 2s ease-in-out infinite;
  box-shadow: 0 0 6px rgba(191, 64, 191, 0.7);
}

@keyframes ft-pulse {
  0%, 100% { opacity: 0.9; }
  50% { opacity: 0.3; }
}

.ft__badge-text {
  font-size: 12px;
  font-weight: 500;
  color: rgba(220, 190, 245, 0.92);
  letter-spacing: -0.01em;
  white-space: nowrap;
}

.ft__contact {
  margin: 2px 0 0;
  font-size: 12.5px;
  color: rgba(200, 215, 240, 0.55);
  letter-spacing: -0.01em;
}

.ft__contact-link {
  color: rgba(200, 215, 240, 0.8);
  text-decoration: none;
  border-bottom: 1px solid rgba(200, 215, 240, 0.25);
  transition: color .2s, border-color .2s;
}

.ft__contact-link:hover {
  color: #fff;
  border-color: rgba(191, 64, 191, 0.6);
}

.ft__contact-sep {
  margin: 0 4px;
  opacity: .5;
}

.ft__social-icons {
  display: flex;
  gap: 10px;
  margin-top: 4px;
}

.ft__social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(191,64,191, 0.08);
  border: 1px solid rgba(191,64,191, 0.18);
  color: rgba(200, 215, 240, 0.75);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.ft__social-icon:hover {
  background: rgba(191,64,191, 0.18);
  border-color: rgba(191,64,191, 0.4);
  color: #ffffff;
  transform: translateY(-3px);
}

.ft__cols {
  display: flex;
  flex-direction: row;
  gap: 56px;
  flex: 0 0 auto;
}

.ft__col {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 100px;
}

.ft__col-heading {
  font-size: 11px;
  font-weight: 700;
  color: rgba(200, 215, 240, 0.8);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.ft__links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ft__link {
  font-size: 13px;
  font-weight: 400;
  color: rgba(200, 215, 240, 0.7);
  text-decoration: none;
  letter-spacing: -0.01em;
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}

.ft__link:hover {
  color: #ffffff;
  transform: translateX(2px);
}

.ft__bottom {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 24px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.ft__copy {
  font-size: 12px;
  font-weight: 400;
  color: rgba(200, 215, 240, 0.55);
  letter-spacing: -0.01em;
}

.ft__bottom-links {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10px;
}

.ft__bottom-sep {
  font-size: 12px;
  color: rgba(200, 215, 240, 0.25);
}

.ft__bottom-link {
  font-size: 12px;
  font-weight: 400;
  color: rgba(200, 215, 240, 0.55);
  text-decoration: none;
  letter-spacing: -0.01em;
  transition: color 0.2s ease;
}

.ft__bottom-link:hover {
  color: rgba(200, 215, 240, 0.95);
}

@media (max-width: 768px) {
  .ft__main {
    flex-direction: column;
    gap: 40px;
    padding: 48px 20px 40px;
  }

  .ft__brand {
    max-width: 100%;
  }

  .ft__cols {
    gap: 32px;
    flex-wrap: wrap;
  }

  .ft__col {
    min-width: calc(50% - 16px);
  }

  .ft__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px;
  }
}
</style>

{% endif %}

<style>
.ft__pay{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;
  padding:14px 0 4px;border-top:1px solid rgba(255,255,255,.05);margin-top:8px}
.ft__pay-label{font-family:'JetBrains Mono',monospace;font-size:.58rem;letter-spacing:.2em;color:rgba(200,215,240,.35);margin-right:4px}
.ft__pay-item{font-size:.72rem;font-weight:800;font-style:italic;color:rgba(220,232,255,.55)}
.ft__pay-dot{color:rgba(200,215,240,.25)}
</style>
