{#
  buy-faq.njk — Pre-purchase objection handling for the product page.
  IMPORTANT (SellAuth Nunjucks constraint): everything here is static HTML.
  No {% set %} arrays, no {% for %} over synthetic data.
  Reviews below are real reviews copied verbatim from components/feedbacks.njk.
#}

<section class="bfq">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What exactly do I get after paying?",
      "acceptedAnswer": { "@type": "Answer", "text": "Your loader download and serial key are issued automatically the moment payment clears — shown on screen and saved to your account. Run the loader, enter your key, and you're in-game." }
    },
    {
      "@type": "Question",
      "name": "Is the current build up and working right now?",
      "acceptedAnswer": { "@type": "Answer", "text": "Zaza Cheats publishes a live status page at zazacheats.net/status showing the current state of every build, so buyers can verify before purchasing." }
    },
    {
      "@type": "Question",
      "name": "What happens if the build goes down after I buy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Short maintenance windows (game updates, re-verification) are part of running any private build and aren't compensated. If the build is offline for a continuous 24 hours or more, we add that time back to your key or replace it once the build is back up." }
    },
    {
      "@type": "Question",
      "name": "How do I pay, and is checkout safe?",
      "acceptedAnswer": { "@type": "Answer", "text": "Checkout is handled by an automated payment system with payment options shown at the next step. Orders and keys are tied to your email so purchases can always be recovered." }
    },
    {
      "@type": "Question",
      "name": "How do I pay with crypto?",
      "acceptedAnswer": { "@type": "Answer", "text": "Choose a crypto option at checkout, send the exact shown amount to the displayed wallet address from any exchange or wallet app, and the order completes automatically on confirmation. The key is shown on screen and saved to the account, the same as a card purchase." }
    },
    {
      "@type": "Question",
      "name": "What's the cheapest way to test it before committing?",
      "acceptedAnswer": { "@type": "Answer", "text": "The shortest key duration listed on the product is priced as a low-cost way to test the loader, features and support before buying a longer key. Questions can be asked for free on the Zaza Cheats Discord first." }
    },
    {
      "@type": "Question",
      "name": "What's your refund policy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Full details are published at zazacheats.net/refund-policy. Most issues are resolved via Discord support without needing a refund." }
    },
    {
      "@type": "Question",
      "name": "How do I get support before buying?",
      "acceptedAnswer": { "@type": "Answer", "text": "Join the Zaza Cheats Discord at discord.gg/zazacheats to ask questions before purchasing, or email support@zazacheats.net." }
    }
  ]
}
</script>

  <div class="bfq__inner">

    <div class="bfq__reviews" id="zz-reviews">
      <p class="bfq__eyebrow">// WHAT BUYERS SAY</p>
      <div class="bfq__review-grid">
        {# Two of the carried-over reviews, quoted verbatim from the array in
           components/feedbacks.njk. Kept as a 5 and a 4 on purpose: a buy-page
           panel showing nothing but five stars is the least persuasive thing
           you can put next to a price. The byline said "ShadowByte92" here and
           "Verified buyer" on all 39 others, which only ever raised the
           question of where that one name came from. #}
        <div class="bfq__review">
          <div class="bfq__review-head">
            <span class="bfq__review-stars" aria-hidden="true">★★★★★</span>
            <span class="bfq__review-user">Verified buyer</span>
          </div>
          <p class="bfq__review-text">Couple of months on it now. It&#x27;s come through the last few Rust updates without a flag, which is more than I can say for the one I used before this.</p>
        </div>
        <div class="bfq__review">
          <div class="bfq__review-head">
            <span class="bfq__review-stars" aria-hidden="true">★★★★☆</span>
            <span class="bfq__review-user">Verified buyer</span>
          </div>
          <p class="bfq__review-text">Undetected, installed fine, no issues there. The only thing holding it back for me is I&#x27;d like more to fiddle with in the menu. Asked about it and got a straight answer rather than a sales pitch, so fair enough. Still using it.</p>
        </div>
      </div>
      <a href="/feedback" class="bfq__review-link">Read all <span data-zz-rc>100</span> verified reviews →</a>
      <p class="bfq__review-prov">Carried over from our previous storefront. New reviews post automatically after purchase.</p>
    </div>

    <div class="bfq__faq">
      <p class="bfq__eyebrow">// BEFORE YOU BUY</p>
      <h3 class="bfq__title">Common questions, answered straight</h3>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>What exactly do I get after paying?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Your loader download and serial key are issued automatically the moment payment clears — shown on screen and saved to your account. No waiting on a human, no manual delivery. Run the loader, enter your key, and you're in-game.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>Is the current build up and working right now?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Check the live status badge at the top of this page and our <a href="/status">status page</a> — we keep it updated so you can see the current state of the build before you buy, not after.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>What happens if the build goes down after I buy?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Short maintenance windows (game updates, re-verification) are part of running any private build and aren't compensated. If the build is offline for a continuous 24 hours or more, we add that time back to your key or replace it once it's back up.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>How do I pay, and is checkout safe?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Checkout is handled by an automated payment system — you'll see all available payment options on the next step after hitting Buy Now. Your order and key are tied to your email, so you can always recover your purchase.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>How do I pay with crypto? I've never done it before.</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>It takes about two minutes even if it's your first time. Hit Buy Now, pick a crypto option at checkout, and you'll be shown an exact amount and a wallet address (with a QR code). Send that amount from any exchange app or wallet — Coinbase, Kraken, Binance, whatever you already use — and the order completes automatically once the payment confirms. Your key is then shown on screen and saved to your account, same as a card purchase. If your card gets declined, crypto is the reliable fallback: no bank in the middle to block it.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>I'm not sure yet — what's the cheapest way to test it?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Grab the shortest key duration listed above. It's priced so you can test everything yourself — the loader, the features, the support — before committing to a longer key. Most long-key customers started exactly that way. And if you have questions first, ask on <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener">Discord</a> before spending anything.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>What's your refund policy?</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Full details are in our <a href="/refund-policy">refund policy</a>. If something's genuinely wrong on our end, talk to us on <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" >Discord</a> first — most issues get resolved without needing a refund at all.</p>
        </div>
      </details>

      <details class="bfq__item">
        <summary class="bfq__q">
          <span>I have a question that isn't answered here.</span>
          <svg class="bfq__chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="bfq__a">
          <p>Join our <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" >Discord</a> and ask — you can see the community and get a real answer before spending anything. You can also email <a href="mailto:support@zazacheats.net">support@zazacheats.net</a>.</p>
        </div>
      </details>
    </div>

  </div>
</section>

<style>
.bfq{padding:56px 0 24px;font-family:var(--zz-sans)}
.bfq__inner{max-width:1100px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start}
@media (max-width:900px){.bfq__inner{grid-template-columns:1fr;gap:36px}}
.bfq__eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.68rem;letter-spacing:.12em;color:#BF40BF;margin:0 0 10px}
.bfq__title{font-size:1.45rem;font-weight:700;color:#fff;margin:0 0 18px;line-height:1.25}

.bfq__review-grid{display:flex;flex-direction:column;gap:14px}
.bfq__review{padding:16px 18px;border:1px solid rgba(191,64,191,.16);border-radius:14px;background:rgba(255,255,255,.02)}
.bfq__review-head{display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.bfq__review-stars{color:#fbbf24;font-size:.85rem;letter-spacing:.04em}
.bfq__review-user{font-size:.74rem;color:rgba(200,215,240,.55)}
.bfq__review-text{margin:0;font-size:.87rem;line-height:1.6;color:rgba(220,230,245,.85)}
.bfq__review-link{display:inline-block;margin-top:14px;font-size:.82rem;font-weight:700;color:#c084fc;text-decoration:none}
.bfq__review-link:hover{color:#e0b3ff;text-decoration:underline}
.bfq__review-prov{margin:5px 0 0;font-size:.7rem;color:rgba(200,215,240,.65);line-height:1.5}

.bfq__item{border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(255,255,255,.02);margin-bottom:10px;overflow:hidden;transition:border-color .2s;interpolate-size:allow-keywords}
/* smooth open/close where ::details-content is supported; older browsers keep
   the instant toggle, reduced-motion users get none */
.bfq__item::details-content{block-size:0;overflow:hidden;
  transition:block-size .32s cubic-bezier(.22,1,.36,1),content-visibility .32s allow-discrete}
.bfq__item[open]::details-content{block-size:auto}
@media (prefers-reduced-motion:reduce){.bfq__item::details-content{transition:none}}
.bfq__item[open]{border-color:rgba(191,64,191,.35)}
.bfq__q{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;cursor:pointer;
  font-size:.92rem;font-weight:700;color:#fff;list-style:none;user-select:none}
.bfq__q::-webkit-details-marker{display:none}
.bfq__chev{flex-shrink:0;color:rgba(200,215,240,.5);transition:transform .25s}
.bfq__item[open] .bfq__chev{transform:rotate(180deg)}
.bfq__a{padding:0 16px 16px}
.bfq__a p{margin:0;font-size:.86rem;line-height:1.65;color:rgba(200,215,240,.72)}
.bfq__a a{color:#c084fc;font-weight:500;text-decoration:none}
.bfq__a a:hover{text-decoration:underline}
</style>
