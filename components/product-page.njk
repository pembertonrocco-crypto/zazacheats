{# ---------- EXIT-INTENT (desktop, once per session, honest copy) ---------- #}
<div class="zz-exit" id="zz-exit" role="dialog" aria-modal="true" aria-labelledby="zz-exit-title" hidden>
  <div class="zz-exit__backdrop" data-zz-exit-close></div>
  <div class="zz-exit__panel">
    <button type="button" class="zz-exit__x" aria-label="Close" data-zz-exit-close>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <p class="zz-exit__eyebrow">// BEFORE YOU GO</p>
    <h3 class="zz-exit__title" id="zz-exit-title">Something holding you back?</h3>
    <p class="zz-exit__d">No pressure — but if you're unsure about anything, you don't have to guess. Check the real state of the build, or ask us directly and spend nothing.</p>
    <div class="zz-exit__btns">
      <a href="{{ '/status' | shopUrl }}" class="zz-exit__btn zz-exit__btn--status">
        <span class="zz-exit__pulse" aria-hidden="true"></span>
        See Live Status
      </a>
      <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener" class="zz-exit__btn zz-exit__btn--dc">Ask Us on Discord</a>
    </div>
    <button type="button" class="zz-exit__dismiss" data-zz-exit-close>No thanks, just browsing</button>
  </div>
</div>

<style>
.zz-exit{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;padding:20px;
  font-family:'Satoshi','Inter',system-ui,sans-serif}
.zz-exit[hidden]{display:none}
.zz-exit__backdrop{position:absolute;inset:0;background:rgba(4,6,16,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.zz-exit__panel{position:relative;max-width:420px;width:100%;padding:30px 28px 24px;border-radius:18px;
  border:1px solid rgba(191,64,191,.28);
  background:linear-gradient(180deg,rgba(26,16,38,.98),rgba(9,12,26,.98));
  box-shadow:0 30px 80px -20px rgba(0,0,0,.8),0 0 60px -20px rgba(191,64,191,.35);
  animation:zzExitIn .3s cubic-bezier(.16,1,.3,1)}
@keyframes zzExitIn{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}
.zz-exit__x{position:absolute;top:12px;right:12px;display:inline-flex;padding:8px;border-radius:9px;border:none;
  background:rgba(255,255,255,.06);color:rgba(200,215,240,.7);cursor:pointer}
.zz-exit__x:hover{background:rgba(255,255,255,.12);color:#fff}
.zz-exit__eyebrow{font-family:'JetBrains Mono',monospace;font-size:.62rem;letter-spacing:.14em;color:#d98ad9;margin:0 0 8px}
.zz-exit__title{margin:0 0 8px;font-size:1.35rem;font-weight:800;color:#fff}
.zz-exit__d{margin:0 0 18px;font-size:.86rem;line-height:1.55;color:rgba(205,218,242,.72)}
.zz-exit__btns{display:flex;flex-direction:column;gap:10px}
.zz-exit__btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:.85rem 1.2rem;border-radius:11px;
  font-weight:700;font-size:.9rem;text-decoration:none;transition:filter .2s}
.zz-exit__btn--status{background:linear-gradient(135deg,#BF40BF,#7C3AED);color:#fff;
  box-shadow:0 8px 24px -10px rgba(191,64,191,.8)}
.zz-exit__btn--status:hover{filter:brightness(1.12)}
.zz-exit__btn--dc{border:1px solid rgba(200,215,240,.22);color:rgba(220,230,250,.9)}
.zz-exit__btn--dc:hover{border-color:rgba(200,215,240,.45)}
.zz-exit__pulse{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.6);
  animation:zzExitPulse 1.8s infinite}
@keyframes zzExitPulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.55)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.zz-exit__dismiss{display:block;margin:14px auto 0;background:none;border:none;cursor:pointer;
  font-size:.75rem;color:rgba(200,215,240,.45);text-decoration:underline}
.zz-exit__dismiss:hover{color:rgba(200,215,240,.75)}
@media (prefers-reduced-motion:reduce){.zz-exit__panel,.zz-exit__pulse{animation:none}}
</style>

<script>
(function(){
  var KEY='zz-exit-shown';
  // Desktop only, once per session, and never on touch devices (mouseleave is meaningless there).
  if(window.matchMedia('(pointer: coarse)').matches) return;
  try{ if(sessionStorage.getItem(KEY)) return; }catch(e){ return; }

  var modal=document.getElementById('zz-exit');
  if(!modal) return;
  var armed=false, shown=false;

  // Don't fire in the first 15s — give them time to actually read.
  setTimeout(function(){ armed=true; }, 15000);

  function show(){
    if(shown || !armed) return;
    shown=true;
    try{ sessionStorage.setItem(KEY,'1'); }catch(e){}
    modal.hidden=false;
    document.documentElement.style.overflow='hidden';
  }
  function hide(){
    modal.hidden=true;
    document.documentElement.style.overflow='';
  }

  document.addEventListener('mouseout',function(e){
    if(!e.relatedTarget && e.clientY<=0) show();
  });
  modal.querySelectorAll('[data-zz-exit-close]').forEach(function(el){
    el.addEventListener('click',hide);
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape' && !modal.hidden) hide();
  });
})();
</script>

{% if 'latestOrders' in liveStats and liveStats.latestOrders|length > 0 %}
<link href="https://cdn.jsdelivr.net/npm/flag-icons@7.3.2/css/flag-icons.min.css" rel="stylesheet" integrity="sha256-tyPeBlnZW2qWbAF1hQiCt9qo6SOgOSymvJBum+FrrwI=" crossorigin="anonymous">
<div x-data="salesNotifications" x-cloak class="pp-notif-container">
  <div x-show="show" x-transition:enter="pp-notif-enter" x-transition:enter-start="pp-notif-enter-start" x-transition:enter-end="pp-notif-enter-end" x-transition:leave="pp-notif-leave" x-transition:leave-start="pp-notif-leave-start" x-transition:leave-end="pp-notif-leave-end" class="pp-notif">
    <template x-if="order">
      <div class="pp-notif__inner">
        {% if product.image_urls|length > 0 %}
        <div class="pp-notif__img-wrap">
          <img src="{{ product.image_urls[0] }}" alt="{{ product.name }}" class="pp-notif__img" loading="lazy" decoding="async">
        </div>
        {% endif %}
        <div class="pp-notif__text">
          <p class="pp-notif__primary">
            Someone
            <template x-if="order.country_code">
              <span>from <i :class="`fi fi-${order.country_code.toLowerCase()}`"></i></span>
            </template>
            purchased
          </p>
          <p class="pp-notif__product">{{ product.name }}</p>
          <p class="pp-notif__time" x-text="getTimeAgo(order.completed_at)"></p>
        </div>
      </div>
    </template>
  </div>
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('salesNotifications', () => ({
      displayTime: 8000,
      initTimeMin: 2000,
      initTimeMax: 4000,
      nextTimeMin: 8000,
      nextTimeMax: 12000,
      latestOrders: {{ liveStats.latestOrders | json }},
      show: false,
      get order() { return this.latestOrders.length > 0 ? this.latestOrders[0] : null; },
      getRandomInterval(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; },
      getTimeAgo(input) {
        const date = (input instanceof Date) ? input : new Date(input);
        const formatter = new Intl.RelativeTimeFormat('en');
        const ranges = { years: 3600*24*365, months: 3600*24*30, weeks: 3600*24*7, days: 3600*24, hours: 3600, minutes: 60, seconds: 1 };
        const secondsElapsed = (date.getTime() - Date.now()) / 1000;
        for (let key in ranges) { if (ranges[key] < Math.abs(secondsElapsed)) { return formatter.format(Math.round(secondsElapsed / ranges[key]), key); } }
        return 'just now';
      },
      showNotification() {
        if (this.latestOrders.length === 0) return;
        this.show = true;
        setTimeout(() => {
          this.show = false;
          setTimeout(() => {
            this.latestOrders.shift();
            if (this.latestOrders.length > 0) { setTimeout(() => this.showNotification(), this.getRandomInterval(this.nextTimeMin, this.nextTimeMax)); }
          }, 500);
        }, this.displayTime);
      },
      init() { setTimeout(() => this.showNotification(), this.getRandomInterval(this.initTimeMin, this.initTimeMax)); }
    }));
  });
</script>
{% endif %}

