.fbq {
  position: relative;
  padding: 5rem 0;
  background: #06091a;
  overflow: hidden;
  font-family: 'Satoshi', 'Inter', system-ui, sans-serif;
}

.fbq__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
  padding: 0 1.5rem;
  margin-bottom: 3rem;
}

.fbq__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 999px;
  padding: 0.38rem 1.05rem 0.38rem 0.75rem;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.79rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.fbq__badge::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 6px;
  background: linear-gradient(90deg, transparent, rgba(180, 210, 255, 0.18) 40%, rgba(180, 210, 255, 0.18) 60%, transparent);
  border-radius: 999px;
  filter: blur(4px);
  pointer-events: none;
}

.fbq__badge::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15%;
  right: 15%;
  height: 6px;
  background: linear-gradient(90deg, transparent, rgba(180, 210, 255, 0.12) 40%, rgba(180, 210, 255, 0.12) 60%, transparent);
  border-radius: 999px;
  filter: blur(4px);
  pointer-events: none;
}

.fbq__title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.08;
  margin: 0;
  background: linear-gradient(180deg, #ffffff 0%, #ffffff 65%, #dae6ff 85%, #a8c4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.fbq__subtitle {
  font-size: clamp(0.875rem, 1.4vw, 0.97rem);
  line-height: 1.8;
  color: rgba(200, 215, 240, 0.45);
  max-width: 520px;
  margin: 0;
  font-weight: 400;
}

.fbq__marquee-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 1100px;
  margin: 0 auto;
}

.fbq__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 120px;
  z-index: 2;
  pointer-events: none;
}

.fbq__fade--left {
  left: 0;
  background: linear-gradient(to right, #06091a 0%, rgba(6, 9, 26, 0.7) 50%, transparent 100%);
}

.fbq__fade--right {
  right: 0;
  background: linear-gradient(to left, #06091a 0%, rgba(6, 9, 26, 0.7) 50%, transparent 100%);
}

.fbq__row {
  overflow: hidden;
  width: 100%;
}

.fbq__track {
  display: flex;
  gap: 14px;
  width: max-content;
  will-change: transform;
}

.fbq__item {
  width: 300px;
  flex-shrink: 0;
