  background:radial-gradient(130% 90% at 50% -10%,#0a0c18 0%,#06070f 58%);
  font-family:var(--zz-sans);color:var(--ink)}
.af-page *{box-sizing:border-box}


.af-green{color:var(--g)}

.af-bg{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.af-bg__grid{position:absolute;inset:-2px;
  background-image:linear-gradient(rgba(191,64,191,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(191,64,191,.05) 1px,transparent 1px);
  background-size:46px 46px;-webkit-mask-image:radial-gradient(100% 60% at 50% 0%,#000 28%,transparent 78%);mask-image:radial-gradient(100% 60% at 50% 0%,#000 28%,transparent 78%)}
.af-bg__beam{position:absolute;border-radius:50%;filter:blur(100px);opacity:.4;}
.af-bg__beam--a{width:34rem;height:34rem;top:-12rem;left:-9rem;background:radial-gradient(circle,rgba(191,64,191,.5),transparent 65%)}
.af-bg__beam--b{width:30rem;height:30rem;top:-6rem;right:-9rem;background:radial-gradient(circle,rgba(34,197,94,.28),transparent 65%);animation-delay:-8s}

.af-wrap{position:relative;z-index:1;max-width:960px;margin:0 auto;padding:130px 20px 90px}
.af-rise{opacity:0;transform:translateY(20px);animation:afRise .8s cubic-bezier(.16,1,.3,1) forwards;animation-delay:var(--d,0s)}
@keyframes afRise{to{opacity:1;transform:translateY(0)}}

.af-head{text-align:center;margin-bottom:64px}
.af-eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;color:var(--v);font-size:.74rem;letter-spacing:.22em;margin:0}
.af-title{font-size:clamp(2.4rem,6.5vw,3.8rem);font-weight:700;letter-spacing:-.03em;margin:.45rem 0 0;color:#fff}
.af-subtitle{color:var(--mut);font-size:1.06rem;line-height:1.65;max-width:620px;margin:.8rem auto 0}
.af-subtitle strong{font-weight:700}
.af-hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:26px}
.af-hero-chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
.af-chip{display:inline-flex;align-items:center;gap:7px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.68rem;letter-spacing:.14em;
  color:rgba(231,236,255,.7);border:1px solid rgba(255,255,255,.1);border-radius:999px;padding:7px 13px;background:rgba(255,255,255,.03)}
.af-dot{width:7px;height:7px;border-radius:50%;background:var(--g);box-shadow:0 0 10px var(--g);animation:afPulse 2s infinite}
@keyframes afPulse{0%,100%{opacity:1}50%{opacity:.45}}

.af-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:12px;
  background:linear-gradient(135deg,var(--v),var(--b));color:#fff;font-weight:700;font-size:1rem;text-decoration:none;
  box-shadow:0 12px 32px -10px rgba(191,64,191,.8);transition:filter .25s,transform .25s,gap .25s}
.af-btn:hover{filter:brightness(1.1);transform:translateY(-2px);gap:13px;color:#fff}
.af-btn--ghost{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);box-shadow:none}
.af-btn--ghost:hover{background:rgba(255,255,255,.09)}
.af-btn--big{padding:16px 34px;font-size:1.08rem}

.af-section{margin-bottom:72px}
.af-h2{font-size:clamp(1.5rem,3.4vw,2rem);font-weight:700;letter-spacing:-.02em;margin:0 0 8px}
.af-lead{color:var(--mut);font-size:.98rem;margin:0 0 26px}

/* ---- tiers ---- */
.af-tiers{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.af-tier{position:relative;border:1px solid var(--edge);border-radius:18px;padding:26px 20px;background:var(--panel);
  backdrop-filter:blur(14px);text-align:center;transition:transform .25s,border-color .25s}
.af-tier:hover{transform:translateY(-4px);border-color:rgba(191,64,191,.35)}
.af-tier--hot{border-color:rgba(34,197,94,.4);background:linear-gradient(160deg,rgba(34,197,94,.1),rgba(10,12,24,.62))}
.af-tier--hot:hover{border-color:rgba(34,197,94,.65)}
.af-tier__badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);white-space:nowrap;
  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.62rem;letter-spacing:.16em;font-weight:700;color:#0a0c18;
  background:linear-gradient(135deg,#4ade80,var(--g));border-radius:999px;padding:5px 12px;box-shadow:0 6px 18px -6px rgba(34,197,94,.8)}
.af-tier__name{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.76rem;letter-spacing:.18em;color:var(--mut);margin:0 0 10px;text-transform:uppercase}
.af-tier__pct{font-size:2.9rem;font-weight:700;letter-spacing:-.04em;margin:0;line-height:1;color:#fff}
.af-tier__pct span{font-size:1.4rem;color:var(--mut)}
.af-tier--hot .af-tier__pct{color:var(--g)}
.af-tier__per{font-weight:700;font-size:.95rem;color:#fff;margin:12px 0 2px}
.af-tier__note{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.72rem;color:rgba(231,236,255,.65);margin:0}

/* ---- earnings math ---- */
.af-math{border:1px solid var(--edge);border-radius:18px;background:var(--panel);backdrop-filter:blur(14px);padding:10px 26px}
.af-math__row{display:flex;align-items:baseline;gap:16px;padding:16px 0;border-top:1px solid rgba(255,255,255,.05)}
.af-math__row:first-child{border-top:none}
.af-math__calc{color:var(--mut);font-size:.96rem;white-space:nowrap}
.af-math__calc em{font-style:normal;color:var(--v);font-weight:700;padding:0 2px}
.af-math__line{flex:1;border-bottom:1px dashed rgba(255,255,255,.12);transform:translateY(-4px)}
.af-math__total{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-weight:700;font-size:1.05rem;color:#fff;white-space:nowrap}
.af-math__row--sum .af-math__calc{color:#fff;font-weight:700}
.af-math__row--sum .af-math__total{font-size:1.3rem}
.af-fine{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.72rem;color:rgba(231,236,255,.65);margin:12px 4px 0}

/* ---- steps ---- */
.af-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.af-step{border:1px solid var(--edge);border-radius:18px;padding:26px 24px;background:var(--panel);backdrop-filter:blur(14px)}
.af-step__num{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.8rem;font-weight:700;color:#e6aaff;
  display:inline-grid;place-items:center;width:34px;height:34px;border-radius:9px;
  background:rgba(191,64,191,.16);border:1px solid rgba(191,64,191,.3)}
.af-step__t{font-size:1.08rem;font-weight:700;margin:14px 0 8px}
.af-step__p{color:var(--mut);font-size:.92rem;line-height:1.6;margin:0}
.af-step__p a{color:#e6aaff;text-decoration:none}
.af-step__p a:hover{color:#fff;text-decoration:underline}
.af-step__p code{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.8rem;background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.1);border-radius:5px;padding:2px 6px;color:#fff;word-break:break-all}

/* ---- leaderboard ---- */
.af-lb-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:26px}
.af-lb-head .af-lead{margin-bottom:0}
.af-lb-live{display:inline-flex;align-items:center;gap:8px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.68rem;
  letter-spacing:.14em;color:#4ade80;border:1px solid rgba(34,197,94,.3);background:rgba(34,197,94,.08);border-radius:999px;padding:8px 14px}
.af-podium{display:grid;grid-template-columns:1fr 1.15fr 1fr;gap:12px;align-items:end;margin-bottom:14px}
.af-podium__spot{position:relative;border-radius:18px;padding:26px 18px 22px;text-align:center;
  border:1px solid var(--edge);background:var(--panel);backdrop-filter:blur(14px)}
.af-podium__spot--1{border-color:rgba(251,191,36,.45);background:linear-gradient(160deg,rgba(251,191,36,.12),rgba(10,12,24,.62));padding-top:38px;padding-bottom:34px}
.af-podium__spot--2{border-color:rgba(148,163,184,.35);background:linear-gradient(160deg,rgba(148,163,184,.09),rgba(10,12,24,.62))}
.af-podium__spot--3{border-color:rgba(251,191,36,.35);background:linear-gradient(160deg,rgba(251,191,36,.09),rgba(10,12,24,.62))}
.af-podium__rank{position:absolute;top:-14px;left:50%;transform:translateX(-50%);width:30px;height:30px;border-radius:50%;
  display:grid;place-items:center;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-weight:700;font-size:.88rem;color:#06070f}
.af-podium__spot--1 .af-podium__rank{background:linear-gradient(135deg,#fde047,var(--gold));box-shadow:0 6px 18px -4px rgba(251,191,36,.7)}
.af-podium__spot--2 .af-podium__rank{background:linear-gradient(135deg,#e7ecff,var(--silver))}
.af-podium__spot--3 .af-podium__rank{background:linear-gradient(135deg,#fbbf24,var(--bronze))}
.af-podium__name{font-weight:700;font-size:1.15rem;margin:6px 0 4px;color:#fff}
.af-podium__spot--1 .af-podium__name{font-size:1.3rem}
.af-podium__name--open{color:rgba(231,236,255,.4);font-style:italic;font-weight:500}
.af-podium__amt{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-weight:700;color:var(--g);margin:0;font-size:1.02rem}
.af-podium__amt--open{color:rgba(231,236,255,.35);font-weight:500;font-size:.82rem}
.af-lb-table{border:1px solid var(--edge);border-radius:16px;background:var(--panel);backdrop-filter:blur(14px);overflow:hidden}
.af-lb-row{display:flex;align-items:center;gap:16px;padding:14px 22px;border-top:1px solid rgba(255,255,255,.05)}
.af-lb-row:first-child{border-top:none}
.af-lb-row__rank{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-weight:700;font-size:.85rem;color:var(--mut);width:26px}
.af-lb-row__name{flex:1;font-weight:700;color:#fff}
.af-lb-row--open .af-lb-row__name{color:rgba(231,236,255,.35);font-weight:500;font-style:italic}
.af-lb-row__amt{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-weight:700;color:var(--g)}
.af-lb-row--open .af-lb-row__amt{color:rgba(231,236,255,.3)}
.af-lb-pitch{text-align:center;color:var(--mut);font-size:.92rem;margin:18px 0 0}
.af-lb-pitch a{color:#e6aaff;text-decoration:none;font-weight:700}
.af-lb-pitch a:hover{color:#fff}

/* ---- rules ---- */
.af-rules{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.af-rule{border:1px solid var(--edge);border-radius:18px;padding:24px;background:var(--panel);backdrop-filter:blur(14px)}
.af-rule__t{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.9rem;font-weight:700;color:#fff;margin:0 0 8px}
.af-rule__p{color:var(--mut);font-size:.92rem;line-height:1.6;margin:0}

/* ---- final cta ---- */
.af-cta{text-align:center;border:1px solid rgba(191,64,191,.3);border-radius:22px;padding:52px 28px;
  background:linear-gradient(135deg,rgba(191,64,191,.12),rgba(191,64,191,.05));backdrop-filter:blur(14px)}
.af-cta__t{font-size:clamp(1.5rem,3.6vw,2.1rem);font-weight:700;letter-spacing:-.02em;margin:0 0 8px}
.af-cta__p{color:var(--mut);margin:0 0 24px}

@media (max-width:860px){
  .af-tiers{grid-template-columns:1fr 1fr}
  .af-steps{grid-template-columns:1fr}
  .af-rules{grid-template-columns:1fr}
}
@media (max-width:560px){
  .af-wrap{padding:104px 16px 64px}
  .af-tiers{grid-template-columns:1fr 1fr;gap:10px}
  .af-tier{padding:22px 12px}
  .af-tier__pct{font-size:2.3rem}
  .af-podium{grid-template-columns:1fr;align-items:stretch}
  .af-podium__spot--1{order:-1}
  .af-math{padding:6px 16px}
  .af-math__row{flex-wrap:wrap;gap:8px}
  .af-math__line{display:none}
  .af-math__total{margin-left:auto}
}
@media (prefers-reduced-motion:reduce){
  .af-page *{animation:none!important}
  .af-rise{opacity:1!important;transform:none!important}
}
</style>


{% elif custom_page.path == 'pay' or custom_page.path == 'secure-checkout' %}

{# ============================================================================
   checkout.njk — custom checkout for Zaza Cheats (renders at /pay)

   Uses only the shopUrl filter (safe on custom pages) plus window.shopId /
   window.apiBaseUrl runtime globals — no component-only Nunjucks vars, so it
   can't white-screen in the custom-page context.

   Price data comes from (1) a snapshot written by the cart / Buy Now button,
   (2) the internal cart API, or (3) a graceful item-count fallback. SellAuth
   always computes the real charge server-side, so display is never binding.
============================================================================ #}
<div class="container">
  <div class="zzco">
    <style>
    .zzco{--v:#BF40BF;--b:#8e2d8e;--acc:#e6aaff;--g:#22c55e;--a:#fbbf24;--r:#ef4444;
      --panel:#0a0c18;--void:#06070f;--edge:#1b1f3a;--edge2:#1b1f3a;
      --ink:#e7ecff;--mut:rgba(231,236,255,.62);--mut2:rgba(231,236,255,.4);
      font-family:var(--zz-sans);color:var(--ink);
      padding:6rem 0 4rem}
    .zzco *{box-sizing:border-box}
    .zzco__grid{display:grid;grid-template-columns:1fr;gap:1.4rem;max-width:1040px;margin:0 auto}
    @media (min-width:900px){.zzco__grid{grid-template-columns:minmax(0,1fr) 1.1fr;align-items:start}}

    /* ---------- summary ---------- */
    .zzco__eyebrow{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.7rem;letter-spacing:.2em;
      text-transform:uppercase;color:var(--mut);margin:0 0 .4rem}
    .zzco__amount{font-size:clamp(2rem,4vw,2.8rem);font-weight:700;letter-spacing:-.03em;margin:0 0 1.4rem;line-height:1;min-height:1px;color:#fff}
    .zzco__card{border:1px solid var(--edge);border-radius:16px;overflow:hidden;
      background:linear-gradient(150deg,var(--panel),rgba(6,7,15,.85))}
    .zzco__line{display:flex;align-items:center;gap:1rem;padding:1rem}
    .zzco__thumb{width:60px;height:60px;border-radius:12px;flex-shrink:0;overflow:hidden;border:1px solid var(--edge2);
      background:var(--void);display:grid;place-items:center;position:relative}
    .zzco__thumb img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;border-radius:inherit}
    .zzco__lbody{min-width:0;flex:1}
    .zzco__lname{font-weight:700;font-size:.9rem}
    .zzco__lvar{font-size:.74rem;color:var(--mut);margin-top:.1rem}
    .zzco__lqty{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.64rem;color:var(--mut2);border:1px solid var(--edge2);
      border-radius:5px;padding:.05rem .3rem;margin-left:.35rem}
    .zzco__lprice{margin-left:auto;font-weight:700;font-size:.9rem;white-space:nowrap}
    /* addon rows sit under their parent key: no thumbnail, indented to the
       width of one so they read as part of the item above, not a separate buy */
    .zzco__line--addon{padding:0 1rem .85rem calc(1rem + 60px + 1rem);margin-top:-.5rem}
    .zzco__line--addon .zzco__lname{font-weight:500;font-size:.82rem;color:var(--mut)}
    .zzco__line--addon .zzco__lprice{font-weight:700;font-size:.82rem;color:var(--mut)}
    .zzco__totals{padding:.3rem 1rem 1rem}
    .zzco__trow{display:flex;justify-content:space-between;font-size:.84rem;color:var(--mut);padding:.35rem 0}
    .zzco__trow--save{color:#4ade80}
    .zzco__trow--grand{border-top:1px solid var(--edge);margin-top:.25rem;padding-top:.7rem;color:#fff;font-weight:700;font-size:1.02rem}

    /* what happens next — removes post-click uncertainty */
    .zzco__next{margin-top:1rem;border:1px solid var(--edge);border-radius:14px;padding:.9rem 1rem;
      background:rgba(6,7,15,.5)}
    .zzco__next h4{margin:0 0 .6rem;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.66rem;letter-spacing:.16em;
      text-transform:uppercase;color:var(--mut)}
    .zzco__step{display:flex;gap:.6rem;align-items:flex-start;font-size:.78rem;padding:.22rem 0}
    .zzco__step b{flex-shrink:0;width:17px;height:17px;border-radius:50%;display:grid;place-items:center;
      font-size:.6rem;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--v),var(--b));margin-top:1px}
    .zzco__step span{color:var(--ink);opacity:.82}

    /* ---------- form ---------- */
    .zzco__form{border:1px solid var(--edge);border-radius:20px;padding:1.6rem;position:relative;overflow:hidden;
      background:linear-gradient(160deg,rgba(10,12,24,.9),rgba(6,7,15,.92))}
    .zzco__legend{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;
      color:var(--mut);margin:1.4rem 0 .7rem}
    .zzco__legend:first-child{margin-top:0}
    .zzco__field{border:1px solid var(--edge2);border-radius:12px;background:var(--void);padding:.65rem .9rem;
      transition:border-color .2s,box-shadow .2s}
    .zzco__field:focus-within{border-color:var(--v);box-shadow:0 0 0 3px rgba(191,64,191,.18)}
    .zzco__field.is-bad{border-color:rgba(239,68,68,.55)}
    .zzco__field label{display:block;font-size:.64rem;color:var(--mut2);margin-bottom:.1rem}
    .zzco__field input{width:100%;border:0;background:transparent;color:#fff;font-size:.9rem;font-family:inherit;outline:none}
    .zzco__hint{margin:.4rem 0 0;font-size:.7rem;color:var(--mut2);display:flex;align-items:center;gap:.35rem}
    .zzco__hint svg{width:12px;height:12px;flex-shrink:0}
    .zzco__coupon{display:flex;gap:.5rem}.zzco__coupon .zzco__field{flex:1}
    .zzco__cnote{margin:.45rem 0 0;font-size:.74rem;line-height:1.45;color:#4ade80}
    .zzco__cnote.is-warn{color:#fde047}
    .zzco__capply{border:1px solid var(--edge2);background:var(--panel);color:var(--ink);border-radius:12px;
      padding:0 1rem;font-weight:700;font-size:.8rem;cursor:pointer;transition:border-color .2s,color .2s}
    .zzco__capply:hover{border-color:var(--v);color:#fff}
    .zzco__capply.is-on{color:#4ade80;border-color:rgba(34,197,94,.5)}

    /* vibrant payment tiles */
    .zzco__pays{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
    @media (max-width:520px){.zzco__pays{grid-template-columns:1fr}}
    .zzco__pay{position:relative;display:flex;align-items:center;gap:.7rem;border:1px solid var(--edge2);border-radius:13px;
      background:var(--panel);padding:.75rem .85rem;cursor:pointer;overflow:hidden;
      transition:border-color .2s,transform .12s,background .2s,box-shadow .2s}
    .zzco__pay:hover{transform:translateY(-1px)}
    .zzco__pay::after{content:"";position:absolute;inset:0;opacity:0;transition:opacity .25s;pointer-events:none;
      background:radial-gradient(120% 90% at 12% 50%,var(--tint,rgba(191,64,191,.22)),transparent 62%)}
    .zzco__pay:hover::after,.zzco__pay.is-sel::after{opacity:1}
    .zzco__pay.is-sel{border-color:var(--ring,var(--v));
      box-shadow:0 0 0 1px var(--ring,var(--v)) inset,0 10px 26px -14px var(--ring,var(--v))}
    .zzco__pico{width:36px;height:36px;border-radius:10px;flex-shrink:0;display:grid;place-items:center;position:relative;
      background:var(--ico,#12162a)}
    .zzco__pico svg{width:21px;height:21px;display:block}
    .zzco__pbody{min-width:0;position:relative}
    .zzco__pname{font-size:.8rem;font-weight:700;line-height:1.15}
    .zzco__pvia{font-size:.64rem;color:var(--mut2)}
    .zzco__badge{margin-left:auto;position:relative;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.64rem;font-weight:700;
      border-radius:999px;padding:.14rem .48rem;white-space:nowrap}
    .zzco__badge--off{color:#4ade80;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3)}
    .zzco__badge--fee{color:#fbbf24;background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.32)}

    /* consent sits under the button now, not behind a required tickbox */
    .zzco__consent{margin:.7rem 0 0;text-align:center;font-size:.72rem;line-height:1.5;color:var(--mut2)}
    .zzco__consent a{color:var(--mut);text-decoration:none;border-bottom:1px solid rgba(255,255,255,.18)}
    .zzco__consent a:hover{color:#fff;border-color:var(--acc)}
    /* the button is always pressable; this only softens it while something
       upstream is still missing, so it reads as "not yet" rather than broken */
    .zzco__btn.is-waiting{opacity:.72}
    /* the removed terms checkbox used to supply the gap above the button */
    .zzco__btn{width:100%;border:0;cursor:pointer;color:#fff;font-weight:700;font-size:.98rem;padding:1rem;border-radius:14px;
      margin-top:1.4rem;
      display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
      background:linear-gradient(135deg,var(--v),var(--b));box-shadow:0 16px 38px -12px rgba(191,64,191,.85);
      transition:transform .15s,filter .15s}
    .zzco__btn:hover:not(:disabled){transform:translateY(-2px);filter:brightness(1.08)}
    .zzco__btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none}
    .zzco__err{margin-top:.9rem;font-size:.8rem;color:#f87171;background:rgba(239,68,68,.1);
      border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:.6rem .8rem;display:none}
    .zzco__note{margin-top:.8rem;text-align:center;font-size:.68rem;color:var(--mut2)}

    .zzco__trust{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--edge);
      display:flex;flex-wrap:wrap;gap:.5rem .9rem;justify-content:center;font-size:.7rem;color:var(--mut)}
    .zzco__trust span,.zzco__trust a{display:inline-flex;align-items:center;gap:.35rem}
    .zzco__trust a{color:var(--acc);text-decoration:none}
    .zzco__trust a:hover{text-decoration:underline}
    .zzco__trust svg{width:12px;height:12px;opacity:.8}

    .zzco__empty{border:1px dashed var(--edge2);border-radius:16px;padding:2.4rem;text-align:center;color:var(--mut)}
    .zzco__spin{width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;
      animation:zzcoSpin .8s linear infinite;display:none}
    .zzco__btn.is-loading .zzco__spin{display:inline-block}
    @keyframes zzcoSpin{to{transform:rotate(360deg)}}
    </style>

    <div class="zzco__grid">
      <div>
        <p class="zzco__eyebrow">Pay Zaza Cheats</p>
        <h1 class="zzco__amount" id="zzco-amount"></h1>
        <div class="zzco__card">
          <div id="zzco-lines"></div>
          <div class="zzco__totals">
            <div class="zzco__trow"><span>Subtotal</span><span id="zzco-subtotal">&mdash;</span></div>
            <div class="zzco__trow zzco__trow--save" id="zzco-saverow" style="display:none">
              <span id="zzco-savelabel">Crypto discount</span><span id="zzco-save">&mdash;</span>
            </div>
            <div class="zzco__trow zzco__trow--grand"><span>Total</span><span id="zzco-total">&mdash;</span></div>
          </div>
        </div>

        <div class="zzco__next">
          <h4>What happens next</h4>
          <div class="zzco__step"><b>1</b><span>Pay with your chosen method on the next screen.</span></div>
          <div class="zzco__step"><b>2</b><span>Your key is delivered instantly to the email you enter.</span></div>
          <div class="zzco__step"><b>3</b><span>It stays tied to that email, so you can always recover it.</span></div>
        </div>
      </div>

      <div class="zzco__form">
        <p class="zzco__legend">Contact &amp; delivery</p>
        <div class="zzco__field" id="zzco-emailwrap">
          <label>E-mail address *</label>
          <input type="email" id="zzco-email" placeholder="you@email.com" autocomplete="email" inputmode="email" />
        </div>
        <p class="zzco__hint">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M4 7.5l8 6 8-6" stroke="currentColor" stroke-width="1.7"/></svg>
          Your key is sent here &mdash; double-check it's right.
        </p>

        <p class="zzco__legend">Discount</p>
        <div class="zzco__coupon">
          <div class="zzco__field"><input type="text" id="zzco-coupon" placeholder="Coupon code" /></div>
          <button type="button" class="zzco__capply" id="zzco-coupon-apply">Apply</button>
        </div>
        <p class="zzco__cnote" id="zzco-coupon-note" hidden></p>

        <p class="zzco__legend">Payment</p>
        <div class="zzco__pays" id="zzco-pays"></div>
        {# Crypto is preselected because it's the cheapest option, which means the
           card tile is no longer the first thing read. Say so plainly, or a card
           buyer can scan the list and assume cards aren't offered. #}
        <p class="zzco__hint">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.7"/></svg>
          Prefer card, Apple Pay or PayPal? Pick it above &mdash; a flat 60&cent; processing fee is added, whatever the order size.
        </p>

        {# Consent moved out of a required checkbox and into the button itself.
           The tickbox was a mandatory extra click that held the Pay button
           disabled with nothing on screen saying why — and it is not what the
           payment industry does: Apple, Shopify and Stripe Checkout all bind
           consent to the act of paying and state the terms beside the button.
           The links are unchanged and still open in a new tab, so nothing is
           harder to read than it was before. #}
        <button type="button" class="zzco__btn" id="zzco-pay">
          <span class="zzco__spin"></span>
          <span id="zzco-pay-label">Proceed to Payment &rarr;</span>
        </button>
        <p class="zzco__consent">
          By continuing you agree to our
          <a href="{{ '/terms-of-service' | shopUrl }}" target="_blank" rel="noopener">Terms of Service</a>
          and <a href="{{ '/refund-policy' | shopUrl }}" target="_blank" rel="noopener">Refund Policy</a>.
        </p>
        <div class="zzco__err" id="zzco-err"></div>
        <p class="zzco__note">You'll confirm the exact amount with your provider before paying.</p>

        <div class="zzco__trust">
          <span><svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg> Secure &amp; encrypted</span>
          <span><svg viewBox="0 0 24 24" fill="none"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg> Instant delivery</span>
          <a href="{{ '/status' | shopUrl }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> Live status</a>
          <a href="{{ '/refund-policy' | shopUrl }}" target="_blank" rel="noopener">Refund policy</a>
          <a href="https://discord.gg/zazacheats" target="_blank" rel="noopener">Support</a>
        </div>
      </div>
    </div>

    <div class="zzco__empty" id="zzco-empty" style="display:none;max-width:1040px;margin:1rem auto 0">
      Your cart is empty. <a href="{{ '/products' | shopUrl }}" style="color:var(--acc)">Browse products &rarr;</a>
    </div>
  </div>
</div>

<script>
(function(){
  /* ===================== CONFIG ===================== */
  var CHECKOUT_WORKER = 'https://nfa-sellauth-bridge-production.up.railway.app/checkout';

  /* Vibrant brand-coloured tiles. `pct` (percentage) and `flat` (fixed amount)
     mirror the real dashboard fee/discount and are display-only — SellAuth
     calculates the binding amount server-side.

     Card is a FLAT $0.60, not a percentage. That distinction matters to the
     buyer: on a $1.00 NFA account a 5% fee was 5 cents and on a $199 lifetime
     key it was ten dollars, so the same tile meant wildly different things
     depending on what was in the cart. A flat fee is the same sentence every
     time. It also means card stops being the most expensive option on small
     orders and starts being the cheapest, which the ordering below picks up
     on its own because it sorts on real money, not on a percentage. */
  var PAYMENT_METHODS = [
    { id: '195134', name: 'Cards, Apple Pay, PayPal', via: 'via Shopify', badge: '+$0.60', badgeType: 'fee', flat: 0.60,
      ico: 'linear-gradient(135deg,#6366f1,#a855f7)', ring: '#8b5cf6', tint: 'rgba(139,92,246,.25)',
      svg: '<svg viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="3" fill="#ffffff" fill-opacity=".95"/><rect x="2" y="8.4" width="20" height="2.6" fill="#312e81"/><circle cx="15.2" cy="15.1" r="2.4" fill="#eb001b"/><circle cx="18.2" cy="15.1" r="2.4" fill="#f79e1b" fill-opacity=".92"/><rect x="4.6" y="14.2" width="5" height="1.8" rx=".9" fill="#94a3b8"/></svg>' },
    { id: '194378', name: 'Litecoin', via: 'via Litecoin Network', badge: '-5%', badgeType: 'off', pct: -5,
      ico: 'linear-gradient(135deg,#4a7fd4,#2a4f8f)', ring: '#4a7fd4', tint: 'rgba(74,127,212,.28)',
      svg: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#ffffff" fill-opacity=".16"/><path d="M9.7 5.5h3.2l-1.6 6.4 2.8-.9-.5 1.9-2.8.9-.8 3h6l-.6 2.3H6.8l1.3-5.2-2.1.7.5-1.9 2.1-.7L9.7 5.5z" fill="#ffffff"/></svg>' },
    { id: '205537', name: 'Solana', via: 'via Solana Network', badge: '-5%', badgeType: 'off', pct: -5,
      ico: 'linear-gradient(135deg,#9945FF,#14F195)', ring: '#14F195', tint: 'rgba(20,241,149,.25)',
      svg: '<svg viewBox="0 0 24 24"><path d="M6.4 15.9a.8.8 0 01.55-.22h13.2c.33 0 .5.4.27.64l-2.8 2.8a.8.8 0 01-.55.22H3.87a.38.38 0 01-.27-.64l2.8-2.8z" fill="#ffffff"/><path d="M6.4 4.66a.8.8 0 01.55-.22h13.2c.33 0 .5.4.27.64l-2.8 2.8a.8.8 0 01-.55.22H3.87a.38.38 0 01-.27-.64l2.8-2.8z" fill="#ffffff" fill-opacity=".85"/><path d="M17.6 10.24a.8.8 0 00-.55-.22H3.87a.38.38 0 00-.27.64l2.8 2.8a.8.8 0 00.55.22h13.2c.33 0 .5-.4.27-.64l-2.8-2.8z" fill="#ffffff" fill-opacity=".6"/></svg>' },
    { id: '205539', name: 'Ethereum', via: 'via Ethereum Network', badge: '-5%', badgeType: 'off', pct: -5,
      ico: 'linear-gradient(135deg,#8a93f7,#454a75)', ring: '#8a93f7', tint: 'rgba(138,147,247,.28)',
      svg: '<svg viewBox="0 0 24 24"><path d="M12 2.6l5.5 9.2L12 15 6.5 11.8 12 2.6z" fill="#ffffff" fill-opacity=".95"/><path d="M12 16.2l5.5-3.2L12 21.4 6.5 13l5.5 3.2z" fill="#ffffff" fill-opacity=".7"/></svg>' }
  ];
  /* ================================================== */

  /* shop id + internal API base come from window globals that master.njk sets
     on every page. Custom pages don't get shop.id or apiInternalUrl in Nunjucks
     scope, so we read them here instead. */
  var SHOP_ID = window.shopId;

  var state = { cart: [], full: [], currency: 'USD', method: null, sel: null, subtotal: 0, havePrices: false };

  var $ = function(id){ return document.getElementById(id); };

  function money(n, cur){
    try { return new Intl.NumberFormat(undefined, { style: 'currency', currency: cur || 'USD' }).format(n); }
    catch(e){ return '$' + (Number(n) || 0).toFixed(2); }
  }
  function readCart(){
    try { var c = JSON.parse(localStorage.getItem('cart') || '[]'); return Array.isArray(c) ? c : []; }
    catch(e){ return []; }
  }
  function affiliate(){
    try { return localStorage.getItem('affiliate') || ''; } catch(e){ return ''; }
  }

  /* The scratch-card prize, if this visitor still holds an unexpired one.

     scratch-card-popup.njk writes `zz_sc_claim` through its setC() helper, and
     the cart page reads it back to promise "your scratch code is still active
     — apply it at checkout". Checkout never read it, so the code the site had
     just promised had to be remembered or re-copied by hand. This mirrors that
     file's getC(): a localStorage {v, exp} envelope where `v` is itself the
     JSON string {code, pct}, falling back to a plain cookie value when
     localStorage is unavailable — the same two-tier storage setC() writes.

     Expiry is enforced here as well as at write time: the popup caps the claim
     at the real drop deadline, and honouring that means a dead code can never
     be silently pre-filled into the box. */
  function scratchClaim(){
    var raw = null;
    try {
      raw = window.localStorage.getItem('zz_sc_claim');
      if (raw !== null){
        var o = JSON.parse(raw);
        if (o && o.exp && Date.now() > o.exp){
          window.localStorage.removeItem('zz_sc_claim');
          return null;
        }
        raw = o ? o.v : null;
      }
    } catch(e){ raw = null; }
    if (raw == null){
      try { raw = (typeof Cookies !== 'undefined') ? Cookies.get('zz_sc_claim') : null; } catch(e){ return null; }
    }
    if (!raw) return null;
    try {
      var claim = JSON.parse(raw);
      return (claim && claim.code) ? claim : null;
    } catch(e){ return null; }
  }

  /* Snapshot written by the cart / Buy Now button — same shape as fullCart. */
  function readSnapshot(){
    try {
      var s = JSON.parse(localStorage.getItem('zz_pay_snapshot') || 'null');
      return (Array.isArray(s) && s.length) ? s : null;
    } catch(e){ return null; }
  }

  /* Cheapest method first, and preselected.
     The buyer has just come from a product page showing an exact total. If we
     open on the card tile (+5%) that total visibly jumps the moment they land
     here, which is the classic unexpected-cost abandonment. Sorting by `pct`
     ascending puts the -5% crypto tiles at the top, so the headline amount
     opens on the discounted figure and any change from here is a choice they
     made. Sorting by the real `pct` rather than hardcoding an index means the
     day a fee changes in the dashboard, this still picks the cheapest.
     Array.prototype.sort is stable in every browser we support, so the three
     crypto tiles keep their existing relative order. */
  /* What this method actually adds to (or takes off) the current subtotal, in
     money. Percentage and flat fees are not comparable as raw numbers — a
     `pct` of 5 and a `flat` of 0.60 are the same figure on a $12 order and
     nothing alike on a $1 one — so everything that ranks or displays a fee
     goes through here. */
  function adjustmentOf(m, sub){
    if (!m) return 0;
    if (typeof m.flat === 'number') return m.flat;
    return (sub || 0) * ((m.pct || 0) / 100);
  }

  function orderedMethods(){
    var sub = state.subtotal || 0;
    return PAYMENT_METHODS.slice().sort(function(a, b){
      return adjustmentOf(a, sub) - adjustmentOf(b, sub);
    });
  }

  function renderPays(){
    var wrap = $('zzco-pays');
    wrap.innerHTML = '';
    var methods = orderedMethods();
    methods.forEach(function(m, i){
      var el = document.createElement('div');
      el.className = 'zzco__pay' + (i === 0 ? ' is-sel' : '');
      el.style.setProperty('--ring', m.ring);
      el.style.setProperty('--tint', m.tint);
      el.innerHTML =
        '<div class="zzco__pico" style="background:' + m.ico + '">' + m.svg + '</div>' +
        '<div class="zzco__pbody"><div class="zzco__pname">' + m.name + '</div>' +
        '<div class="zzco__pvia">' + m.via + '</div></div>' +
        (m.badge ? '<span class="zzco__badge zzco__badge--' + m.badgeType + '">' + m.badge + '</span>' : '');
      el.addEventListener('click', function(){
        state.method = m.id;
        state.sel = m;
        [].forEach.call(wrap.children, function(c){ c.classList.remove('is-sel'); });
        el.classList.add('is-sel');
        renderTotals();
        refreshBtn();
      });
      wrap.appendChild(el);
    });
    if (methods[0]){
      state.method = methods[0].id;
      state.sel = methods[0];
    }
  }

  function renderTotals(){
    if (!state.havePrices){
      $('zzco-subtotal').textContent = '\u2014';
      $('zzco-total').textContent = '\u2014';
      $('zzco-amount').textContent = '';
      $('zzco-saverow').style.display = 'none';
      return;
    }
    var sub = state.subtotal;
    var adj = adjustmentOf(state.sel, sub);
    var total = sub + adj;
    $('zzco-subtotal').textContent = money(sub, state.currency);
    var row = $('zzco-saverow');
    if (adj !== 0){
      row.style.display = 'flex';
      row.style.color = adj < 0 ? '#4ade80' : '#fbbf24';
      /* The card fee is a fixed amount now, so it is not an estimate — say the
         exact figure. Only the crypto side still moves with the subtotal. */
      $('zzco-savelabel').textContent = adj < 0 ? 'Crypto discount (est.)' : 'Card fee';
      $('zzco-save').textContent = (adj < 0 ? '\u2212' : '+') + money(Math.abs(adj), state.currency);
    } else {
      row.style.display = 'none';
    }
    $('zzco-total').textContent = money(total, state.currency);
    $('zzco-amount').textContent = money(total, state.currency);
  }

  /* Fallback product images, keyed by SellAuth product ID. Used when a product
     has no image set in the dashboard. Paste a direct image URL (must end in
     .png/.jpg) — e.g. upload to postimg.cc and copy the "Direct link". */
  var PRODUCT_IMAGES = {
    '760665': '',   // Rust Internal Private Cheat  -> box art
    '766224': ''    // Rust NFA account             -> Steam account image
  };

  /* Products expose image_urls[] with image_url as a fallback, so try both. */
  function imgOf(p, cartItem){
    if (p){
      if (p.image_urls && p.image_urls.length && p.image_urls[0]) return p.image_urls[0];
      if (p.image_url) return p.image_url;
      if (p.image) return p.image;
      if (p.id && PRODUCT_IMAGES[String(p.id)]) return PRODUCT_IMAGES[String(p.id)];
    }
    if (cartItem && cartItem.productId && PRODUCT_IMAGES[String(cartItem.productId)]){
      return PRODUCT_IMAGES[String(cartItem.productId)];
    }
    return null;
  }
  var PLACEHOLDER =
    '<svg viewBox="0 0 24 24" fill="none" style="width:22px;height:22px;opacity:.5">' +
    '<path d="M12 2.6l8 4v6.2c0 4.6-3.4 8.6-8 9.6-4.6-1-8-5-8-9.6V6.6l8-4z" stroke="#e6aaff" stroke-width="1.6" stroke-linejoin="round"/>' +
    '<path d="M9 12.2l2.2 2.2L15 10.6" stroke="#e6aaff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function renderLines(){
    var lines = $('zzco-lines');
    lines.innerHTML = '';
    var sub = 0;
    state.full.forEach(function(it, idx){
      var price = (it.variant && it.variant.price) || 0;
      var qty = it.quantity || 1;
      sub += price * qty;
      var cur = (it.product && it.product.currency) || state.currency;
      var src = imgOf(it.product, state.cart[idx]);

      var row = document.createElement('div');
      row.className = 'zzco__line';

      var thumb = document.createElement('div');
      thumb.className = 'zzco__thumb';
      if (src){
        var im = document.createElement('img');
        im.src = src;
        im.alt = '';
        im.loading = 'lazy';
        // Swap to the placeholder if the URL 404s. Done as a listener, not an
        // inline onerror attribute — the SVG contains quotes and would break it.
        im.addEventListener('error', function(){ thumb.innerHTML = PLACEHOLDER; });
        thumb.appendChild(im);
      } else {
        thumb.innerHTML = PLACEHOLDER;
      }

      var body = document.createElement('div');
      body.className = 'zzco__lbody';
      body.innerHTML =
        '<div class="zzco__lname">' + (it.product ? it.product.name : 'Item') +
        '<span class="zzco__lqty">x' + qty + '</span></div>' +
        '<div class="zzco__lvar">' + (it.variant ? it.variant.name : '') + '</div>';

      var pr = document.createElement('div');
      pr.className = 'zzco__lprice';
      pr.textContent = money(price * qty, cur);

      row.appendChild(thumb);
      row.appendChild(body);
      row.appendChild(pr);
      lines.appendChild(row);

      /* Addons ride nested inside their parent item in the cart API's
         response, so summing only the top level silently under-counts every
         bundled order — the buyer would see a total that excludes the NFA
         account they just added. Billed once each, matching how the cart page
         totals them (quantity applies to the parent key, not the addon). */
      var addons = (it.addons && it.addons.length) ? it.addons : [];
      addons.forEach(function(ad){
        var adPrice = (ad.variant && ad.variant.price) || 0;
        sub += adPrice;

        var adRow = document.createElement('div');
        adRow.className = 'zzco__line zzco__line--addon';

        var adBody = document.createElement('div');
        adBody.className = 'zzco__lbody';
        adBody.innerHTML =
          '<div class="zzco__lname">+ ' + (ad.product ? ad.product.name : 'Addon') + '</div>' +
          '<div class="zzco__lvar">' + (ad.variant ? ad.variant.name : '') + '</div>';

        var adPr = document.createElement('div');
        adPr.className = 'zzco__lprice';
        adPr.textContent = money(adPrice, (ad.product && ad.product.currency) || cur);

        adRow.appendChild(adBody);
        adRow.appendChild(adPr);
        lines.appendChild(adRow);
      });
    });
    if (state.full[0] && state.full[0].product){
      state.currency = state.full[0].product.currency || state.currency;
    }
    state.subtotal = sub;
    state.havePrices = sub > 0;
    renderTotals();
  }

  function renderFallback(){
    var lines = $('zzco-lines');
    lines.innerHTML = '';
    var count = state.cart.reduce(function(n, i){ return n + (i.quantity || 1); }, 0);
    var row = document.createElement('div');
    row.className = 'zzco__line';
    row.innerHTML = '<div class="zzco__thumb"></div>' +
      '<div><div class="zzco__lname">' + count + (count === 1 ? ' item' : ' items') + ' in your order</div>' +
      '<div class="zzco__lvar">Final total is confirmed on the payment step</div></div>';
    lines.appendChild(row);
    state.havePrices = false;
    renderTotals();
  }

  function cartApiCandidates(){
    var base = (window.apiBaseUrl || '').replace(/\/$/, '');
    var list = [];
    if (base) list.push(base + '/v1/cart');
    list.push('https://api.sellauth.com/v1/cart');
    list.push(location.origin + '/v1/cart');
    return list;
  }

  async function fetchFull(){
    var qs = 'shopId=' + encodeURIComponent(SHOP_ID) +
             '&cart=' + encodeURIComponent(JSON.stringify(state.cart));
    var cands = cartApiCandidates();
    for (var i = 0; i < cands.length; i++){
      try {
        var res = await fetch(cands[i] + '?' + qs, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) continue;
        var data = await res.json();
        if (data && data.fullCart && data.fullCart.length) return data.fullCart;
      } catch(e){ /* try next candidate */ }
    }
    return null;
  }

  async function hydrate(){
    state.cart = readCart();
    if (!state.cart.length){
      $('zzco-empty').style.display = 'block';
      $('zzco-pay').disabled = true;
      return;
    }

    /* 1) instant: snapshot handed over by the cart / Buy Now button */
    var snap = readSnapshot();
    if (snap){ state.full = snap; renderLines(); }
    else { renderFallback(); }

    /* 2) refresh against the API when reachable */
    var full = await fetchFull();
    if (full && full.length){ state.full = full; renderLines(); }
    else if (!snap){
      console.warn('[checkout] price hydrate failed - apiBaseUrl:', window.apiBaseUrl, 'shopId:', window.shopId);
    }

    refreshBtn();
  }

  function emailOk(){ return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test($('zzco-email').value.trim()); }

  /* What is still missing, in the order a buyer fills the form. Returns null
     when the order can actually be placed. */
  function blocker(){
    if (!state.cart.length) return { msg: 'Your cart is empty.', focus: null };
    if (!$('zzco-email').value.trim()) return { msg: 'Enter the e-mail address your key should go to.', focus: 'zzco-email' };
    if (!emailOk()) return { msg: "That e-mail doesn't look right — check it before we send your key there.", focus: 'zzco-email' };
    if (!state.method) return { msg: 'Choose how you want to pay.', focus: null };
    return null;
  }

  /* The button used to sit disabled until four separate conditions were all
     satisfied, with nothing on screen saying which one was outstanding — a
     buyer who missed the terms tickbox just saw a dead button and no reason.
     It stays clickable now and says what is missing when pressed, which is
     both kinder and one fewer thing to get right before anything responds. */
  function refreshBtn(){
    $('zzco-pay').disabled = false;
    var b = blocker();
    $('zzco-pay').setAttribute('aria-disabled', b ? 'true' : 'false');
    $('zzco-pay').classList[b ? 'add' : 'remove']('is-waiting');
  }

  function showErr(msg){
    var e = $('zzco-err');
    e.textContent = msg;
    e.style.display = 'block';
  }

  async function pay(){
    var btn = $('zzco-pay');
    if (btn.disabled) return;

    var b = blocker();
    if (b){
      showErr(b.msg);
      if (b.focus){
        var f = $(b.focus);
        if (f){ f.focus(); $('zzco-emailwrap').classList.add('is-bad'); }
      }
      return;
    }

    btn.disabled = true;
    btn.classList.add('is-loading');
    $('zzco-pay-label').textContent = 'Creating checkout...';
    $('zzco-err').style.display = 'none';

    var email = $('zzco-email').value.trim();
    try { localStorage.setItem('zz_email', email); } catch(e){}

    var payload = { cart: state.cart, email: email, payment_method_id: state.method, currency: state.currency };
    var coupon = $('zzco-coupon').value.trim();
    if (coupon) payload.coupon = coupon;
    var aff = affiliate();
    if (aff) payload.affiliate = aff;

    try {
      var res = await fetch(CHECKOUT_WORKER, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      var data = await res.json();
      if (data && data.url){
        try {
          localStorage.setItem('cart', JSON.stringify([]));
          localStorage.removeItem('zz_pay_snapshot');
        } catch(e){}
        window.location.href = data.url;
        return;
      }
      showErr('Could not start checkout (' + ((data && (data.detail || data.error)) || 'unknown') +
              '). Nothing was charged - please try again.');
    } catch(e){
      showErr('Network error - nothing was charged. Please refresh and try again.');
    }
    btn.classList.remove('is-loading');
    $('zzco-pay-label').textContent = 'Proceed to Payment \u2192';
    refreshBtn();
  }

  document.addEventListener('DOMContentLoaded', function(){
    renderPays();
    hydrate();

    /* prefill a remembered email so repeat buyers don't retype */
    try {
      var saved = (window.shopCustomer && window.shopCustomer.email) || localStorage.getItem('zz_email');
      if (saved) $('zzco-email').value = saved;
    } catch(e){}

    var em = $('zzco-email');
    em.addEventListener('input', function(){
      $('zzco-emailwrap').classList.remove('is-bad');
      refreshBtn();
    });
    em.addEventListener('blur', function(){
      if (em.value.trim() && !emailOk()) $('zzco-emailwrap').classList.add('is-bad');
    });
    $('zzco-pay').addEventListener('click', pay);

    /* ---- Coupon box: prefill it, and say honestly what will happen ----

       Two codes can be waiting for a buyer by the time they reach checkout:

       - a scratch-card prize (`zz_sc_claim`), worth up to 10%, which the cart
         page has already told them is "still active — apply it at checkout";
       - an affiliate code (v81: every affiliate code is also a live 5%-off
         coupon), so link traffic gets the same discount as people who were
         told the code by name.

       Only one can ride along — `payload.coupon` is a single string and the
       codes don't stack — so precedence is: whatever the buyer typed, then the
       scratch prize, then the affiliate code. Scratch outranks affiliate
       because it's worth more and because we promised it by name one page ago.
       Preferring it costs the referrer nothing: pay() sends `payload.affiliate`
       separately from `payload.coupon`, so attribution survives either way.

       We can't verify a code here — validation lives in the checkout worker,
       which isn't part of this theme — so the copy never claims a discount has
       already come off. It says the code travels with the order and lands at
       the payment step, which is what actually happens. Claiming a discount
       the totals don't show is how a buyer stops trusting every other number
       on the page. */
    (function(){
      var note = $('zzco-coupon-note');
      var box  = $('zzco-coupon');
      var btn  = $('zzco-coupon-apply');
      if (!note || !box) return;

      var claim = scratchClaim();
      var aff   = affiliate();

      /* The code we put there ourselves, and how to describe it while it is
         still the one in the box. */
      var prefill = null;
      if (claim && claim.code){
        var sc = String(claim.code).toUpperCase();
        prefill = {
          code: sc,
          text: 'Scratch code ' + sc + ' added \u2014 ' +
                (claim.pct ? claim.pct + '% off, applied' : 'applied') + ' at the payment step.'
        };
      } else if (aff){
        prefill = {
          code: aff.toUpperCase(),
          text: 'Referral code ' + aff.toUpperCase() + ' added \u2014 5% off, applied at the payment step.'
        };
      }

      function setOn(on){
        if (!btn) return;
        btn.textContent = on ? 'Added' : 'Apply';
        btn.classList[on ? 'add' : 'remove']('is-on');
      }

      function describe(){
        var v = box.value.trim();
        if (!v){ note.hidden = true; note.classList.remove('is-warn'); setOn(false); return; }
        setOn(true);
        note.hidden = false;
        if (prefill && v.toUpperCase() === prefill.code){
          note.classList.remove('is-warn');
          note.textContent = prefill.text;
        } else if (prefill){
          note.classList.add('is-warn');
          note.textContent = 'Using ' + v + ' instead of your saved code \u2014 we\u2019ll check it at the payment step.';
        } else {
          note.classList.remove('is-warn');
          note.textContent = 'Code ' + v + ' will be applied at the payment step.';
        }
      }

      /* Never overwrite a code the buyer typed themselves. */
      if (prefill && !box.value.trim()) box.value = prefill.code;

      describe();
      box.addEventListener('input', describe);
      if (btn) btn.addEventListener('click', describe);
    })();
    refreshBtn();
    if (!em.value) em.focus();
  });
})();
</script>

