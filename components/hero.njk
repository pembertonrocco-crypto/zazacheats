<script>
(function () {
  var section = document.querySelector('[data-component-id="{{ componentId }}"]');
  if (!section) return;
  var canvas = section.querySelector('.hero-canvas');
  var ctx = canvas.getContext('2d');

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var W = 0, H = 0, DPR = 1;
  var targets = [];
  var particles = [];
  var tick = 0;

  /* crosshair state */
  var cross = { x: 0, y: 0 };          /* rendered position (lerped) */
  var aim = { x: 0, y: 0 };            /* where it wants to go */
  var mouse = { x: null, y: null, t: 0 };
  var IDLE_MS = 2600;

  var MONO = '10px ui-monospace, "Cascadia Code", "SF Mono", Consolas, monospace';

  function rand(a, b) { return a + Math.random() * (b - a); }

  function makeTargets() {
    var isMobile = W < 640;
    var count = isMobile ? 3 : 5;
    var labels = ['PLAYER', 'PLAYER', 'SLEEPER', 'PLAYER', 'PLAYER'];
    targets = [];
    for (var i = 0; i < count; i++) {
      var z = rand(0.45, 1);                       /* depth: 1 = close */
      var h = (isMobile ? 90 : 120) * z * rand(0.85, 1.1);
      var w = h * 0.46;
      /* keep boxes off the exact centre where the copy sits */
      var side = i % 2 === 0 ? rand(0.06, 0.3) : rand(0.7, 0.94);
      targets.push({
        x: W * side,
        y: H * rand(0.16, 0.62),
        w: w,
        h: h,
        z: z,
        vx: rand(-0.05, 0.05) * z,
        vy: rand(-0.028, 0.028) * z,
        dist: Math.round(210 - z * 165 + rand(-8, 8)),
        hp: rand(0.55, 0.98),
        label: labels[i % labels.length],
        phase: rand(0, Math.PI * 2),
