          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#af-rates" class="af-btn af-btn--ghost">See commission rates</a>
        <script>
        /* /customer/affiliate is auth-gated. SellAuth bounces logged-out
           visitors to the homepage with no explanation, so the main call to
           action on this page is a dead end for anyone not already signed in.

           Delegated click handler rather than rewriting hrefs: it catches
           every affiliate link on the page no matter where it sits or when it
           renders, and it re-checks the session at click time instead of at
           page load. `affiliate` also has to be in the `back` allowlist in
           script.js, or login succeeds and drops them on the dashboard. */
        (function(){
          document.addEventListener('click', function(e){
            var a = e.target && e.target.closest && e.target.closest('a[href*="/customer/affiliate"]');
            if (!a) return;
            if (window.shopCustomer && window.shopCustomer.email) return; // signed in, let it through
            e.preventDefault();
            window.location.href = '/?login=1&back=affiliate';
          }, true);
        })();
        </script>
