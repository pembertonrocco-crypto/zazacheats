<script>
(function(){
  /* ---- duration chooser ---- */
  var chooser=document.querySelector('.pp-chooser');
  if(chooser){
    var head=chooser.querySelector('[data-zz-chooser-toggle]');
    var body=chooser.querySelector('.pp-chooser__body');
    head.addEventListener('click',function(){
      var open=chooser.classList.toggle('is-open');
      head.setAttribute('aria-expanded',open?'true':'false');
      body.hidden=!open;
    });
    chooser.querySelectorAll('[data-zz-pick]').forEach(function(opt){
      opt.addEventListener('click',function(){
        var want=opt.getAttribute('data-zz-pick').toLowerCase();
        var target=null;
        document.querySelectorAll('.pf-variant').forEach(function(v){
          if(target)return;
          var name=v.querySelector('.pf-variant__name');
          if(name && name.textContent.toLowerCase().indexOf(want)!==-1 && !v.disabled) target=v;
        });
        if(!target)return;
        target.click();
        chooser.classList.remove('is-open');
        head.setAttribute('aria-expanded','false');
        body.hidden=true;
        target.scrollIntoView({behavior:'smooth',block:'center'});
        target.classList.remove('pf-variant--flash');
        void target.offsetWidth;
        target.classList.add('pf-variant--flash');
      });
    });
  }

  /* ---- lightbox ---- */
  var lb=document.getElementById('pp-lightbox');
  if(!lb)return;
  var lbImg=document.getElementById('pp-lightbox-img');
  var lbCount=document.getElementById('pp-lightbox-count');
  var sources=[];
  document.querySelectorAll('.pp-carousel .pp-carousel__img, .pp-image-wrap .pp-carousel__img').forEach(function(img){
    if(sources.indexOf(img.src)===-1)sources.push(img.src);
  });
  if(!sources.length)return;
  if(sources.length===1)lb.classList.add('pp-lightbox--single');
  var idx=0;

  function render(){
    lbImg.src=sources[idx];
    lbCount.textContent=(idx+1)+' / '+sources.length;
    /* preload neighbours */
    [idx+1,idx-1].forEach(function(n){
      var i=(n+sources.length)%sources.length;
      if(i!==idx){var p=new Image();p.src=sources[i];}
    });
  }
  function open(src){
    var found=sources.indexOf(src);
    idx=found===-1?0:found;
    render();
    lb.hidden=false;
    document.documentElement.style.overflow='hidden';
  }
  function close(){
    lb.hidden=true;
    document.documentElement.style.overflow='';
  }
  function step(d){idx=(idx+d+sources.length)%sources.length;render();}

  document.querySelectorAll('.pp-carousel .pp-carousel__img, .pp-image-wrap .pp-carousel__img').forEach(function(img){
    img.addEventListener('click',function(){open(img.src);});
  });
  lb.querySelectorAll('[data-pp-lb-close]').forEach(function(el){el.addEventListener('click',close);});
  lb.querySelector('[data-pp-lb-prev]').addEventListener('click',function(){step(-1);});
  lb.querySelector('[data-pp-lb-next]').addEventListener('click',function(){step(1);});
  document.addEventListener('keydown',function(e){
    if(lb.hidden)return;
    if(e.key==='Escape')close();
    else if(e.key==='ArrowLeft')step(-1);
    else if(e.key==='ArrowRight')step(1);
  });
  /* basic swipe */
  var sx=null;
  lb.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  lb.addEventListener('touchend',function(e){
    if(sx===null)return;
    var dx=e.changedTouches[0].clientX-sx;
    if(Math.abs(dx)>50)step(dx<0?1:-1);
    sx=null;
  },{passive:true});
})();
</script>

{# ===== 100x PRODUCT PAGE LAYER: sticky buy bar, lightbox, trust, pair-with ===== #}
<style>
/* sticky buy bar */
.ppx-bar{position:fixed;left:0;right:0;bottom:0;z-index:900;display:flex;align-items:center;gap:14px;
  padding:12px 18px calc(12px + env(safe-area-inset-bottom));
  background:rgba(8,10,22,.88);backdrop-filter:blur(18px);border-top:1px solid rgba(191,64,191,.25);
  transform:translateY(110%);transition:transform .38s cubic-bezier(.22,1,.36,1)}
