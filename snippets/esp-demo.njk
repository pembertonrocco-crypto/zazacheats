.zed__sublabel{margin:8px 0 6px;font-size:.64rem;color:rgba(200,185,215,.5)}

.zed__opt{display:flex;align-items:center;gap:10px;padding:5px 4px;border-radius:6px;cursor:pointer;transition:background .15s}
