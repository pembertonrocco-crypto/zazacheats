<div class="product-card-premium" data-product-card>
  <div class="product-card-wrapper">
    <!-- Image Container -->
    <div class="product-image-container">
      <img 
        src="{{ item.image }}" 
        alt="{{ item.name }}" 
        class="product-image"
        loading="lazy"
      />
      <div class="product-overlay">
        <a href="{{ ('/product/' + item.path) | shopUrl }}" class="product-view-btn">
          <span>View Details</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      
      <!-- Status Badge -->
      {% if item.in_stock %}
      <div class="product-badge in-stock">
        <span>In Stock</span>
      </div>
      {% else %}
      <div class="product-badge out-of-stock">
        <span>Coming Soon</span>
      </div>
      {% endif %}

      <!-- Premium Badge (if applicable) -->
      {% if "Premium" in item.name or "Pro" in item.name %}
      <div class="product-badge-premium-label">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L15.09 10.26H24L17.54 15.7L20.63 23.96L12 18.54L3.37 23.96L6.46 15.7L0 10.26H8.91L12 2Z"/>
        </svg>
        <span>PREMIUM</span>
      </div>
      {% endif %}
    </div>

    <!-- Content -->
    <div class="product-content">
      <!-- Header -->
      <div class="product-header">
        <h3 class="product-name">{{ item.name }}</h3>
        <div class="product-rating">
          <div class="stars">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
            </svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" opacity="0.3">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/>
            </svg>
          </div>
          <span class="rating-text">({{ item.reviews_count | default('0') }})</span>
        </div>
      </div>

      <!-- Description -->
      {% if item.description %}
      <p class="product-description">
        {{ item.description | truncate(60) }}
      </p>
      {% endif %}

      <!-- Features / Quick Facts -->
      <div class="product-features">
        <div class="feature-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Instant Access</span>
        </div>
        <div class="feature-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Secure</span>
        </div>
      </div>

      <!-- Pricing -->
      <div class="product-pricing">
        <div class="price-container">
          {% if item.discount_percentage %}
          <span class="original-price">${{ item.original_price }}</span>
          <span class="discount-badge">-{{ item.discount_percentage }}%</span>
          {% endif %}
          <div class="current-price">${{ item.price }}</div>
        </div>
      </div>

      <!-- CTA Button -->
      <a href="{{ ('/product/' + item.path) | shopUrl }}" class="product-cta-btn">
        <span>Get Started</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
.product-card-premium {
  height: 100%;
  animation: slideUp 0.6s ease-out backwards;
}

.product-card-premium:nth-child(1) { animation-delay: 0.1s; }
.product-card-premium:nth-child(2) { animation-delay: 0.15s; }
.product-card-premium:nth-child(3) { animation-delay: 0.2s; }
.product-card-premium:nth-child(4) { animation-delay: 0.25s; }
.product-card-premium:nth-child(5) { animation-delay: 0.3s; }
.product-card-premium:nth-child(6) { animation-delay: 0.35s; }

.product-card-wrapper {
  height: 100%;
  background: linear-gradient(135deg, rgba(191,64,191, 0.08) 0%, rgba(124,58,237, 0.04) 100%);
  border: 1px solid rgba(191,64,191, 0.15);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card-wrapper:hover {
  background: linear-gradient(135deg, rgba(191,64,191, 0.12) 0%, rgba(124,58,237, 0.08) 100%);
  border-color: rgba(191,64,191, 0.25);
  transform: translateY(-8px);
  box-shadow: 0 24px 48px rgba(191,64,191, 0.2);
}

.product-card-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(191,64,191, 0.4), transparent);
  pointer-events: none;
}

/* Image Container */
.product-image-container {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.3);
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card-wrapper:hover .product-image {
  transform: scale(1.08);
}

/* Overlay */
.product-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 2;
}

.product-card-wrapper:hover .product-overlay {
  opacity: 1;
}

.product-view-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: #BF40BF;
  color: #ffffff;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.product-view-btn:hover {
  background: #BF40BF;
  transform: translateY(-2px);
}

/* Badges */
.product-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  padding: 6px 12px;
  background: #22C55E;
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  border-radius: 6px;
  z-index: 1;
  animation: slideInRight 0.6s ease-out;
  letter-spacing: 0.05em;
}

.product-badge.out-of-stock {
  background: #EAB308;
}

.product-badge-premium-label {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #000000;
  font-size: 0.7rem;
  font-weight: 800;
  border-radius: 6px;
  z-index: 1;
  letter-spacing: 0.05em;
}

.product-badge-premium-label svg {
  width: 12px;
  height: 12px;
}

/* Content */
.product-content {
  flex: 1;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}

.product-name {
  font-size: 1rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  line-height: 1.3;
  flex: 1;
}

/* Rating */
.product-rating {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8rem;
}

.stars {
  display: flex;
  gap: 2px;
}

.stars svg {
  color: #FFD700;
}

.rating-text {
  color: rgba(200, 215, 240, 0.5);
  font-size: 0.8rem;
  white-space: nowrap;
}

/* Description */
.product-description {
  font-size: 0.85rem;
  color: rgba(200, 215, 240, 0.6);
  line-height: 1.4;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Features */
.product-features {
  display: flex;
  gap: 12px;
  font-size: 0.8rem;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 4px;
  color: rgba(200, 215, 240, 0.6);
}

.feature-item svg {
  color: #22C55E;
  flex-shrink: 0;
}

/* Pricing */
.product-pricing {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 12px;
}

.price-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.original-price {
  font-size: 0.8rem;
  color: rgba(200, 215, 240, 0.5);
  text-decoration: line-through;
}

.discount-badge {
  font-size: 0.75rem;
  padding: 2px 6px;
  background: rgba(239, 68, 68, 0.2);
  color: #EF4444;
  border-radius: 4px;
  font-weight: 600;
}

.current-price {
  font-size: 1.3rem;
  font-weight: 800;
  color: #22C55E;
}

/* CTA Button */
.product-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  background: linear-gradient(135deg, #BF40BF 0%, #7C3AED 100%);
  color: #ffffff;
  text-decoration: none;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  margin-top: auto;
  box-shadow: 0 4px 16px rgba(191,64,191, 0.3);
}

.product-cta-btn:hover {
  background: linear-gradient(135deg, #BF40BF 0%, #5B9EF9 100%);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(191,64,191, 0.4);
}

/* Animations */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .product-content {
    padding: 16px;
    gap: 12px;
  }

  .product-name {
    font-size: 0.9rem;
  }

  .current-price {
    font-size: 1.1rem;
  }

  .product-cta-btn {
    padding: 10px 14px;
    font-size: 0.85rem;
  }
}

/* Respect prefers-reduced-motion. These entrance slides and infinite
   pulses are decoration; this file was still animating regardless of the
   user's setting. Scoped to this component's own selectors so it cannot
   override the tuned reduced-motion rules other components define. */
@media (prefers-reduced-motion: reduce){
  .product-card-premium,
  .product-card-premium .product-card-badge{animation:none}
}
</style>