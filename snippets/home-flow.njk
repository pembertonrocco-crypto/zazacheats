{# =========================================================================
   HOME-FLOW — "from checkout to in-game" delivery walkthrough.
   A terminal window types out the real delivery sequence, with the three
   steps in plain language beside it and a live-status link underneath.
   Fully static HTML (no {% set %} object arrays, no synthetic loops).
   ========================================================================= #}
<section class="zzhf" aria-labelledby="zzhf-title">
  <div class="zzhf__bg" aria-hidden="true">
    <span class="zzhf__orb"></span>
  </div>

  <div class="zzhf__inner">

    <div class="zzhf__copy">
      <p class="zzhf__eyebrow">// FROM CHECKOUT TO IN-GAME</p>
      <h2 id="zzhf-title" class="zzhf__title">No waiting on a human.<br><span class="zzhf__accent">Ever.</span></h2>
      <p class="zzhf__sub">
        Delivery is fully automated. Your key appears on the receipt page and in
        your account the moment payment clears — day or night.
      </p>

      <ol class="zzhf__steps">
        <li class="zzhf__step">
          <span class="zzhf__step-num" aria-hidden="true">1</span>
          <div class="zzhf__step-body">
            <span class="zzhf__step-t">Pick a duration &amp; pay</span>
            <span class="zzhf__step-d">Card or crypto through secure automated checkout.</span>
          </div>
        </li>
        <li class="zzhf__step">
          <span class="zzhf__step-num" aria-hidden="true">2</span>
          <div class="zzhf__step-body">
            <span class="zzhf__step-t">Key on screen instantly</span>
            <span class="zzhf__step-d">Shown at checkout and saved to your customer account.</span>
          </div>
        </li>
        <li class="zzhf__step">
          <span class="zzhf__step-num" aria-hidden="true">3</span>
          <div class="zzhf__step-body">
            <span class="zzhf__step-t">Run the loader &amp; play</span>
            <span class="zzhf__step-d">Enter your key, inject, load into Rust. Stuck? Discord support is a click away.</span>
          </div>
        </li>
      </ol>

      <a href="{{ '/status' | shopUrl }}" class="zzhf__status">
        <span class="zzhf__status-pulse" aria-hidden="true"></span>
        <span>We publish the real state of every build — <strong>check live status first</strong></span>
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <div class="zznx" style="align-items:flex-start;text-align:left;margin:18px 0 0;padding:0;max-width:none">
        <div class="zznx__row" style="justify-content:flex-start">
          <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="zznx__btn">Start the sequence — get your key</a>
        </div>
      </div>
    </div>
    <div class="zzhf__term-wrap">
      <span class="zzhf__term-glow" aria-hidden="true"></span>
      <div class="zzhf__term" role="img" aria-label="Illustration of the automated delivery sequence: payment confirmed, key issued, loader ready.">
        <div class="zzhf__term-bar">
          <span class="zzhf__dot zzhf__dot--r" aria-hidden="true"></span>
          <span class="zzhf__dot zzhf__dot--y" aria-hidden="true"></span>
          <span class="zzhf__dot zzhf__dot--g" aria-hidden="true"></span>
          <span class="zzhf__term-name">zaza — delivery</span>
        </div>
        <div class="zzhf__term-body">
          <p class="zzhf__ln zzhf__ln--1"><span class="zzhf__prompt">$</span> checkout --product rust-private</p>
          <p class="zzhf__ln zzhf__ln--2">payment ............ <span class="zzhf__ok">confirmed</span></p>
          <p class="zzhf__ln zzhf__ln--3">key ................ ZAZA-&#9608;&#9608;&#9608;&#9608;-&#9608;&#9608;&#9608;&#9608;-&#9608;&#9608;&#9608;&#9608;</p>
          <p class="zzhf__ln zzhf__ln--4">loader ............. <span class="zzhf__ok">ready</span></p>
          <p class="zzhf__ln zzhf__ln--5"><span class="zzhf__accent-txt">&gt; inject &amp; play</span><span class="zzhf__caret" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .zzhf{
    --zzhf-accent: var(--cl-accent, #BF40BF);
    --zzhf-accent-rgb: var(--cl-accent-rgb, 191,64,191);
    position:relative;overflow:hidden;isolation:isolate;
    padding:clamp(3.5rem,7vw,6rem) 1.5rem;
    background:var(--cl-background-primary,#06091a);
  }
  .zzhf__bg{position:absolute;inset:0;z-index:-1;pointer-events:none;}
  .zzhf__orb{
    position:absolute;top:50%;right:-14%;transform:translateY(-50%);
    width:46vw;max-width:640px;aspect-ratio:1;border-radius:50%;
    background:rgba(var(--zzhf-accent-rgb),.16);filter:blur(130px);
  }

  .zzhf__inner{
    max-width:1140px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem);
    align-items:center;
  }

  /* ---------- copy column ---------- */
  .zzhf__eyebrow{
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:.72rem;letter-spacing:.14em;font-weight:500;
    color:rgba(var(--zzhf-accent-rgb),.85);margin:0 0 .9rem;
  }
  .zzhf__title{
    font-family:var(--zz-sans);
    font-size:clamp(1.7rem,3.4vw,2.5rem);font-weight:700;letter-spacing:-.02em;
    line-height:1.12;color:#fff;margin:0 0 .9rem;
  }
  .zzhf__accent{color:#e6aaff}
  .zzhf__sub{
    font-size:.95rem;line-height:1.75;color:rgba(200,215,240,.55);
    margin:0 0 1.8rem;max-width:44ch;
  }

  .zzhf__steps{list-style:none;margin:0 0 1.8rem;padding:0;display:flex;flex-direction:column;gap:1.05rem;}
  .zzhf__step{display:flex;gap:.9rem;align-items:flex-start;}
  .zzhf__step-num{
    flex-shrink:0;width:1.7rem;height:1.7rem;border-radius:7px;
    display:inline-flex;align-items:center;justify-content:center;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:.78rem;font-weight:700;color:rgba(240,225,255,.9);
    background:rgba(var(--zzhf-accent-rgb),.12);
    border:1px solid rgba(var(--zzhf-accent-rgb),.3);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
  }
  .zzhf__step-body{display:flex;flex-direction:column;gap:.15rem;}
  .zzhf__step-t{font-size:.92rem;font-weight:700;color:rgba(235,242,255,.92);letter-spacing:.01em;}
  .zzhf__step-d{font-size:.82rem;line-height:1.6;color:rgba(195,210,235,.5);}

  .zzhf__status{
    display:inline-flex;align-items:center;gap:.6rem;flex-wrap:wrap;
    padding:.65rem 1rem;border-radius:9px;text-decoration:none;
    background:rgba(34,197,94,.05);border:1px solid rgba(34,197,94,.2);
    font-size:.8rem;color:rgba(205,235,215,.8);
    transition:border-color .25s ease,background .25s ease;
  }
  .zzhf__status strong{color:rgba(180,240,200,.95);font-weight:700;}
  .zzhf__status:hover{border-color:rgba(34,197,94,.45);background:rgba(34,197,94,.09);color:rgba(225,245,232,.95);}
  .zzhf__status-pulse{
    position:relative;width:7px;height:7px;border-radius:50%;flex-shrink:0;
    background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,.9);
  }
  .zzhf__status-pulse::after{
    content:'';position:absolute;inset:-4px;border-radius:50%;
    border:1px solid rgba(34,197,94,.55);
    animation:zzhfPulse 2.2s ease-out infinite;
  }
  @keyframes zzhfPulse{0%{transform:scale(.5);opacity:1}70%,100%{transform:scale(1.6);opacity:0}}

  /* ---------- terminal ---------- */
  .zzhf__term-wrap{position:relative;}
  .zzhf__term-glow{
    position:absolute;inset:-8%;z-index:-1;border-radius:24px;
    background:radial-gradient(55% 60% at 50% 45%,rgba(var(--zzhf-accent-rgb),.22),transparent 72%);
    filter:blur(28px);
  }
  .zzhf__term{
    border-radius:14px;overflow:hidden;
    background:rgba(9,12,30,.85);
    border:1px solid rgba(255,255,255,.09);
    box-shadow:0 24px 70px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.06);
    backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  }
  .zzhf__term-bar{
    display:flex;align-items:center;gap:.45rem;
    padding:.7rem .95rem;
    background:rgba(255,255,255,.03);
    border-bottom:1px solid rgba(255,255,255,.07);
  }
  .zzhf__dot{width:10px;height:10px;border-radius:50%;}
  .zzhf__dot--r{background:#ff5f57;}
  .zzhf__dot--y{background:#febc2e;}
  .zzhf__dot--g{background:#28c840;}
  .zzhf__term-name{
    margin-left:.55rem;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:.7rem;letter-spacing:.08em;color:rgba(200,215,240,.4);
  }
  .zzhf__term-body{
    padding:1.4rem 1.3rem 1.5rem;
    font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
    font-size:clamp(.72rem,1.6vw,.86rem);
    line-height:2.1;
  }
  .zzhf__ln{margin:0;color:rgba(205,220,245,.75);white-space:nowrap;overflow:hidden;}
  .zzhf__prompt{color:rgba(var(--zzhf-accent-rgb),.9);font-weight:700;margin-right:.4ch;}
  .zzhf__ok{color:#4ade80;font-weight:700;}
  .zzhf__accent-txt{color:rgba(230,170,255,.95);font-weight:700;}
  .zzhf__caret{
    display:inline-block;width:.62ch;height:1.05em;margin-left:.25ch;
    vertical-align:text-bottom;background:rgba(230,170,255,.85);
    animation:zzhfBlink 1.05s steps(1,end) infinite;
  }
  @keyframes zzhfBlink{0%,55%{opacity:1}56%,100%{opacity:0}}

  /* typewriter reveal — only when JS marks the section live under zz-motion */
  html.zz-motion .zzhf.is-live .zzhf__ln{width:0;animation:zzhfType .7s steps(34,end) forwards;}
  html.zz-motion .zzhf.is-live .zzhf__ln--1{animation-delay:.15s;}
  html.zz-motion .zzhf.is-live .zzhf__ln--2{animation-delay:1s;}
  html.zz-motion .zzhf.is-live .zzhf__ln--3{animation-delay:1.8s;}
  html.zz-motion .zzhf.is-live .zzhf__ln--4{animation-delay:2.6s;}
  html.zz-motion .zzhf.is-live .zzhf__ln--5{animation-delay:3.4s;animation-duration:.45s;}
  html.zz-motion .zzhf:not(.is-live) .zzhf__ln{width:0;}
  @keyframes zzhfType{from{width:0}to{width:100%}}

  @media (prefers-reduced-motion:reduce){
    .zzhf__ln{width:auto!important;animation:none!important;}
    .zzhf__caret,.zzhf__status-pulse::after{animation:none!important;}
  }

  @media (max-width:900px){
    .zzhf__inner{grid-template-columns:1fr;gap:2.5rem;}
    .zzhf__term-wrap{order:-1;max-width:560px;margin:0 auto;width:100%;}
  }
</style>

<script>
  (function () {
    var el = document.querySelector('.zzhf');
    if (!el) return;
    var arm = function () { el.classList.add('is-live'); };
    if (!('IntersectionObserver' in window)) { arm(); return; }
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { arm(); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(el);
    /* failsafe: never leave the terminal empty */
    setTimeout(arm, 6000);
  })();
</script>
