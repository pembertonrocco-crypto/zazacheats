{# =========================================================================
   HERO — "ESP viewport" edition.
   The background is the product's own visual language: faint corner-bracket
   target boxes drifting at depth, distance tags, and a crosshair that eases
   toward your cursor. Fully static Nunjucks (no {% set %} object arrays).
   No GSAP — entrance is pure CSS, gated on html.zz-motion (reduced-motion
   and no-JS users get instantly visible content).
   ========================================================================= #}
<section
  class="hero alignment-{{ properties.alignment }} height-{{ properties.height }} component"
  data-component-id="{{ componentId }}"
>
  <div class="hero-scene" aria-hidden="true">
    <div class="hero-bg">
      {# LCP element. AVIF 53K / WebP 60K / JPEG 93K — same pixels, and the
         JPEG stays as the fallback so nothing regresses on older browsers.
         Preloaded in master.njk for AVIF-capable browsers. width/height are
         the intrinsic dimensions — .hero-bg__img is absolutely positioned so
         they don't affect layout here, they just document the source size.
         Sizing stays entirely with the existing class. #}
      <picture>
        <source srcset="{{ 'esp-demo-player.avif' | assetUrl }}" type="image/avif">
        <source srcset="{{ 'esp-demo-player.webp' | assetUrl }}" type="image/webp">
        <img src="{{ 'esp-demo-player.jpg' | assetUrl }}" alt="" class="hero-bg__img"
             width="1058" height="671" loading="eager" decoding="async" fetchpriority="high">
      </picture>
      <div class="hero-bg__grade"></div>
    </div>
    <canvas class="hero-canvas"></canvas>
  </div>
  <div class="hero-grain" aria-hidden="true"></div>

  {# ---- HUD overlays: injector watermark (real measured FPS) + mini radar ---- #}
  <div class="hero-hud hero-hud--tl" aria-hidden="true">
    <span class="hero-hud__dot"></span>
    <span class="hero-hud__seg">ZAZA.EXE</span>
    <span class="hero-hud__sep">▸</span>
    <span class="hero-hud__seg hero-hud__seg--ok">ATTACHED</span>
    <span class="hero-hud__sep">|</span>
    <span class="hero-hud__seg">rust.exe</span>
    <span class="hero-hud__sep">|</span>
    <span class="hero-hud__seg"><span id="hero-hud-fps">—</span> FPS</span>
  </div>
  <div class="hero-radar" aria-hidden="true">
    <div class="hero-radar__rings"></div>
    <div class="hero-radar__cross"></div>
    <div class="hero-radar__sweep"></div>
    <span class="hero-radar__blip hero-radar__blip--a"></span>
    <span class="hero-radar__blip hero-radar__blip--b"></span>
    <span class="hero-radar__blip hero-radar__blip--c"></span>
    <span class="hero-radar__label">RADAR</span>
  </div>

  <div class="hero-inner">

    <a href="{{ '/status' | shopUrl }}" class="hero-status">
      <span class="hero-status__pulse" aria-hidden="true"></span>
      <span class="hero-status__label">Live status</span>
      <span class="hero-status__sep" aria-hidden="true"></span>
      <span class="hero-status__text">check detection before you buy</span>
      <svg class="hero-status__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>

    <h1 class="hero-title">
      {% if properties.title %}
      {{ properties.title | renderString }}
      {% else %}
      <span class="hero-title-mask"><span class="hero-title-line">Private Rust Tooling</span></span><br><span class="hero-title-mask"><span class="hero-title-line hero-title-line--accent">Built, Updated, Supported</span></span>
      {% endif %}
    </h1>

    <p class="hero-sub">
      {{ properties.subtitle | renderString if properties.subtitle else 'A private Rust cheat with frequent updates and active support — instant delivery, card or crypto.' }}
    </p>

    <div class="hero-ctas">
      {% if properties.cta and properties.cta_text %}
      <a href="{{ properties.cta | shopUrl }}" class="hero-btn hero-btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-btn__ico"><path d="M12 2L3 6.5V11.5C3 16.25 6.9 20.7 12 22C17.1 20.7 21 16.25 21 11.5V6.5L12 2Z" fill="currentColor"/></svg>
        <span>{{ properties.cta_text }}</span>
      </a>
      {% else %}
      <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="hero-btn hero-btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-btn__ico"><path d="M12 2L3 6.5V11.5C3 16.25 6.9 20.7 12 22C17.1 20.7 21 16.25 21 11.5V6.5L12 2Z" fill="currentColor"/></svg>
        <span>Get your key</span>
      </a>
      {% endif %}
      <a href="https://discord.gg/zazacheats" class="hero-btn hero-btn-ghost">Ask Us Anything on Discord</a>
    </div>

    <p class="hero-micro">Checkout takes about a minute — your key is on screen the moment payment clears.</p>

    {# Resume chip — revealed by JS only for returning visitors who viewed
       the product page in the last 7 days but didn't check out. #}
    <div class="hero-resume" id="zz-resume" hidden>
      <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="hero-resume__link">
        <span class="hero-resume__dot" aria-hidden="true"></span>
        <span>Pick up where you left off — <strong>Zaza Rust Private</strong></span>
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button type="button" class="hero-resume__x" id="zz-resume-x" aria-label="Dismiss">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
    <style>
      .hero-micro{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.7rem;letter-spacing:.06em;
        color:rgba(231,236,255,.68);margin:10px 0 0}
      .hero-resume{display:inline-flex;align-items:center;gap:8px;margin-top:14px;
        padding:6px 8px 6px 12px;border:1px solid rgba(var(--cl-accent-rgb,191,64,191),.35);
        border-radius:999px;background:rgba(var(--cl-accent-rgb,191,64,191),.1)}
      .hero-resume__link{display:inline-flex;align-items:center;gap:8px;text-decoration:none;
        font-size:.8rem;color:rgba(231,236,255,.85)}
      .hero-resume__link strong{color:#fff}
      .hero-resume__dot{width:6px;height:6px;border-radius:50%;background:var(--cl-accent,#BF40BF);
        box-shadow:0 0 8px rgba(var(--cl-accent-rgb,191,64,191),.8)}
      .hero-resume__x{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;
        border:none;border-radius:50%;background:rgba(255,255,255,.08);color:rgba(231,236,255,.6);cursor:pointer;
        position:relative}
      /* invisible 44px hit area for touch without changing the visual */
      .hero-resume__x::before{content:"";position:absolute;inset:-12px}
      .hero-resume__x:hover{background:rgba(255,255,255,.16);color:#fff}
    </style>
    <script>
    (function(){
      try{
        var box=document.getElementById('zz-resume'); if(!box) return;
        var raw=localStorage.getItem('zzLastProduct'); if(!raw) return;
        if(localStorage.getItem('zzResumeHide')) return;
        var d=JSON.parse(raw);
        if(!d.t || (Date.now()-d.t) > 7*24*3600*1000) return;
        box.hidden=false;
        var x=document.getElementById('zz-resume-x');
        if(x){ x.addEventListener('click',function(){ box.hidden=true;
          try{ localStorage.setItem('zzResumeHide','1'); }catch(e){} }); }
      }catch(e){}
    })();
    </script>

    <a href="{{ '/feedback' | shopUrl }}" class="hero-rating">
      <span class="hero-rating__stars" data-zz-rstars-svg aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24"><path fill="#fbbf24" d="M12 17.3 6.2 20.6l1.5-6.5L2.6 9.7l6.6-.6L12 3l2.8 6.1 6.6.6-5.1 4.4 1.5 6.5z"/></svg>
        <svg width="13" height="13" viewBox="0 0 24 24"><path fill="#fbbf24" d="M12 17.3 6.2 20.6l1.5-6.5L2.6 9.7l6.6-.6L12 3l2.8 6.1 6.6.6-5.1 4.4 1.5 6.5z"/></svg>
        <svg width="13" height="13" viewBox="0 0 24 24"><path fill="#fbbf24" d="M12 17.3 6.2 20.6l1.5-6.5L2.6 9.7l6.6-.6L12 3l2.8 6.1 6.6.6-5.1 4.4 1.5 6.5z"/></svg>
        <svg width="13" height="13" viewBox="0 0 24 24"><path fill="#fbbf24" d="M12 17.3 6.2 20.6l1.5-6.5L2.6 9.7l6.6-.6L12 3l2.8 6.1 6.6.6-5.1 4.4 1.5 6.5z"/></svg>
        <svg width="13" height="13" viewBox="0 0 24 24"><path fill="#fbbf24" d="M12 17.3 6.2 20.6l1.5-6.5L2.6 9.7l6.6-.6L12 3l2.8 6.1 6.6.6-5.1 4.4 1.5 6.5z"/></svg>
      </span>
      <span class="hero-rating__text"><strong><span data-zz-ravg>{% if shop.average_rating and shop.average_rating > 0 %}{{ helpers.numbers.formatDecimal(shop.average_rating) }}{% else %}4.8{% endif %}</span>/5</strong> from <span data-zz-rc>100</span> verified customer reviews</span>
      <svg class="hero-rating__arrow" width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>

    <div class="hero-trust" aria-label="Why buy from us">
      <span class="hero-trust__item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M13 2L4.5 13H11l-1 9 8.5-11H12l1-9z" fill="#BF40BF"/></svg>Instant delivery</span>
      <span class="hero-trust__sep" aria-hidden="true"></span>
      <span class="hero-trust__item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 2.5l7 3v5.2c0 4.3-2.9 7.9-7 9.3-4.1-1.4-7-5-7-9.3V5.5l7-3z" fill="none" stroke="#22c55e" stroke-width="1.6"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8" stroke="#22c55e" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Live detection status</span>
      <span class="hero-trust__sep" aria-hidden="true"></span>
      <span class="hero-trust__item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="2.5" fill="none" stroke="#BF40BF" stroke-width="1.6"/><path d="M2 9.5h20" stroke="#BF40BF" stroke-width="1.6"/></svg>Card &amp; crypto</span>
      <span class="hero-trust__sep" aria-hidden="true"></span>
      <span class="hero-trust__item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 00-9 9v5a3 3 0 003 3h1v-7H5v-1a7 7 0 0114 0v1h-3v7h1a3 3 0 003-3v-5a9 9 0 00-9-9z" fill="#BF40BF"/></svg>Active support</span>
      <span class="hero-trust__sep" aria-hidden="true"></span>
      <span class="hero-trust__item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0114-5.3M20 12a8 8 0 01-14 5.3" stroke="#BF40BF" stroke-width="1.7" stroke-linecap="round"/><path d="M18 3v4h-4M6 21v-4h4" stroke="#BF40BF" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Frequent updates</span>
    </div>

    {# PAYMENT STRIP — EDIT: remove any method you don't actually accept,
       and add chips the same way if you enable more (e.g. PayPal). #}
    <div class="hero-pay" aria-label="Accepted payment methods">
      <span class="hero-pay__label">PAY WITH</span>
      <span class="hero-pay__chip">VISA</span>
      <span class="hero-pay__chip">Mastercard</span>
      <span class="hero-pay__chip"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M14.6 7.9c1.6 0 2.9-.6 3.8-1.7.8-1 1.2-2.2 1.1-3.5-1.3.1-2.6.7-3.5 1.7-.8.9-1.3 2.2-1.4 3.5zM19.4 8.6c-2.1-.1-3.8 1.2-4.8 1.2-1 0-2.5-1.1-4.1-1.1-2.1 0-4.1 1.2-5.2 3.1-2.2 3.8-.6 9.5 1.6 12.6 1.1 1.5 2.3 3.2 4 3.1 1.6-.1 2.2-1 4.1-1 1.9 0 2.5 1 4.1 1 1.7 0 2.8-1.5 3.8-3.1 1.2-1.8 1.7-3.5 1.7-3.6-.1 0-3.3-1.3-3.3-5-.1-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.6-2.4-4.5-2.5z" transform="scale(.8) translate(1 -1)"/></svg> Pay</span>
      <span class="hero-pay__chip">G&nbsp;Pay</span>
      <span class="hero-pay__sep"></span>
      <span class="hero-pay__chip hero-pay__chip--crypto">&#8383; BTC</span>
      <span class="hero-pay__chip hero-pay__chip--crypto">&Xi; ETH</span>
      <span class="hero-pay__chip hero-pay__chip--crypto">&#321; LTC</span>
    </div>
  </div>

  <button type="button" class="hero-scrollcue" data-hero-scrollcue aria-label="Scroll to content">
    <span class="hero-scrollcue__track" aria-hidden="true"><span class="hero-scrollcue__dot"></span></span>
    <span class="hero-scrollcue__label">scroll</span>
  </button>

</section>

<style>
.hero-pay{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:18px;opacity:.85}
.hero-pay__label{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.6rem;letter-spacing:.22em;color:rgba(231,236,255,.4);margin-right:2px}
.hero-pay__chip{display:inline-flex;align-items:center;gap:4px;font-size:.7rem;font-weight:700;letter-spacing:.04em;
  color:rgba(231,236,255,.72);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:5px 10px;
  background:rgba(255,255,255,.03);font-style:italic}
.hero-pay__chip--crypto{font-style:normal;color:rgba(251,191,36,.85);border-color:rgba(251,191,36,.22);background:rgba(251,191,36,.05)}
.hero-pay__sep{width:1px;height:14px;background:rgba(255,255,255,.12)}
@media (max-width:560px){.hero-pay{gap:6px}.hero-pay__chip{padding:4px 8px;font-size:.64rem}}

.hero {
  position: relative;
  width: 100%;
  min-height: 100svh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0c18;
  font-family:var(--zz-sans);
}

.hero-scene {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to bottom, black 62%, transparent 100%);
  -webkit-mask-composite: destination-in;
  mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%), linear-gradient(to bottom, black 62%, transparent 100%);
  mask-composite: intersect;
}

.hero-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.35rem;
  padding: 11rem 1.5rem 12.5rem;
  max-width: 1100px;
  margin: 0 auto;
}

/* ---------- live status chip ---------- */
.hero-status {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.42rem 1.05rem 0.42rem 0.85rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  text-decoration: none;
  font-family: ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  color: rgba(231, 236, 255, 0.78);
  transition: border-color .25s ease, background .25s ease, color .25s ease;
}
.hero-status:hover {
  border-color: rgba(34, 197, 94, 0.35);
  background: rgba(34, 197, 94, 0.05);
  color: rgba(231, 236, 255, 0.95);
}
.hero-status__pulse {
  position: relative;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.9);
  flex-shrink: 0;
}
.hero-status__pulse::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid rgba(34, 197, 94, 0.55);
  animation: heroPulse 2.2s ease-out infinite;
}
@keyframes heroPulse {
  0%   { transform: scale(0.5); opacity: 1; }
  70%  { transform: scale(1.6); opacity: 0; }
  100% { transform: scale(1.6); opacity: 0; }
}
.hero-status__label {
  text-transform: uppercase;
  font-weight: 700;
  color: rgba(134, 239, 172, 0.9);
}
.hero-status__sep {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(231, 236, 255, 0.3);
}
.hero-status__arrow {
  opacity: 0.55;
  transition: transform .25s ease, opacity .25s ease;
}
.hero-status:hover .hero-status__arrow {
  transform: translateX(3px);
  opacity: 1;
}

/* ---------- title ---------- */
.hero-title {
  font-size: clamp(2.6rem, 7vw, 5.2rem);
  line-height: 1.04;
  letter-spacing: -0.03em;
  font-weight: 700;
  margin: 0;
  color: #fff;
}
.hero-title-line { display: inline-block; }

.hero-sub {
  font-size: clamp(0.9rem, 1.5vw, 1.02rem);
  line-height: 1.8;
  color: rgba(231, 236, 255, 0.55);
  max-width: 640px;
  margin: 0;
  font-weight: 400;
}

/* ---------- CTAs ---------- */
.hero-ctas {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 0.35rem;
}

.hero-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.8rem 1.9rem;
  border-radius: 7px;
  font-size: 0.9rem;
  font-weight: 700;
  font-family:var(--zz-sans);
  text-decoration: none;
  transition: box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s cubic-bezier(0.16, 1, 0.3, 1), background 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
  letter-spacing: 0.01em;
  cursor: pointer;
  isolation: isolate;
  overflow: hidden;
}
.hero-btn__ico { flex-shrink: 0; }

.hero-btn-primary {
  background: #BF40BF;
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 8px 28px rgba(191, 64, 191, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}
.hero-btn-primary::after {
  content: '';
  position: absolute;
  top: -20%;
  bottom: -20%;
  left: -60%;
  width: 34%;
  background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.32), transparent);
  transform: skewX(-18deg);
  
  pointer-events: none;
}
.hero-btn-primary:hover {
  box-shadow: 0 10px 36px rgba(191, 64, 191, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  transform: translateY(-1px);
}
.hero-btn-primary:hover::after { animation-duration: 1.1s; }

.hero-btn-ghost {
  background: rgba(255, 255, 255, 0.04);
  color: rgba(231, 236, 255, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
.hero-btn-ghost:hover {
  border-color: rgba(191, 64, 191, 0.45);
  background: rgba(191, 64, 191, 0.07);
  color: #ffffff;
}

/* ---------- rating proof chip ---------- */
.hero-rating {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  margin-top: 1.15rem;
  padding: .5rem 1rem;
  border-radius: 999px;
  background: rgba(251, 191, 36, .06);
  border: 1px solid rgba(251, 191, 36, .18);
  text-decoration: none;
  transition: border-color .25s ease, background .25s ease, transform .25s cubic-bezier(.16,1,.3,1);
}
.hero-rating:hover {
  background: rgba(251, 191, 36, .1);
  border-color: rgba(251, 191, 36, .35);
  transform: translateY(-1px);
}
.hero-rating__stars { display: inline-flex; gap: 2px; }
.hero-rating__text {
  font-size: .8rem;
  font-weight: 500;
  color: rgba(231, 236, 255, .85);
  letter-spacing: .01em;
}
.hero-rating__text strong { color: #fff; font-weight: 700; }
.hero-rating__arrow { color: rgba(251, 191, 36, .8); transition: transform .25s ease; }
.hero-rating:hover .hero-rating__arrow { transform: translateX(3px); }

/* ---------- trust bar ---------- */
.hero-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: .55rem 1rem;
  margin-top: 1.4rem;
}
.hero-trust__item {
  display: inline-flex;
  align-items: center;
  gap: .42rem;
  font-size: .8rem;
  font-weight: 500;
  color: rgba(231, 236, 255, .82);
  letter-spacing: .01em;
  white-space: nowrap;
}
.hero-trust__item svg { flex-shrink: 0; }
.hero-trust__sep {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(231, 236, 255, .28);
}

/* ---------- entrance (CSS only, gated on html.zz-motion) ---------- */
@keyframes heroRise {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: none; }
}
html.zz-motion .hero-status { animation: heroRise .7s cubic-bezier(.22,1,.36,1) both; animation-delay: .55s; }
