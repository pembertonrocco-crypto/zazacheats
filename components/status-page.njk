.zs-card:hover{transform:translateY(-6px);border-color:rgba(34,197,94,.45);box-shadow:0 30px 64px -26px rgba(34,197,94,.5)}
.zs-card__glow{position:absolute;top:-60%;right:-30%;width:360px;height:360px;border-radius:50%;
  background:radial-gradient(circle,rgba(34,197,94,.2),transparent 70%);opacity:.4;transition:opacity .45s}
.zs-card:hover .zs-card__glow{opacity:1}
.zs-card__sheen{position:absolute;top:0;left:-60%;width:50%;height:100%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.06),transparent);transform:skewX(-18deg)}
.zs-card:hover .zs-card__sheen{animation:zsSheen 1.1s ease forwards}
@keyframes zsSheen{to{left:130%}}

.zs-card__top{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.zs-card__id{display:flex;align-items:center;gap:14px}
.zs-card__icon{display:grid;place-items:center;width:46px;height:46px;border-radius:12px;
  background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.22)}
.zs-card__name{margin:0;font-size:1.2rem;font-weight:700;letter-spacing:-.01em}
.zs-card__sub{margin:.2rem 0 0;font-size:.82rem;color:var(--mut);font-family:var(--zz-alt);font-variant-numeric:tabular-nums}
.zs-pill{display:inline-flex;align-items:center;gap:8px;flex-shrink:0;padding:8px 15px;font-size:.82rem;font-weight:700;--ch:7px;
  -webkit-clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch));
  clip-path:polygon(var(--ch) 0,calc(100% - var(--ch)) 0,100% var(--ch),100% calc(100% - var(--ch)),calc(100% - var(--ch)) 100%,var(--ch) 100%,0 calc(100% - var(--ch)),0 var(--ch))}
.zs-pill__dot{width:8px;height:8px;border-radius:50%;background:currentColor;animation:zsPulse 1.8s ease-in-out infinite}

.zs-bar{position:relative;height:6px;border-radius:99px;background:rgba(255,255,255,.06);overflow:hidden;margin:20px 0}
.zs-bar__fill{position:absolute;inset:0;border-radius:99px;width:0;animation:zsFill 1.4s cubic-bezier(.16,1,.3,1) .6s forwards}
@keyframes zsFill{to{width:100%}}
@keyframes zsShift{to{background-position:200% 0}}

/* state-driven cards: colour follows --c from the status modifier */
.zs-card--u{--c:34,197,94}
.zs-card--p{--c:234,179,8}
.zs-card--d{--c:239,68,68}
.zs-card--state{border-color:rgba(var(--c),.2);background:linear-gradient(135deg,rgba(var(--c),.07),rgba(124,58,237,.03))}
.zs-card--state::before{background:linear-gradient(90deg,transparent,rgba(var(--c),.6),transparent)}
.zs-card--state:hover{border-color:rgba(var(--c),.45);box-shadow:0 30px 64px -26px rgba(var(--c),.5)}
.zs-card--state .zs-card__glow{background:radial-gradient(circle,rgba(var(--c),.2),transparent 70%)}
.zs-card--state .zs-card__icon{background:rgba(var(--c),.1);border-color:rgba(var(--c),.22)}
.zs-card--state .zs-card__icon svg [stroke]{stroke:rgb(var(--c))}
.zs-card--state .zs-card__icon svg [fill]:not([fill="none"]){fill:rgba(var(--c),.14)}
.zs-card--state .zs-pill{background:rgba(var(--c),.12);border:1px solid rgba(var(--c),.28);color:rgb(var(--c))}
.zs-card--state .zs-bar__fill{background:linear-gradient(90deg,rgba(var(--c),.7),rgb(var(--c)),rgba(var(--c),.7));background-size:200% 100%;animation:zsFill 1.4s cubic-bezier(.16,1,.3,1) .6s forwards, zsShift 3s linear infinite 2s}
.zs-card--state .zs-stateClr{color:rgb(var(--c))}

/* cursor spotlight + tilt */
.zs-grid{perspective:1400px}
.zs-card{transform-style:preserve-3d}
.zs-card::after{content:'';position:absolute;inset:0;border-radius:20px;pointer-events:none;z-index:1;opacity:0;
  transition:opacity .35s ease;
  background:radial-gradient(260px circle at var(--mx,50%) var(--my,50%),rgba(var(--c,191,64,191),.16),transparent 60%)}
.zs-card:hover::after{opacity:1}
.zs-card__top,.zs-card .zs-bar,.zs-card .zs-meta,.zs-card__cta{position:relative;z-index:2}

.zs-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.zs-meta__item{display:flex;flex-direction:column;gap:4px}
.zs-meta__k{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:rgba(200,215,240,.4)}
.zs-meta__v{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.92rem;font-weight:500}

.zs-card__cta{display:inline-flex;align-items:center;gap:9px;margin-top:22px;padding:11px 18px;border-radius:11px;
  background:linear-gradient(135deg,var(--u),#16a34a);color:#04140a;font-size:.92rem;font-weight:700;
  box-shadow:0 10px 28px -10px rgba(34,197,94,.8);transition:gap .25s,filter .25s}
.zs-card:hover .zs-card__cta{gap:13px;filter:brightness(1.08)}
.zs-card--p .zs-card__cta,.zs-card--d .zs-card__cta{background:linear-gradient(135deg,rgba(var(--c),1),rgba(var(--c),.75));color:#140d02;box-shadow:0 10px 28px -10px rgba(var(--c),.8)}

/* ═══ update log ═══ */
.zs-log{margin-top:56px}
.zs-log__list{list-style:none;margin:18px 0 0;padding:0;position:relative;
  border:1px solid rgba(255,255,255,.07);border-radius:16px;background:var(--panel);overflow:hidden}
.zs-log__row{position:relative;display:flex;align-items:flex-start;gap:14px;padding:16px 20px;
  border-bottom:1px solid rgba(255,255,255,.05)}
.zs-log__row:last-child{border-bottom:none}
.zs-log__date{flex-shrink:0;width:86px;padding-top:2px;
  font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.72rem;letter-spacing:.04em;color:rgba(200,215,240,.5)}
.zs-log__dot{flex-shrink:0;width:9px;height:9px;border-radius:50%;margin-top:5px}
.zs-log__dot--u{background:var(--u);box-shadow:0 0 10px rgba(34,197,94,.7)}
.zs-log__dot--p{background:var(--p);box-shadow:0 0 10px rgba(234,179,8,.7)}
.zs-log__dot--d{background:var(--d);box-shadow:0 0 10px rgba(239,68,68,.7)}
.zs-log__dot--i{background:var(--v);box-shadow:0 0 10px rgba(191,64,191,.7)}
.zs-log__body{display:flex;flex-direction:column;gap:3px;min-width:0}
.zs-log__t{font-size:.92rem;font-weight:700;color:#fff;letter-spacing:.01em}
.zs-log__d{font-size:.82rem;line-height:1.6;color:rgba(200,215,240,.6)}
.zs-log__note{margin:14px 0 0;text-align:center;font-size:.78rem;color:rgba(200,215,240,.5);font-style:italic}
@media (max-width:560px){
  .zs-log__row{flex-wrap:wrap;gap:8px 12px}
  .zs-log__date{width:auto;order:3;flex-basis:100%;padding-left:21px}
}

/* ═══ how the light works ═══ */
.zs-verify{margin-top:56px}
.zs-verify__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}
@media (max-width:700px){.zs-verify__grid{grid-template-columns:1fr}}
.zs-verify__card{padding:20px;border-radius:16px;border:1px solid rgba(255,255,255,.07);background:var(--panel)}
.zs-verify__card--hl{border-color:rgba(191,64,191,.3);
  background:linear-gradient(160deg,rgba(191,64,191,.09),rgba(12,15,30,.72) 55%)}
.zs-verify__ico{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;margin-bottom:12px;
  color:#e0c2ff;background:rgba(191,64,191,.1);border:1px solid rgba(191,64,191,.22)}
.zs-verify__t{margin:0 0 8px;font-size:.98rem;font-weight:700;letter-spacing:.01em;color:#fff}
.zs-verify__d{margin:0;font-size:.84rem;line-height:1.65;color:rgba(200,215,240,.68)}
.zs-verify__d strong{color:rgba(235,242,255,.92)}
.zs-verify__link{display:inline-flex;align-items:center;gap:6px;margin-top:10px;
  font-weight:700;font-size:.84rem;color:#e0a6ff;text-decoration:none;transition:gap .2s}
.zs-verify__link:hover{gap:9px;text-decoration:underline}

/* key protocol */
.zs-proto{margin-top:56px}
.zs-proto__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:6px}
@media (max-width:700px){.zs-proto__grid{grid-template-columns:1fr}}
.zs-proto__card{padding:18px;border-radius:16px;border:1px solid rgba(255,255,255,.07);background:var(--panel)}
.zs-proto__card--u{border-color:rgba(34,197,94,.22)}
.zs-proto__card--p{border-color:rgba(234,179,8,.22)}
.zs-proto__card--d{border-color:rgba(239,68,68,.22)}
.zs-proto__head{display:flex;align-items:center;gap:9px;margin-bottom:9px}
.zs-proto__dot{width:9px;height:9px;border-radius:50%}
.zs-proto__dot--u{background:var(--u);box-shadow:0 0 10px rgba(34,197,94,.7)}
.zs-proto__dot--p{background:var(--p);box-shadow:0 0 10px rgba(234,179,8,.7)}
.zs-proto__dot--d{background:var(--d);box-shadow:0 0 10px rgba(239,68,68,.7)}
.zs-proto__state{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff}
.zs-proto__body{margin:0;font-size:.84rem;line-height:1.6;color:rgba(200,215,240,.7)}
.zs-proto__note{margin:16px 0 0;text-align:center;font-size:.78rem;color:rgba(200,215,240,.5);font-style:italic}

/* status-aware CTA */
.zs-go{margin-top:34px;display:flex;align-items:center;gap:18px;padding:22px 26px;border-radius:18px;
  border:1px solid rgba(34,197,94,.25);background:linear-gradient(135deg,rgba(34,197,94,.08),rgba(34,197,94,.02))}
.zs-go--p,.zs-go--d{border-color:rgba(234,179,8,.25);background:linear-gradient(135deg,rgba(234,179,8,.07),rgba(234,179,8,.02))}
.zs-go__text{flex:1;display:flex;flex-direction:column;line-height:1.4;min-width:0}
.zs-go__t{font-size:1.02rem;font-weight:700;color:#fff}
.zs-go__d{font-size:.78rem;color:rgba(200,215,240,.6);margin-top:3px}
.zs-go__btn{flex-shrink:0;display:inline-flex;align-items:center;gap:9px;padding:.85rem 1.6rem;border-radius:12px;
  font-size:.92rem;font-weight:700;color:#fff;text-decoration:none;
  background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 10px 28px -12px rgba(34,197,94,.9);
  transition:transform .2s,box-shadow .2s}
.zs-go__btn:hover{transform:translateY(-2px);box-shadow:0 16px 36px -12px rgba(34,197,94,.95)}
.zs-go__btn--dc{background:linear-gradient(135deg,#5865F2,#7C3AED);box-shadow:0 10px 28px -12px rgba(88,101,242,.9)}
.zs-go__btn--dc:hover{box-shadow:0 16px 36px -12px rgba(88,101,242,.95)}
@media (max-width:560px){.zs-go{flex-direction:column;text-align:center}.zs-go__btn{width:100%;justify-content:center}}
@media (prefers-reduced-motion:reduce){.zs-go__btn{transition:none}}

.zs-foot{text-align:center;color:rgba(200,215,240,.65);font-size:.86rem;margin:42px 0 0;
  padding-top:28px;border-top:1px solid rgba(255,255,255,.05)}

/* legacy dynamic cards (platform statuses) */
.zs-grid .status-card{border:1px solid var(--edge);border-radius:16px;padding:18px 22px;text-decoration:none;
  display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--panel);color:var(--ink)}
.zs-grid .status-card h3{margin:0;font-size:1.05rem;font-weight:700}
.zs-grid .status-card .status{display:flex;align-items:center;gap:9px}
.zs-grid .status-card .indicator{position:relative;width:9px;height:9px;border-radius:50%}
.zs-grid .status-card .pulsating{position:absolute;inset:0;border-radius:50%;animation:zsPulse 1.8s ease-in-out infinite}
.zs-grid .status-card .label{font-weight:500;font-size:.88rem}

@media (max-width:680px){
  .zs-wrap{padding:104px 16px 64px}
  .zs-shield{width:220px;height:220px;margin-top:40px}
  .zs-shield__pulse{width:168px;height:168px}
  .zs-band{gap:4px;padding:16px 10px}
  .zs-band__div{display:none}
  .zs-band__item{min-width:70px}
  .zs-band__v{font-size:1rem}
  .zs-meta{grid-template-columns:repeat(2,1fr);gap:16px}
  .zs-card__top{flex-direction:column}
}
@media (prefers-reduced-motion:reduce){
  .zs-page *{animation:none!important}
  .zs-rise{opacity:1!important;transform:none!important}
  .zs-shield__fill{stroke-dashoffset:14!important}
  .zs-bar__fill{width:100%!important}
}

/* ===== flashy upgrades ===== */
.zs-shield{transform-style:preserve-3d;transition:transform .25s cubic-bezier(.16,1,.3,1);will-change:transform}
.zs-shield__core,.zs-shield__ring{transition:transform .25s cubic-bezier(.16,1,.3,1)}
.zs-shield__sweep{position:absolute;inset:0;border-radius:50%;pointer-events:none;overflow:hidden;
  -webkit-mask:radial-gradient(circle,transparent 78%,#000 80%,#000 92%,transparent 94%);
  mask:radial-gradient(circle,transparent 78%,#000 80%,#000 92%,transparent 94%)}
.zs-shield__sweep::before{content:'';position:absolute;top:50%;left:50%;width:140%;height:40%;
  transform-origin:left center;
  background:linear-gradient(90deg,transparent,rgba(34,197,94,.55),transparent);
  animation:zsSweep 3.6s linear infinite}
@keyframes zsSweep{from{transform:translate(-50%,-50%) rotate(0deg)}to{transform:translate(-50%,-50%) rotate(360deg)}}
.zs-shield__state{font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){
  .zs-shield__sweep::before{animation:none!important}
  .zs-shield{transform:none!important}
}

/* ===== 100x PASS: release notes, restock log, timeline rail ===== */
.zs-cl{margin-top:14px;border:1px solid rgba(255,255,255,.08);border-radius:12px;
  background:rgba(255,255,255,.025);overflow:hidden}
.zs-cl__sum{display:flex;align-items:center;justify-content:space-between;gap:10px;cursor:pointer;
  list-style:none;padding:11px 14px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
  font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(200,215,240,.65);
  transition:color .2s,background .2s}
.zs-cl__sum::-webkit-details-marker{display:none}
.zs-cl__sum:hover{color:#fff;background:rgba(255,255,255,.03)}
.zs-cl__sum svg{transition:transform .3s cubic-bezier(.22,1,.36,1)}
.zs-cl[open] .zs-cl__sum svg{transform:rotate(180deg)}
.zs-cl__rows{padding:4px 14px 12px;display:grid;gap:10px}
.zs-cl__row{display:flex;gap:12px;align-items:flex-start}
.zs-cl__ver{flex-shrink:0;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.66rem;font-weight:700;
  color:#c7b8ff;background:rgba(124,58,237,.16);border:1px solid rgba(124,58,237,.3);
  border-radius:7px;padding:4px 8px;margin-top:1px}
.zs-cl__body{display:flex;flex-direction:column;gap:2px;min-width:0}
.zs-cl__date{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.64rem;color:rgba(200,215,240,.42);letter-spacing:.1em}
.zs-cl__txt{font-size:.86rem;color:rgba(220,232,255,.78);line-height:1.55}

/* update log: connected timeline rail */
.zs-log__list{position:relative}
.zs-log__list::before{content:"";position:absolute;left:118px;top:10px;bottom:10px;width:1px;
  background:linear-gradient(180deg,rgba(191,64,191,.35),rgba(124,58,237,.15) 60%,transparent)}
.zs-log__row{transition:background .25s,transform .25s}
.zs-log__row:hover{background:rgba(255,255,255,.025);transform:translateX(3px)}
.zs-log__dot{position:relative;z-index:1;box-shadow:0 0 0 4px rgba(6,7,15,1)}
@media (max-width:640px){.zs-log__list::before{display:none}}

/* card CTA is now a real link */
a.zs-card__cta{text-decoration:none}

/* ===== 100x v2: component board, live clock, aura, log permalinks ===== */
.zs-aura{position:absolute;inset:-10% -10% auto;height:60vh;pointer-events:none;filter:blur(90px);opacity:.5;transition:background 1s}
.zs-aura--u{background:radial-gradient(60% 60% at 50% 0%,rgba(34,197,94,.16),transparent 70%)}
.zs-aura--p{background:radial-gradient(60% 60% at 50% 0%,rgba(245,196,81,.16),transparent 70%)}
.zs-aura--d{background:radial-gradient(60% 60% at 50% 0%,rgba(248,113,113,.18),transparent 70%)}

.zs-band__v--clock{font-variant-numeric:tabular-nums;color:#c7b8ff}

.zs-sys{max-width:860px;margin:0 auto 34px;border:1px solid rgba(191,64,191,.16);border-radius:20px;
  background:rgba(12,15,30,.62);backdrop-filter:blur(14px);overflow:hidden}
.zs-sys__head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap;
  padding:18px 22px 12px;border-bottom:1px solid rgba(255,255,255,.06)}
.zs-sys__title{font-size:1.05rem;font-weight:700;margin:0;letter-spacing:-.01em}
.zs-sys__note{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.62rem;letter-spacing:.1em;color:rgba(200,215,240,.65)}
.zs-sys__grid{display:grid;grid-template-columns:1fr 1fr}
.zs-sys__row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 22px;
  border-top:1px solid rgba(255,255,255,.04)}
.zs-sys__row:nth-child(odd){border-right:1px solid rgba(255,255,255,.04)}
.zs-sys__row:nth-child(-n+2){border-top:none}
.zs-sys__name{font-size:.92rem;font-weight:500;color:rgba(228,238,255,.85)}
.zs-sys__chip{display:inline-flex;align-items:center;gap:7px;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;
  font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border-radius:999px;padding:6px 12px}
.zs-sys__dot{width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 9px currentColor;animation:zsSysPulse 2.2s infinite}
@keyframes zsSysPulse{0%,100%{opacity:1}50%{opacity:.45}}
.zs-sys__chip--op{color:#4ade80;background:rgba(34,197,94,.09);border:1px solid rgba(34,197,94,.28)}
.zs-sys__chip--slow{color:#fbbf24;background:rgba(245,196,81,.09);border:1px solid rgba(245,196,81,.3)}
.zs-sys__chip--down{color:#f87171;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.32)}
@media (max-width:640px){.zs-sys__grid{grid-template-columns:1fr}.zs-sys__row:nth-child(odd){border-right:none}.zs-sys__row:nth-child(2){border-top:1px solid rgba(255,255,255,.04)}}

.zs-log__row{scroll-margin-top:110px}
.zs-log__row:target{background:rgba(191,64,191,.08);border-radius:12px;animation:zsTargetFlash 1.6s ease}
@keyframes zsTargetFlash{0%{background:rgba(191,64,191,.22)}100%{background:rgba(191,64,191,.08)}}
.zs-log__link{margin-left:auto;flex-shrink:0;opacity:0;border:0;background:transparent;color:rgba(200,215,240,.5);
  cursor:pointer;padding:4px;border-radius:6px;transition:opacity .2s,color .2s;font-size:.8rem;line-height:1}
.zs-log__row:hover .zs-log__link{opacity:1}
.zs-log__link:hover{color:#fff}

/* ===== 100x v3: history strip, since-last-visit, coverage ===== */
.zs-hist{max-width:860px;margin:26px auto 0;border:1px solid rgba(191,64,191,.14);border-radius:18px;
  background:rgba(12,15,30,.6);backdrop-filter:blur(12px);padding:16px 20px 14px}
.zs-hist__head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.zs-hist__title{font-weight:700;font-size:.95rem;color:#fff}
.zs-hist__note{font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.6rem;letter-spacing:.1em;color:rgba(200,215,240,.65)}
.zs-hist__cells{display:grid;grid-template-columns:repeat(30,1fr);gap:4px}
.zs-hist__cell{position:relative;height:26px;border-radius:5px;background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.05);transition:transform .18s}
.zs-hist__cell:hover{transform:scaleY(1.18)}
.zs-hist__cell--u{background:rgba(34,197,94,.55);border-color:rgba(34,197,94,.7)}
.zs-hist__cell--p{background:rgba(245,196,81,.55);border-color:rgba(245,196,81,.7)}
.zs-hist__cell--d{background:rgba(248,113,113,.6);border-color:rgba(248,113,113,.75)}
.zs-hist__cell::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 7px);left:50%;transform:translateX(-50%);
  white-space:nowrap;font-family:var(--zz-alt);font-variant-numeric:tabular-nums;font-size:.6rem;letter-spacing:.06em;color:#fff;
  background:#151833;border:1px solid rgba(255,255,255,.12);border-radius:7px;padding:5px 9px;
