    ctx.moveTo(x, y + arm); ctx.lineTo(x, y); ctx.lineTo(x + arm, y);
    /* top-right */
    ctx.moveTo(x + w - arm, y); ctx.lineTo(x + w, y); ctx.lineTo(x + w, y + arm);
    /* bottom-right */
    ctx.moveTo(x + w, y + h - arm); ctx.lineTo(x + w, y + h); ctx.lineTo(x + w - arm, y + h);
    /* bottom-left */
    ctx.moveTo(x + arm, y + h); ctx.lineTo(x, y + h); ctx.lineTo(x, y + h - arm);
    ctx.stroke();
  }

  function drawSkeleton(t, alpha) {
    var cx = t.x + t.w / 2;
    var sway = Math.sin(tick * 0.012 + t.phase) * (t.w * 0.05);
    var headR = t.h * 0.075;
    var headY = t.y + t.h * 0.16;
    var hipY = t.y + t.h * 0.55;
    var a = alpha * 0.55;

    ctx.strokeStyle = 'rgba(231, 236, 255, ' + a + ')';
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.arc(cx, headY, headR, 0, Math.PI * 2);
    ctx.stroke();

    ctx.beginPath();
    /* spine */
    ctx.moveTo(cx, headY + headR); ctx.lineTo(cx, hipY);
    /* arms */
    ctx.moveTo(cx, t.y + t.h * 0.3);
    ctx.lineTo(cx - t.w * 0.24 + sway, t.y + t.h * 0.44);
    ctx.moveTo(cx, t.y + t.h * 0.3);
    ctx.lineTo(cx + t.w * 0.24 + sway, t.y + t.h * 0.44);
    /* legs */
    ctx.moveTo(cx, hipY);
    ctx.lineTo(cx - t.w * 0.18 - sway * 0.6, t.y + t.h * 0.92);
    ctx.moveTo(cx, hipY);
    ctx.lineTo(cx + t.w * 0.18 + sway * 0.6, t.y + t.h * 0.92);
    ctx.stroke();
