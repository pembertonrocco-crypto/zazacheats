{#
  home-buybar.njk — mobile-only sticky buy bar for the homepage.
  Static HTML/CSS/JS (SellAuth rule: no {% set %} object arrays).
  Behaviour: hidden until the visitor scrolls past ~85% of the first
  viewport, dismissible (remembered for the session), never rendered
  on desktop widths. Progressive enhancement — without JS it simply
  never appears.
#}
<div class="zzbb" id="zz-buybar" role="complementary" aria-label="Quick buy" hidden>
  <div class="zzbb__pill">
    <div class="zzbb__info">
      <span class="zzbb__name">Zaza Rust Private</span>
      <span class="zzbb__meta">
        <span class="zzbb__dot" aria-hidden="true"></span>
        Instant key delivery
      </span>
    </div>
    <a href="{{ '/product/zaza-rust-private-cheat' | shopUrl }}" class="zzbb__cta">
      Get your key
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M13 8l-4-4M13 8l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <button type="button" class="zzbb__close" id="zz-buybar-close" aria-label="Dismiss quick buy bar">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>
</div>

<style>
  .zzbb {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 990; /* below the navbar's 1000, above content */
    display: none;
    justify-content: center;
    padding: 0 .8rem calc(.8rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .zzbb { display: flex; }
  }
  .zzbb__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: .7rem;
    width: 100%;
    max-width: 480px;
    padding: .55rem .55rem .55rem .95rem;
    border-radius: 12px;
    background: rgba(6, 7, 15, 0.9);
    border: 1px solid rgba(191, 64, 191, 0.28);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 -4px 30px rgba(0,0,0,.5), 0 0 24px -8px rgba(191,64,191,.35);
    font-family:var(--zz-sans);
    transform: translateY(120%);
    opacity: 0;
    transition: transform .45s cubic-bezier(.16,1,.3,1), opacity .35s ease;
  }
  .zzbb.zzbb--show .zzbb__pill {
    transform: translateY(0);
    opacity: 1;
  }
  .zzbb__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .zzbb__name {
    font-size: .84rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .zzbb__meta {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .68rem;
    font-weight: 500;
    color: rgba(231, 236, 255, .6);
  }
  .zzbb__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,.8);
    flex-shrink: 0;
  }
  .zzbb__cta {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .62rem 1rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #BF40BF 0%, #8e2d8e 100%);
    color: #fff;
    font-size: .82rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: .01em;
    box-shadow: 0 1px 0 rgba(255,255,255,.14) inset, 0 8px 20px -8px rgba(191,64,191,.9);
    flex-shrink: 0;
  }
  .zzbb__cta:active { transform: scale(.97); }
  .zzbb__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.55);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .zzbb__pill { transition: none; }
  }
</style>

<script>
(function () {
  'use strict';
  var bar = document.getElementById('zz-buybar');
  var close = document.getElementById('zz-buybar-close');
  if (!bar || !close) return;

  var KEY = 'zz-buybar-dismissed';
  try { if (sessionStorage.getItem(KEY)) return; } catch (e) {}

  bar.hidden = false;
  var shown = false;

  function onScroll() {
    var past = (window.scrollY || document.documentElement.scrollTop) > window.innerHeight * 0.85;
    if (past && !shown) { shown = true; bar.classList.add('zzbb--show'); }
    else if (!past && shown) { shown = false; bar.classList.remove('zzbb--show'); }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  close.addEventListener('click', function () {
    bar.classList.remove('zzbb--show');
    window.removeEventListener('scroll', onScroll);
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    setTimeout(function () { bar.hidden = true; }, 450);
  });
})();
</script>
