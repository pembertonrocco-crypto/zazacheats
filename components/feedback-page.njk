      <!-- average + ring -->
      <div class="rev-panel-cell rev-score">
        <div class="rev-ring" data-zz-ring>
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="rev-ring-bg" cx="60" cy="60" r="52"></circle>
            <circle class="rev-ring-fg" cx="60" cy="60" r="52"></circle>
          </svg>
