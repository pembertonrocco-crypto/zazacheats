        {% for v in zzVouches %}
        <div class="fbq__item">
          <div class="fc">
            <div class="fc__head">
              <div class="fc__avatar">V</div>
              <div class="fc__who">
                <span class="fc__user">Verified buyer</span>
                <span class="fc__verified">✓ Verified buyer</span>
              </div>
              <div class="fc__stars" aria-label="{{ v.r }} out of 5 stars">{% for i in range(0, v.r) %}<svg viewBox="0 0 24 24" class="fc__star fc__star--filled" aria-hidden="true"><use href="#zz-fcstar"/></svg>{% endfor %}{% for i in range(0, 5 - v.r) %}<svg viewBox="0 0 24 24" class="fc__star" aria-hidden="true"><use href="#zz-fcstar"/></svg>{% endfor %}</div>
            </div>
            <div class="fc__message"><p>{{ v.m }}</p></div>
            <div class="fc__footer">
              <span class="fc__date">{{ v.d }}</span>
              <span class="fc__product-tag">Zaza Rust Private Cheat</span>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="fbq__row" data-direction="rtl">
      <div class="fbq__track">
        {# The second row used to replay the first eighteen reviews the top row
           had just shown, so anyone who watched both rows saw the same quotes go
           past twice in opposite directions. It now carries the half the first
           row has not reached yet. #}
        {% for v in zzVouches.slice(20) %}
        <div class="fbq__item">
          <div class="fc">
            <div class="fc__head">
              <div class="fc__avatar">V</div>
              <div class="fc__who">
                <span class="fc__user">Verified buyer</span>
                <span class="fc__verified">✓ Verified buyer</span>
              </div>
              <div class="fc__stars" aria-label="{{ v.r }} out of 5 stars">{% for i in range(0, v.r) %}<svg viewBox="0 0 24 24" class="fc__star fc__star--filled" aria-hidden="true"><use href="#zz-fcstar"/></svg>{% endfor %}{% for i in range(0, 5 - v.r) %}<svg viewBox="0 0 24 24" class="fc__star" aria-hidden="true"><use href="#zz-fcstar"/></svg>{% endfor %}</div>
            </div>
            <div class="fc__message"><p>{{ v.m }}</p></div>
            <div class="fc__footer">
              <span class="fc__date">{{ v.d }}</span>
