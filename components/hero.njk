  function drawParticles() {
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      p.x += p.sx; p.y += p.sy;
      if (p.y < -4) p.y = H + 4;
      if (p.y > H + 4) p.y = -4;
