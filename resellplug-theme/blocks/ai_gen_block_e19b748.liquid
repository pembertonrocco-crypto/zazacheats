{% doc %}
  @prompt
    Create a cart section that displays the products currently in the customer's cart, including product images, titles, quantities, prices, and a subtotal. Include options to update quantities and remove items, plus a checkout button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cart-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.container_padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-cart-header-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-cart-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
  }

  .ai-cart-item-count-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-cart-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
  }

  .ai-cart-empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-cart-empty-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.text_color }};
  }

  .ai-cart-empty-message-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.text_color }};
    margin-bottom: 24px;
  }

  .ai-cart-items-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-cart-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-cart-item-{{ ai_gen_id }}:first-child {
    padding-top: 0;
  }

  .ai-cart-item-image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-cart-item-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-cart-item-details-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-cart-item-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-cart-item-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-cart-item-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-cart-item-variant-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-cart-item-price-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-cart-item-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .ai-cart-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.divider_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
  }

  .ai-cart-quantity-button-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border: none;
    background-color: transparent;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .ai-cart-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.divider_color }};
  }

  .ai-cart-quantity-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-cart-quantity-input-{{ ai_gen_id }} {
    width: 50px;
    height: 32px;
    border: none;
    text-align: center;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    background-color: transparent;
  }

  .ai-cart-remove-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.remove_color }};
    cursor: pointer;
    font-size: 14px;
    text-decoration: underline;
    padding: 0;
  }

  .ai-cart-remove-button-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-cart-footer-{{ ai_gen_id }} {
    border-top: 2px solid {{ block.settings.divider_color }};
    padding-top: 24px;
  }

  .ai-cart-subtotal-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .ai-cart-subtotal-label-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-cart-subtotal-price-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-cart-note-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin-bottom: 20px;
  }

  .ai-cart-checkout-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: background-color 0.2s ease;
  }

  .ai-cart-checkout-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-cart-continue-shopping-{{ ai_gen_id }} {
    display: block;
    text-align: center;
    margin-top: 16px;
    color: {{ block.settings.text_color }};
    text-decoration: underline;
    font-size: 14px;
  }

  .ai-cart-continue-shopping-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-cart-loading-{{ ai_gen_id }} {
    pointer-events: none;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-cart-item-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-cart-item-image-{{ ai_gen_id }} {
      width: 100%;
      height: 200px;
    }

    .ai-cart-subtotal-price-{{ ai_gen_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<cart-component-{{ ai_gen_id }}
  class="ai-cart-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-cart-header-{{ ai_gen_id }}">
    <h2 class="ai-cart-title-{{ ai_gen_id }}">{{ block.settings.cart_title }}</h2>
    <div class="ai-cart-item-count-{{ ai_gen_id }}">
      {% if cart.item_count == 0 %}
        {{ block.settings.empty_cart_text }}
      {% elsif cart.item_count == 1 %}
        1 item
      {% else %}
        {{ cart.item_count }} items
      {% endif %}
    </div>
  </div>

  {% if cart.item_count == 0 %}
    <div class="ai-cart-empty-{{ ai_gen_id }}">
      <div class="ai-cart-empty-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
      <p class="ai-cart-empty-message-{{ ai_gen_id }}">{{ block.settings.empty_cart_message }}</p>
      <a href="{{ block.settings.continue_shopping_url }}" class="ai-cart-checkout-button-{{ ai_gen_id }}">
        {{ block.settings.continue_shopping_text }}
      </a>
    </div>
  {% else %}
    <div class="ai-cart-items-{{ ai_gen_id }}">
      {% for item in cart.items %}
        <div class="ai-cart-item-{{ ai_gen_id }}" data-cart-item="{{ item.key }}">
          <div class="ai-cart-item-image-{{ ai_gen_id }}">
            {% if item.image %}
              <img
                src="{{ item.image | image_url: width: 300 }}"
                alt="{{ item.image.alt | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
          </div>

          <div class="ai-cart-item-details-{{ ai_gen_id }}">
            <h3 class="ai-cart-item-title-{{ ai_gen_id }}">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
            </h3>

            {% if item.variant.title != 'Default Title' %}
              <div class="ai-cart-item-variant-{{ ai_gen_id }}">
                {{ item.variant.title }}
              </div>
            {% endif %}

            {% if block.settings.show_vendor and item.vendor != blank %}
              <div class="ai-cart-item-variant-{{ ai_gen_id }}">
                {{ item.vendor }}
              </div>
            {% endif %}

            <div class="ai-cart-item-price-{{ ai_gen_id }}">
              {{ item.final_line_price | money }}
            </div>

            <div class="ai-cart-item-actions-{{ ai_gen_id }}">
              <div class="ai-cart-quantity-{{ ai_gen_id }}">
                <button
                  class="ai-cart-quantity-button-{{ ai_gen_id }}"
                  data-action="decrease"
                  data-line="{{ forloop.index }}"
                  aria-label="Decrease quantity"
                  {% if item.quantity <= 1 %}disabled{% endif %}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
                <input
                  type="number"
                  class="ai-cart-quantity-input-{{ ai_gen_id }}"
                  value="{{ item.quantity }}"
                  min="1"
                  data-line="{{ forloop.index }}"
                  aria-label="Quantity"
                >
                <button
                  class="ai-cart-quantity-button-{{ ai_gen_id }}"
                  data-action="increase"
                  data-line="{{ forloop.index }}"
                  aria-label="Increase quantity"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>

              <button
                class="ai-cart-remove-button-{{ ai_gen_id }}"
                data-action="remove"
                data-line="{{ forloop.index }}"
              >
                {{ block.settings.remove_text }}
              </button>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="ai-cart-footer-{{ ai_gen_id }}">
      <div class="ai-cart-subtotal-{{ ai_gen_id }}">
        <span class="ai-cart-subtotal-label-{{ ai_gen_id }}">{{ block.settings.subtotal_text }}</span>
        <span class="ai-cart-subtotal-price-{{ ai_gen_id }}">{{ cart.total_price | money }}</span>
      </div>

      {% if block.settings.show_shipping_note %}
        <p class="ai-cart-note-{{ ai_gen_id }}">{{ block.settings.shipping_note_text }}</p>
      {% endif %}

      <a href="/checkout" class="ai-cart-checkout-button-{{ ai_gen_id }}">
        {{ block.settings.checkout_button_text }}
      </a>

      {% if block.settings.show_continue_shopping %}
        <a href="{{ block.settings.continue_shopping_url }}" class="ai-cart-continue-shopping-{{ ai_gen_id }}">
          {{ block.settings.continue_shopping_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</cart-component-{{ ai_gen_id }}>

<script>
  (function() {
    class CartComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cart = null;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.addEventListener('click', (event) => {
          const button = event.target.closest('button[data-action]');
          if (!button) return;

          const action = button.dataset.action;
          const line = button.dataset.line;

          if (action === 'increase') {
            this.updateQuantity(line, 1);
          } else if (action === 'decrease') {
            this.updateQuantity(line, -1);
          } else if (action === 'remove') {
            this.removeItem(line);
          }
        });

        this.addEventListener('change', (event) => {
          if (event.target.classList.contains('ai-cart-quantity-input-{{ ai_gen_id }}')) {
            const line = event.target.dataset.line;
            const newQuantity = parseInt(event.target.value);
            if (newQuantity > 0) {
              this.setQuantity(line, newQuantity);
            }
          }
        });
      }

      async updateQuantity(line, change) {
        const input = this.querySelector(`input[data-line="${line}"]`);
        const currentQuantity = parseInt(input.value);
        const newQuantity = currentQuantity + change;

        if (newQuantity < 1) return;

        await this.setQuantity(line, newQuantity);
      }

      async setQuantity(line, quantity) {
        this.setLoading(true);

        try {
          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              line: line,
              quantity: quantity
            })
          });

          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          console.error('Error updating cart:', error);
        } finally {
          this.setLoading(false);
        }
      }

      async removeItem(line) {
        this.setLoading(true);

        try {
          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              line: line,
              quantity: 0
            })
          });

          if (response.ok) {
            window.location.reload();
          }
        } catch (error) {
          console.error('Error removing item:', error);
        } finally {
          this.setLoading(false);
        }
      }

      setLoading(loading) {
        if (loading) {
          this.classList.add('ai-cart-loading-{{ ai_gen_id }}');
        } else {
          this.classList.remove('ai-cart-loading-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('cart-component-{{ ai_gen_id }}', CartComponent{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "cart_title",
      "label": "Cart title",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "empty_cart_text",
      "label": "Empty cart text",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "empty_cart_message",
      "label": "Empty cart message",
      "default": "Add some products to get started"
    },
    {
      "type": "text",
      "id": "subtotal_text",
      "label": "Subtotal text",
      "default": "Subtotal"
    },
    {
