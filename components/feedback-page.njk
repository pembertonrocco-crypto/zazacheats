          </div>
        </div>
        <div class="rev-score-caption">average rating&nbsp;·&nbsp;<span data-zz-rc>{{ zzTotal }}</span>&nbsp;reviews</div>
      </div>

      <div class="rev-panel-div"></div>

      <!-- headline stat tiles -->
      <div class="rev-panel-cell rev-tiles">
