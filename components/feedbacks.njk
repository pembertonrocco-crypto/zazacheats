  </div>

</section>

<style>
/* feedback card styles (inlined) */

.fc {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 180px;
  background: #0a0e22;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
  padding: 16px;
  font-family:var(--zz-sans);
  overflow: hidden;
  transition: border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.fc::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(180, 210, 255, 0.22) 50%, transparent);
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1;
}

.fc::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -40%;
  width: 140%;
  height: 80%;
  transform: translateX(-50%);
  background: radial-gradient(
    ellipse at center,
    rgba(191,64,191, 0.2) 0%,
    rgba(124,58,237, 0.1) 30%,
    rgba(191,64,191, 0.03) 60%,
    transparent 75%
  );
  opacity: 0;
  transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 0;
}

.fc:hover {
  background: #0c1128;
  border-color: rgba(180, 210, 255, 0.14);
}

.fc:hover::before {
  opacity: 1;
}

.fc:hover::after {
  opacity: 1;
}

.fc__top,
.fc__message,
.fc__footer {
  position: relative;
  z-index: 1;
}

.fc__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-shrink: 0;
}

.fc__meta {
  min-width: 0;
  flex: 1;
}

.fc__product {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.02em;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.fc__stars {
  display: flex;
  gap: 2px;
  flex-shrink: 0;
}

.fc__star {
  width: 13px;
  height: 13px;
}

.fc__star--filled {
  fill: rgba(255, 196, 70, 0.9);
}

.fc__star--empty {
  fill: none;
  stroke: rgba(255, 196, 70, 0.28);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.fc__message {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.fc__message p {
  font-size: 0.855rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.7;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fc__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-shrink: 0;
}

.fc__date {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: none;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1;
}

.fc__rating-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 196, 70, 0.07);
  border: 1px solid rgba(255, 196, 70, 0.14);
  border-radius: 999px;
  padding: 4px 8px;
  line-height: 1;
}

.fc__rating-badge span {
  font-size: 10px;
  font-weight: 700;
  color: rgba(255, 196, 70, 0.85);
  letter-spacing: 0.02em;
}

.fc__rating-star {
  width: 10px;
  height: 10px;
  fill: rgba(255, 196, 70, 0.85);
}

@media (max-width: 640px) {
  .fc {
    padding: 14px;
    gap: 10px;
    height: 170px;
  }

  .fc__product {
    font-size: 12px;
  }

  .fc__message p {
    font-size: 0.82rem;
  }
}


.fbq {
  position: relative;
  padding: 5rem 0;
  background: #06091a;
  overflow: hidden;
  font-family:var(--zz-sans);
}

.fbq__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  text-align: center;
  padding: 0 1.5rem;
  margin-bottom: 3rem;
}

.fbq__badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 999px;
  padding: 0.38rem 1.05rem 0.38rem 0.75rem;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.79rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.fbq__badge::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 6px;
  background: linear-gradient(90deg, transparent, rgba(180, 210, 255, 0.18) 40%, rgba(180, 210, 255, 0.18) 60%, transparent);
  border-radius: 999px;
  filter: blur(4px);
  pointer-events: none;
}

.fbq__badge::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15%;
  right: 15%;
  height: 6px;
  background: linear-gradient(90deg, transparent, rgba(180, 210, 255, 0.12) 40%, rgba(180, 210, 255, 0.12) 60%, transparent);
  border-radius: 999px;
  filter: blur(4px);
  pointer-events: none;
}

.fbq__title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.08;
  margin: 0;
  background: linear-gradient(180deg, #ffffff 0%, #ffffff 65%, #dae6ff 85%, #a8c4ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.fbq__subtitle {
  font-size: clamp(0.875rem, 1.4vw, 0.97rem);
  line-height: 1.8;
  color: rgba(200, 215, 240, 0.45);
  max-width: 520px;
  margin: 0;
  font-weight: 400;
}

.fbq__marquee-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 1100px;
  margin: 0 auto;
}

.fbq__fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 120px;
  z-index: 2;
  pointer-events: none;
}

.fbq__fade--left {
  left: 0;
  background: linear-gradient(to right, #06091a 0%, rgba(6, 9, 26, 0.7) 50%, transparent 100%);
}

.fbq__fade--right {
  right: 0;
  background: linear-gradient(to left, #06091a 0%, rgba(6, 9, 26, 0.7) 50%, transparent 100%);
}

.fbq__row {
  overflow: hidden;
  width: 100%;
}

.fbq__track {
  display: flex;
  gap: 14px;
  width: max-content;
  will-change: transform;
}

.fbq__item {
  width: 300px;
  flex-shrink: 0;
}

@media (max-width: 640px) {
  .fbq {
    padding: 3.5rem 0;
  }
  .fbq__head {
    margin-bottom: 2rem;
  }
  .fbq__item {
    width: 260px;
  }
  .fbq__fade {
    width: 60px;
  }
}

