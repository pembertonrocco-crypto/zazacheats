{% if feedbacks_paginator and feedbacks_paginator.data %}
{% for fb in feedbacks_paginator.data %}
{% if not fb.message or ('Automatic feedback' in fb.message) %}
      <div class="rc rc--auto" data-stars="{{ fb.rating }}" data-auto="1" style="--a:#22c55e;--b:#16a34a">
