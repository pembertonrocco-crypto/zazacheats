{# ---- REVIEW TOTALS (server-computed, single source of truth) ----
   PLATFORM REALITY (pieced together from live renders, 21-22 Jul 2026):
   /feedback sometimes receives feedbacks_paginator only, and sometimes BOTH
   feedbacks_paginator AND the homepage-style feedbacks array — and both carry
   the SAME automated entries. Scanning both therefore double-counts (that bug
   showed "80 reviews" = 44 written + 18 autos counted twice).
   feedbacks_paginator.total is separately unreliable (read 4 on one render,
   22 on another) and is deliberately not used. Every number below is derived
   from entries that actually render, and the automated scan reads ONE source
   only — paginator data first, the feedbacks array only when the paginator
   data held no automated entries — so nothing is ever counted twice:
     written   = 40 legacy + written entries in the data
     automated = max(zzAutoBase, automated entries found once)
   zzAutoBase is a floor for data-starved renders — bump it if the automated
   count in the SellAuth dashboard outgrows it (32 as of 27 Jul 2026, verified
   against the live page: 46 written + 32 automated = 78).
   zzTotal is echoed into the meta tag + every [data-zz-rc] on this page, and
   polish.njk syncs it to every other page. That sync refuses any total lower
   than the seed already in the markup, so a starved render here can no longer
   push a wrong number sitewide — it just leaves the other pages alone.
   Array mutation uses the proven if-push idiom from product-form.njk —
   do NOT change to "set x = arr.push(...)", that form is unverified on SellAuth. #}
{% set zzAutoBase = 32 %}
{% set autoArr = [] %}
{% if feedbacks_paginator and feedbacks_paginator.data %}
{% for fb in feedbacks_paginator.data %}{% if not fb.message or ('Automatic feedback' in fb.message) %}{% if autoArr.push(1) %}{% endif %}{% endif %}{% endfor %}
{% endif %}
{% set zzAutoPagN = autoArr|length %}
{% if feedbacks and not zzAutoPagN %}
{% for fb in feedbacks %}{% if not fb.message or ('Automatic feedback' in fb.message) %}{% if autoArr.push(1) %}{% endif %}{% endif %}{% endfor %}
{% endif %}
{% set zzAutoLive = autoArr|length %}
{% set zzAutoN = zzAutoBase %}
{% if zzAutoLive > zzAutoBase %}{% set zzAutoN = zzAutoLive %}{% endif %}
{# wArr mirrors the written grid's accept condition and branch order exactly,
   so zzWrittenN always equals 40 + the cards actually rendered below. #}
{% set wArr = [] %}
{% if feedbacks_paginator and feedbacks_paginator.data %}
{% for fb in feedbacks_paginator.data %}{% if fb.message and not ('Automatic feedback' in fb.message) %}{% if wArr.push(1) %}{% endif %}{% endif %}{% endfor %}
{% elif feedbacks %}
{% for fb in feedbacks %}{% if fb.message and not ('Automatic feedback' in fb.message) %}{% if wArr.push(1) %}{% endif %}{% endif %}{% endfor %}
{% endif %}
{% set zzWrittenN = 40 + (wArr|length) %}
{% set zzTotal = zzWrittenN + zzAutoN %}
